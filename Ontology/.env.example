# ============================================================================
#   APPLICATION CORE
# ============================================================================
APP_HOST=localhost
APP_PORT=7777
APP_ENV=development
FRONTEND_URL=http://localhost:5173

DB_USER=test_user
DB_PASSWORD=test_pass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db

DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================================
#   ONTOLOGY TBOX PIPELINE
# ============================================================================

# --- API keys (one per parallel extraction worker) --------------------------
API_KEY_1=
API_KEY_2=
API_KEY_3=
API_BASE_1=
API_BASE_2=
API_BASE_3=

# --- Model -------------------------------------------------------------------
LITELLM_MODEL=azure/gpt-5.4-nano
LITELLM_TEMPERATURE=0.0
LITELLM_MAX_TOKENS=16384
LITELLM_REQUEST_TIMEOUT=120

# --- Chunking (justification: see OPTIMIZATION_PLAN.md section 3) -----------
CHUNK_SIZE=60000          # ~15K tokens. Was 20000. Reduces 79 chunks -> ~22.
CHUNK_OVERLAP=1500        # ~2.5%. Was 2000 (10%). Lower because dedup is now
                          # post-hoc and can stitch entities across boundaries.

# --- Concurrency / rate-limit awareness -------------------------------------
NUM_KEYS=3                # Number of API keys (matches API_KEY_1..N).
RPM_PER_KEY=5000          # Azure deployment quota per key (informational).
TPM_PER_KEY=5000000       # Azure deployment quota per key (informational).
MAX_CONCURRENT_PER_KEY=50 # Defensive ceiling. Real usage will be ~8-10.
                          # Bound is set well below 5K RPM (5K/min ≈ 83/sec).

# --- Retry policy (only on actual 429s — never preemptive sleep) -----------
LLM_RETRY_MAX_ATTEMPTS=5
LLM_RETRY_MAX_BACKOFF_S=30

# --- Deduplication ---------------------------------------------------------
ENABLE_LLM_ALIAS_MERGE=true   # If true, run a single structured-output LLM
                              # call per phase after deterministic dedup to
                              # catch true synonyms (Customer/Client/Buyer).
                              # Set to false to skip and save 1 call/phase.

# --- Paths -------------------------------------------------------------------
PREPROCESSED_DIR=data/output_markdowns
OUTPUT_DIR=data/ontology_output

# --- Output filenames (relative to OUTPUT_DIR) ------------------------------
OUTPUT_CLASSES_JSON=classes.json
OUTPUT_CLASSES_MD=classes.md
OUTPUT_ONTOLOGY_TTL=ontology.ttl
OUTPUT_ONTOLOGY_OWL=ontology.owl

# --- Ontology metadata -------------------------------------------------------
ONTOLOGY_BASE_IRI=https://talan.com/ontology/bpi#
ONTOLOGY_PREFIX=bpi

# --- Pipeline tuning ---------------------------------------------------------
PIPELINE_LOG_LEVEL=INFO
