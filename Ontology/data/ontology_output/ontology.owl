    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CET1Ratio"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#exceptionalProfitOrLoss">
    <rdfs:label>exceptionalProfitOrLoss</rdfs:label>
    <rdfs:comment>Exceptional profit or loss amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ExceptionalProfitOrLoss"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#nonDeductibleExpensesAmount">
    <rdfs:label>nonDeductibleExpensesAmount</rdfs:label>
