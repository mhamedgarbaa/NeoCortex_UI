    <rdfs:comment>Repayment date of a loan.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Loan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#includes">
    <rdfs:label>includes</rdfs:label>
    <rdfs:comment>Indicates that the consolidated financial statements include equity-consolidated companies.</rdfs:comment>
