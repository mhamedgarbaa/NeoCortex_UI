    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CreditRiskCommittee"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ActuarialGainLoss">
    <rdfs:label>ActuarialGainLoss</rdfs:label>
    <rdfs:comment>Actuarial gains and losses arising from defined benefit plans.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DefinedBenefitPlan"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#operatingIncomeAfterShareOfNetIncomeOfEquityConsolidatedCompanies">
    <rdfs:label>operatingIncomeAfterShareOfNetIncomeOfEquityConsolidatedCompanies</rdfs:label>
    <rdfs:comment>Operating income after share of net income from equity-consolidated companies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#summarisedBy">
    <rdfs:label>summarisedBy</rdfs:label>
    <rdfs:comment>Indicates that the universal registration document (as amended) may be supplemented by a summary.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SecuritiesSummary"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#periodEndDate">
    <rdfs:label>periodEndDate</rdfs:label>
    <rdfs:comment>End date of the period covered by the half-year consolidated financial statements (e.g., 30 June 2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGuaranteeCommitmentsInFavourOf">
    <rdfs:label>hasGuaranteeCommitmentsInFavourOf</rdfs:label>
    <rdfs:comment>Links the institution to guarantee commitments it provides in favour of another entity (e.g., EPIC Bpifrance guarantee commitments in favour of Bpifrance SA bond issues).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitment"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BondIssue">
    <rdfs:label>BondIssue</rdfs:label>
    <rdfs:comment>A bond issuance referenced in the context of funding sources and liquidity risk.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#impairmentLoss">
    <rdfs:label>impairmentLoss</rdfs:label>
    <rdfs:comment>Impairment loss amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ImpairmentLoss"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Impairment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteeCommitmentsGivenAmount">
    <rdfs:label>guaranteeCommitmentsGivenAmount</rdfs:label>
    <rdfs:comment>Total amount of guarantee commitments given.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitment"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitments"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentActivityRisk">
    <rdfs:label>InvestmentActivityRisk</rdfs:label>
    <rdfs:comment>Risk of impairment and fair value variability arising from holding securities and investment fund units.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Risk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GreentechEntity">
    <rdfs:label>GreentechEntity</rdfs:label>
    <rdfs:comment>Entity providing an innovative service, product, or technology that enhances environmental impact aligned with EU environmental objectives.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Entity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#collectsPersonalData">
    <rdfs:label>collectsPersonalData</rdfs:label>
    <rdfs:comment>Indicates that a personal data collection activity collects personal data.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataCollection"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityAffiliate">
    <rdfs:label>EquityAffiliate</rdfs:label>
    <rdfs:comment>An affiliate accounted for using the equity method, with the investor’s share of net profit presented accordingly.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AffiliateCompany"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Company"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#expenseRatio">
    <rdfs:label>expenseRatio</rdfs:label>
    <rdfs:comment>Expense ratio (if disclosed in the document).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ExpenseRatio"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#legalBasisDescription">
    <rdfs:label>legalBasisDescription</rdfs:label>
    <rdfs:comment>Narrative description of the legal basis for processing for a specific purpose.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#LegalBasisForProcessing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#coversEligibleGreenLoansCategories">
    <rdfs:label>coversEligibleGreenLoansCategories</rdfs:label>
    <rdfs:comment>The framework covers eligible green loan categories that are financed/refinanced through green financing instruments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingInstrument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Loans"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NEUCPProgramme">
    <rdfs:label>NEUCPProgramme</rdfs:label>
    <rdfs:comment>NEU CP/EUR CP programme referenced as a bond resources category.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EMTNProgramme"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#UnconventionalResources">
    <rdfs:label>UnconventionalResources</rdfs:label>
    <rdfs:comment>A sector category (e.g., oil and gas from oil sands, shale, Arctic) referenced in exclusion criteria.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Issuer">
    <rdfs:label>Issuer</rdfs:label>
    <rdfs:comment>An entity that files universal registration documents and related amendments and provides information about its activities and financial position.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#includesCompaniesInConsolidationScope">
    <rdfs:label>includesCompaniesInConsolidationScope</rdfs:label>
    <rdfs:comment>Indicates that the consolidated financial statements include companies within the consolidation scope (exclusively controlled companies, joint ventures, and significant influence investees).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ControlledCompany"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasExpectedRisks">
    <rdfs:label>hasExpectedRisks</rdfs:label>
    <rdfs:comment>Indicates that cost of risk includes expected risks.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CostOfRisk"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ExpectedRisks"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Affiliate">
    <rdfs:label>Affiliate</rdfs:label>
    <rdfs:comment>An entity over which the group has significant influence, typically accounted for using the equity method.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isAlignedWithSustainableDevelopmentGoals">
    <rdfs:label>isAlignedWithSustainableDevelopmentGoals</rdfs:label>
    <rdfs:comment>Green financing instruments aim to contribute to the Sustainable Development Goals.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingInstrument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SustainableDevelopmentGoal"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExpertiseCentre">
    <rdfs:label>ExpertiseCentre</rdfs:label>
    <rdfs:comment>A support division working transversally on strategic areas such as climate and industry of the future.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SupportDivision"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#secondPartyOpinionYear">
    <rdfs:label>secondPartyOpinionYear</rdfs:label>
    <rdfs:comment>Year referenced for the alignment of the Second-Party Opinion with the ICMA Green Bond Principles (2025).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CorporateCustomer">
    <rdfs:label>CorporateCustomer</rdfs:label>
    <rdfs:comment>A customer entity receiving guarantees for counterparty risk related to long-term contracts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityInterestInFutureTechnologyCompany">
    <rdfs:label>EquityInterestInFutureTechnologyCompany</rdfs:label>
    <rdfs:comment>Equity interests in companies developing future technologies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityInvestments"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasAdvisoryCommittee">
    <rdfs:label>hasAdvisoryCommittee</rdfs:label>
    <rdfs:comment>Indicates that the group has advisory committees for governance of partner funds.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#AdvisoryCommittee"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isSubjectTo">
    <rdfs:label>isSubjectTo</rdfs:label>
    <rdfs:comment>Indicates the processing is subject to applicable regulations referenced in the policy.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ApplicableRegulation"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#shareOfNetBookValueAmount">
    <rdfs:label>shareOfNetBookValueAmount</rdfs:label>
    <rdfs:comment>Share of net book value of securities (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#incomeFromDisposalOfAssetsAmount">
    <rdfs:label>incomeFromDisposalOfAssetsAmount</rdfs:label>
    <rdfs:comment>Income from disposal of assets amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#IncomeFromDisposalOfAssets"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dataRetentionPeriodYears">
    <rdfs:label>dataRetentionPeriodYears</rdfs:label>
    <rdfs:comment>Retention duration in years for personal data, as stated in the policy.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RetentionPeriod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExternalWorker">
    <rdfs:label>ExternalWorker</rdfs:label>
    <rdfs:comment>A worker who is not directly employed by the recruiting entity (e.g., temporary worker) and for whom personal data may be processed.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dilutedEarningsPerShare">
    <rdfs:label>dilutedEarningsPerShare</rdfs:label>
    <rdfs:comment>Diluted earnings per share (in euros) for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ROE"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ForeignEquityInterest">
    <rdfs:label>ForeignEquityInterest</rdfs:label>
    <rdfs:comment>An equity interest in a foreign company not included in the detailed paragraph for major holdings.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityInterest"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#integratesRiskAssessmentInto">
    <rdfs:label>integratesRiskAssessmentInto</rdfs:label>
    <rdfs:comment>Indicates that the bank gradually integrates the assessment of risks into its risk management system.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicSectorInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RiskManagementSystem"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#providesExportInsuranceThrough">
    <rdfs:label>providesExportInsuranceThrough</rdfs:label>
    <rdfs:comment>Indicates that the group provides export insurance through its export insurance business line.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ExportInsuranceBusinessLine"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CreditActivity">
    <rdfs:label>CreditActivity</rdfs:label>
    <rdfs:comment>Credit-related activity including innovation loans, digital loans and export credit.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancingBusinessLine"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#updatesArticlesOfAssociation">
    <rdfs:label>updatesArticlesOfAssociation</rdfs:label>
    <rdfs:comment>Indicates the amendment updates the company’s articles of association (e.g., company object/preamble).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ArticlesOfAssociation"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#postBalanceSheetEventDate">
    <rdfs:label>postBalanceSheetEventDate</rdfs:label>
    <rdfs:comment>Date of a post balance sheet event referenced in the financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#SignificantEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#paysDividends">
    <rdfs:label>paysDividends</rdfs:label>
    <rdfs:comment>Indicates that dividends are paid according to the distribution policy.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Dividends"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DividendDistributionPolicy"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BiodiversityProtectionProject">
    <rdfs:label>BiodiversityProtectionProject</rdfs:label>
    <rdfs:comment>Projects and expenditures aimed at protecting and restoring biodiversity.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#incorporatesEquityMethodAccounting">
    <rdfs:label>incorporatesEquityMethodAccounting</rdfs:label>
    <rdfs:comment>Indicates that consolidated accounts incorporate equity-accounting method for investments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodAccounting"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasCorporateIncomeTax">
    <rdfs:label>hasCorporateIncomeTax</rdfs:label>
    <rdfs:comment>Indicates the presence of corporate income tax in the financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CorporateIncomeTax"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#UNSustainableDevelopmentGoals">
    <rdfs:label>UNSustainableDevelopmentGoals</rdfs:label>
    <rdfs:comment>A set of UN sustainable development goals referenced as part of commitments and reporting context.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsultancyAndOperationalManagement">
    <rdfs:label>ConsultancyAndOperationalManagement</rdfs:label>
    <rdfs:comment>A support division participating in design and implementation of consultancy and operational management projects.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SupportDivision"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#responseDeadline">
    <rdfs:label>responseDeadline</rdfs:label>
    <rdfs:comment>Maximum time to respond to a data subject request (e.g., within one month, subject to GDPR derogations).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RetentionPeriod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#recognisesDividendsInOtherFinancialIncomeAndExpenses">
    <rdfs:label>recognisesDividendsInOtherFinancialIncomeAndExpenses</rdfs:label>
    <rdfs:comment>Dividends are recorded in other financial income and expenses when related to equity instruments accounted for at fair value through profit or loss.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Dividends"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#loansFromStateAmount">
    <rdfs:label>loansFromStateAmount</rdfs:label>
    <rdfs:comment>Loans from the State amount reported for the period (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialLoansAndFinancialDebts"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#consolidationMethodAsOf">
    <rdfs:label>consolidationMethodAsOf</rdfs:label>
    <rdfs:comment>Date for which the consolidation scope and methods are presented (e.g., 31/12/2022).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidationScope"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#registeredOfficePostalCode">
    <rdfs:label>registeredOfficePostalCode</rdfs:label>
    <rdfs:comment>Postal code of the registered office.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#usesEquityMethodFor">
    <rdfs:label>usesEquityMethodFor</rdfs:label>
    <rdfs:comment>Indicates that jointly controlled investments and significant influence investments are accounted for using the equity method.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodAccounting"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialAssetsAtFairValueThroughProfitOrLoss">
    <rdfs:label>FinancialAssetsAtFairValueThroughProfitOrLoss</rdfs:label>
    <rdfs:comment>Financial assets measured at fair value with changes recognized in profit or loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IntangibleAsset">
    <rdfs:label>IntangibleAsset</rdfs:label>
    <rdfs:comment>Intangible assets presented as part of fixed assets in the consolidated balance sheet.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ScopeOfConsolidation">
    <rdfs:label>ScopeOfConsolidation</rdfs:label>
    <rdfs:comment>Section/note describing the scope of consolidation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#equityToPercentageInterest">
    <rdfs:label>equityToPercentageInterest</rdfs:label>
