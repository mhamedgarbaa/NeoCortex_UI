    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancingCommitments"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#accountsForSATTActivityAsEquityInterestsInTechnologyTransferAccelerationCompanies">
    <rdfs:label>accountsForSATTActivityAsEquityInterestsInTechnologyTransferAccelerationCompanies</rdfs:label>
    <rdfs:comment>SATT activity corresponds to equity interests in technology transfer acceleration companies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ThirdPartyActivity"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#TechnologyTransferAccelerationCompany"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#previousYearEndDate">
    <rdfs:label>previousYearEndDate</rdfs:label>
    <rdfs:comment>Reference year-end date used for comparative figures (e.g., 31 December 2021).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isDataControllerFor">
    <rdfs:label>isDataControllerFor</rdfs:label>
    <rdfs:comment>Indicates that a data controller is responsible for a specific personal data processing activity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataController"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#periodStartDate">
    <rdfs:label>periodStartDate</rdfs:label>
    <rdfs:comment>Start date of the period covered by the half-year consolidated financial statements (e.g., 1 January 2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#currentIncomeBeforeTaxes">
    <rdfs:label>currentIncomeBeforeTaxes</rdfs:label>
    <rdfs:comment>Income before taxes amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CurrentIncomeBeforeTaxes"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dataDisclosureRecipient">
    <rdfs:label>dataDisclosureRecipient</rdfs:label>
    <rdfs:comment>Recipient category to whom personal data may be disclosed (e.g., group entities, advisors, auditors, authorities, depositary, tax authorities).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataDisclosure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#participatesInInvestmentProgramme">
    <rdfs:label>participatesInInvestmentProgramme</rdfs:label>
    <rdfs:comment>Indicates participation in an investment programme (e.g., PIA4/France 2030).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InvestmentProgramme"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#incorporatesAccountsOfParentEntity">
    <rdfs:label>incorporatesAccountsOfParentEntity</rdfs:label>
    <rdfs:comment>Indicates that consolidated accounts include the accounts of the parent entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ParentEntityFinancialStatements"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityConsolidation">
    <rdfs:label>EquityConsolidation</rdfs:label>
    <rdfs:comment>A consolidation approach using the equity method for joint ventures and equity-accounted companies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityAccountingMethod"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidationMethod"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LongTermInvestmentsInPortfolioSecurities">
    <rdfs:label>LongTermInvestmentsInPortfolioSecurities</rdfs:label>
    <rdfs:comment>Long-term holdings of portfolio securities intended for portfolio activity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAssets"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#provenRisksAmount">
    <rdfs:label>provenRisksAmount</rdfs:label>
    <rdfs:comment>Amount of proven risks for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ProvenRisks"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasBalanceSheet">
    <rdfs:label>hasBalanceSheet</rdfs:label>
    <rdfs:comment>Consolidated financial statements include a balance sheet.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#BalanceSheet"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GreenBankStrategy">
    <rdfs:label>GreenBankStrategy</rdfs:label>
    <rdfs:comment>A strategic objective focused on integrating climate considerations into banking activities.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#earningsPerShare">
    <rdfs:label>earningsPerShare</rdfs:label>
    <rdfs:comment>Earnings per share (in euros) for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ROE"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#otherDebts">
    <rdfs:label>otherDebts</rdfs:label>
    <rdfs:comment>Other debts amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OtherDebts"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OtherDebt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#consolidatedReserves">
    <rdfs:label>consolidatedReserves</rdfs:label>
    <rdfs:comment>Consolidated reserves amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholderEquity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasCreditRiskCommittee">
    <rdfs:label>hasCreditRiskCommittee</rdfs:label>
