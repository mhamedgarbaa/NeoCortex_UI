    <rdfs:comment>A legislative or regulatory provision applicable to banking and financial activities, whose non-compliance can trigger sanctions.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasMarketPriceRisk">
    <rdfs:label>hasMarketPriceRisk</rdfs:label>
    <rdfs:comment>Indicates that market price risk is one of the financial risks managed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#MarketPriceRisk"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#unrealisedForeignExchangeLossesAmount">
    <rdfs:label>unrealisedForeignExchangeLossesAmount</rdfs:label>
    <rdfs:comment>Amount of unrealised foreign exchange losses reported.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UnrealisedForeignExchangeGain"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ESGDueDiligence">
    <rdfs:label>ESGDueDiligence</rdfs:label>
    <rdfs:comment>Due diligence specifically focused on identifying priority ESG issues and risks to justify investment decisions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DueDiligence"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGuaranteeBusinessLine">
    <rdfs:label>hasGuaranteeBusinessLine</rdfs:label>
    <rdfs:comment>Indicates that guarantee commitments relate to the guarantee business line context.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GuaranteeBusinessLine"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ComplianceDepartment">
    <rdfs:label>ComplianceDepartment</rdfs:label>
    <rdfs:comment>Organizational unit ensuring compliance with applicable rules, eligibility criteria, and governance requirements.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#includesEquityInvestmentInEquityConsolidatedCompanies">
    <rdfs:label>includesEquityInvestmentInEquityConsolidatedCompanies</rdfs:label>
    <rdfs:comment>Indicates that the consolidated statements include equity investments in equity-consolidated companies accounted for using the equity method.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestment"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#cashAndCashEquivalentsAmount">
    <rdfs:label>cashAndCashEquivalentsAmount</rdfs:label>
    <rdfs:comment>Cash and cash equivalents amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CashAndCashEquivalents"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CashAndCashEquivalent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#derecognisesFinancialAsset">
    <rdfs:label>derecognisesFinancialAsset</rdfs:label>
    <rdfs:comment>Indicates that the group derecognises financial assets when contractual rights expire or risks and rewards are transferred.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DerecognitionEvent"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#totalDividendAmount">
    <rdfs:label>totalDividendAmount</rdfs:label>
    <rdfs:comment>Total dividend amount distributed for the financial year.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Dividends"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#consolidationBalanceSheetDate">
    <rdfs:label>consolidationBalanceSheetDate</rdfs:label>
    <rdfs:comment>Balance sheet date used for classification and for the annual closing of companies in the consolidation scope.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#securitiesRemainingToBeReleasedAmount">
    <rdfs:label>securitiesRemainingToBeReleasedAmount</rdfs:label>
    <rdfs:comment>Securities remaining to be released amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#SecuritiesRemainingToBeReleased"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ESGCorrespondent">
    <rdfs:label>ESGCorrespondent</rdfs:label>
    <rdfs:comment>An ESG role embedded in business lines and investment hubs to support ESG integration.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ESGWorkforce"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TradeAndCompaniesRegister">
    <rdfs:label>TradeAndCompaniesRegister</rdfs:label>
    <rdfs:comment>A register referenced as a source of databases for indirect collection.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RegulatoryDatabase"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EUGreenBondStandard">
    <rdfs:label>EU_GreenBondStandard</rdfs:label>
    <rdfs:comment>EU Green Bond Standard referenced as a driver for updating the framework.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#carbonFootprintUnlistedCompanyCorrectionTeqCO2">
    <rdfs:label>carbonFootprintUnlistedCompanyCorrectionTeqCO2</rdfs:label>
    <rdfs:comment>Carbon footprint correction value for an omitted unlisted company (e.g., 0.213 teqCO2).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#article8FundsClassification">
    <rdfs:label>article8FundsClassification</rdfs:label>
    <rdfs:comment>SFDR classification referenced for qualifying financial products (Article 8 funds).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProbabilityOfDefault">
    <rdfs:label>ProbabilityOfDefault</rdfs:label>
    <rdfs:comment>A credit risk metric referenced for bucket allocation and significant increase in credit risk.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#equityAffiliatesContributionNegativeAmount">
    <rdfs:label>equityAffiliatesContributionNegativeAmount</rdfs:label>
    <rdfs:comment>Negative contribution from an equity affiliate due to additional provision (e.g., -€19 million for Eutelsat).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EccContributionToNetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasKYCProcess">
    <rdfs:label>hasKYCProcess</rdfs:label>
    <rdfs:comment>Indicates that the group performs KYC as part of AML/CFT processes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#KYCProcess"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasSharePriceRisk">
    <rdfs:label>hasSharePriceRisk</rdfs:label>
    <rdfs:comment>Indicates that share price risk is a key risk family.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SharePriceRisk"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasConsolidationScope">
    <rdfs:label>hasConsolidationScope</rdfs:label>
    <rdfs:comment>Indicates that the consolidated financial statements define a scope of consolidation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ConsolidationScope"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#commitmentsReceivedAmount">
    <rdfs:label>commitmentsReceivedAmount</rdfs:label>
    <rdfs:comment>Total amount of financing commitments received.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TaxAndSocialSecurityDebtsNote">
    <rdfs:label>TaxAndSocialSecurityDebtsNote</rdfs:label>
    <rdfs:comment>Note section detailing tax and social security debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicResourcesProgram">
    <rdfs:label>PublicResourcesProgram</rdfs:label>
    <rdfs:comment>Receivables related to public resources programs such as France 2030 and PIA4.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherReceivables"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#rightToObjectToProcessing">
    <rdfs:label>rightToObjectToProcessing</rdfs:label>
    <rdfs:comment>Whether the policy states a right to object to processing / commercial prospecting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataSubjectRights"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancingAndNetworkManagementDepartment">
    <rdfs:label>FinancingAndNetworkManagementDepartment</rdfs:label>
    <rdfs:comment>A department performing initial analysis of credit-risk involving commitments and monitoring client relations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherFinancialLiabilities">
    <rdfs:label>OtherFinancialLiabilities</rdfs:label>
    <rdfs:comment>Financial liabilities other than trade debts, including allocations payable and accrued expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLiability"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ZeroInterestInnovationLoan">
    <rdfs:label>ZeroInterestInnovationLoan</rdfs:label>
    <rdfs:comment>Innovation loans with zero interest used when traditional financing fails.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Loan"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasFairValueHierarchy">
    <rdfs:label>hasFairValueHierarchy</rdfs:label>
    <rdfs:comment>Indicates that the financial statements include fair value hierarchy information.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchy"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherReceivablesNote">
    <rdfs:label>OtherReceivablesNote</rdfs:label>
    <rdfs:comment>Note section detailing other receivables.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BpifranceNetwork">
    <rdfs:label>BpifranceNetwork</rdfs:label>
    <rdfs:comment>Bpifrance network referenced as having an organisational chart in the appendix.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#bankAccountInterestAmount">
    <rdfs:label>bankAccountInterestAmount</rdfs:label>
    <rdfs:comment>Bank account interest amount included in interest and similar expenses (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InterestExpense"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CorporateGovernanceRegime">
    <rdfs:label>CorporateGovernanceRegime</rdfs:label>
    <rdfs:comment>The applicable corporate governance framework referenced for compliance.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Covid19PandemicRisk">
    <rdfs:label>Covid19PandemicRisk</rdfs:label>
    <rdfs:comment>Risk arising from the spread of the Covid-19 pandemic, including impacts on economic conditions, financial markets, credit risk, refinancing conditions, and valuation of securities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperationalRisk"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasFinancingCommitment">
    <rdfs:label>hasFinancingCommitment</rdfs:label>
    <rdfs:comment>Indicates the institution discloses financing commitments as part of off-balance sheet commitments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#creditRiskExposureGuaranteeCommitmentsGiven">
    <rdfs:label>creditRiskExposureGuaranteeCommitmentsGiven</rdfs:label>
