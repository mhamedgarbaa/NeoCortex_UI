    <rdfs:comment>Indicates that the group provides training via an online training platform and related learning modules.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#TrainingPlatform"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOperatingExpenses">
    <rdfs:label>hasOperatingExpenses</rdfs:label>
    <rdfs:comment>Relates the financial statement section on operating expenses to operating expense items.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OperatingExpense"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PhysicalAssetAndInformationSystemRisk">
    <rdfs:label>PhysicalAssetAndInformationSystemRisk</rdfs:label>
    <rdfs:comment>Risk of breakdown, interruption, or failure of information systems and related operational disruptions, including impacts from unforeseen events or non-compliant behaviors.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperationalRisk"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasStatutoryAuditorsReport">
    <rdfs:label>hasStatutoryAuditorsReport</rdfs:label>
    <rdfs:comment>The financial statements are accompanied by a statutory auditors report.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditorReport"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditorsReport"/>
