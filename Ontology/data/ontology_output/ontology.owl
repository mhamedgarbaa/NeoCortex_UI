  <owl:Class rdf:about="https://talan.com/ontology/bpi#SupportActivity">
    <rdfs:label>SupportActivity</rdfs:label>
    <rdfs:comment>Operational support activity including accelerated companies and consultancy assignments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BusinessSupportBusinessLine"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PointOfContact">
    <rdfs:label>PointOfContact</rdfs:label>
