    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendDistributionIncomeAmount">
    <rdfs:label>dividendDistributionIncomeAmount</rdfs:label>
    <rdfs:comment>Dividend distribution income amount (in thousands of euros).</rdfs:comment>
