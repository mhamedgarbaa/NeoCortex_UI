  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividends">
    <rdfs:label>dividends</rdfs:label>
    <rdfs:comment>Dividends amount recognised/received as referenced in performance indicators.</rdfs:comment>
