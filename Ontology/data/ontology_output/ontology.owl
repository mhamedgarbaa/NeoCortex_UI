  <owl:Class rdf:about="https://talan.com/ontology/bpi#OrdinaryGeneralMeeting">
    <rdfs:label>OrdinaryGeneralMeeting</rdfs:label>
    <rdfs:comment>A shareholder meeting type governed by ordinary quorum and majority requirements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GeneralMeeting"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#interestReceivable">
    <rdfs:label>interestReceivable</rdfs:label>
    <rdfs:comment>Interest receivable amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InterestReceivable"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#transfersPersonalDataOutsideEuropeanUnion">
    <rdfs:label>transfersPersonalDataOutsideEuropeanUnion</rdfs:label>
    <rdfs:comment>Indicates that an international data transfer activity transfers personal data outside the European Union.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InternationalDataTransfer"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#asAtDate">
    <rdfs:label>asAtDate</rdfs:label>
    <rdfs:comment>Reference date for the consolidated financial statements (e.g., end-of-year date).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#WorkingCapitalRequirements">
    <rdfs:label>WorkingCapitalRequirements</rdfs:label>
    <rdfs:comment>The net working capital requirement changes used to compute cash flow from operating activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingActivities"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasDividendDistributionPolicy">
    <rdfs:label>hasDividendDistributionPolicy</rdfs:label>
    <rdfs:comment>Indicates dividend distribution is governed by a dividend policy context (dividend distribution policy referenced in the financial statement narrative).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DividendDistributionPolicy"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#goodwill">
    <rdfs:label>goodwill</rdfs:label>
    <rdfs:comment>Goodwill component for investments accounted for using the equity method.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestee"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendPerAction">
    <rdfs:label>dividendPerAction</rdfs:label>
    <rdfs:comment>The dividend amount per action (as stated for the total dividend).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationAndIndustryFundAllocation">
    <rdfs:label>InnovationAndIndustryFundAllocation</rdfs:label>
    <rdfs:comment>Allocation payable to the Innovation and Industry Fund referenced in other debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherDebts"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#mandatoryStandardsEntryIntoForceDate">
    <rdfs:label>mandatoryStandardsEntryIntoForceDate</rdfs:label>
    <rdfs:comment>Date from which mandatory standards, amendments and interpretations enter into force.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#acquisitionDate">
    <rdfs:label>acquisitionDate</rdfs:label>
    <rdfs:comment>Date of acquisition used to measure identifiable assets and liabilities at fair values for goodwill recognition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Goodwill"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExchangeRateRisk">
    <rdfs:label>ExchangeRateRisk</rdfs:label>
    <rdfs:comment>Risk of adverse effects from currency exchange rate changes on instruments and financing.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#equity">
    <rdfs:label>equity</rdfs:label>
    <rdfs:comment>Total equity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholderEquity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#classifiesFairValueMeasurementsIntoLevels">
    <rdfs:label>classifiesFairValueMeasurementsIntoLevels</rdfs:label>
    <rdfs:comment>Fair value hierarchy measurements are classified into specific hierarchy levels (e.g., Level 1/2/3).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchy"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchyLevel"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasStatutoryAuditor">
    <rdfs:label>hasStatutoryAuditor</rdfs:label>
    <rdfs:comment>Links the institution to its statutory auditors (reappointment by the Board of Directors).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#filedWithCompetentAuthority">
    <rdfs:label>filedWithCompetentAuthority</rdfs:label>
    <rdfs:comment>Indicates the amendment was filed with the competent authority (e.g., AMF) under applicable securities regulation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CompetentAuthority"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#exchangeRiskAmount">
    <rdfs:label>exchangeRiskAmount</rdfs:label>
    <rdfs:comment>Amount of exchange risk reported (e.g., €806m).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ExchangeRisk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasLiquidityManagementProcedure">
    <rdfs:label>hasLiquidityManagementProcedure</rdfs:label>
    <rdfs:comment>Indicates that the group has a liquidity management procedure as part of liquidity risk management.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#LiquidityManagementProcedure"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ESGControversy">
    <rdfs:label>ESGControversy</rdfs:label>
    <rdfs:comment>Major ESG controversy that can lead to withdrawal of a project from eligible green loans.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#authorisesSigningOfAmendmentToAgreement">
    <rdfs:label>authorisesSigningOfAmendmentToAgreement</rdfs:label>
    <rdfs:comment>Indicates that governance authorises signing of amendments to agreements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#AmendmentToAgreement"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RealEstateLeasing">
    <rdfs:label>RealEstateLeasing</rdfs:label>
    <rdfs:comment>Real estate leasing referenced as part of medium- and long-term financing.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Loan"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#unallocatedProceedsNotInvestedInExclusionListActivities">
    <rdfs:label>unallocatedProceedsNotInvestedInExclusionListActivities</rdfs:label>
    <rdfs:comment>Indicates that unallocated proceeds are not invested in activities listed in the exclusion list.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#totalCashAndCashEquivalents">
    <rdfs:label>totalCashAndCashEquivalents</rdfs:label>
    <rdfs:comment>Total cash and cash equivalents reported for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#LiquidityPosition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationCapitalBusinessLine">
    <rdfs:label>InnovationCapitalBusinessLine</rdfs:label>
    <rdfs:comment>An investment business line investing in start-ups and scale-ups in future-oriented sectors via sector/stage investment units.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentBusinessLine"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DebtInvestment">
    <rdfs:label>DebtInvestment</rdfs:label>
    <rdfs:comment>A debt investment instrument used to support companies’ development and growth.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentBusinessLine"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Investment"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#financingCommitmentsGivenAmount">
    <rdfs:label>financingCommitmentsGivenAmount</rdfs:label>
    <rdfs:comment>Financing commitments given amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitments"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#consolidatesInBalanceSheetUnderAccountingStandards">
    <rdfs:label>consolidatesInBalanceSheetUnderAccountingStandards</rdfs:label>
    <rdfs:comment>Indicates that eligible green loans are consolidated in the bank’s balance sheet under IFRS accounting standards.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#IFRSStandard"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#processesPersonalData">
    <rdfs:label>processesPersonalData</rdfs:label>
    <rdfs:comment>Links a personal data processing activity to the personal data categories processed during recruitment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataController"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#measuresFairValueUsingFairValueHierarchy">
    <rdfs:label>measuresFairValueUsingFairValueHierarchy</rdfs:label>
    <rdfs:comment>Fair value measurements are determined using the fair value hierarchy levels.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchy"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternationalFinancialReportingStandards">
    <rdfs:label>InternationalFinancialReportingStandards</rdfs:label>
    <rdfs:comment>International standards for financial reporting, including IFRS as adopted and applied for consolidation and measurement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AccountingStandard"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#corporateIncomeTaxes">
    <rdfs:label>corporateIncomeTaxes</rdfs:label>
    <rdfs:comment>Corporate income tax amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateIncomeTax"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RecruitmentOfferPublishingServiceProvider">
    <rdfs:label>RecruitmentOfferPublishingServiceProvider</rdfs:label>
    <rdfs:comment>A service provider that publishes recruitment offers and may process CVs and related personal data.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ServiceProvider"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ParentEntityStatutoryAuditorReport">
    <rdfs:label>ParentEntityStatutoryAuditorReport</rdfs:label>
    <rdfs:comment>Statutory auditor report on parent entity financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditorReport"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#periodStart">
    <rdfs:label>periodStart</rdfs:label>
    <rdfs:comment>Start date of the financial period covered by the statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialYear"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#uses">
    <rdfs:label>uses</rdfs:label>
    <rdfs:comment>Indicates that the consolidated financial statements are prepared in accordance with IFRS standards.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InternationalFinancialReportingStandard"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TradeDebtsAndRelatedAccounts">
    <rdfs:label>TradeDebtsAndRelatedAccounts</rdfs:label>
    <rdfs:comment>Note category for trade debts and related accounts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#fundOfFundsContributionAmount">
    <rdfs:label>fundOfFundsContributionAmount</rdfs:label>
    <rdfs:comment>Contribution from the fund of funds business for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FundOfFundsBusiness"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#usesEquityMethodForJointControl">
    <rdfs:label>usesEquityMethodForJointControl</rdfs:label>
    <rdfs:comment>Joint control over a partnership/joint venture leads to equity method consolidation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#JointControl"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BMTNProgramme">
    <rdfs:label>BMTNProgramme</rdfs:label>
    <rdfs:comment>Medium-term refinancing programme referenced alongside EMTN in outstanding amounts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Decree">
    <rdfs:label>Decree</rdfs:label>
    <rdfs:comment>A regulatory instrument referenced for application of non-financial transparency requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ElectricitySupplyContract">
    <rdfs:label>ElectricitySupplyContract</rdfs:label>
    <rdfs:comment>A long-term contract for electricity supplies using renewable energies.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#updates">
    <rdfs:label>updates</rdfs:label>
    <rdfs:comment>Indicates that the expected credit loss model uses updated forward-looking scenarios.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ECLModel"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ForwardLookingScenarios"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasInvestingActivities">
    <rdfs:label>hasInvestingActivities</rdfs:label>
    <rdfs:comment>Indicates that cash flows are broken down by investing activities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InvestingActivities"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EuropeanUnion">
    <rdfs:label>EuropeanUnion</rdfs:label>
    <rdfs:comment>A supranational public actor providing policy support and participating in financing allocations and regulatory frameworks.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EducationTrainingQualificationsData">
    <rdfs:label>EducationTrainingQualificationsData</rdfs:label>
    <rdfs:comment>Personal data about education, training, qualifications, and related details.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DigitalInnovationInvest">
    <rdfs:label>DigitalInnovationInvest</rdfs:label>
    <rdfs:comment>A business line referenced as part of the group’s activities under the “Other” item.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InternationalBusiness"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasFraudProtectionPurpose">
    <rdfs:label>hasFraudProtectionPurpose</rdfs:label>
    <rdfs:comment>Indicates that fraud protection is a purpose of the group’s controls and tools.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FraudProtectionPurpose"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#shortTermFinancingAmount">
    <rdfs:label>shortTermFinancingAmount</rdfs:label>
    <rdfs:comment>Gross outstandings for short-term financing at the reporting date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Loans"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasInvestmentProgramme">
    <rdfs:label>hasInvestmentProgramme</rdfs:label>
    <rdfs:comment>Indicates that the bank operates investment programmes as part of its activities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicSectorInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InvestmentProgramme"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#equityValue">
    <rdfs:label>equityValue</rdfs:label>
    <rdfs:comment>Equity value of an investment accounted for using the equity method.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestments"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestee"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#operatingIncomeBeforeOtherIncomeAndExpensesAmount">
    <rdfs:label>operatingIncomeBeforeOtherIncomeAndExpensesAmount</rdfs:label>
    <rdfs:comment>Operating income before other income and expenses.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendDistributionAmount">
    <rdfs:label>dividendDistributionAmount</rdfs:label>
    <rdfs:comment>Amount of dividend distribution to the State as described for the financial year (e.g., €217M).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistributionPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MiscellaneousFinancialDebts">
    <rdfs:label>MiscellaneousFinancialDebts</rdfs:label>
    <rdfs:comment>Financial debts other than those specifically classified as loans to credit institutions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialDebts"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#amendingFinanceActFor2003Date">
    <rdfs:label>amendingFinanceActFor2003Date</rdfs:label>
    <rdfs:comment>Date of the Amending Finance Act for 2003 referenced as an amendment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistributionPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Security">
    <rdfs:label>Security</rdfs:label>
    <rdfs:comment>A securities instrument referenced in the context of market transactions and counterparty risk.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EligibleGreentechLoan">
    <rdfs:label>EligibleGreentechLoan</rdfs:label>
    <rdfs:comment>Eligible green loan supporting Greentech entities and solutions that enhance environmental impact aligned with EU environmental objectives.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EligibleGreenLoan"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#euGreenBondStandardReference">
    <rdfs:label>euGreenBondStandardReference</rdfs:label>
    <rdfs:comment>Reference to the EU Green Bond Standard regulation used to update/align the framework.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasProvisions">
    <rdfs:label>hasProvisions</rdfs:label>
    <rdfs:comment>Indicates that the notes describe provisions recognition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Provisions"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#carbonFootprintAttributableToBpifranceTeqCO2PerThousandEurInvested2021">
    <rdfs:label>carbonFootprintAttributableToBpifranceTeqCO2PerThousandEurInvested2021</rdfs:label>
    <rdfs:comment>Carbon footprint attributable to Bpifrance for total listed portfolio in 2021 (teqCO2 per thousand euros invested).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendPaymentDate">
