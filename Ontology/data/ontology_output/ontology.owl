    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingExpense"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#TaxAndDuties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isRequestedByDataSubject">
    <rdfs:label>isRequestedByDataSubject</rdfs:label>
    <rdfs:comment>Indicates that a personal data request is made by a data subject.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataRequest"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DataSubject"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#amendsUniversalRegistrationDocument">
    <rdfs:label>amendsUniversalRegistrationDocument</rdfs:label>
