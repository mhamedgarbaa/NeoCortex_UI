    <rdfs:label>isGovernedByGDPR</rdfs:label>
    <rdfs:comment>Indicates that the processing is governed by the GDPR.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GDPR"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#fairValueLevel1Amount">
    <rdfs:label>fairValueLevel1Amount</rdfs:label>
    <rdfs:comment>Fair value amount classified in Level 1 of the fair value hierarchy.</rdfs:comment>
