    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#offBalanceSheetCommitmentsReceivedFinancingCommitmentsAmount">
    <rdfs:label>offBalanceSheetCommitmentsReceivedFinancingCommitmentsAmount</rdfs:label>
