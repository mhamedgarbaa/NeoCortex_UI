    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestment"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodAccounting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FrenchCompany">
    <rdfs:label>FrenchCompany</rdfs:label>
    <rdfs:comment>A company located in France referenced as the group’s client base for scenarios and exposures.</rdfs:comment>
