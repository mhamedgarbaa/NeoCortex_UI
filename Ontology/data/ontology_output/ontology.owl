  <owl:Class rdf:about="https://talan.com/ontology/bpi#Policyholder">
    <rdfs:label>Policyholder</rdfs:label>
    <rdfs:comment>A person holding an insurance policy referenced in the context of managing contractual/commercial relationships.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#telNumber">
    <rdfs:label>telNumber</rdfs:label>
    <rdfs:comment>Telephone number of the company.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#reportingDate">
    <rdfs:label>reportingDate</rdfs:label>
    <rdfs:comment>Date to which the half-year consolidated financial statements are prepared (e.g., 30 June 2022).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialYear"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FairValueMeasurement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#recognisesImpairmentForEquityMethodInvestments">
    <rdfs:label>recognisesImpairmentForEquityMethodInvestments</rdfs:label>
    <rdfs:comment>Equity method investments are tested for impairment and impairment losses are recognized when objective evidence exists.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestments"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ImpairmentTest"/>
