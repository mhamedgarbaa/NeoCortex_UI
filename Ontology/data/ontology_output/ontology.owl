    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#IdentificationData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#offBalanceSheetCommitmentsGiven">
