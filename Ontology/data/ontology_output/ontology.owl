    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#loanRepaymentDate">
