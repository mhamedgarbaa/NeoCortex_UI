    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ProvenRisks"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasAuditedData">
    <rdfs:label>hasAuditedData</rdfs:label>
    <rdfs:comment>Consolidated financial statements are supported by audited data.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#AuditedData"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#responsiblePersonTitle">
    <rdfs:label>responsiblePersonTitle</rdfs:label>
    <rdfs:comment>Title/role of the person responsible for the half-year consolidated financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GeneralManagement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#shareOfNetProfitOfEquityMethodCompanies">
    <rdfs:label>shareOfNetProfitOfEquityMethodCompanies</rdfs:label>
    <rdfs:comment>Share of net profit from companies accounted for using the equity method.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EccContributionToNetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#boardMeetingCount">
    <rdfs:label>boardMeetingCount</rdfs:label>
    <rdfs:comment>Number of board meetings held during the year.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SharesToBeReleased">
    <rdfs:label>SharesToBeReleased</rdfs:label>
