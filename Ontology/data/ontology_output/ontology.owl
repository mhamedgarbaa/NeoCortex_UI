  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#appliesAccountingStandard">
    <rdfs:label>appliesAccountingStandard</rdfs:label>
    <rdfs:comment>Indicates that the consolidated financial statements are prepared using IFRS standards.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#IFRSStandard"/>
