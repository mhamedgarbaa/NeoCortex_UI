    <rdfs:label>stateCurrentAccountInnovationCapitalAmount</rdfs:label>
    <rdfs:comment>State current account (Agence France Trésor Innovation) balance included in cash and cash equivalents (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CashAndCashEquivalents"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StateCurrentAccountInnovationCapital"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicInterestCompany">
    <rdfs:label>PublicInterestCompany</rdfs:label>
