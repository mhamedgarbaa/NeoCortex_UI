    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityInvestments"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BpifranceAccruedExpenses">
