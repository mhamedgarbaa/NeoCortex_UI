  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperationalCommittee">
    <rdfs:label>OperationalCommittee</rdfs:label>
    <rdfs:comment>An operational committee (COMOP) including investment managers and support activities directed by the investment branch.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CommitmentsReceived">
