  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ControversialWeapons">
    <rdfs:label>ControversialWeapons</rdfs:label>
    <rdfs:comment>A category referenced in legal compliance exclusions for controversial weapons.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StrategicInvestmentFund">
    <rdfs:label>StrategicInvestmentFund</rdfs:label>
    <rdfs:comment>The Strategic Investment Fund referenced as part of the Banque Publique d’Investissement activities.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOperatingIncome">
    <rdfs:label>hasOperatingIncome</rdfs:label>
    <rdfs:comment>States the operating income figure reported in the financial results.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OperatingIncome"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGeneralManagement">
    <rdfs:label>hasGeneralManagement</rdfs:label>
    <rdfs:comment>Indicates that the institution has general management (e.g., director general).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GeneralManagement"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isLimitedReviewedBy">
    <rdfs:label>isLimitedReviewedBy</rdfs:label>
    <rdfs:comment>Indicates that the consolidated financial statements are subject to a limited review by statutory auditors.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasConsolidatedHalfYearFinancialStatements">
