  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasROE">
    <rdfs:label>hasROE</rdfs:label>
    <rdfs:comment>States the return on equity (ROE) reported in the financial results.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ROE"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AuditEvidence">
    <rdfs:label>AuditEvidence</rdfs:label>
    <rdfs:comment>Evidence obtained by auditors as a basis for their opinion.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditors"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#committeeMeetsAtLeastOncePerYear">
    <rdfs:label>committeeMeetsAtLeastOncePerYear</rdfs:label>
    <rdfs:comment>Indicates that the Green Financing Committee meets at least once a year.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#includesInConsolidation">
    <rdfs:label>includesInConsolidation</rdfs:label>
    <rdfs:comment>The consolidated group includes legal entities accounted for using the equity method within the consolidation scope.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestee"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RepoTransaction">
    <rdfs:label>RepoTransaction</rdfs:label>
    <rdfs:comment>A repurchase agreement transaction referenced as part of financial transactions subject to counterparty risk.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BusinessLoan">
    <rdfs:label>BusinessLoan</rdfs:label>
    <rdfs:comment>Business loans (co-financing) described as financing solutions for investments and operations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Loan"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#complaintAuthorityName">
    <rdfs:label>complaintAuthorityName</rdfs:label>
    <rdfs:comment>Name of the complaint authority mentioned in the policy (e.g., CNIL).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ComplaintAuthority"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SignificantIncreaseInCreditRisk">
    <rdfs:label>SignificantIncreaseInCreditRisk</rdfs:label>
