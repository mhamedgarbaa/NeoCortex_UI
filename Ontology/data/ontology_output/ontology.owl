    <rdfs:comment>Off-balance sheet commitments given amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitmentsGiven"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
