    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netBankingIncomeAmount">
    <rdfs:label>netBankingIncomeAmount</rdfs:label>
