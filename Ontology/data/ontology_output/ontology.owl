    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#accountsForInvestmentsUsingEquityMethod">
    <rdfs:label>accountsForInvestmentsUsingEquityMethod</rdfs:label>
