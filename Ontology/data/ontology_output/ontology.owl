    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FundOfFundsBusiness"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#managesInvestmentProgramme">
    <rdfs:label>managesInvestmentProgramme</rdfs:label>
