    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SolvencyAndLiquidityStatus"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#financialResultAmount">
    <rdfs:label>financialResultAmount</rdfs:label>
    <rdfs:comment>Net financial result amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#operatingExpenditureAmount">
    <rdfs:label>operatingExpenditureAmount</rdfs:label>
    <rdfs:comment>Operating expenditure amount for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingExpenditure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicGuaranteeFund">
    <rdfs:label>PublicGuaranteeFund</rdfs:label>
    <rdfs:comment>A guarantee fund category presented as public guarantee funds in the balance sheet.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GuaranteeFund"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#retainedEarningsAmount">
    <rdfs:label>retainedEarningsAmount</rdfs:label>
    <rdfs:comment>Retained earnings included in shareholders' equity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholderEquity"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholdersEquity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityIntervention">
    <rdfs:label>EquityIntervention</rdfs:label>
    <rdfs:comment>Equity-based interventions used to finance development and growth.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Investment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#JointInsuranceAgreementParticipant">
    <rdfs:label>JointInsuranceAgreementParticipant</rdfs:label>
    <rdfs:comment>An entity intervening within joint insurance agreements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ReinsuranceAgreementParticipant"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#statutoryAuditorReappointmentEndDate">
    <rdfs:label>statutoryAuditorReappointmentEndDate</rdfs:label>
    <rdfs:comment>End date of the statutory auditor appointment term (e.g., financial year ending 31 December 2028).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#supplementedBy">
    <rdfs:label>supplementedBy</rdfs:label>
    <rdfs:comment>Indicates that the universal registration document (as amended) is supplemented by a securities note for public offering or admission to trading.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SecuritiesNote"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#actsAsDataControllerFor">
    <rdfs:label>actsAsDataControllerFor</rdfs:label>
    <rdfs:comment>Indicates the Bpifrance group entity that is deemed to act as the data controller for personal data processing in the recruitment context.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroupEntity"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Bpifrance"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#percentageOfVotingRights">
    <rdfs:label>percentageOfVotingRights</rdfs:label>
    <rdfs:comment>Percentage of voting rights held in an equity-accounted investee.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodAccounting"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#loans">
    <rdfs:label>loans</rdfs:label>
    <rdfs:comment>Loans amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Loans"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LoanContract">
    <rdfs:label>LoanContract</rdfs:label>
    <rdfs:comment>A contract type under which a loan is granted as part of financing/support schemes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancingMechanism"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#appliesDataProtectionPolicy">
    <rdfs:label>appliesDataProtectionPolicy</rdfs:label>
    <rdfs:comment>Indicates that a policy document applies a personal data protection policy.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PolicyDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PersonalDataProtectionPolicy"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#cashContributionAmount">
    <rdfs:label>cashContributionAmount</rdfs:label>
    <rdfs:comment>Amount of cash contribution taken back by the State as part of a fund.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicResources"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#managesProgramme">
    <rdfs:label>managesProgramme</rdfs:label>
    <rdfs:comment>Indicates that the institution manages an investment programme (e.g., programmes financed by the Innovation and Industry Fund / France 2030).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InvestmentProgramme"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#policyVersion">
    <rdfs:label>policyVersion</rdfs:label>
    <rdfs:comment>Version identifier or update reference for the GDPR policy (if specified).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GDPR"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PrivacyPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExecutiveSupportDepartment">
    <rdfs:label>ExecutiveSupportDepartment</rdfs:label>
    <rdfs:comment>Executive department managing the support business line and structured into multiple divisions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BusinessSupportBusinessLine"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#interestIncome">
    <rdfs:label>interestIncome</rdfs:label>
    <rdfs:comment>Interest income amount for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InterestIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NonPerformingExposure">
    <rdfs:label>NonPerformingExposure</rdfs:label>
    <rdfs:comment>An exposure classified in the highest risk bucket (bucket 3) as non-performing.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CreditRiskBucket"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#User">
    <rdfs:label>User</rdfs:label>
    <rdfs:comment>A natural person who accesses a platform and whose identity and access are managed.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataSubject"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#consolidatesEntityUsingEquityMethod">
    <rdfs:label>consolidatesEntityUsingEquityMethod</rdfs:label>
    <rdfs:comment>Indicates that the institution consolidates a jointly controlled entity using the equity method.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodCompany"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#impactReportUntilMaturity">
    <rdfs:label>impactReportUntilMaturity</rdfs:label>
    <rdfs:comment>Indicates that the allocation and impact reporting continues until maturity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RightOfDeletion">
    <rdfs:label>RightOfDeletion</rdfs:label>
    <rdfs:comment>Right to request deletion of personal data.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IndividualRights"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ThermalCoalSector">
    <rdfs:label>ThermalCoalSector</rdfs:label>
    <rdfs:comment>A sector category referenced in exclusion criteria based on mining and electricity production thresholds.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#tradeDebtsMaturityLessThanOneYear">
    <rdfs:label>tradeDebtsMaturityLessThanOneYear</rdfs:label>
    <rdfs:comment>Indicates that trade debts have a maturity of less than one year (as stated in the note).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#TradeDebts"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasExtraordinaryIncome">
    <rdfs:label>hasExtraordinaryIncome</rdfs:label>
    <rdfs:comment>Relates the financial statement section on extraordinary income to extraordinary income items.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ExtraordinaryIncome"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeOfSecurities">
    <rdfs:label>GuaranteeOfSecurities</rdfs:label>
    <rdfs:comment>Guarantee of securities issued by Bpifrance referenced as part of EPIC Bpifrance’s missions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitment"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#votingRightsPercentage">
    <rdfs:label>votingRightsPercentage</rdfs:label>
    <rdfs:comment>Percentage of voting rights held in an equity-consolidated company.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InterestAndSimilarIncomeNote">
    <rdfs:label>InterestAndSimilarIncomeNote</rdfs:label>
    <rdfs:comment>Note section dealing with interest and similar income.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
