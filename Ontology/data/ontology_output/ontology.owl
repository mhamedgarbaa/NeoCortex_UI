  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BoardOfDirectorsReport">
    <rdfs:label>BoardOfDirectorsReport</rdfs:label>
    <rdfs:comment>A management report to the general meeting prepared/updated by the board, including corporate governance information.</rdfs:comment>
