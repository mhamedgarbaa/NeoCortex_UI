    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BondIssueProgramme"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#riskCost">
    <rdfs:label>riskCost</rdfs:label>
    <rdfs:comment>Cost of risk for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CostOfRisk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#interimDividendPerShare">
    <rdfs:label>interimDividendPerShare</rdfs:label>
    <rdfs:comment>Interim dividend amount distributed per share (e.g., €0.63 per share).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Dividends"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
