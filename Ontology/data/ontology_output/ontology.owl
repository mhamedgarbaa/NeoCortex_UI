    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitments"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasStructuredEntityInterests">
