    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Securities"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOrganizationalChartOfNetwork">
