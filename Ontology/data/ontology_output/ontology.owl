      <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#prepares">
        <rdfs:label>prepares</rdfs:label>
        <rdfs:comment>Indicates that the company prepares the consolidated financial statements.</rdfs:comment>
        <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
        <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
        <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
        <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
        <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
        <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InterimFinancialStatement"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicLimitedCompanyInvestmentEntity">
    <rdfs:label>PublicLimitedCompanyInvestmentEntity</rdfs:label>
