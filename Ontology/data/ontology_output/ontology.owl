    <rdfs:comment>Accelerator program offered to start-ups, SMEs, and mid-caps.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Subscriber">
    <rdfs:label>Subscriber</rdfs:label>
    <rdfs:comment>A person subscribing to an investment fund managed by the organization.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Person"/>
