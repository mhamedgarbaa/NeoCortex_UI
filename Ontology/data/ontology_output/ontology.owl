    <rdfs:comment>Indicates that one public limited company holds a stake in another company (e.g., EPIC Bpifrance holding shares in Bpifrance).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#midAndLargeAssetsUnderManagement">
