    <rdfs:comment>Net income attributable to the group share.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#managesInnovationAndIndustryFund">
    <rdfs:label>managesInnovationAndIndustryFund</rdfs:label>
    <rdfs:comment>Indicates that the institution manages the Innovation and Industry Fund.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InnovationAndIndustryFund"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DirectorateOfNetwork">
    <rdfs:label>DirectorateOfNetwork</rdfs:label>
    <rdfs:comment>A directorate responsible for the network organization.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChartOfNetwork"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LargeVentureUnit">
    <rdfs:label>LargeVentureUnit</rdfs:label>
    <rdfs:comment>An investment unit investing via participation and dedicated venture funds in innovation areas.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentUnit"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#HoldingCompany">
    <rdfs:label>HoldingCompany</rdfs:label>
    <rdfs:comment>A company that holds interests and acts through subsidiaries to conduct financing and investment activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ITServiceProvider">
    <rdfs:label>ITServiceProvider</rdfs:label>
    <rdfs:comment>A service provider providing IT solutions, including those integrating databases used for indirect collection.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ServiceProvider"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#cashFlowMethod">
    <rdfs:label>cashFlowMethod</rdfs:label>
    <rdfs:comment>The cash flow presentation method (e.g., indirect method).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StatementOfCashFlows"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netBankingIncomeChangePercent">
    <rdfs:label>netBankingIncomeChangePercent</rdfs:label>
    <rdfs:comment>Percentage change in net banking income versus the prior-year comparable period (e.g., -21.2%).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetBankingIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Article8Fund">
    <rdfs:label>Article8Fund</rdfs:label>
    <rdfs:comment>A classification of financial products/funds under EU sustainable finance disclosure rules.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isGuarantorFor">
    <rdfs:label>isGuarantorFor</rdfs:label>
    <rdfs:comment>Indicates that the institution provides guarantees for bond issues under a bond issue programme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#BondIssueProgramme"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#organizesEvents">
    <rdfs:label>organizesEvents</rdfs:label>
    <rdfs:comment>Indicates that the group organizes events and interviews to raise awareness and support responsible investment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EventOrganization"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#holdsEquityInterestIn">
    <rdfs:label>holdsEquityInterestIn</rdfs:label>
    <rdfs:comment>Indicates the institution holds equity interests in subsidiaries/holdings (including equity interests accounted for via equity method).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestee"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MaritimePort">
    <rdfs:label>MaritimePort</rdfs:label>
    <rdfs:comment>A maritime port referenced as the context for a director representing the State.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#europeanInvestmentBankLoanInterestAmount">
    <rdfs:label>europeanInvestmentBankLoanInterestAmount</rdfs:label>
    <rdfs:comment>European Investment Bank loan interest amount included in interest and similar expenses (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InterestExpense"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGeneralMeetingResolution">
    <rdfs:label>hasGeneralMeetingResolution</rdfs:label>
    <rdfs:comment>Indicates the general meeting considers and approves specific resolutions.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GeneralMeeting"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Resolution"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasFinancingAgreement">
    <rdfs:label>hasFinancingAgreement</rdfs:label>
    <rdfs:comment>Indicates that financing commitments are associated with financing agreements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancingAgreement"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#competentAuthorityName">
    <rdfs:label>competentAuthorityName</rdfs:label>
    <rdfs:comment>Name of the competent authority with which the amendment was filed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ForwardForeignExchangeTransaction">
    <rdfs:label>ForwardForeignExchangeTransaction</rdfs:label>
    <rdfs:comment>A forward FX transaction referenced as having outstanding receivables.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#TransactionDerivative"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EuropeanInvestmentBank">
    <rdfs:label>EuropeanInvestmentBank</rdfs:label>
    <rdfs:comment>The European Investment Bank referenced as a cooperation partner.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#universalRegistrationDocumentDate">
    <rdfs:label>universalRegistrationDocumentDate</rdfs:label>
    <rdfs:comment>Date of the underlying universal registration document to which the amendment relates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InformationSystem">
    <rdfs:label>InformationSystem</rdfs:label>
    <rdfs:comment>An entity of stored data and reporting systems whose failure or inadequate defense can cause operational impacts.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#currentTaxLegislationEffectiveDate">
    <rdfs:label>currentTaxLegislationEffectiveDate</rdfs:label>
    <rdfs:comment>Effective date of the tax rules and rates used for current tax computation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CurrentTax"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CybersecurityRisk">
    <rdfs:label>CybersecurityRisk</rdfs:label>
    <rdfs:comment>Risk caused by cyber sabotage or cyberattacks affecting the integrity of information systems.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperationalAndNonComplianceRisk"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#taxableProfitAmount">
    <rdfs:label>taxableProfitAmount</rdfs:label>
    <rdfs:comment>Taxable profit amount used to determine current corporation tax.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CurrentTax"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateIncomeTax"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NationalSeedFund">
    <rdfs:label>NationalSeedFund</rdfs:label>
    <rdfs:comment>National Seed Fund referenced in equity investments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SeedFund"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CounterpartyRiskOnFinancialAssets">
    <rdfs:label>CounterpartyRiskOnFinancialAssets</rdfs:label>
    <rdfs:comment>Risk relating to interbank and securities transactions on financial markets (excluding derivatives).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NonPerformanceRisk"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendsPaidYearCurrency">
    <rdfs:label>dividendsPaidYearCurrency</rdfs:label>
    <rdfs:comment>Currency used for the reported dividends paid amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalCharacteristicsData">
    <rdfs:label>PersonalCharacteristicsData</rdfs:label>
    <rdfs:comment>Personal data describing characteristics such as age, date/place of birth, and gender.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#managesInvestmentFundsOfFunds">
    <rdfs:label>managesInvestmentFundsOfFunds</rdfs:label>
    <rdfs:comment>Indicates that the group manages funds-of-funds activity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FundOfFundsBusiness"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#WorkingCapital">
    <rdfs:label>WorkingCapital</rdfs:label>
    <rdfs:comment>Working capital requirements whose changes are used in operating cash flow calculations.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#addressesClimateRisks">
    <rdfs:label>addressesClimateRisks</rdfs:label>
    <rdfs:comment>Indicates that the group addresses climate risks through its climate risk management framework.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ClimateRisk"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#methodologyUpdateStatedInImpactReport">
    <rdfs:label>methodologyUpdateStatedInImpactReport</rdfs:label>
    <rdfs:comment>Indicates that any changes to the impact reporting methodology are clearly stated in the Impact Report.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#financialDebtsAmount">
    <rdfs:label>financialDebtsAmount</rdfs:label>
    <rdfs:comment>Total financial debts amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialDebts"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AnnualFinancialStatements">
    <rdfs:label>AnnualFinancialStatements</rdfs:label>
    <rdfs:comment>Financial statements prepared for the parent entity on an annual basis.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasBoardOfDirectorsManagementReport">
    <rdfs:label>hasBoardOfDirectorsManagementReport</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes a board of directors management report to the general meeting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectorsManagementReport"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AccountingStandardsAuthority">
    <rdfs:label>AccountingStandardsAuthority</rdfs:label>
    <rdfs:comment>An authority referenced as having a board where a representative of the State is delegated.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GreenIndustryProject">
    <rdfs:label>GreenIndustryProject</rdfs:label>
    <rdfs:comment>Industrial projects aimed at ecological and energy transition, including circular economy and cleaner solutions.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#fundOfFunds">
    <rdfs:label>fundOfFunds</rdfs:label>
    <rdfs:comment>Fund of funds component of assets under management reported for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FundOfFundsBusiness"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#legalBasis">
    <rdfs:label>legalBasis</rdfs:label>
    <rdfs:comment>Legal basis invoked for processing personal data (e.g., contract performance, legal obligation, legitimate interest).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#LegalBasisForProcessing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#totalShareholdersEquityAmount">
    <rdfs:label>totalShareholdersEquityAmount</rdfs:label>
    <rdfs:comment>Total shareholders' equity amount reported for the period (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholdersEquity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ElectronicSignatureEvidenceBody">
    <rdfs:label>ElectronicSignatureEvidenceBody</rdfs:label>
    <rdfs:comment>The body of evidence contributing to the reliability of the electronic signature process.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ElectronicSignatureProcess"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasLiquidityReserve">
    <rdfs:label>hasLiquidityReserve</rdfs:label>
    <rdfs:comment>Indicates the liquidity reserve used to assess liquidity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#LiquidityPosition"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicSectorInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#LiquidityReserve"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#stateAccruedExpensesAmount">
    <rdfs:label>stateAccruedExpensesAmount</rdfs:label>
    <rdfs:comment>State accrued expenses amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AccruedExpense"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MutualInsuranceOrganization">
    <rdfs:label>MutualInsuranceOrganization</rdfs:label>
    <rdfs:comment>A mutual insurance organization that may receive information to finalize recruitment.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#deferredTaxLiabilities">
    <rdfs:label>deferredTaxLiabilities</rdfs:label>
    <rdfs:comment>Deferred tax liabilities recognized in the consolidated balance sheet.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DeferredTax"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#equityAffiliatesContributionPositiveAmount">
    <rdfs:label>equityAffiliatesContributionPositiveAmount</rdfs:label>
    <rdfs:comment>Positive contribution to net profit from an equity affiliate (e.g., €16 million for Soitec).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EccContributionToNetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#statutoryAuditorsFeesExcludingTax">
    <rdfs:label>statutoryAuditorsFeesExcludingTax</rdfs:label>
    <rdfs:comment>Statutory auditors' fees included in the income statement for the financial year, excluding tax.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasSATTActivity">
    <rdfs:label>hasSATTActivity</rdfs:label>
    <rdfs:comment>Indicates that SATT activity is disclosed as a type of technology transfer activity on behalf of the French State.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ThirdPartyActivity"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#TechnologyTransferProgramme"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#operatingExpensesNoteAmount">
    <rdfs:label>operatingExpensesNoteAmount</rdfs:label>
    <rdfs:comment>Operating expenses amount disclosed in the corresponding note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingExpensesNote"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ClimateRiskManagementTool">
    <rdfs:label>ClimateRiskManagementTool</rdfs:label>
    <rdfs:comment>Internal tool used during credit granting to assess physical climate risks under multiple hazards, scenarios, and time horizons.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationFunding">
    <rdfs:label>InnovationFunding</rdfs:label>
    <rdfs:comment>Financing activity focused on innovation funding.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancingActivity"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#professionalLifeDataPosition">
    <rdfs:label>professionalLifeDataPosition</rdfs:label>
    <rdfs:comment>Position/role within the company component of professional life data.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ProfessionalLifeData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#gdprReference">
    <rdfs:label>gdprReference</rdfs:label>
    <rdfs:comment>Reference to the GDPR instrument as cited in the policy.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GDPR"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#trustedServiceProviderNetheosName">
    <rdfs:label>trustedServiceProviderNetheosName</rdfs:label>
    <rdfs:comment>Name of the trusted service provider used for advanced electronic signature (Netheos).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#TrustedServiceProviderNetheos"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ESGIntegration">
    <rdfs:label>ESGIntegration</rdfs:label>
    <rdfs:comment>The incorporation of ESG criteria into investment processes, including due diligence and monitoring.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentProcess"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasExpenseRatio">
    <rdfs:label>hasExpenseRatio</rdfs:label>
    <rdfs:comment>Indicates the expense ratio used to assess the investment business.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ExpenseRatio"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValueThroughShareholdersEquity">
    <rdfs:label>FairValueThroughShareholdersEquity</rdfs:label>
    <rdfs:comment>A measurement category for financial assets whose fair value changes are recognized through shareholders’ equity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#carbonFootprintAssessedShare">
    <rdfs:label>carbonFootprintAssessedShare</rdfs:label>
    <rdfs:comment>Share of respondent businesses that assessed partial or total carbon footprint (e.g., 33%).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NationalResearchAgency">
    <rdfs:label>NationalResearchAgency</rdfs:label>
    <rdfs:comment>The national research agency referenced as a partner in implementing initiatives.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternationalSupportUnit">
    <rdfs:label>InternationalSupportUnit</rdfs:label>
    <rdfs:comment>A unit providing services and missions to accelerate and support companies’ international development.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InternationalBusinessLine"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#allocatesToEligibleGreenLoans">
