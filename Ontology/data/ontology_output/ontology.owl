  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#exposesToRisk">
    <rdfs:label>exposesToRisk</rdfs:label>
    <rdfs:comment>Indicates that the public sector investment bank is exposed to a financial risk due to borrower-related constraints.</rdfs:comment>
