    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CreditRiskIncreaseAssessment"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#complaintBodyName">
    <rdfs:label>complaintBodyName</rdfs:label>
    <rdfs:comment>Name of the authority where a complaint can be lodged (CNIL).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ComplaintAuthority"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialLoansAndFinancialDebtsNote">
    <rdfs:label>FinancialLoansAndFinancialDebtsNote</rdfs:label>
    <rdfs:comment>Note category detailing financial loans and financial debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#providesGuaranteesThrough">
    <rdfs:label>providesGuaranteesThrough</rdfs:label>
    <rdfs:comment>Indicates that the group provides guarantees through its guarantee business line.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GuaranteeBusinessLine"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#maximumCreditRiskExposurePriorYearAmount">
    <rdfs:label>maximumCreditRiskExposurePriorYearAmount</rdfs:label>
    <rdfs:comment>Maximum exposure to credit risk at the prior year-end (e.g., €89,980.2 million at 31 December 2022).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Solvency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#accountingStandardsInForceDate">
    <rdfs:label>accountingStandardsInForceDate</rdfs:label>
    <rdfs:comment>Date as at which the applicable IFRS/IAS standards are stated to be in force for the consolidated financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#processesPersonalDataFor">
    <rdfs:label>processesPersonalDataFor</rdfs:label>
