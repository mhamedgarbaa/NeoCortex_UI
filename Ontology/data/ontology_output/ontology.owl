    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#disclosesPersonalDataTo">
    <rdfs:label>disclosesPersonalDataTo</rdfs:label>
    <rdfs:comment>Indicates that personal data is disclosed to service providers/subcontractors that provide services related to the processing on behalf of Bpifrance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataController"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ServiceProvider"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DataProcessor"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#BpifranceGroupEntity"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityInvestmentsNote">
    <rdfs:label>EquityInvestmentsNote</rdfs:label>
    <rdfs:comment>Note section detailing equity investments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BilateralLoan">
    <rdfs:label>BilateralLoan</rdfs:label>
    <rdfs:comment>Debt financing provided through bilateral loans referenced in guarantee commitments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DebtSecurity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#includesNetCashFlowFromOperatingActivities">
