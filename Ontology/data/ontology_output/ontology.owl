    <rdfs:label>includesBusinessLine</rdfs:label>
    <rdfs:comment>The organizational chart of business lines includes business lines.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OrganizationalChartOfBusinessLines"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#BusinessLine"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#relatedReceivables">
    <rdfs:label>relatedReceivables</rdfs:label>
    <rdfs:comment>Related receivables amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OtherReceivables"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteeCommissionToBeSpread">
    <rdfs:label>guaranteeCommissionToBeSpread</rdfs:label>
    <rdfs:comment>Guarantee commission to be spread amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommission"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StudiesAndSatisfactionSurveys">
    <rdfs:label>StudiesAndSatisfactionSurveys</rdfs:label>
    <rdfs:comment>Processing for carrying out studies or satisfaction surveys.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InsuranceProducts">
    <rdfs:label>InsuranceProducts</rdfs:label>
    <rdfs:comment>A category of products used to insure export activities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherExpenses">
    <rdfs:label>OtherExpenses</rdfs:label>
    <rdfs:comment>Subcategory of operating expenses for other expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingExpenses"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasStructuralInterestRateRisk">
    <rdfs:label>hasStructuralInterestRateRisk</rdfs:label>
    <rdfs:comment>Indicates that structural interest rate risk is a key risk family.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#StructuralInterestRateRisk"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasSecuritiesCommitmentsReceived">
    <rdfs:label>hasSecuritiesCommitmentsReceived</rdfs:label>
    <rdfs:comment>Relates securities commitments received to the off-balance sheet commitments section.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SecuritiesCommitments"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancedCompany">
    <rdfs:label>FinancedCompany</rdfs:label>
    <rdfs:comment>A company whose data is collected for investigation of an operation and its follow-up after financing/support is granted.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netProfit">
    <rdfs:label>netProfit</rdfs:label>
    <rdfs:comment>Net profit amount for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GroupRiskManagementCommittee">
    <rdfs:label>GroupRiskManagementCommittee</rdfs:label>
    <rdfs:comment>A committee reviewing group risk management matters after presentations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SustainableFinanceDisclosureRegulation">
    <rdfs:label>SustainableFinanceDisclosureRegulation</rdfs:label>
    <rdfs:comment>A regulation referenced for harmonised transparency and classification of financial products.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskDivision">
    <rdfs:label>RiskDivision</rdfs:label>
    <rdfs:comment>Organizational unit responsible for credit risk policy and risk assessments/monitoring within the financing process.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#result">
    <rdfs:label>result</rdfs:label>
    <rdfs:comment>Result amount included in shareholders’ equity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholderEquity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#managesOnBehalfOf">
    <rdfs:label>managesOnBehalfOf</rdfs:label>
    <rdfs:comment>The institution manages operations on behalf of the State/public entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PublicEntity"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#StateEntity"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatement">
    <rdfs:label>HalfYearConsolidatedFinancialStatement</rdfs:label>
    <rdfs:comment>A consolidated financial statement prepared for a half-year period.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OrdinaryResolution">
    <rdfs:label>OrdinaryResolution</rdfs:label>
    <rdfs:comment>A resolution submitted to an ordinary general meeting.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Resolution"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ParticipationsCompany">
    <rdfs:label>ParticipationsCompany</rdfs:label>
    <rdfs:comment>Participation holding company referenced in the capital structure and agreements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompanySubsidiary"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#issuesGreenFinancingInstruments">
    <rdfs:label>issuesGreenFinancingInstruments</rdfs:label>
    <rdfs:comment>Indicates that Bpifrance issues green financing instruments under the green financing framework.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Bpifrance"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GreenFinancingInstrument"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dpoContactMethod">
    <rdfs:label>dpoContactMethod</rdfs:label>
    <rdfs:comment>Contact method(s) offered for reaching the data protection officer (e.g., email, post).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataProtectionOfficer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ScoringSystem">
    <rdfs:label>ScoringSystem</rdfs:label>
    <rdfs:comment>A scoring approach used to rank geographical areas or assess vulnerability to transition risks.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ManagementOfProceeds">
    <rdfs:label>ManagementOfProceeds</rdfs:label>
    <rdfs:comment>Pillar describing how proceeds are managed after issuance.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dataRetentionStartCondition">
    <rdfs:label>dataRetentionStartCondition</rdfs:label>
    <rdfs:comment>Condition/event that triggers the start of the retention period (e.g., end of business relationship).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RetentionPeriod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExportCreditAgency">
    <rdfs:label>ExportCreditAgency</rdfs:label>
    <rdfs:comment>Public body role providing export credit/guarantee support for international trade.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NegotiableEuropeanMediumTermNote">
    <rdfs:label>NegotiableEuropeanMediumTermNote</rdfs:label>
    <rdfs:comment>Negotiable European medium-term note (NEU MTN) issued as a green debt instrument under the framework.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GreenFinancingInstrument"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#MediumTermNegotiableDebtSecurity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasDeputyCEO">
    <rdfs:label>hasDeputyCEO</rdfs:label>
    <rdfs:comment>Indicates the deputy CEO is responsible for the amendment’s information.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DeputyCEO"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#bookValueOfInterestsInJointVenture">
    <rdfs:label>bookValueOfInterestsInJointVenture</rdfs:label>
    <rdfs:comment>Book value of interests in a joint venture accounted for using the equity method.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestment"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodAccounting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationAdvisoryCommittee">
    <rdfs:label>InnovationAdvisoryCommittee</rdfs:label>
    <rdfs:comment>Advisory committee for innovation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AdvisoryCommittee"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InformedInvestor">
    <rdfs:label>InformedInvestor</rdfs:label>
    <rdfs:comment>Investment approach operating under market conditions and guided by collective interest.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Investment"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#balanceSheetDate">
    <rdfs:label>balanceSheetDate</rdfs:label>
    <rdfs:comment>The balance sheet closing date used for the consolidated financial statements (e.g., 31 December 2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialYear"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternationalCapitalCompany">
    <rdfs:label>InternationalCapitalCompany</rdfs:label>
    <rdfs:comment>Company developing long-term partnerships with foreign sovereign wealth funds, referenced in history.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompanySubsidiary"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EPIC">
    <rdfs:label>EPIC</rdfs:label>
    <rdfs:comment>French public institution type (établissement public à caractère industriel et commercial) referenced as owning and controlling the organization.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicAffairsActivity">
    <rdfs:label>PublicAffairsActivity</rdfs:label>
    <rdfs:comment>Activities in the field of public affairs, including stakeholder mapping and engagement planning.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SupplierRepresentative">
    <rdfs:label>SupplierRepresentative</rdfs:label>
    <rdfs:comment>A natural person acting as a legal representative or agent of a supplier whose personal data is processed.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataSubject"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TransitionRiskQuantification">
    <rdfs:label>TransitionRiskQuantification</rdfs:label>
    <rdfs:comment>Annual assessment and monitoring of portfolio exposure and vulnerability to climate transition risk.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#treasuryFundsDepositAccountAmount">
    <rdfs:label>treasuryFundsDepositAccountAmount</rdfs:label>
    <rdfs:comment>Treasury Funds Deposit Account balance included in cash and cash equivalents (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CashAndCashEquivalents"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BankAccount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#amountOfRisksGuaranteed">
    <rdfs:label>amountOfRisksGuaranteed</rdfs:label>
    <rdfs:comment>Amount of risks guaranteed (excluding internal funds) reported for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FirstDemandGuarantee">
    <rdfs:label>FirstDemandGuarantee</rdfs:label>
    <rdfs:comment>First-demand guarantee commitments issued to support financing contracts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SignatureCommitment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GeneralDataProtectionRegulation">
    <rdfs:label>GeneralDataProtectionRegulation</rdfs:label>
    <rdfs:comment>The GDPR referenced as the main European regulation governing personal data protection.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EuropeanRegulation"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InsuranceCompany">
    <rdfs:label>InsuranceCompany</rdfs:label>
    <rdfs:comment>An insurance company referenced as generally excluded from investment capital participation.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Parliament">
    <rdfs:label>Parliament</rdfs:label>
    <rdfs:comment>French Parliament referenced as providing supervision and guarantee context.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicEntity"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#rightToProvidePostMortemInstructions">
    <rdfs:label>rightToProvidePostMortemInstructions</rdfs:label>
    <rdfs:comment>Whether the policy states the ability to provide instructions on the fate of personal data after death.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataSubjectRights"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netIncomeGroupShare">
    <rdfs:label>netIncomeGroupShare</rdfs:label>
    <rdfs:comment>Net income attributable to the group share.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RegionalOffices">
    <rdfs:label>RegionalOffices</rdfs:label>
    <rdfs:comment>Local offices providing a single interlocutor to entrepreneurs.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChartOfNetwork"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CoverLetter">
    <rdfs:label>CoverLetter</rdfs:label>
    <rdfs:comment>A cover letter document that may contain personal data used in recruitment.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#usesNetInterestMargin">
    <rdfs:label>usesNetInterestMargin</rdfs:label>
    <rdfs:comment>Indicates that net interest margin is used as an indicator to monitor structural interest rate risk.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RiskManagementTool"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#NetInterestMargin"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#advanceDividendAmount">
    <rdfs:label>advanceDividendAmount</rdfs:label>
    <rdfs:comment>The amount of the advance payment of the dividend.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasCurrentLiquidityBuffer">
    <rdfs:label>hasCurrentLiquidityBuffer</rdfs:label>
    <rdfs:comment>Indicates that liquidity reserve includes a current liquidity buffer.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#LiquidityReserve"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CurrentLiquidityBuffer"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#financialIncomeAmount">
    <rdfs:label>financialIncomeAmount</rdfs:label>
    <rdfs:comment>Total financial income amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LoanInterest">
    <rdfs:label>LoanInterest</rdfs:label>
    <rdfs:comment>Interest income arising from loans.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InterestAndSimilarIncome"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#providesGuaranteeFor">
    <rdfs:label>providesGuaranteeFor</rdfs:label>
    <rdfs:comment>Indicates the institution provides guarantees (e.g., guaranteeing bond issues by Bpifrance).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Guarantee"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#maturityLessThanOneYear">
    <rdfs:label>maturityLessThanOneYear</rdfs:label>
    <rdfs:comment>Amount of loans with a remaining maturity of less than or equal to 1 year.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Loans"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OtherDebt"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitments"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExtraordinaryGeneralMeeting">
    <rdfs:label>ExtraordinaryGeneralMeeting</rdfs:label>
    <rdfs:comment>A shareholder meeting type governed by extraordinary quorum and majority requirements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GeneralMeeting"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#VentureFund">
    <rdfs:label>VentureFund</rdfs:label>
    <rdfs:comment>A venture-oriented fund category referenced in the document.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#usesEUTaxonomyAlignedActivities">
    <rdfs:label>usesEU_TaxonomyAlignedActivities</rdfs:label>
    <rdfs:comment>Some eligible green loan categories may be fully aligned with EU taxonomy activities and technical screening criteria.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Loans"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EUTaxonomyActivity"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PrudentValueAdjustment">
    <rdfs:label>PrudentValueAdjustment</rdfs:label>
    <rdfs:comment>A prudential valuation adjustment referenced in the context of liquidity risk impacts on unlisted financial assets.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasLeverageRatio">
    <rdfs:label>hasLeverageRatio</rdfs:label>
    <rdfs:comment>Indicates that the group reports its leverage ratio.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicSectorInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#LeverageRatio"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#financialExpensesAmount">
    <rdfs:label>financialExpensesAmount</rdfs:label>
    <rdfs:comment>Total financial expenses amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialExpenses"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#policyUpdateDate">
    <rdfs:label>policyUpdateDate</rdfs:label>
    <rdfs:comment>Date when the personal data processing policy was last updated.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PolicyDocument"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GDPR"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PrivacyPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#fairValueHierarchyTransferEndOfPeriod">
    <rdfs:label>fairValueHierarchyTransferEndOfPeriod</rdfs:label>
    <rdfs:comment>Indicates that transfers between fair value hierarchy levels are deemed to occur at the end of the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOperationalRiskDepartment">
    <rdfs:label>hasOperationalRiskDepartment</rdfs:label>
    <rdfs:comment>Indicates that the group has an operational risk department responsible for operational and non-compliance risk control system.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OperationalRiskDepartment"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IncomeFromDisposalOfFinancialAssets">
    <rdfs:label>IncomeFromDisposalOfFinancialAssets</rdfs:label>
    <rdfs:comment>Income from disposal of financial assets (e.g., EDF financial assets).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExtraordinaryIncome"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ComplaintsAndLitigationManagement">
    <rdfs:label>ComplaintsAndLitigationManagement</rdfs:label>
    <rdfs:comment>Processing activities for managing complaints and litigation and defending rights in court.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasEquityInvestmentsAccountedForUsingEquityMethod">
    <rdfs:label>hasEquityInvestmentsAccountedForUsingEquityMethod</rdfs:label>
    <rdfs:comment>Indicates equity investments accounted for using the equity method.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodAccounting"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestee"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#grossOperatingIncomeAmount">
    <rdfs:label>grossOperatingIncomeAmount</rdfs:label>
    <rdfs:comment>Gross operating income amount for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GrossOperatingIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#currentIncomeBeforeTaxesAmount">
    <rdfs:label>currentIncomeBeforeTaxesAmount</rdfs:label>
    <rdfs:comment>Current income before taxes amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CurrentIncomeBeforeTaxes"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EcotechnologiesUnit">
    <rdfs:label>EcotechnologiesUnit</rdfs:label>
    <rdfs:comment>An investment unit intervening via ecotechnologies and impact-related funds.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentUnit"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#cashAndCashEquivalentsTotalAmount">
    <rdfs:label>cashAndCashEquivalentsTotalAmount</rdfs:label>
    <rdfs:comment>Total cash and cash equivalents reported for the period (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CashAndCashEquivalents"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#unallocatedProceedsNotInvestedInGHGIntensiveActivities">
    <rdfs:label>unallocatedProceedsNotInvestedInGHGIntensiveActivities</rdfs:label>
    <rdfs:comment>Indicates that unallocated proceeds are not invested in GHG intensive activities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#processingPurpose">
    <rdfs:label>processingPurpose</rdfs:label>
    <rdfs:comment>Purpose for which personal data is processed (e.g., due diligence, monitoring, complaint management, newsletters).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#reportYear">
    <rdfs:label>reportYear</rdfs:label>
    <rdfs:comment>Financial/reporting year covered by the annual report.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AnnualReport"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PressRelease"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CarbonNeutralityObjective">
    <rdfs:label>CarbonNeutralityObjective</rdfs:label>
    <rdfs:comment>An objective of carbon neutrality referenced for alignment with climate goals.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#unrealisedForeignExchangeGainsAsAtDate">
    <rdfs:label>unrealisedForeignExchangeGainsAsAtDate</rdfs:label>
    <rdfs:comment>Date as at which unrealised foreign exchange gains are reported.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UnrealisedForeignExchangeGain"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AgencyForEcologicalTransition">
    <rdfs:label>AgencyForEcologicalTransition</rdfs:label>
    <rdfs:comment>The agency responsible for ecological transition implementation referenced in agreements.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRiskCommittee">
    <rdfs:label>hasRiskCommittee</rdfs:label>
    <rdfs:comment>Indicates that the board of directors has a risk committee.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RiskCommittee"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ACPR">
    <rdfs:label>ACPR</rdfs:label>
    <rdfs:comment>A regulatory authority referenced for climate stress tests.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#preparesConsolidatedFinancialStatements">
    <rdfs:label>preparesConsolidatedFinancialStatements</rdfs:label>
    <rdfs:comment>Indicates that the institution prepares consolidated financial statements.</rdfs:comment>
