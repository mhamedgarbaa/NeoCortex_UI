  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IFRSStandards">
    <rdfs:label>IFRSStandards</rdfs:label>
    <rdfs:comment>International Financial Reporting Standards applied in preparing the consolidated financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AccountingPrinciplesAndMethods"/>
  </owl:Class>
