  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#deferredTax">
    <rdfs:label>deferredTax</rdfs:label>
    <rdfs:comment>Deferred tax amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DeferredTax"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FundForInnovationAndIndustry">
    <rdfs:label>FundForInnovationAndIndustry</rdfs:label>
    <rdfs:comment>The fund structure associated with the Innovation and Industry Fund, referenced as being run-off.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InnovationAndIndustryFund"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LCRLiquidityRatio">
    <rdfs:label>LCRLiquidityRatio</rdfs:label>
