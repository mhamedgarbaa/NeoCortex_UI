  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValueInformation">
    <rdfs:label>FairValueInformation</rdfs:label>
    <rdfs:comment>Disclosures about fair value measurement, including valuation levels and sensitivity for financial instruments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#providesTraining">
