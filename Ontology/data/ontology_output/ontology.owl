    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#TaxReceivable"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRiskManagementOrganization">
    <rdfs:label>hasRiskManagementOrganization</rdfs:label>
    <rdfs:comment>Associates risk management with the organization responsible for risk management.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RiskManagement"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RiskManagementOrganization"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OffBalanceSheetItem">
    <rdfs:label>OffBalanceSheetItem</rdfs:label>
    <rdfs:comment>An item recognized as off-balance sheet in acquisition and consolidation contexts.</rdfs:comment>
