    <rdfs:label>miscellaneousDebtsAmount</rdfs:label>
    <rdfs:comment>Miscellaneous debts amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#MiscellaneousDebts"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AuditOpinion">
    <rdfs:label>AuditOpinion</rdfs:label>
    <rdfs:comment>The audit opinion expressed on the financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditors"/>
  </owl:Class>
