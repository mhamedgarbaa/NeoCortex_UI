    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StartUp">
    <rdfs:label>StartUp</rdfs:label>
    <rdfs:comment>Start-ups supported as part of the Investing in the Future Programme financing of innovation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Company"/>
