    <rdfs:comment>Full contact address used for correspondence to the data protection officer.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataProtectionOfficer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
