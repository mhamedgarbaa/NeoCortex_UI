    <rdfs:label>frenchStateCurrentAccountAmount</rdfs:label>
    <rdfs:comment>French State current account amount (Agence France Trésor Innovation Capital) included in other financial assets (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAssets"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExportInsuranceActivity">
    <rdfs:label>ExportInsuranceActivity</rdfs:label>
    <rdfs:comment>Activity level of export insurance including accepted guarantee applications.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExportInsurance"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteeCommissionReceivable">
    <rdfs:label>guaranteeCommissionReceivable</rdfs:label>
    <rdfs:comment>Guarantee commission receivable amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommission"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#cicePreFinancingAmount">
    <rdfs:label>cicePreFinancingAmount</rdfs:label>
    <rdfs:comment>Short-term financing - pre-financing of the CICE amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingBusinessLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRiskExposure">
    <rdfs:label>hasRiskExposure</rdfs:label>
    <rdfs:comment>Relates a risk to the exposure it represents.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Risk"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicSectorInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RiskExposure"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StateGuaranteedLoan">
    <rdfs:label>StateGuaranteedLoan</rdfs:label>
    <rdfs:comment>A loan benefiting from state guarantees, referenced in ECL determination and sensitivity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NegotiableEuropeanCommercialPaper">
    <rdfs:label>NegotiableEuropeanCommercialPaper</rdfs:label>
    <rdfs:comment>Negotiable European commercial paper (NEU CP) issued as a green debt instrument under the framework.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GreenFinancingInstrument"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ShortTermNegotiableDebtSecurity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancingPlan">
    <rdfs:label>FinancingPlan</rdfs:label>
    <rdfs:comment>Financing plan for which EPIC provides guarantees and which is referenced for 2024.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BeneficialOwner">
    <rdfs:label>BeneficialOwner</rdfs:label>
    <rdfs:comment>A person who ultimately owns or controls a company seeking or receiving financing/support.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Person"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityCapitalOrganisation">
    <rdfs:label>EquityCapitalOrganisation</rdfs:label>
    <rdfs:comment>An organisation providing equity capital interventions referenced in guarantee and investment contexts.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasLegalBasisForProcessing">
    <rdfs:label>hasLegalBasisForProcessing</rdfs:label>
    <rdfs:comment>Links each processing purpose to its legal basis (e.g., pre-contractual measures, legal obligations, legitimate interest, contract performance).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#LegalBasisForProcessing"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#commitmentsGiven">
    <rdfs:label>commitmentsGiven</rdfs:label>
    <rdfs:comment>Total commitments given (e.g., guarantee commitments given) for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AMFAuthority">
    <rdfs:label>AMFAuthority</rdfs:label>
    <rdfs:comment>The Autorité des Marchés Financiers (AMF) referenced for complaint management under its regulations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RegulatoryAuthority"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#authorisesSigningOfFrameworkAgreement">
    <rdfs:label>authorisesSigningOfFrameworkAgreement</rdfs:label>
    <rdfs:comment>Indicates that governance authorises signing of framework agreements for programme management.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FrameworkAgreement"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#managesTechnologyTransferProgramme">
    <rdfs:label>managesTechnologyTransferProgramme</rdfs:label>
    <rdfs:comment>Indicates that the institution contributes to and manages technology transfer activities/programmes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#TechnologyTransferProgramme"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendsAmount">
    <rdfs:label>dividendsAmount</rdfs:label>
    <rdfs:comment>Dividend amount paid or received for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Dividends"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#debtsOnFixedAssetsAndRelatedAccountsAmount">
    <rdfs:label>debtsOnFixedAssetsAndRelatedAccountsAmount</rdfs:label>
    <rdfs:comment>Debts on fixed assets and related accounts amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DebtsOnFixedAssetsAndRelatedAccounts"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#returnOnEquity">
    <rdfs:label>returnOnEquity</rdfs:label>
    <rdfs:comment>Return on equity (ROE) percentage reported for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ROE"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeActivity">
    <rdfs:label>GuaranteeActivity</rdfs:label>
    <rdfs:comment>Guarantee business activity including local and regional guarantee funds.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#offBalanceSheetCommitmentsGivenAmount">
    <rdfs:label>offBalanceSheetCommitmentsGivenAmount</rdfs:label>
    <rdfs:comment>Total off-balance sheet commitments given.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitmentsGiven"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isShareholderOf">
    <rdfs:label>isShareholderOf</rdfs:label>
    <rdfs:comment>Indicates the institution is a shareholder of a public limited company (e.g., EPIC Bpifrance as shareholder of Bpifrance).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#holdsShareholdingIn">
        <rdfs:label>holdsShareholdingIn</rdfs:label>
        <rdfs:comment>Indicates that the institution holds a shareholding in a public limited company (e.g., share capital of the group).</rdfs:comment>
        <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
        <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TargetCompany">
    <rdfs:label>TargetCompany</rdfs:label>
    <rdfs:comment>A company in which the organization intends to invest or has invested, including for due diligence and transaction processing.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#taxAndSocialSecurityDebtsAmount">
    <rdfs:label>taxAndSocialSecurityDebtsAmount</rdfs:label>
    <rdfs:comment>Tax and social security debts amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#TaxAndSocialSecurityDebts"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ClimateRiskCommittee">
    <rdfs:label>ClimateRiskCommittee</rdfs:label>
    <rdfs:comment>A committee created to monitor the group’s exposure to climate risks and endorse methodological changes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#HealthInsuranceOrganization">
    <rdfs:label>HealthInsuranceOrganization</rdfs:label>
    <rdfs:comment>An organization providing health insurance that may receive information to finalize recruitment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestingActivity">
    <rdfs:label>InvestingActivity</rdfs:label>
    <rdfs:comment>Cash flow activity category representing cash flows for acquisition and disposal of investments and fixed assets.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#retentionPeriodYears">
    <rdfs:label>retentionPeriodYears</rdfs:label>
    <rdfs:comment>Retention period expressed in number of years for personal data.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataRetention"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#lastAppointedDate">
    <rdfs:label>lastAppointedDate</rdfs:label>
    <rdfs:comment>Date when a board member was last appointed (e.g., by decree date).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#addressesPhysicalRisks">
    <rdfs:label>addressesPhysicalRisks</rdfs:label>
    <rdfs:comment>Indicates that the group addresses physical climate risks as part of climate risk management.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PhysicalClimateRisk"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TierOneSupplier">
    <rdfs:label>TierOneSupplier</rdfs:label>
    <rdfs:comment>A supplier at the first tier whose referrals and intermediaries may be managed.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Supplier"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RightOfAccess">
    <rdfs:label>RightOfAccess</rdfs:label>
    <rdfs:comment>Right to obtain access to personal data.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IndividualRights"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendsPaidAmount">
    <rdfs:label>dividendsPaidAmount</rdfs:label>
    <rdfs:comment>Total dividends paid for the period as shown in the dividends note (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RightOfPortability">
    <rdfs:label>RightOfPortability</rdfs:label>
    <rdfs:comment>Right to receive personal data in a portable format.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IndividualRights"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#holdsEquityInvestmentIn">
    <rdfs:label>holdsEquityInvestmentIn</rdfs:label>
    <rdfs:comment>Indicates that the institution holds equity investments in other companies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityInvestments"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#otherServicesFees">
    <rdfs:label>otherServicesFees</rdfs:label>
    <rdfs:comment>Fees for other services provided by statutory auditors.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquipmentLeasing">
    <rdfs:label>EquipmentLeasing</rdfs:label>
    <rdfs:comment>Leasing arrangements referenced as part of medium- and long-term financing.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Loan"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasInternalLiquidityAdequacyAssessmentProcess">
    <rdfs:label>hasInternalLiquidityAdequacyAssessmentProcess</rdfs:label>
    <rdfs:comment>Indicates that the group operates an internal liquidity adequacy assessment process (ILAAP).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InternalLiquidityAdequacyAssessmentProcess"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BankingAndFinancialData">
    <rdfs:label>BankingAndFinancialData</rdfs:label>
    <rdfs:comment>Category of personal data related to banking details and financial information.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dpoEmail">
    <rdfs:label>dpoEmail</rdfs:label>
    <rdfs:comment>Email address of the data protection officer used for contacting the organization.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataProtectionOfficer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SocialEconomyCompany">
    <rdfs:label>SocialEconomyCompany</rdfs:label>
    <rdfs:comment>A company in the social economy that may attract fewer traditional investors and can be targeted by investment funds.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasNotesToFinancialStatements">
    <rdfs:label>hasNotesToFinancialStatements</rdfs:label>
    <rdfs:comment>Links a half-year consolidated financial statements document to its notes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancialStatementNote"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Capital">
    <rdfs:label>Capital</rdfs:label>
    <rdfs:comment>Subscribed capital component of shareholders’ equity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ShareholdersEquity"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#cashFlowAfterCostOfNetFinancialDebtAndTax">
    <rdfs:label>cashFlowAfterCostOfNetFinancialDebtAndTax</rdfs:label>
    <rdfs:comment>Cash flow after cost of net financial debt and tax.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StatementOfCashFlows"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetCashFlow"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicCompany">
    <rdfs:label>PublicCompany</rdfs:label>
    <rdfs:comment>A public company performing a commercial activity and eligible for support regardless of legal status.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#fairValueLevel2Amount">
    <rdfs:label>fairValueLevel2Amount</rdfs:label>
    <rdfs:comment>Fair value amount classified in Level 2 of the fair value hierarchy.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FairValueLevel2"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExtraordinaryIncomeNote">
    <rdfs:label>ExtraordinaryIncomeNote</rdfs:label>
    <rdfs:comment>Note section dealing with extraordinary income.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LifeSciencesUnit">
    <rdfs:label>LifeSciencesUnit</rdfs:label>
    <rdfs:comment>An investment unit operating in biotech and medtech sectors via dedicated funds.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentUnit"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LegalEntity">
    <rdfs:label>LegalEntity</rdfs:label>
    <rdfs:comment>A legal entity that can be included in consolidation or hold financial statement items.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#offBalanceSheetCommitmentsGivenFinancingCommitmentsAmount">
    <rdfs:label>offBalanceSheetCommitmentsGivenFinancingCommitmentsAmount</rdfs:label>
    <rdfs:comment>Financing commitments given amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitmentsGiven"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasPersonalDataProtectionPolicy">
    <rdfs:label>hasPersonalDataProtectionPolicy</rdfs:label>
    <rdfs:comment>Indicates that the group has a personal data protection policy (implied by governance of data and security measures).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PersonalDataProtectionPolicy"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasConsolidationMethod">
    <rdfs:label>hasConsolidationMethod</rdfs:label>
    <rdfs:comment>Indicates the consolidation method used for preparing consolidated financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidationScope"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ConsolidationMethod"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExclusionPolicy">
    <rdfs:label>ExclusionPolicy</rdfs:label>
    <rdfs:comment>A set of exclusion criteria defining sectors and company behaviors not eligible for investment.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ResponsibleInvestmentPolicy"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#rightToPortability">
    <rdfs:label>rightToPortability</rdfs:label>
    <rdfs:comment>Whether the policy states the right to data portability.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataSubjectRights"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#extraordinaryExpensesTotalAmount">
    <rdfs:label>extraordinaryExpensesTotalAmount</rdfs:label>
    <rdfs:comment>Total extraordinary expenses reported for the period (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ExtraordinaryExpense"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#recognisesImpairmentLossInIncomeStatement">
    <rdfs:label>recognisesImpairmentLossInIncomeStatement</rdfs:label>
    <rdfs:comment>Indicates that impairment losses are recognised when recoverable amount is less than book value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ImpairmentTest"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Impairment"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#reportingYear">
    <rdfs:label>reportingYear</rdfs:label>
    <rdfs:comment>Financial year to which the reported information applies (e.g., 2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialYear"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NEUMTNProgramme">
    <rdfs:label>NEUMTNProgramme</rdfs:label>
    <rdfs:comment>A NEU MTN bond programme referenced as part of refinancing and bond resources.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EMTNProgramme"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasFundOfFundsBusinessContribution">
    <rdfs:label>hasFundOfFundsBusinessContribution</rdfs:label>
    <rdfs:comment>Indicates that net banking income includes a contribution from the Fund of Funds business.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetBankingIncome"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FundOfFundsBusiness"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dataCollectionSource">
    <rdfs:label>dataCollectionSource</rdfs:label>
    <rdfs:comment>Source from which personal data is collected indirectly (e.g., group entities, co-investors, authorities databases, IT service providers).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#IndirectCollection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#interestAndSimilarIncomeAmount">
    <rdfs:label>interestAndSimilarIncomeAmount</rdfs:label>
    <rdfs:comment>Interest and similar income amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InterestIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#midLongTermFinancingInvestmentCoFinancing">
    <rdfs:label>midLongTermFinancingInvestmentCoFinancing</rdfs:label>
    <rdfs:comment>Mid-long-term financing - investment co-financing amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingBusinessLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LargeCapRegionalFunds">
    <rdfs:label>LargeCapRegionalFunds</rdfs:label>
    <rdfs:comment>Large cap regional funds referenced in the organizational chart.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#exercisesJointControlOver">
    <rdfs:label>exercisesJointControlOver</rdfs:label>
    <rdfs:comment>Relates a group/public institution to a partnership/joint venture over which it exercises joint control.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#JointVenture"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RecoverableAdvance">
    <rdfs:label>RecoverableAdvance</rdfs:label>
    <rdfs:comment>Advance funding that is recoverable, used in innovation financing.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasDataSubjectRights">
    <rdfs:label>hasDataSubjectRights</rdfs:label>
    <rdfs:comment>Connects a personal data rights concept to the specific rights available to data subjects.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataRights"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DataSubjectRights"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasIncomeStatement">
    <rdfs:label>hasIncomeStatement</rdfs:label>
    <rdfs:comment>Consolidated financial statements include an income statement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasESGQuestionnaire">
    <rdfs:label>hasESGQuestionnaire</rdfs:label>
    <rdfs:comment>Indicates that the group uses an ESG questionnaire within diligence packs for fund-of-funds and monitoring.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DiligencePack"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netBankingIncome">
    <rdfs:label>netBankingIncome</rdfs:label>
    <rdfs:comment>Net banking income for the period (e.g., H1 2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetBankingIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#economicAndFinancialDataSiren">
    <rdfs:label>economicAndFinancialDataSiren</rdfs:label>
    <rdfs:comment>SIREN identifier component of economic and financial data.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EconomicAndFinancialData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#businessLoginDataIpAddress">
    <rdfs:label>businessLoginDataIpAddress</rdfs:label>
    <rdfs:comment>IP address used for portal access.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BusinessLoginData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasLoanCommitment">
    <rdfs:label>hasLoanCommitment</rdfs:label>
    <rdfs:comment>Indicates that financing commitments include loan commitments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#LoanCommitment"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#boardMeetingDate">
    <rdfs:label>boardMeetingDate</rdfs:label>
    <rdfs:comment>The date of the board meeting that determined dividend and authorized amendments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SeparateFinancialStatements">
    <rdfs:label>SeparateFinancialStatements</rdfs:label>
    <rdfs:comment>Financial statements prepared for the parent entity only, including publishable balance sheet and income statement and related notes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AnnualReport"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StrategicProjectGuarantee">
    <rdfs:label>StrategicProjectGuarantee</rdfs:label>
    <rdfs:comment>A guarantee context referenced for sharing personal data with reinsurance/joint insurance participants.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConnectedSpace">
    <rdfs:label>ConnectedSpace</rdfs:label>
    <rdfs:comment>A user-accessible connected environment for which identification and authentication data are processed.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MidSizedBusiness">
    <rdfs:label>MidSizedBusiness</rdfs:label>
    <rdfs:comment>A company category referenced alongside SMEs as a concentration area for customer loans and receivables.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Company"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#budgetYear">
    <rdfs:label>budgetYear</rdfs:label>
    <rdfs:comment>Financial year referenced for budgeting and performance comparison (e.g., 2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialYear"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#eligiblePoolMustAlwaysExceedMaximumIssuedAmount">
    <rdfs:label>eligiblePoolMustAlwaysExceedMaximumIssuedAmount</rdfs:label>
    <rdfs:comment>Indicates that the total eligible pool for short-term and medium-term financing must always exceed the maximum amount of issued NEUCP and NEUMTN.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#amountInThousandsOfEuros">
    <rdfs:label>amountInThousandsOfEuros</rdfs:label>
    <rdfs:comment>Numeric amounts presented in the notes, expressed in thousands of euros.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValueThroughProfitOrLoss">
    <rdfs:label>FairValueThroughProfitOrLoss</rdfs:label>
    <rdfs:comment>A measurement category for financial assets whose fair value changes are recognized in profit or loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#maximumCreditRiskExposureAmount">
    <rdfs:label>maximumCreditRiskExposureAmount</rdfs:label>
    <rdfs:comment>Maximum exposure to credit risk measured under IFRS standards (e.g., €92,789.0 million at 30 June 2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Solvency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteeCommitmentsEndDate">
    <rdfs:label>guaranteeCommitmentsEndDate</rdfs:label>
    <rdfs:comment>Date at which the guarantee commitments amount is reported (e.g., end-2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
