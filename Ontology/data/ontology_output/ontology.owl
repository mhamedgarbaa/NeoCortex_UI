    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RetentionPeriod"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#balanceSheetTotalAsOfDate">
