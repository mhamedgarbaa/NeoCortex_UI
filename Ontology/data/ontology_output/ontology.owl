    <rdfs:comment>Provisions amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Provision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#operatingCosts">
    <rdfs:label>operatingCosts</rdfs:label>
    <rdfs:comment>Operating costs for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingExpenditure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SignificantInfluence">
    <rdfs:label>SignificantInfluence</rdfs:label>
    <rdfs:comment>The power to participate in decisions regarding financial and operating policies of an investee without controlling or jointly controlling it.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidationPrinciple"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#rightToRectification">
    <rdfs:label>rightToRectification</rdfs:label>
    <rdfs:comment>Whether the policy states the right to rectification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataSubjectRights"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GreenTech">
    <rdfs:label>GreenTech</rdfs:label>
    <rdfs:comment>Companies and solutions focused on green technologies and decarbonization.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netSalesOrIncomeAmount">
    <rdfs:label>netSalesOrIncomeAmount</rdfs:label>
    <rdfs:comment>Net sales or income amount for a subsidiary/holding (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Annex">
    <rdfs:label>Annex</rdfs:label>
    <rdfs:comment>An annex section referenced for structured regulatory content (e.g., Annex I and II headings).</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#consolidatedNetIncomeGroupShare">
    <rdfs:label>consolidatedNetIncomeGroupShare</rdfs:label>
    <rdfs:comment>Consolidated net income attributable to the group share.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#profitAmount">
    <rdfs:label>profitAmount</rdfs:label>
    <rdfs:comment>The profit amount recorded for the last financial year.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NonRecyclableEquityItem">
    <rdfs:label>NonRecyclableEquityItem</rdfs:label>
    <rdfs:comment>Equity items that cannot be reclassified (non-recyclable) to profit or loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ShareholdersEquity"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#halfYearDate">
    <rdfs:label>halfYearDate</rdfs:label>
    <rdfs:comment>Reporting date of the half-year consolidated financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RegionalFunds">
    <rdfs:label>RegionalFunds</rdfs:label>
    <rdfs:comment>Regional funds referenced in the organizational chart.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#carbonIntensityEvaluationStartYear">
    <rdfs:label>carbonIntensityEvaluationStartYear</rdfs:label>
    <rdfs:comment>Year of the first evaluation of all portfolios (e.g., 31 December 2019 evaluation conducted in summer 2020).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Agent">
    <rdfs:label>Agent</rdfs:label>
    <rdfs:comment>A natural person acting as an agent of a supplier whose personal data is processed.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataSubject"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#managedAssetsAmount">
    <rdfs:label>managedAssetsAmount</rdfs:label>
    <rdfs:comment>Total amount of financial assets managed as of the reporting date (e.g., €44.4 bn).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#equityInvestmentsClosingAmount">
    <rdfs:label>equityInvestmentsClosingAmount</rdfs:label>
    <rdfs:comment>Equity investments closing amount at 31/12/2024 (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityInvestments"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IUCN">
    <rdfs:label>IUCN</rdfs:label>
    <rdfs:comment>An organization referenced in biodiversity-related international meetings.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LimitedLiabilityCompany">
    <rdfs:label>LimitedLiabilityCompany</rdfs:label>
    <rdfs:comment>A corporate legal form referenced for the company described in the document.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendsReceivedYearAmount">
    <rdfs:label>dividendsReceivedYearAmount</rdfs:label>
    <rdfs:comment>Amount of dividends received during the financial year.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Dividends"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PortfolioHolding">
    <rdfs:label>PortfolioHolding</rdfs:label>
    <rdfs:comment>An individual company or entity in which the investment branch holds stakes and monitors via governance representation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Portfolio"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#personalDataCategories">
    <rdfs:label>personalDataCategories</rdfs:label>
    <rdfs:comment>Categories of personal data collected and processed (e.g., identification data, administrative data, professional life data, business login data, economic and financial data).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataCategory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
