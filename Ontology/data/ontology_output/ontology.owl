    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Loans"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LargeCompany">
    <rdfs:label>LargeCompany</rdfs:label>
