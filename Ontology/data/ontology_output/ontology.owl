    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#carbonFootprintAssessedAllScopesShare">
    <rdfs:label>carbonFootprintAssessedAllScopesShare</rdfs:label>
    <rdfs:comment>Share of carbon-footprint-assessing respondents that assessed scopes 1, 2 and 3 (e.g., 37%).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperatingActivity">
    <rdfs:label>OperatingActivity</rdfs:label>
    <rdfs:comment>Cash flow activity category representing cash flows from the group’s revenue generating activities.</rdfs:comment>
