    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CreditRisk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#includesConsolidationScope">
    <rdfs:label>includesConsolidationScope</rdfs:label>
    <rdfs:comment>Consolidated financial statements include information about the consolidation scope.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ConsolidationScope"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#taxesAndDuties">
    <rdfs:label>taxesAndDuties</rdfs:label>
    <rdfs:comment>Taxes and duties amount for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Tax"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PartnershipAgreement">
    <rdfs:label>PartnershipAgreement</rdfs:label>
    <rdfs:comment>An agreement concluded with partners for implementing initiatives and support programmes.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#assetsUnderManagement">
    <rdfs:label>assetsUnderManagement</rdfs:label>
    <rdfs:comment>Assets under management reported for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FundOfFundsBusiness"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ActivitiesOnBehalfOfThirdPartiesNote">
    <rdfs:label>ActivitiesOnBehalfOfThirdPartiesNote</rdfs:label>
    <rdfs:comment>Note section describing activities on behalf of third parties.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialAssetDisposal">
    <rdfs:label>FinancialAssetDisposal</rdfs:label>
