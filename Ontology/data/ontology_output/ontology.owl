    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingDebts"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RAndDLoan">
    <rdfs:label>RAndDLoan</rdfs:label>
    <rdfs:comment>Loans dedicated to research and development innovation projects.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Loan"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#unallocatedProceedsTemporary">
    <rdfs:label>unallocatedProceedsTemporary</rdfs:label>
    <rdfs:comment>Indicates that unallocated proceeds are temporary.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
