    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasCurrentLiquidity">
    <rdfs:label>hasCurrentLiquidity</rdfs:label>
    <rdfs:comment>Indicates that liquidity reserve includes current liquidity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#LiquidityReserve"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CurrentLiquidity"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#otherFinancialChargesAmount">
    <rdfs:label>otherFinancialChargesAmount</rdfs:label>
    <rdfs:comment>Other financial charges amount included in interest and similar expenses (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InterestExpense"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ImageRegistrationData">
    <rdfs:label>ImageRegistrationData</rdfs:label>
    <rdfs:comment>Personal data consisting of an image of the person when provided.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AidContract">
    <rdfs:label>AidContract</rdfs:label>
    <rdfs:comment>A contract type under which aid is granted as part of financing/support schemes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancingMechanism"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#includingMinorityInterestsShare">
    <rdfs:label>includingMinorityInterestsShare</rdfs:label>
    <rdfs:comment>Portion of net income and gains/losses directly recognised in equity attributable to minority interests.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ReindustrialisationSupport">
    <rdfs:label>ReindustrialisationSupport</rdfs:label>
    <rdfs:comment>Support for reindustrialisation initiatives referenced in agreements and board decisions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EnergyAndEcologicalTransitionSupport"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeCommissionIncome">
    <rdfs:label>GuaranteeCommissionIncome</rdfs:label>
    <rdfs:comment>Guarantee commissions included as interest and similar income.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InterestAndSimilarIncome"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#includesSignificantlyInfluencedCompanies">
    <rdfs:label>includesSignificantlyInfluencedCompanies</rdfs:label>
    <rdfs:comment>Indicates that consolidated financial statements include companies over which the group has significant influence (equity method investees).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodCompany"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#respondentBusinessesCountBiodiversity">
    <rdfs:label>respondentBusinessesCountBiodiversity</rdfs:label>
    <rdfs:comment>Number of respondents in biodiversity-related survey (e.g., 190).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationScheme">
    <rdfs:label>InnovationScheme</rdfs:label>
    <rdfs:comment>Innovation schemes financed by the Innovation and Industry Fund.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentProgramme"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasPolicy">
    <rdfs:label>hasPolicy</rdfs:label>
    <rdfs:comment>Indicates that the privacy policy governs/relates to the personal data processing activities described for recruitment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PrivacyPolicy"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasEquityConsolidatedCompany">
    <rdfs:label>hasEquityConsolidatedCompany</rdfs:label>
    <rdfs:comment>Indicates that the half-year consolidated financial statements include holdings in equity-consolidated companies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EuropeanCommission">
    <rdfs:label>EuropeanCommission</rdfs:label>
    <rdfs:comment>A European-level institution referenced as a recipient for certain disclosures and as a basis for adequacy decisions.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#equityMethodImpairmentReversalAllowed">
    <rdfs:label>equityMethodImpairmentReversalAllowed</rdfs:label>
    <rdfs:comment>Indicates whether impairment loss can be reversed if value-in-use or market value improves.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ImpairmentTest"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#negativeImpactLevel">
    <rdfs:label>negativeImpactLevel</rdfs:label>
    <rdfs:comment>Qualitative level of the negative impact for a risk (e.g., low, moderate, high).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RiskFactor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#interestAndSimilarExpenses">
    <rdfs:label>interestAndSimilarExpenses</rdfs:label>
    <rdfs:comment>Interest and similar expenses amount disclosed in the financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InterestExpense"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetInterestMargin"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EventParticipationManagement">
    <rdfs:label>EventParticipationManagement</rdfs:label>
    <rdfs:comment>Processing to organize and manage a prospect’s participation in an event via forms or social networks.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExportSupportEntity">
    <rdfs:label>ExportSupportEntity</rdfs:label>
    <rdfs:comment>An organization missioned to encourage, support, and secure French exports, including medium/long-term investments abroad.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasParentEntityStatutoryAuditorReport">
    <rdfs:label>hasParentEntityStatutoryAuditorReport</rdfs:label>
    <rdfs:comment>The parent entity financial statements are accompanied by a parent entity statutory auditor report.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ParentEntityFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ParentEntityFinancialStatementsAuditReport"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#eventDescription">
    <rdfs:label>eventDescription</rdfs:label>
    <rdfs:comment>Short description of a significant event or post balance sheet event.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#SignificantEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SecuritiesAcquiredWithBuybackOrTakebackOption">
    <rdfs:label>SecuritiesAcquiredWithBuybackOrTakebackOption</rdfs:label>
    <rdfs:comment>Securities acquired with an option of buyback or takeback.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SecuritiesCommitment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialIntermediary">
    <rdfs:label>FinancialIntermediary</rdfs:label>
    <rdfs:comment>A generic category of intermediaries used to execute or facilitate financial transactions.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasCashFlowStatement">
    <rdfs:label>hasCashFlowStatement</rdfs:label>
    <rdfs:comment>Indicates that the consolidated financial statements include a cash flow statement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#StatementOfCashFlows"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LoanFromState">
    <rdfs:label>LoanFromState</rdfs:label>
    <rdfs:comment>Loans from the State included in financial loans and financial debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLoanAndFinancialDebt"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#VentureCapitalFund">
    <rdfs:label>VentureCapitalFund</rdfs:label>
    <rdfs:comment>A venture capital fund.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#exceptionalProfitOrLossAmount">
    <rdfs:label>exceptionalProfitOrLossAmount</rdfs:label>
    <rdfs:comment>Exceptional profit or loss amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ExtraordinaryIncome"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ExceptionalProfitOrLoss"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#balanceSheetTotalAmount">
    <rdfs:label>balanceSheetTotalAmount</rdfs:label>
    <rdfs:comment>Total assets (balance sheet total) reported in the balance sheet.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BalanceSheet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#taxRulesApplicableDate">
    <rdfs:label>taxRulesApplicableDate</rdfs:label>
    <rdfs:comment>Date as at which tax rules and rates are applied for deferred tax calculation (e.g., 31 December 2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DeferredTax"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#groupShareholdersEquity">
    <rdfs:label>groupShareholdersEquity</rdfs:label>
    <rdfs:comment>Group share of shareholders' equity amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholderEquity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#amendmentApprovalRegulation">
    <rdfs:label>amendmentApprovalRegulation</rdfs:label>
    <rdfs:comment>The regulation under which the amendment is filed/approved (e.g., EU regulation reference).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasDerivativeHedging">
    <rdfs:label>hasDerivativeHedging</rdfs:label>
    <rdfs:comment>Indicates that the bank uses derivative hedging instruments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicSectorInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DerivativeHedging"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasInterestExpense">
    <rdfs:label>hasInterestExpense</rdfs:label>
    <rdfs:comment>Indicates the institution has interest expense (e.g., state loan interest, EIB loan interest, bank account interest).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InterestExpense"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#frameworkTitle">
    <rdfs:label>frameworkTitle</rdfs:label>
    <rdfs:comment>Title of the green financing framework document.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FossilFuel">
    <rdfs:label>FossilFuel</rdfs:label>
    <rdfs:comment>A sector/energy category referenced for exclusion and for measuring exposure in companies working towards fossil fuels.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#asOfDate">
    <rdfs:label>asOfDate</rdfs:label>
    <rdfs:comment>Reporting date for the financial statement figures (e.g., 31/12/2021, 31/12/2020).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#identificationDataPostalAddress">
    <rdfs:label>identificationDataPostalAddress</rdfs:label>
    <rdfs:comment>Personal postal address component of identification data.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#IdentificationData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#nominalAmount">
    <rdfs:label>nominalAmount</rdfs:label>
    <rdfs:comment>Nominal amount of a bond transaction.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BondIssueProgramme"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#creditFinancingCommitments">
    <rdfs:label>creditFinancingCommitments</rdfs:label>
    <rdfs:comment>Credit financing commitments made (total) at the reporting date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetworkDirectorates">
    <rdfs:label>NetworkDirectorates</rdfs:label>
    <rdfs:comment>Directorates within the network structure.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChartOfNetwork"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#bpifranceAccruedExpensesAmount">
    <rdfs:label>bpifranceAccruedExpensesAmount</rdfs:label>
    <rdfs:comment>Bpifrance accrued expenses amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceAccruedExpense"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#probabilityLevel">
    <rdfs:label>probabilityLevel</rdfs:label>
    <rdfs:comment>Qualitative level of the probability of occurrence for a risk (e.g., low, moderate, high).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RiskFactor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Profiling">
    <rdfs:label>Profiling</rdfs:label>
    <rdfs:comment>Automated or structured processing used for profiling related to commercial prospecting.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicInstitutionMission">
    <rdfs:label>PublicInstitutionMission</rdfs:label>
    <rdfs:comment>Mission category for public institution activities such as financing innovation and supporting SMEs.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#MissionOfGeneralInterest"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicLimitedCompanyParticipationEntity">
    <rdfs:label>PublicLimitedCompanyParticipationEntity</rdfs:label>
    <rdfs:comment>Participation-related public limited company referenced as Bpifrance Participations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOperatingExpenditure">
    <rdfs:label>hasOperatingExpenditure</rdfs:label>
    <rdfs:comment>States the operating expenditure figure reported in the financial results.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OperatingExpenditure"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MicroAndSME">
    <rdfs:label>MicroAndSME</rdfs:label>
    <rdfs:comment>Micro and small/medium enterprises referenced as beneficiaries of the organization’s missions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SME"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#cashAndCashEquivalentsOpeningBalance">
    <rdfs:label>cashAndCashEquivalentsOpeningBalance</rdfs:label>
    <rdfs:comment>Cash and cash equivalents at the beginning of the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#LiquidityPosition"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StatementOfCashFlows"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetCashFlow"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#annualReportReleaseOccasion">
    <rdfs:label>annualReportReleaseOccasion</rdfs:label>
    <rdfs:comment>Reference to the occasion when the allocation report is published (at the Annual Report release).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#article8FundsShareOutstanding">
    <rdfs:label>article8FundsShareOutstanding</rdfs:label>
    <rdfs:comment>Whether there were outstanding Article 8 funds at the reporting date (stated as none).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#recognisesShareOfNetProfitFromEquityConsolidatedCompanies">
    <rdfs:label>recognisesShareOfNetProfitFromEquityConsolidatedCompanies</rdfs:label>
    <rdfs:comment>Represents that the consolidated income statement includes the share of net profit from equity-consolidated companies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Guarantor">
    <rdfs:label>Guarantor</rdfs:label>
    <rdfs:comment>A person providing guarantees whose data may be collected for due diligence and follow-up.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Person"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#portfolioApproachManagedByGreenFinancingCommittee">
    <rdfs:label>portfolioApproachManagedByGreenFinancingCommittee</rdfs:label>
    <rdfs:comment>Indicates that net proceeds are managed using a portfolio approach by the Green Financing Committee.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#policyUpdatedDate">
    <rdfs:label>policyUpdatedDate</rdfs:label>
    <rdfs:comment>Date when the privacy policy was last updated.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PrivacyPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FraudPrevention">
    <rdfs:label>FraudPrevention</rdfs:label>
    <rdfs:comment>Processing activities carried out to comply with legal obligations related to fighting fraud.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Resources">
    <rdfs:label>Resources</rdfs:label>
    <rdfs:comment>Disclosures about the group’s resources such as loans, financing commitments, guarantees, and related business activity breakdowns.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#externalChargesAmount">
    <rdfs:label>externalChargesAmount</rdfs:label>
    <rdfs:comment>External charges amount included in operating expenses (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingExpense"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ETI">
    <rdfs:label>ETI</rdfs:label>
    <rdfs:comment>Mid-sized enterprises (ETIs) referenced as beneficiaries of Investing in the Future Programme financing.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#policyLastUpdatedOn">
    <rdfs:label>policyLastUpdatedOn</rdfs:label>
