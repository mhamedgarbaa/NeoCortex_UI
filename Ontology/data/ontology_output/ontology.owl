    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataProcessingActivity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasEccContributionToNetIncome">
    <rdfs:label>hasEccContributionToNetIncome</rdfs:label>
    <rdfs:comment>Indicates that equity-consolidated companies contribute to net income.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EccContributionToNetIncome"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGuarantee">
    <rdfs:label>hasGuarantee</rdfs:label>
    <rdfs:comment>Indicates that guarantee commitments relate to guarantees.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitment"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Guarantee"/>
  </owl:ObjectProperty>
