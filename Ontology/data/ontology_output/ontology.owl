    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CounterTerrorismFinancingProcess"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#AntiCorruptionProcess"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#totalAssets">
    <rdfs:label>totalAssets</rdfs:label>
    <rdfs:comment>Total assets amount reported in the balance sheet.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BalanceSheet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isPreparedInAccordanceWith">
    <rdfs:label>isPreparedInAccordanceWith</rdfs:label>
    <rdfs:comment>The framework references EU delegated acts for eligibility criteria (e.g., taxonomy delegated acts).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingInstrument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EuropeanCommissionDelegatedRegulation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGuaranteeCommitment">
    <rdfs:label>hasGuaranteeCommitment</rdfs:label>
    <rdfs:comment>Indicates the institution discloses guarantee commitments given and received.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitment"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AccountingMethodEquity">
    <rdfs:label>AccountingMethodEquity</rdfs:label>
    <rdfs:comment>Equity-accounting method used to incorporate equity-consolidated companies in consolidated financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidationScope"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasALMCommittee">
    <rdfs:label>hasALMCommittee</rdfs:label>
    <rdfs:comment>Indicates that the group has an ALM committee for interest rate risk assessment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ALMCommittee"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#relatedPartiesCommittedAmountUnderFrameworkAgreement">
    <rdfs:label>relatedPartiesCommittedAmountUnderFrameworkAgreement</rdfs:label>
    <rdfs:comment>Committed amount under the framework agreement between Bpifrance Participations and EPIC Bpifrance (total and/or annual amounts as disclosed).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RelatedPartyTransaction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendsPaid">
    <rdfs:label>dividendsPaid</rdfs:label>
    <rdfs:comment>Total dividends paid amount (e.g., interim dividend amount).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#frameworkPublicationDateAppliesToFutureBonds">
    <rdfs:label>frameworkPublicationDateAppliesToFutureBonds</rdfs:label>
    <rdfs:comment>Indicates that the updated framework applies to all future green bonds issued after the publication date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Level3FinancialInstrument">
    <rdfs:label>Level3FinancialInstrument</rdfs:label>
    <rdfs:comment>Financial instruments measured using Level 3 fair value inputs requiring judgement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FairValueLevel"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#State">
    <rdfs:label>State</rdfs:label>
    <rdfs:comment>The public authority allocating resources and granting or controlling public guarantees and export insurance on behalf of the state.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicAuthority"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicEntity"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#roeValue">
    <rdfs:label>roeValue</rdfs:label>
    <rdfs:comment>Return on equity (ROE) value for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ROE"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#publishableBalanceSheetDate">
    <rdfs:label>publishableBalanceSheetDate</rdfs:label>
    <rdfs:comment>Reporting date used for the publishable balance sheet (e.g., 31/12/2023 and 31/12/2022).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#accountsForUsingEquityMethod">
    <rdfs:label>accountsForUsingEquityMethod</rdfs:label>
    <rdfs:comment>The entity accounts for investments using the equity method for certain investees.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodAccounting"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestee"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodAccounting"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestment"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#allocationPayableAmount">
    <rdfs:label>allocationPayableAmount</rdfs:label>
    <rdfs:comment>Allocation payable amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AllocationPayable"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#preparedBy">
    <rdfs:label>preparedBy</rdfs:label>
    <rdfs:comment>Inverse of prepares: the consolidated financial statements are prepared by the company.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
