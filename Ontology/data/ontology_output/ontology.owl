  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherCommitmentGiven">
    <rdfs:label>OtherCommitmentGiven</rdfs:label>
    <rdfs:comment>Other commitments given.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitment"/>
  </owl:Class>
