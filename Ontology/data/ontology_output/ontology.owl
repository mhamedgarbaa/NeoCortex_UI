    <rdfs:comment>Indicates that the consolidated cash flow statement reports net cash flow from investing activities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#NetCashFlowFromInvestingActivities"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#publicationDate">
    <rdfs:label>publicationDate</rdfs:label>
    <rdfs:comment>Date when the green financing framework is published.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasNetCashFlow">
    <rdfs:label>hasNetCashFlow</rdfs:label>
    <rdfs:comment>Indicates that the consolidated cash flow section reports net cash flow measures.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#NetCashFlow"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Financier">
    <rdfs:label>Financier</rdfs:label>
    <rdfs:comment>A party providing financing in transactions, including co-investors and other financiers.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#fullAllocationTakesPlaceEachCalendarYear">
    <rdfs:label>fullAllocationTakesPlaceEachCalendarYear</rdfs:label>
    <rdfs:comment>Indicates that full allocation of net proceeds to eligible green loans takes place each calendar year.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GreenFinancingFramework"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#publishableIncomeStatementAmount">
    <rdfs:label>publishableIncomeStatementAmount</rdfs:label>
    <rdfs:comment>Numeric amount shown in the publishable income statement tables (values in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#legalBasisForProcessingLegalObligation">
    <rdfs:label>legalBasisForProcessingLegalObligation</rdfs:label>
    <rdfs:comment>Legal basis indicating processing is necessary to comply with a legal obligation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#LegalObligationLegalBasis"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternalAudit">
    <rdfs:label>InternalAudit</rdfs:label>
    <rdfs:comment>Internal review by the permanent control department ensuring compliance, audit trail existence, data quality, and first-level controls.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GreenFinancingCommittee">
    <rdfs:label>GreenFinancingCommittee</rdfs:label>
    <rdfs:comment>Governance committee responsible for verifying eligibility criteria, monitoring allocation of proceeds, and ensuring EU taxonomy alignment.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#remainingDividendPerShare">
    <rdfs:label>remainingDividendPerShare</rdfs:label>
    <rdfs:comment>The remaining dividend amount per share.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#includingGroupShare">
    <rdfs:label>includingGroupShare</rdfs:label>
    <rdfs:comment>Portion of net income and gains/losses directly recognised in equity attributable to the group.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#transferAmountToReserveOfNonRecyclableItems">
    <rdfs:label>transferAmountToReserveOfNonRecyclableItems</rdfs:label>
    <rdfs:comment>Amount transferred to reserves of non-recyclable items.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#allowsExerciseOfRight">
    <rdfs:label>allowsExerciseOfRight</rdfs:label>
    <rdfs:comment>Indicates individuals can exercise rights (access, rectification, deletion, portability, limitation, objection, etc.) via requests.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataRequest"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DataSubjectRights"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netOperatingIncomeAmount">
    <rdfs:label>netOperatingIncomeAmount</rdfs:label>
    <rdfs:comment>Net operating income amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingIncome"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetOperatingIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#rcsNumber">
    <rdfs:label>rcsNumber</rdfs:label>
    <rdfs:comment>Company registration number (RCS) stated in the document (e.g., 320 252 489 RCS CRETEIL).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netIncomeBeforeTaxAmount">
    <rdfs:label>netIncomeBeforeTaxAmount</rdfs:label>
    <rdfs:comment>Net income before tax amount for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasDirector">
    <rdfs:label>hasDirector</rdfs:label>
    <rdfs:comment>Indicates the board of directors includes directors whose terms end or are appointed/coopted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Director"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SMEPortfolioCompany">
    <rdfs:label>SMEPortfolioCompany</rdfs:label>
    <rdfs:comment>SME portfolio entity referenced in the capital structure chart.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompanySubsidiary"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasComplaintAuthority">
    <rdfs:label>hasComplaintAuthority</rdfs:label>
    <rdfs:comment>Indicates that a complaint authority is the CNIL for lodging complaints.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ComplaintAuthority"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CNIL"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ComplaintAuthority"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EPICBpifrance">
    <rdfs:label>EPICBpifrance</rdfs:label>
    <rdfs:comment>The EPIC Bpifrance public industrial and commercial institution responsible for missions including innovation support, SME financing support, and guarantees.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RegionalisedProgramme">
    <rdfs:label>RegionalisedProgramme</rdfs:label>
    <rdfs:comment>Regionalised implementation of PIA initiatives through regional agreements and steering committees.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestingInTheFutureProgramme"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TangibleFixedAsset">
    <rdfs:label>TangibleFixedAsset</rdfs:label>
    <rdfs:comment>Tangible fixed assets referenced in investing cash flows and depreciation.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#operatingDebtsAmount">
    <rdfs:label>operatingDebtsAmount</rdfs:label>
    <rdfs:comment>Total operating debts amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingDebts"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#incorporatesConsolidatedFinancialStatements">
    <rdfs:label>incorporatesConsolidatedFinancialStatements</rdfs:label>
    <rdfs:comment>The consolidated accounts incorporate the parent entity accounts (i.e., parent entity financial statements are included in consolidation).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ParentEntityFinancialStatements"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Client">
    <rdfs:label>Client</rdfs:label>
    <rdfs:comment>A counterparty receiving financing or subject to credit risk measurement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Control">
    <rdfs:label>Control</rdfs:label>
    <rdfs:comment>The condition under which the group is exposed to variable returns and can direct relevant activities to influence those returns.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidationPrinciple"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#UnemploymentInsuranceOrganization">
    <rdfs:label>UnemploymentInsuranceOrganization</rdfs:label>
    <rdfs:comment>An organization providing unemployment insurance that may receive information to finalize recruitment.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dpoPostalAddress">
    <rdfs:label>dpoPostalAddress</rdfs:label>
    <rdfs:comment>Postal address of the data protection officer used for contacting the organization.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataProtectionOfficer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicProcurementRules">
    <rdfs:label>PublicProcurementRules</rdfs:label>
    <rdfs:comment>The set of public procurement rules under which certain processing activities are carried out.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicProcurementCode"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendTotalAmount">
    <rdfs:label>dividendTotalAmount</rdfs:label>
    <rdfs:comment>Total dividend amount distributed (e.g., €440.7 million).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGovernanceBody">
    <rdfs:label>hasGovernanceBody</rdfs:label>
    <rdfs:comment>Indicates the institution has a governance body (e.g., governance framework including board and committees).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CyberattackRisk">
    <rdfs:label>CyberattackRisk</rdfs:label>
    <rdfs:comment>Risk of malicious or fraudulent acts using digital means to access stored data, including impacts from information system failures.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperationalRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AccountingAmendment">
    <rdfs:label>AccountingAmendment</rdfs:label>
    <rdfs:comment>An amendment to existing accounting standards or interpretations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AccountingStandard"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#exercisesSignificantInfluenceOver">
    <rdfs:label>exercisesSignificantInfluenceOver</rdfs:label>
    <rdfs:comment>Relates a group/public institution to an investee over which it has significant influence (but not control or joint control).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendDistributionDecreeDate">
    <rdfs:label>dividendDistributionDecreeDate</rdfs:label>
    <rdfs:comment>Date of the decree referenced for determining the dividend paid to the State.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistributionPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#capitalAndRelatedReserves">
    <rdfs:label>capitalAndRelatedReserves</rdfs:label>
    <rdfs:comment>Capital and related reserves amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholderEquity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EuropeanInvestmentBankGroup">
    <rdfs:label>EuropeanInvestmentBankGroup</rdfs:label>
    <rdfs:comment>EIB Group referenced as a partner providing financing in specific issues or strategic sectors.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Dispute">
    <rdfs:label>Dispute</rdfs:label>
    <rdfs:comment>A complaint or dispute arising from recruitment operations that may require retention of personal data until remedies expire.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#bpifranceCurrentAccountAmount">
    <rdfs:label>bpifranceCurrentAccountAmount</rdfs:label>
    <rdfs:comment>Bpifrance current account balance included in cash and cash equivalents (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CashAndCashEquivalents"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#fossilFuelParticipationShareUnit">
    <rdfs:label>fossilFuelParticipationShareUnit</rdfs:label>
    <rdfs:comment>Unit/interpretation of the fossil-fuel participation share (e.g., percentage of gross amounts invested).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#reserveFundAmount">
    <rdfs:label>reserveFundAmount</rdfs:label>
    <rdfs:comment>Reserve fund amount included in other financial assets (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAssets"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ReserveFund"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#WorldEconomicForum">
    <rdfs:label>WorldEconomicForum</rdfs:label>
    <rdfs:comment>An organization referenced as producing a report estimating dependence of GDP on nature services.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#shareholdersEquityAmount">
    <rdfs:label>shareholdersEquityAmount</rdfs:label>
    <rdfs:comment>Shareholders’ equity amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholdersEquity"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholderEquity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#reserveFund">
    <rdfs:label>reserveFund</rdfs:label>
    <rdfs:comment>Reserve fund amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAssets"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ReserveFund"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#identificationDataIdentityDocumentType">
    <rdfs:label>identificationDataIdentityDocumentType</rdfs:label>
    <rdfs:comment>Type of identity document (e.g., passport or national identity card).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#IdentificationData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteeCoverage">
    <rdfs:label>guaranteeCoverage</rdfs:label>
    <rdfs:comment>Guarantee coverage amount for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCoverage"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Guarantee"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentActivity">
    <rdfs:label>InvestmentActivity</rdfs:label>
    <rdfs:comment>Overall investment activity carried out by the group’s investment business lines.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentBusinessLine"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#includesCompanies">
    <rdfs:label>includesCompanies</rdfs:label>
    <rdfs:comment>Indicates that the consolidated financial statements include companies controlled or over which significant influence is exercised.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#taxUncertaintyAmount">
    <rdfs:label>taxUncertaintyAmount</rdfs:label>
    <rdfs:comment>Amount reflected in financial statements when a tax position is not expected to be accepted by tax authorities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#TaxUncertainty"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Tax"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#minorityInterestsResult">
    <rdfs:label>minorityInterestsResult</rdfs:label>
    <rdfs:comment>Minority interests result.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholderEquity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialIncomeFromInnovationAndIndustryFund">
    <rdfs:label>FinancialIncomeFromInnovationAndIndustryFund</rdfs:label>
    <rdfs:comment>Financial income from the Innovation and Industry Fund.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InterestAndSimilarIncome"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netCashFlowFromFinancingOperationsAmount">
    <rdfs:label>netCashFlowFromFinancingOperationsAmount</rdfs:label>
    <rdfs:comment>Net cash flow from financing operations amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetCashFlow"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SovereignWealthFund">
    <rdfs:label>SovereignWealthFund</rdfs:label>
    <rdfs:comment>Public investment role described for the organization as a sovereign wealth fund.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicEntity"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#operatingIncomeAfterShareOfNetIncomeFromEquityConsolidatedCompanies">
    <rdfs:label>operatingIncomeAfterShareOfNetIncomeFromEquityConsolidatedCompanies</rdfs:label>
    <rdfs:comment>Operating income after share of net income from equity-consolidated companies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BanquePubliqueDInvestissement">
    <rdfs:label>BanquePubliqueDInvestissement</rdfs:label>
    <rdfs:comment>The public investment bank/group that brings together business financing and development activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ForeignExchangeTransaction">
    <rdfs:label>ForeignExchangeTransaction</rdfs:label>
    <rdfs:comment>Forward foreign exchange transactions referenced for outstanding receivables and deliverables.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityFundingInstitution">
    <rdfs:label>EquityFundingInstitution</rdfs:label>
    <rdfs:comment>An institution providing equity funding referenced in guarantee coverage.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CreditInstitution"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#consolidatedNetIncome">
    <rdfs:label>consolidatedNetIncome</rdfs:label>
    <rdfs:comment>Net income amount reported on a consolidated basis for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonApplyingForPosition">
