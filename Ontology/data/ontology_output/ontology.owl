<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#submitsResolutionsToGeneralMeeting">
    <rdfs:label>submitsResolutionsToGeneralMeeting</rdfs:label>
    <rdfs:comment>Indicates that resolutions are submitted to the company’s general meeting(s).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GeneralMeeting"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#businessAddress">
    <rdfs:label>businessAddress</rdfs:label>
    <rdfs:comment>The business address of the director.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Director"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasCEO">
    <rdfs:label>hasCEO</rdfs:label>
    <rdfs:comment>Indicates the company has a CEO responsible for certification in the amendment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CEO"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#treasurySharesAssumptionDate">
    <rdfs:label>treasurySharesAssumptionDate</rdfs:label>
    <rdfs:comment>The date on which the treasury shares value assumption is made (date remaining dividend is paid).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#TreasuryShares"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#extraordinaryGeneralMeetingDate">
    <rdfs:label>extraordinaryGeneralMeetingDate</rdfs:label>
    <rdfs:comment>The date of the extraordinary general meeting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ExtraordinaryGeneralMeeting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#ordinaryGeneralMeetingDate">
    <rdfs:label>ordinaryGeneralMeetingDate</rdfs:label>
    <rdfs:comment>The date of the ordinary general meeting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OrdinaryGeneralMeeting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#termOfCurrentOfficeEndYear">
    <rdfs:label>termOfCurrentOfficeEndYear</rdfs:label>
    <rdfs:comment>The year in which the director’s current term of office is expected to end (when expressed as a year).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Director"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasCorporateGovernanceReport">
    <rdfs:label>hasCorporateGovernanceReport</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes a corporate governance report section.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CorporateGovernanceReport"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasMajorContract">
    <rdfs:label>hasMajorContract</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes information about major contracts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#MajorContract"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasAuditCommittee">
    <rdfs:label>hasAuditCommittee</rdfs:label>
    <rdfs:comment>Indicates the corporate governance report includes an audit committee.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateGovernanceReport"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#AuditCommittee"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasFinancialStatements">
    <rdfs:label>hasFinancialStatements</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRiskFactorsSection">
    <rdfs:label>hasRiskFactorsSection</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes a risk factors section.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RiskFactorsSection"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#implementsGuaranteeFund">
    <rdfs:label>implementsGuaranteeFund</rdfs:label>
    <rdfs:comment>Indicates the corporate object relates to implementing a guarantee fund for long-term electricity supply contracts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateObject"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GuaranteeFundImplementation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasCorporateObject">
    <rdfs:label>hasCorporateObject</rdfs:label>
    <rdfs:comment>Indicates the company’s corporate object is defined in the articles of association and may be amended.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ArticlesOfAssociation"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CorporateObject"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#remunerationTotalGrossAmount">
    <rdfs:label>remunerationTotalGrossAmount</rdfs:label>
    <rdfs:comment>Total gross remuneration amount approved for the financial year.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Remuneration"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#statementDate">
    <rdfs:label>statementDate</rdfs:label>
    <rdfs:comment>The date of the certification/statement by the CEO and Deputy CEO.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#financialYearEndDate">
    <rdfs:label>financialYearEndDate</rdfs:label>
    <rdfs:comment>The end date of the financial year referenced in the document.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialYear"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#registeredOfficeAddress">
    <rdfs:label>registeredOfficeAddress</rdfs:label>
    <rdfs:comment>The registered office address of the company.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#advancePaymentPaidDate">
    <rdfs:label>advancePaymentPaidDate</rdfs:label>
    <rdfs:comment>The date(s) on which the advance dividend was paid to shareholders.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#usesRenewableEnergy">
    <rdfs:label>usesRenewableEnergy</rdfs:label>
    <rdfs:comment>Indicates the corporate object relates to long-term electricity supplies using renewable energies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateObject"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RenewableEnergy"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRelatedPartyTransaction">
    <rdfs:label>hasRelatedPartyTransaction</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes information about related party transactions.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RelatedPartyTransaction"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#meetingDate">
    <rdfs:label>meetingDate</rdfs:label>
    <rdfs:comment>The date of the board meeting referenced in the document.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasPublicSectorInvestmentBankRole">
    <rdfs:label>hasPublicSectorInvestmentBankRole</rdfs:label>
    <rdfs:comment>Indicates the company’s object is that of a public sector investment bank.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateObject"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PublicSectorInvestmentBank"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#termExpiredDate">
    <rdfs:label>termExpiredDate</rdfs:label>
    <rdfs:comment>The date when the director’s term expired.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Director"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dateOfBirth">
    <rdfs:label>dateOfBirth</rdfs:label>
    <rdfs:comment>The director’s date of birth.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Director"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#remainingDividendPaidDate">
    <rdfs:label>remainingDividendPaidDate</rdfs:label>
    <rdfs:comment>The date when the remaining dividend is expected to be paid (if specified).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteeFundImplementationAnnouncementDate">
    <rdfs:label>guaranteeFundImplementationAnnouncementDate</rdfs:label>
    <rdfs:comment>The date of the government announcement entrusting implementation of the guarantee fund.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeFundImplementation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#advancePaymentDate">
    <rdfs:label>advancePaymentDate</rdfs:label>
    <rdfs:comment>The date on which the board decided the advance payment of the dividend.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendPerAction">
    <rdfs:label>dividendPerAction</rdfs:label>
    <rdfs:comment>Dividend unit amount per action (when stated).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#guaranteesCounterpartyRiskForLongTermElectricitySupply">
    <rdfs:label>guaranteesCounterpartyRiskForLongTermElectricitySupply</rdfs:label>
    <rdfs:comment>Indicates the corporate object includes guaranteeing counterparty risk for long-term electricity supplies using renewable energies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateObject"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#LongTermElectricitySupply"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicEndowment">
    <rdfs:label>PublicEndowment</rdfs:label>
    <rdfs:comment>Public endowments referenced as providing guarantee funds or reserves with exclusive counterparties.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasAmendment">
    <rdfs:label>hasAmendment</rdfs:label>
    <rdfs:comment>Indicates that the universal registration document can have associated amendments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#amendsUniversalRegistrationDocument">
        <rdfs:label>amendsUniversalRegistrationDocument</rdfs:label>
        <rdfs:comment>Indicates that the amendment updates a specific universal registration document.</rdfs:comment>
        <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
        <rdfs:range rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasPrincipalShareholder">
    <rdfs:label>hasPrincipalShareholder</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes information about principal shareholders.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#PrincipalShareholder"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#firstAppointmentDate">
    <rdfs:label>firstAppointmentDate</rdfs:label>
    <rdfs:comment>The date of the director’s first appointment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Director"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasDirector">
    <rdfs:label>hasDirector</rdfs:label>
    <rdfs:comment>Indicates the board of directors includes directors whose terms may end or be renewed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Director"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#guaranteesCounterpartyRisk">
    <rdfs:label>guaranteesCounterpartyRisk</rdfs:label>
    <rdfs:comment>Indicates the corporate object includes guaranteeing counterparty risk.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateObject"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CounterpartyRisk"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasEmployeesTrainingStatement">
    <rdfs:label>hasEmployeesTrainingStatement</rdfs:label>
    <rdfs:comment>Indicates the non-financial performance statement includes employees training information.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NonFinancialPerformanceStatement"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EmployeesTrainingStatement"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#capitalAmount">
    <rdfs:label>capitalAmount</rdfs:label>
    <rdfs:comment>The company’s issued capital amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasExtraordinaryGeneralMeeting">
    <rdfs:label>hasExtraordinaryGeneralMeeting</rdfs:label>
    <rdfs:comment>Indicates the company holds an extraordinary general meeting where extraordinary resolutions are considered.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ExtraordinaryGeneralMeeting"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGeneralManagement">
    <rdfs:label>hasGeneralManagement</rdfs:label>
    <rdfs:comment>Indicates the company has general management responsible for statements certified in the amendment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GeneralManagement"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#termOfCurrentOfficeEndDateText">
    <rdfs:label>termOfCurrentOfficeEndDateText</rdfs:label>
    <rdfs:comment>The textual description of the end of the director’s current term of office when not given as a specific date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Director"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasStatutoryAuditor">
    <rdfs:label>hasStatutoryAuditor</rdfs:label>
    <rdfs:comment>Indicates the company has statutory auditors whose reports are reviewed/approved by the general meeting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#availableOnInvestorRelationsWebsite">
    <rdfs:label>availableOnInvestorRelationsWebsite</rdfs:label>
    <rdfs:comment>Indicates the document is available on the company’s investor relations website.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InvestorRelationsWebsite"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#filedWithCompetentAuthority">
    <rdfs:label>filedWithCompetentAuthority</rdfs:label>
    <rdfs:comment>Indicates the amendment was filed with the competent authority (e.g., AMF).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CompetentAuthority"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasConsolidatedFinancialStatements">
    <rdfs:label>hasConsolidatedFinancialStatements</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes consolidated financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOrdinaryGeneralMeeting">
    <rdfs:label>hasOrdinaryGeneralMeeting</rdfs:label>
    <rdfs:comment>Indicates the company holds an ordinary general meeting where ordinary resolutions are considered.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OrdinaryGeneralMeeting"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasNonFinancialPerformanceStatement">
    <rdfs:label>hasNonFinancialPerformanceStatement</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes a non-financial performance statement section.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#NonFinancialPerformanceStatement"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#filingDate">
    <rdfs:label>filingDate</rdfs:label>
    <rdfs:comment>The date the amendment was filed with the competent authority (AMF).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#approvesAmendmentToUniversalRegistrationDocument">
    <rdfs:label>approvesAmendmentToUniversalRegistrationDocument</rdfs:label>
    <rdfs:comment>Indicates the competent authority approves the amendment to the universal registration document.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CompetentAuthority"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendAdvancePaymentPerShare">
    <rdfs:label>dividendAdvancePaymentPerShare</rdfs:label>
    <rdfs:comment>The advance dividend unit amount per share.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#treasurySharesCountAssumption">
    <rdfs:label>treasurySharesCountAssumption</rdfs:label>
    <rdfs:comment>The assumed number of shares entitled to dividends on the date of the general meeting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#TreasuryShares"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasArticlesOfAssociation">
    <rdfs:label>hasArticlesOfAssociation</rdfs:label>
    <rdfs:comment>Indicates the company has articles of association that can be proposed to be amended.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ArticlesOfAssociation"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#treasurySharesAssumedValue">
    <rdfs:label>treasurySharesAssumedValue</rdfs:label>
    <rdfs:comment>The assumed value of treasury shares used in the dividend allocation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#TreasuryShares"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRemunerationCommittee">
    <rdfs:label>hasRemunerationCommittee</rdfs:label>
    <rdfs:comment>Indicates the corporate governance report includes a remuneration committee.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateGovernanceReport"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RemunerationCommittee"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOrganisationalStructure">
    <rdfs:label>hasOrganisationalStructure</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes an organisational structure section.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OrganisationalStructure"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#remunerationFte">
    <rdfs:label>remunerationFte</rdfs:label>
    <rdfs:comment>The number of full-time equivalent (FTE) persons to whom remuneration relates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Remuneration"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#generalMeetingDate">
    <rdfs:label>generalMeetingDate</rdfs:label>
    <rdfs:comment>The date of the general meeting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GeneralMeeting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGuaranteeFund">
    <rdfs:label>hasGuaranteeFund</rdfs:label>
    <rdfs:comment>Indicates the corporate object involves guarantee funds.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateObject"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GuaranteeFund"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteeFundImplementationAnnouncementReference">
    <rdfs:label>guaranteeFundImplementationAnnouncementReference</rdfs:label>
    <rdfs:comment>Reference or description of the announcement related to guarantee fund implementation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeFundImplementation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#requiresSecuritiesNote">
    <rdfs:label>requiresSecuritiesNote</rdfs:label>
    <rdfs:comment>Indicates that use of the universal registration document for an offer/admission is completed by a securities note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SecuritiesNote"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasBoardOfDirectors">
    <rdfs:label>hasBoardOfDirectors</rdfs:label>
    <rdfs:comment>Indicates the company has a board of directors that determines proposals and updates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRegulatedMarket">
    <rdfs:label>hasRegulatedMarket</rdfs:label>
    <rdfs:comment>Indicates securities admission to trading occurs on a regulated market.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#SecuritiesAdmissionToTrading"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RegulatedMarket"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasLegalAndArbitrationProceedings">
    <rdfs:label>hasLegalAndArbitrationProceedings</rdfs:label>
    <rdfs:comment>Indicates the universal registration document includes information about legal and arbitration proceedings.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#LegalAndArbitrationProceedings"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#universalRegistrationDocumentReferenceNumber">
    <rdfs:label>universalRegistrationDocumentReferenceNumber</rdfs:label>
    <rdfs:comment>The reference number under which the 2022 Universal Registration Document was filed with the AMF.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasFinancialYear">
    <rdfs:label>hasFinancialYear</rdfs:label>
    <rdfs:comment>Indicates financial statements relate to a financial year.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancialYear"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#remainingDividendAmount">
    <rdfs:label>remainingDividendAmount</rdfs:label>
    <rdfs:comment>The total amount of the remaining dividend to be distributed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#universalRegistrationDocumentFilingDate">
    <rdfs:label>universalRegistrationDocumentFilingDate</rdfs:label>
    <rdfs:comment>The filing date of the referenced Universal Registration Document (2022 URD).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#mayIncludeSummaryDocument">
    <rdfs:label>mayIncludeSummaryDocument</rdfs:label>
    <rdfs:comment>Indicates that a summary document may be included when completing the universal registration document for an offer/admission.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SummaryDocument"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Regulation">
    <rdfs:label>Regulation</rdfs:label>
    <rdfs:comment>A legal instrument governing filings and approvals under EU securities regulation referenced in the text.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Guarantee">
    <rdfs:label>Guarantee</rdfs:label>
    <rdfs:comment>A financial guarantee activity referenced as part of the company object, including guarantees for repayment and counterparty risk.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasSpecialAuditorsReport">
    <rdfs:label>hasSpecialAuditorsReport</rdfs:label>
    <rdfs:comment>Indicates the company has a special statutory auditors report approved by the general meeting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SpecialAuditorsReport"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#approvesUniversalRegistrationDocument">
    <rdfs:label>approvesUniversalRegistrationDocument</rdfs:label>
    <rdfs:comment>Indicates the competent authority approves the universal registration document (and related amendments) under applicable regulation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CompetentAuthority"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <owl:inverseOf rdf:resource="https://talan.com/ontology/bpi#isApprovedByCompetentAuthority"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CorporateCustomer">
    <rdfs:label>CorporateCustomer</rdfs:label>
    <rdfs:comment>A business client referenced as benefiting from counterparty risk guarantees for long-term electricity supplies.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#tradeRegisterNumber">
    <rdfs:label>tradeRegisterNumber</rdfs:label>
    <rdfs:comment>The company’s trade and companies register (RCS) number.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#termEndedDate">
    <rdfs:label>termEndedDate</rdfs:label>
    <rdfs:comment>The date when the director’s term ended.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Director"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendRemainingDeterminedDate">
    <rdfs:label>dividendRemainingDeterminedDate</rdfs:label>
    <rdfs:comment>The date when the board determined the dividend remaining to be distributed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#termOfCurrentOfficeEndDate">
    <rdfs:label>termOfCurrentOfficeEndDate</rdfs:label>
    <rdfs:comment>The end date of the director’s current term of office.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Director"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendPerShare">
    <rdfs:label>dividendPerShare</rdfs:label>
    <rdfs:comment>Dividend unit amount per share (when stated for a distribution period).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#approvalDate">
    <rdfs:label>approvalDate</rdfs:label>
    <rdfs:comment>The date the amendment was approved/handled by the competent authority under the applicable regulation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#counterpartyRiskLongTermElectricitySupplyRenewableEnergies">
    <rdfs:label>counterpartyRiskLongTermElectricitySupplyRenewableEnergies</rdfs:label>
    <rdfs:comment>Indicates that the company’s object includes guaranteeing counterparty risk for long-term electricity supplies using renewable energies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#LongTermElectricitySupply"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#remainingDividendPerShare">
    <rdfs:label>remainingDividendPerShare</rdfs:label>
    <rdfs:comment>The remaining dividend unit amount per share.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#remunerationFinancialYearEndDate">
    <rdfs:label>remunerationFinancialYearEndDate</rdfs:label>
    <rdfs:comment>The end date of the financial year for which remuneration is reported.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Remuneration"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRemuneration">
    <rdfs:label>hasRemuneration</rdfs:label>
    <rdfs:comment>Indicates the corporate governance report includes remuneration information.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateGovernanceReport"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Remuneration"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasDeputyCEO">
    <rdfs:label>hasDeputyCEO</rdfs:label>
    <rdfs:comment>Indicates the company has a deputy CEO responsible for certification in the amendment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DeputyCEO"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isUsedForSecuritiesOffer">
    <rdfs:label>isUsedForSecuritiesOffer</rdfs:label>
    <rdfs:comment>Indicates the universal registration document may be used as part of a public securities offer.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SecuritiesOffer"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#profitAmount">
    <rdfs:label>profitAmount</rdfs:label>
    <rdfs:comment>The profit amount for the last financial year used for the proposed allocation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#dividendAdvancePaymentAmount">
    <rdfs:label>dividendAdvancePaymentAmount</rdfs:label>
    <rdfs:comment>The amount of the advance payment of the dividend.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isUsedForSecuritiesAdmissionToTrading">
    <rdfs:label>isUsedForSecuritiesAdmissionToTrading</rdfs:label>
    <rdfs:comment>Indicates the universal registration document may be used as part of securities admission to trading on a regulated market.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SecuritiesAdmissionToTrading"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#articlesOfAssociationAmendmentAuthorizedDate">
    <rdfs:label>articlesOfAssociationAmendmentAuthorizedDate</rdfs:label>
    <rdfs:comment>The date when the board authorized the preliminary modification to the articles of association.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGeneralReserve">
    <rdfs:label>hasGeneralReserve</rdfs:label>
    <rdfs:comment>Indicates the corporate object relies on general reserves constituted by shareholders.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#CorporateObject"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GeneralReserve"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#cooptationDate">
    <rdfs:label>cooptationDate</rdfs:label>
    <rdfs:comment>The date from which the director was coopted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Director"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Subsidiary">
    <rdfs:label>Subsidiary</rdfs:label>
    <rdfs:comment>An entity considered as part of the group, referenced as important subsidiaries in the organisational structure.</rdfs:comment>
  </owl:Class>
  <owl:Ontology rdf:about="https://talan.com/ontology/bpi"/>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AuditCommittee">
    <rdfs:label>AuditCommittee</rdfs:label>
    <rdfs:comment>An audit committee referenced in corporate governance annexes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeFund">
    <rdfs:label>GuaranteeFund</rdfs:label>
    <rdfs:comment>A fund provided or established to back or finance guarantees, referenced in the company object description.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OrganisationalStructure">
    <rdfs:label>OrganisationalStructure</rdfs:label>
    <rdfs:comment>A section describing the group’s organisational structure and important subsidiaries.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CorporateObject">
    <rdfs:label>CorporateObject</rdfs:label>
    <rdfs:comment>The company’s object/mission as defined in the articles of association, including proposed updates to clarify activities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LongTermElectricitySupply">
    <rdfs:label>LongTermElectricitySupply</rdfs:label>
    <rdfs:comment>Long-term electricity supply arrangements using renewable energies referenced in the updated company object.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExtraordinaryGeneralMeeting">
    <rdfs:label>ExtraordinaryGeneralMeeting</rdfs:label>
    <rdfs:comment>A type of general meeting with quorum and majority rules for extraordinary matters such as amending the articles of association.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GeneralMeeting"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SecuritiesAdmissionToTrading">
    <rdfs:label>SecuritiesAdmissionToTrading</rdfs:label>
    <rdfs:comment>Admission of securities to trading on a regulated market, supported by the universal registration document and related securities notes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ArticlesOfAssociation">
    <rdfs:label>ArticlesOfAssociation</rdfs:label>
    <rdfs:comment>The company’s constitutional document containing the object and other provisions, amended by shareholder resolutions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CorporateGovernanceReport">
    <rdfs:label>CorporateGovernanceReport</rdfs:label>
    <rdfs:comment>A report section within the universal registration document describing corporate governance information.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RenewableEnergy">
    <rdfs:label>RenewableEnergy</rdfs:label>
    <rdfs:comment>Renewable energies referenced as the basis for long-term electricity supply guarantees.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestorRelationsWebsite">
    <rdfs:label>InvestorRelationsWebsite</rdfs:label>
    <rdfs:comment>A website section used to make the amendment available to the general public.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LegalAndArbitrationProceedings">
    <rdfs:label>LegalAndArbitrationProceedings</rdfs:label>
    <rdfs:comment>Legal and arbitration proceedings referenced as part of additional information.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CEO">
    <rdfs:label>CEO</rdfs:label>
    <rdfs:comment>Chief executive officer role responsible for certifying information in the amendment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SummaryDocument">
    <rdfs:label>SummaryDocument</rdfs:label>
    <rdfs:comment>A summary document that may be required alongside the universal registration document for certain securities transactions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements">
    <rdfs:label>ConsolidatedFinancialStatements</rdfs:label>
    <rdfs:comment>Financial statements prepared on a consolidated basis for the group.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EmployeesTrainingStatement">
    <rdfs:label>EmployeesTrainingStatement</rdfs:label>
    <rdfs:comment>A non-financial performance subtopic focusing on employee training in AML/CFT and anti-corruption.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NonFinancialPerformanceStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#UniversalRegistrationDocument">
    <rdfs:label>UniversalRegistrationDocument</rdfs:label>
    <rdfs:comment>A universal registration document filed with a competent authority (AMF) and used as a base for securities offers or admissions to trading.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeFundImplementation">
    <rdfs:label>GuaranteeFundImplementation</rdfs:label>
    <rdfs:comment>The implementation of a guarantee fund entrusted by government to encourage long-term renewable electricity contracts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument">
    <rdfs:label>AmendmentToUniversalRegistrationDocument</rdfs:label>
    <rdfs:comment>An amendment to a universal registration document, filed with the competent authority and updating or replacing specific sections.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialStatements">
    <rdfs:label>FinancialStatements</rdfs:label>
    <rdfs:comment>Company financial statements including balance sheet, income statement, and appendix.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SpecialAuditorsReport">
    <rdfs:label>SpecialAuditorsReport</rdfs:label>
    <rdfs:comment>A special statutory auditors’ report on agreements referred to by the French Commercial Code.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Director">
    <rdfs:label>Director</rdfs:label>
    <rdfs:comment>A member of the board of directors, including directors representing regions or government and those appointed or coopted.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DeputyCEO">
    <rdfs:label>DeputyCEO</rdfs:label>
    <rdfs:comment>Deputy chief executive officer role responsible for certifying information in the amendment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GeneralMeeting">
    <rdfs:label>GeneralMeeting</rdfs:label>
    <rdfs:comment>A shareholders meeting (ordinary or extraordinary) that approves reports, financial statements, and resolutions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OrdinaryGeneralMeeting">
    <rdfs:label>OrdinaryGeneralMeeting</rdfs:label>
    <rdfs:comment>A type of general meeting with quorum and majority rules for ordinary business items such as approving financial statements and dividend distribution.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GeneralMeeting"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicLimitedCompany">
    <rdfs:label>PublicLimitedCompany</rdfs:label>
    <rdfs:comment>A company organized as a public limited company (société anonyme), referenced as having a specified capital amount and registered office.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RemunerationCommittee">
    <rdfs:label>RemunerationCommittee</rdfs:label>
    <rdfs:comment>A committee referenced in corporate governance annexes for remuneration matters.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskFactorsSection">
    <rdfs:label>RiskFactorsSection</rdfs:label>
    <rdfs:comment>A section of the universal registration document covering risk factors.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CompetentAuthority">
    <rdfs:label>CompetentAuthority</rdfs:label>
    <rdfs:comment>A regulatory body competent to approve or receive filings under applicable securities regulations (e.g., AMF).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StatutoryAuditor">
    <rdfs:label>StatutoryAuditor</rdfs:label>
    <rdfs:comment>An auditor referenced in relation to reports on company and consolidated accounts and special auditors’ reports on agreements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BoardOfDirectors">
    <rdfs:label>BoardOfDirectors</rdfs:label>
    <rdfs:comment>The board of directors that determines corporate actions (e.g., dividend distribution and proposed amendments) and updates drafts for resolutions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialYear">
    <rdfs:label>FinancialYear</rdfs:label>
    <rdfs:comment>A defined accounting period referenced for profits, financial statements, and dividend distribution.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DividendDistribution">
    <rdfs:label>DividendDistribution</rdfs:label>
    <rdfs:comment>The policy and process for distributing dividends, including advance payments and remaining dividends.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MajorContract">
    <rdfs:label>MajorContract</rdfs:label>
    <rdfs:comment>A significant contract referenced in the list of documents and major contracts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GeneralManagement">
    <rdfs:label>GeneralManagement</rdfs:label>
    <rdfs:comment>General management referenced in the corporate governance annexes and governance structure.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SecuritiesOffer">
    <rdfs:label>SecuritiesOffer</rdfs:label>
    <rdfs:comment>An offer to the public of securities, for which the universal registration document may be used when completed by additional notes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicSectorInvestmentBank">
    <rdfs:label>PublicSectorInvestmentBank</rdfs:label>
    <rdfs:comment>A type of company object described as a public sector investment bank facilitating access to financing and guarantees.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SecuritiesNote">
    <rdfs:label>SecuritiesNote</rdfs:label>
    <rdfs:comment>A document that, together with the universal registration document, enables an offer to the public or admission to trading.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TreasuryShares">
    <rdfs:label>TreasuryShares</rdfs:label>
    <rdfs:comment>Shares held by the company itself, referenced in assumptions affecting dividend amounts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CounterpartyRisk">
    <rdfs:label>CounterpartyRisk</rdfs:label>
    <rdfs:comment>The risk borne by a business client that is targeted by the company’s counterparty risk guarantees.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Remuneration">
    <rdfs:label>Remuneration</rdfs:label>
    <rdfs:comment>Remuneration paid to people referred to in the French Monetary and Financial Code, approved by shareholders.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NonFinancialPerformanceStatement">
    <rdfs:label>NonFinancialPerformanceStatement</rdfs:label>
    <rdfs:comment>A statement section covering non-financial performance, including training metrics for AML/CFT and anti-corruption.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GeneralReserve">
    <rdfs:label>GeneralReserve</rdfs:label>
    <rdfs:comment>General reserves constituted by shareholders referenced as a main source relied upon for guarantees.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PrincipalShareholder">
    <rdfs:label>PrincipalShareholder</rdfs:label>
    <rdfs:comment>A person holding significant direct or indirect voting rights in the issuer, referenced in annex headings.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RelatedPartyTransaction">
    <rdfs:label>RelatedPartyTransaction</rdfs:label>
    <rdfs:comment>Transactions between the issuer and related parties, referenced in annex headings.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RegulatedMarket">
    <rdfs:label>RegulatedMarket</rdfs:label>
    <rdfs:comment>A market for trading securities referenced as the context for admission to trading.</rdfs:comment>
  </owl:Class>
</rdf:RDF>
