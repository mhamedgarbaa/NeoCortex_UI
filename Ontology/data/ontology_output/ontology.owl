  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#providesFinancingThrough">
    <rdfs:label>providesFinancingThrough</rdfs:label>
    <rdfs:comment>Indicates that the group provides financing through its financing business line.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancingBusinessLine"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOtherDebts">
    <rdfs:label>hasOtherDebts</rdfs:label>
    <rdfs:comment>Indicates the institution has other debts (e.g., other public intervention resources, allocations payable, accrued expenses).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OtherDebt"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BankAccountInterestExpense">
    <rdfs:label>BankAccountInterestExpense</rdfs:label>
    <rdfs:comment>Interest expense on bank accounts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InterestAndSimilarExpense"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netIncomeMinorityInterests">
    <rdfs:label>netIncomeMinorityInterests</rdfs:label>
    <rdfs:comment>Net income attributable to minority interests.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#managedAssetsCurrency">
    <rdfs:label>managedAssetsCurrency</rdfs:label>
    <rdfs:comment>Currency used for managed assets amounts (e.g., EUR).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOffBalanceSheetCommitmentsReceived">
    <rdfs:label>hasOffBalanceSheetCommitmentsReceived</rdfs:label>
    <rdfs:comment>Indicates that the institution has off-balance-sheet commitments received (if applicable in the text).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitment"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitmentsReceived"/>
