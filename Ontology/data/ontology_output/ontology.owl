    <rdfs:comment>Indicates that cash flows are broken down by financing activities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancingActivities"/>
