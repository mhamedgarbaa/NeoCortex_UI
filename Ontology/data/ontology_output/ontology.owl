    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#smallCapAssetsUnderManagement">
    <rdfs:label>smallCapAssetsUnderManagement</rdfs:label>
    <rdfs:comment>Small Cap component of assets under management reported for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FundOfFundsBusiness"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialAssetSoldBookValue">
    <rdfs:label>FinancialAssetSoldBookValue</rdfs:label>
