  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRiskManagementPolicy">
    <rdfs:label>hasRiskManagementPolicy</rdfs:label>
    <rdfs:comment>Indicates that the group has a risk management policy governing risk management activities.</rdfs:comment>
