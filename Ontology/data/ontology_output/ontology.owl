    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingExpenditure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netCashFlowFromFinancingOperations">
