    <rdfs:comment>A semi-public company (SEM) referenced as generally excluded from investment, potentially subject to investment by another public entity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EBA">
    <rdfs:label>EBA</rdfs:label>
    <rdfs:comment>A regulatory body referenced for sustainability roadmap guidance on climate risk management.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#auditPeriodStartDate">
    <rdfs:label>auditPeriodStartDate</rdfs:label>
    <rdfs:comment>Start date of the period covered by the statutory auditor’s independence statement (e.g., 1 January 2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CleanTransportationProject">
    <rdfs:label>CleanTransportationProject</rdfs:label>
    <rdfs:comment>Projects for clean transportation and acquisition of clean vehicles/equipment.</rdfs:comment>
