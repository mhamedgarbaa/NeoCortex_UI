    <rdfs:label>MediaAndPollingOrganisation</rdfs:label>
    <rdfs:comment>An opinion media and polling organisation referenced as generally excluded to maintain neutrality and avoid conflicts of interest.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasSteeringCommittee">
    <rdfs:label>hasSteeringCommittee</rdfs:label>
    <rdfs:comment>Indicates that the group has steering committees for decision-making and oversight.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SteeringCommittee"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasEquityMethodAccounting">
    <rdfs:label>hasEquityMethodAccounting</rdfs:label>
    <rdfs:comment>Indicates that the half-year consolidated financial statements apply equity method accounting for some investments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodAccounting"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#provisionsAmount">
