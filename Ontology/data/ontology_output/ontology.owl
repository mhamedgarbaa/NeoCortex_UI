    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#processesPersonalDataOf">
    <rdfs:label>processesPersonalDataOf</rdfs:label>
    <rdfs:comment>Indicates that the data controller processes personal data of data subjects in the context described.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataController"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DataSubject"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#HeatMap">
    <rdfs:label>HeatMap</rdfs:label>
    <rdfs:comment>A risk visualization tool used to segment portfolios and identify homogeneous pockets of risk.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#operatingEarningsAmount">
    <rdfs:label>operatingEarningsAmount</rdfs:label>
    <rdfs:comment>Operating earnings amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OperatingIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MidCaps">
    <rdfs:label>MidCaps</rdfs:label>
    <rdfs:comment>Mid-sized companies targeted by support programs.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netIncomeBeforeIncomeFromDiscontinuedOperationsAmount">
    <rdfs:label>netIncomeBeforeIncomeFromDiscontinuedOperationsAmount</rdfs:label>
    <rdfs:comment>Net income before income from discontinued operations or those in the process of being sold.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OrganisationalChart">
    <rdfs:label>OrganisationalChart</rdfs:label>
    <rdfs:comment>Organisational chart artefact describing capital structure and organisational relationships.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#presentsDividendsPaidInCashFlowStatement">
    <rdfs:label>presentsDividendsPaidInCashFlowStatement</rdfs:label>
    <rdfs:comment>Dividends paid are presented as cash flow items in the cash flow statement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#JudicialData">
    <rdfs:label>JudicialData</rdfs:label>
    <rdfs:comment>Category of personal data relating to offences, convictions, or security measures within legal limits.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProcurementPlatform">
    <rdfs:label>ProcurementPlatform</rdfs:label>
    <rdfs:comment>A platform used for calls for tenders, downloading results, and associated studies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Platform"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ChangesInEquity">
    <rdfs:label>ChangesInEquity</rdfs:label>
    <rdfs:comment>A statement section describing movements in equity over time, including group share and minority interests.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Equity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AssetAndIntangiblesFinancing">
    <rdfs:label>AssetAndIntangiblesFinancing</rdfs:label>
    <rdfs:comment>Short-term financing of assets and intangibles.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancingActivity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExternalServiceProvider">
    <rdfs:label>ExternalServiceProvider</rdfs:label>
    <rdfs:comment>An external provider whose services may fail and create operational risk.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProspectIdentification">
    <rdfs:label>ProspectIdentification</rdfs:label>
    <rdfs:comment>Processing to identify prospects as part of pre-contractual and relationship management.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CollectionActions"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FraudRisk">
    <rdfs:label>FraudRisk</rdfs:label>
    <rdfs:comment>Risk of internal or external fraud, including unauthorized actions, embezzlement, and circumvention of rules or policies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperationalAndNonComplianceRisk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperationalRisk"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#appliesAccountingStandards">
    <rdfs:label>appliesAccountingStandards</rdfs:label>
    <rdfs:comment>Indicates that the consolidated financial statements are prepared in accordance with IFRS standards.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#IFRSStandard"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRelatedPartyTransaction">
    <rdfs:label>hasRelatedPartyTransaction</rdfs:label>
    <rdfs:comment>Indicates that related party transactions are disclosed in the consolidated financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RelatedPartyTransaction"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#UniversityPrograms">
    <rdfs:label>UniversityPrograms</rdfs:label>
    <rdfs:comment>Educational or training programs offered to entrepreneurs.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TreasuryTeam">
    <rdfs:label>TreasuryTeam</rdfs:label>
    <rdfs:comment>Organizational unit responsible for management of net proceeds and liquidity/earmarking processes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SocialAndSolidarityEconomyFund">
    <rdfs:label>SocialAndSolidarityEconomyFund</rdfs:label>
    <rdfs:comment>Funds geared towards profitable companies in the social and solidarity economy.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Investment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IndirectInvestment">
    <rdfs:label>IndirectInvestment</rdfs:label>
    <rdfs:comment>Equity investments made indirectly via funds referenced in the text.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityInvestmentActivity"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteeCommissionsToBeSpreadAmount">
    <rdfs:label>guaranteeCommissionsToBeSpreadAmount</rdfs:label>
    <rdfs:comment>Guarantee commissions to be spread amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommissionToBeSpread"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityInterestInTechnologyTransferAccelerationCompany">
    <rdfs:label>EquityInterestInTechnologyTransferAccelerationCompany</rdfs:label>
    <rdfs:comment>Equity interests in Technology Transfer Acceleration Companies (SATT).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityInvestments"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BpifranceAssuranceExport">
    <rdfs:label>BpifranceAssuranceExport</rdfs:label>
    <rdfs:comment>A subsidiary managing public export guarantees on behalf of and under control of the French State.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Subsidiary"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CreditInsurance">
    <rdfs:label>CreditInsurance</rdfs:label>
    <rdfs:comment>Credit insurance activity level referenced through guarantee applications accepted.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExportInsurance"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasMediumTermPlan">
    <rdfs:label>hasMediumTermPlan</rdfs:label>
    <rdfs:comment>Indicates that the group has a medium-term plan supporting transition and financing objectives.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#MediumTermPlan"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IntraGroupDisclosure">
    <rdfs:label>IntraGroupDisclosure</rdfs:label>
    <rdfs:comment>Disclosure of personal data to other entities within the same corporate group to meet legal/regulatory obligations or deploy systems.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalDataDisclosure"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#performsLimitedReviewOf">
    <rdfs:label>performsLimitedReviewOf</rdfs:label>
    <rdfs:comment>Indicates that statutory auditors perform a limited review of the consolidated financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#financialLoansAndFinancialDebtsAmount">
    <rdfs:label>financialLoansAndFinancialDebtsAmount</rdfs:label>
    <rdfs:comment>Amount of financial loans and financial debts (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialLoansAndFinancialDebts"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#directorDateOfBirth">
    <rdfs:label>directorDateOfBirth</rdfs:label>
    <rdfs:comment>The director’s date of birth.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Director"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IdentityCertificate">
    <rdfs:label>IdentityCertificate</rdfs:label>
    <rdfs:comment>A certificate used to evidence identity for legal obligations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityInvestmentFund">
    <rdfs:label>EquityInvestmentFund</rdfs:label>
    <rdfs:comment>An investment fund in which EPIC subscribes and invests (e.g., Deep Tech fund, National Seed Fund 3, Multicap Growth, EcoTech).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetworkingPrograms">
    <rdfs:label>NetworkingPrograms</rdfs:label>
    <rdfs:comment>Programs facilitating networking for entrepreneurs.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#totalRisksWeightedByType">
    <rdfs:label>totalRisksWeightedByType</rdfs:label>
    <rdfs:comment>Total amount of risks weighted by type reported for the period end dates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RiskExposure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TreasuryShares">
    <rdfs:label>TreasuryShares</rdfs:label>
    <rdfs:comment>Shares held by the company itself, affecting dividend allocation and retained earnings adjustments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Equity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRelatedParties">
    <rdfs:label>hasRelatedParties</rdfs:label>
    <rdfs:comment>Notes disclose related parties and related party transactions.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RelatedParty"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#UnallocatedProceeds">
    <rdfs:label>UnallocatedProceeds</rdfs:label>
    <rdfs:comment>Proceeds temporarily not allocated to eligible green loans, managed under liquidity management procedures.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Law">
    <rdfs:label>Law</rdfs:label>
    <rdfs:comment>A legal text referenced as the basis for responsible investment reporting requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#WorldTradeOrganisation">
    <rdfs:label>WorldTradeOrganisation</rdfs:label>
    <rdfs:comment>World Trade Organisation referenced for compliance of export guarantees.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteeCommitmentsAmount">
    <rdfs:label>guaranteeCommitmentsAmount</rdfs:label>
    <rdfs:comment>Total guarantee commitments amount as of the reporting date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExtraordinaryResolution">
    <rdfs:label>ExtraordinaryResolution</rdfs:label>
    <rdfs:comment>A resolution submitted to an extraordinary general meeting.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Resolution"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NonFinancialReportingDirective">
    <rdfs:label>NonFinancialReportingDirective</rdfs:label>
    <rdfs:comment>A directive referenced as requiring non-financial reporting and taxonomy-aligned disclosures.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FintechWithBankingOrInsuranceAuthorisations">
    <rdfs:label>FintechWithBankingOrInsuranceAuthorisations</rdfs:label>
    <rdfs:comment>A fintech that holds or is developing banking or insurance authorisations, enabling exceptional investment eligibility.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fintech"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinanceLeasing">
    <rdfs:label>FinanceLeasing</rdfs:label>
    <rdfs:comment>Finance leasing referenced as part of medium- and long-term financing.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Loan"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ForeignSubsidiary">
    <rdfs:label>ForeignSubsidiary</rdfs:label>
    <rdfs:comment>A subsidiary located outside France (not included in the detailed paragraph for major holdings).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Subsidiary"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasParentEntityFinancialStatements">
    <rdfs:label>hasParentEntityFinancialStatements</rdfs:label>
    <rdfs:comment>Parent entity financial statements are a type of financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ParentEntityFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ParentEntityFinancialStatements"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#creditFinancingCommitmentsReceivedFromCreditInstitutions">
    <rdfs:label>creditFinancingCommitmentsReceivedFromCreditInstitutions</rdfs:label>
    <rdfs:comment>Credit financing commitments received from credit institutions at the reporting date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StateLoanInterestExpense">
    <rdfs:label>StateLoanInterestExpense</rdfs:label>
    <rdfs:comment>Interest expense on State loans.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InterestAndSimilarExpense"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ClearingAgent">
    <rdfs:label>ClearingAgent</rdfs:label>
    <rdfs:comment>A financial intermediary whose interruption or malfunction can create operational risk.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasStrategicObjective">
    <rdfs:label>hasStrategicObjective</rdfs:label>
    <rdfs:comment>Links the bank to its strategic objective expressed through a climate plan context.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicSectorInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ClimatePlan"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EcosystemServices">
    <rdfs:label>EcosystemServices</rdfs:label>
    <rdfs:comment>Services provided by biodiversity that are referenced as relevant to business risks.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Startups">
    <rdfs:label>Startups</rdfs:label>
    <rdfs:comment>Early-stage companies targeted by accelerator and support programs.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RecruitmentProcess">
    <rdfs:label>RecruitmentProcess</rdfs:label>
    <rdfs:comment>The recruitment activities and procedures in which personal data is processed.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RelatedPartiesInformationNote">
    <rdfs:label>RelatedPartiesInformationNote</rdfs:label>
    <rdfs:comment>Note section providing information on related parties.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicLimitedCompanyOfRegionalAuthority">
    <rdfs:label>PublicLimitedCompanyOfRegionalAuthority</rdfs:label>
    <rdfs:comment>Public limited companies of regional authorities that may act by agreement in entrusting missions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RegionalAuthority"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#innovationGrants">
    <rdfs:label>innovationGrants</rdfs:label>
    <rdfs:comment>Innovation grants amount reported for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InnovationFinancingAid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FundInvestment">
    <rdfs:label>FundInvestment</rdfs:label>
    <rdfs:comment>An investment in a fund vehicle, including seed, growth, and industrial project funds referenced in off-balance sheet activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Investment"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#amountOfLoansTakenOut">
    <rdfs:label>amountOfLoansTakenOut</rdfs:label>
    <rdfs:comment>Total amount of loans taken out during the period (in €m).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Loans"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EntrepreneurshipAndRegions">
    <rdfs:label>EntrepreneurshipAndRegions</rdfs:label>
    <rdfs:comment>A business line referenced as part of the group’s activities under the “Other” item.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SupportSchool">
    <rdfs:label>SupportSchool</rdfs:label>
    <rdfs:comment>A support division ensuring and certifying coaching staff quality.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SupportDivision"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AuditEngagement">
    <rdfs:label>AuditEngagement</rdfs:label>
    <rdfs:comment>The engagement entrusted to statutory auditors to audit financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditors"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditorReport"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#legalBasisForProcessingElectronicSignatureProcess">
    <rdfs:label>legalBasisForProcessingElectronicSignatureProcess</rdfs:label>
    <rdfs:comment>Legal/operational basis for managing electronic signature and establishing evidence for reliability of the process.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ElectronicSignatureProcess"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ShareholderPartner">
    <rdfs:label>ShareholderPartner</rdfs:label>
    <rdfs:comment>A person who is a shareholder or partner in a company seeking or receiving financing/support.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Person"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasCreditRiskDepartment">
    <rdfs:label>hasCreditRiskDepartment</rdfs:label>
    <rdfs:comment>Indicates that the group has a credit risk department responsible for counter-analysis and credit risk control.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CreditRiskDepartment"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#personalDataCategoriesDescription">
    <rdfs:label>personalDataCategoriesDescription</rdfs:label>
    <rdfs:comment>Description of categories of personal data processed (e.g., identification, connection, banking and financial data).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataCategory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GeneralTermsAndConditions">
    <rdfs:label>GeneralTermsAndConditions</rdfs:label>
    <rdfs:comment>Contractual terms and conditions referenced for platforms and procurement-related use.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeCommissions">
    <rdfs:label>GuaranteeCommissions</rdfs:label>
    <rdfs:comment>Guarantee commissions referenced as financial income and deferred income.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialIncome"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CommissionNationaleDeLInformatiqueEtDesLibertes">
    <rdfs:label>CommissionNationaleDeLInformatiqueEtDesLibertes</rdfs:label>
    <rdfs:comment>A national data protection authority where individuals may lodge a complaint.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRelatedPartyTransactions">
    <rdfs:label>hasRelatedPartyTransactions</rdfs:label>
    <rdfs:comment>Indicates that the financial statements include transactions with related parties.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#RelatedPartyTransaction"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RegionalEconomicDevelopmentStrategy">
    <rdfs:label>RegionalEconomicDevelopmentStrategy</rdfs:label>
    <rdfs:comment>A regional economic development strategy referenced as a basis for consistency of strategic orientations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GreenFinancingInstrumentsUseOfProceedsProcess">
    <rdfs:label>GreenFinancingInstrumentsUseOfProceedsProcess</rdfs:label>
    <rdfs:comment>Process governing management of proceeds, earmarking, portfolio approach, and allocation to eligible green loans.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FrenchTechAccelerationUnit">
    <rdfs:label>FrenchTechAccelerationUnit</rdfs:label>
    <rdfs:comment>An investment unit supporting accelerators and accelerator investment funds.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentUnit"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OECD">
    <rdfs:label>OECD</rdfs:label>
    <rdfs:comment>OECD referenced for compliance of export guarantees.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExtraordinaryExpensesNote">
    <rdfs:label>ExtraordinaryExpensesNote</rdfs:label>
    <rdfs:comment>Note section dealing with extraordinary expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AllocationAndImpactReport">
    <rdfs:label>AllocationAndImpactReport</rdfs:label>
    <rdfs:comment>Annual reporting package describing allocation of proceeds and environmental impact metrics for eligible green loans categories.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#interestsToBeReceivedStateCurrentAccountAmount">
    <rdfs:label>interestsToBeReceivedStateCurrentAccountAmount</rdfs:label>
    <rdfs:comment>Interests to be received on the State current account (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OtherReceivables"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskTeam">
    <rdfs:label>RiskTeam</rdfs:label>
    <rdfs:comment>A team within the risk organization referenced as contributing FTEs to ESG-related work.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ESGWorkforce"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MarketplacePlayer">
    <rdfs:label>MarketplacePlayer</rdfs:label>
    <rdfs:comment>Role of bringing together financing partners for the benefit of companies.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#holdsEquityInvestmentInCompany">
    <rdfs:label>holdsEquityInvestmentInCompany</rdfs:label>
    <rdfs:comment>Indicates that equity investments can correspond to equity-method investees.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityInvestment"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodCompany"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IndustrialProjectsEquityBusinessLine">
    <rdfs:label>IndustrialProjectsEquityBusinessLine</rdfs:label>
    <rdfs:comment>An investment business line investing minority stakes in industrial project companies to support industrial sectors.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentBusinessLine"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#entrustsProgrammeTo">
    <rdfs:label>entrustsProgrammeTo</rdfs:label>
    <rdfs:comment>Indicates that EPIC entrusts programmes to operators within the Bpifrance group framework (EPIC as operator/manager).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#franceGreenNationGrantsReceivablesAmount">
    <rdfs:label>franceGreenNationGrantsReceivablesAmount</rdfs:label>
    <rdfs:comment>France Green Nation grants receivables amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FranceGreenNationGrantsReceivables"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConnectionData">
    <rdfs:label>ConnectionData</rdfs:label>
    <rdfs:comment>Category of personal data related to identification/authentication and online activity (e.g., IP address, logs).</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#loanMaturityDate">
    <rdfs:label>loanMaturityDate</rdfs:label>
    <rdfs:comment>Maturity date of a loan.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Loan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#deferredTaxIncomeOrExpense">
    <rdfs:label>deferredTaxIncomeOrExpense</rdfs:label>
    <rdfs:comment>Deferred tax income or expense amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Tax"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NationalPassport">
    <rdfs:label>NationalPassport</rdfs:label>
    <rdfs:comment>A passport-related personal data item used to evidence identity for legal obligations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquitySecurity">
    <rdfs:label>EquitySecurity</rdfs:label>
    <rdfs:comment>Equity instruments such as shares and equity holdings referenced in capital structure and equity-accounted companies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DividendsNote">
    <rdfs:label>DividendsNote</rdfs:label>
    <rdfs:comment>Note section dealing with dividends.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#offBalanceSheetCommitmentsReceivedGuaranteeCommitmentsAmount">
    <rdfs:label>offBalanceSheetCommitmentsReceivedGuaranteeCommitmentsAmount</rdfs:label>
    <rdfs:comment>Guarantee commitments received amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitmentsReceived"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialEstablishment">
    <rdfs:label>PublicIndustrialAndCommercialEstablishment</rdfs:label>
    <rdfs:comment>A public industrial and commercial establishment (EPIC) referenced as the consolidated financial reporting entity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ComplaintManagement">
    <rdfs:label>ComplaintManagement</rdfs:label>
    <rdfs:comment>A process for handling complaints under applicable regulatory frameworks.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#usesTrustedServiceProvider">
    <rdfs:label>usesTrustedServiceProvider</rdfs:label>
    <rdfs:comment>Indicates that the data controller uses a trusted service provider to implement electronic signature processes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataController"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#TrustedServiceProvider"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StrategicRisk">
    <rdfs:label>StrategicRisk</rdfs:label>
    <rdfs:comment>Risk related to changes in operating profits due to commercial/economic environment or technological disruption.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Risk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentProperty">
    <rdfs:label>InvestmentProperty</rdfs:label>
    <rdfs:comment>A property investment category referenced in the balance sheet classification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#rightToLimitationOfProcessing">
    <rdfs:label>rightToLimitationOfProcessing</rdfs:label>
    <rdfs:comment>Whether the policy states the right to request limitation of processing.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataSubjectRights"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#warInUkraineInvasionDate">
    <rdfs:label>warInUkraineInvasionDate</rdfs:label>
    <rdfs:comment>Date of the invasion of Ukraine referenced as a post balance sheet event.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#WarInUkraine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#QuasiEquity">
    <rdfs:label>QuasiEquity</rdfs:label>
    <rdfs:comment>A financing instrument category treated similarly to equity for investment and ESG purposes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentBusinessLine"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Investment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#JudicialProcedure">
    <rdfs:label>JudicialProcedure</rdfs:label>
    <rdfs:comment>A judicial process where personal data may be disclosed to authorities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PortfolioFixedSecurity">
    <rdfs:label>PortfolioFixedSecurity</rdfs:label>
    <rdfs:comment>Fixed securities held within the EDF portfolio as part of long-term investments in portfolio securities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#LongTermInvestmentInPortfolioSecurities"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CorporateIncomeTaxes">
    <rdfs:label>CorporateIncomeTaxes</rdfs:label>
    <rdfs:comment>Corporate income tax line item.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#preparedUnderResponsibilityOf">
    <rdfs:label>preparedUnderResponsibilityOf</rdfs:label>
    <rdfs:comment>Inverse of preparesFinancialStatements: the consolidated financial statements are prepared under the responsibility of the board of directors.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#preparesFinancialStatements">
        <rdfs:label>preparesFinancialStatements</rdfs:label>
        <rdfs:comment>Indicates that the board is responsible for preparing the consolidated financial statements.</rdfs:comment>
        <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
        <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RetirementOrganization">
    <rdfs:label>RetirementOrganization</rdfs:label>
    <rdfs:comment>An organization providing retirement-related coverage that may receive information to finalize recruitment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ClimateMaturityIndex">
    <rdfs:label>ClimateMaturityIndex</rdfs:label>
    <rdfs:comment>Index used to evaluate exposure and maturity of companies regarding green transition challenges.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#grossAmountInvestedMeasuredListedPF2020Keur">
    <rdfs:label>grossAmountInvestedMeasuredListedPF2020Keur</rdfs:label>
    <rdfs:comment>Gross amount invested for total listed portfolio measured in 2020 (K€).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Intermediary">
    <rdfs:label>Intermediary</rdfs:label>
    <rdfs:comment>A party involved in supplier referral chains (e.g., intermediaries) whose data may be processed.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentMemo">
    <rdfs:label>InvestmentMemo</rdfs:label>
    <rdfs:comment>A document including ESG analysis results presented to the investment committee as part of company evaluation.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationSupport">
    <rdfs:label>InnovationSupport</rdfs:label>
    <rdfs:comment>Support for innovation and technological innovation referenced as a core mission.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DivestmentTransaction">
    <rdfs:label>DivestmentTransaction</rdfs:label>
    <rdfs:comment>A transaction involving completion of divestment, including analysis of exit opportunities and selection of buyers.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#interestExpense">
    <rdfs:label>interestExpense</rdfs:label>
    <rdfs:comment>Interest expense amount for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InterestExpense"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ClimatePlanCoordinationTeam">
    <rdfs:label>ClimatePlanCoordinationTeam</rdfs:label>
    <rdfs:comment>A team coordinating climate plan activities within the ESG workforce.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ESGWorkforce"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EnergyEnvironmentProjectFinancing">
    <rdfs:label>EnergyEnvironmentProjectFinancing</rdfs:label>
    <rdfs:comment>Financing activity for energy/environment projects.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancingActivity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#VerySmallEnterprise">
    <rdfs:label>VerySmallEnterprise</rdfs:label>
    <rdfs:comment>Very small enterprises supported through public interest missions and financing/guarantee tools.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Company"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DataTransferOutsideEuropeanUnion">
    <rdfs:label>DataTransferOutsideEuropeanUnion</rdfs:label>
    <rdfs:comment>A processing context involving transfer of personal data outside the European Union under GDPR mechanisms.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentBranch">
    <rdfs:label>InvestmentBranch</rdfs:label>
    <rdfs:comment>A business unit responsible for managing investments under a responsible investor approach.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Donor">
    <rdfs:label>Donor</rdfs:label>
    <rdfs:comment>An entity providing funding/support and receiving statistics/reporting where appropriate.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BpifranceFinancement">
    <rdfs:label>BpifranceFinancement</rdfs:label>
    <rdfs:comment>An entity referenced as the subsidiary absorbing the holding company and involved in the group structure.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOperatingActivities">
    <rdfs:label>hasOperatingActivities</rdfs:label>
    <rdfs:comment>Indicates that cash flows are broken down by operating activities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OperatingActivities"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LegitimateInterest">
    <rdfs:label>LegitimateInterest</rdfs:label>
    <rdfs:comment>A legal basis where processing is justified by the controller’s legitimate interests.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#LegalBasisForProcessing"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EligibleGreenLoansPortfolio">
    <rdfs:label>EligibleGreenLoansPortfolio</rdfs:label>
    <rdfs:comment>Portfolio of eligible green loans managed dynamically by adding/removing loans over the life of green financing instruments.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#advanceDividendPerShare">
    <rdfs:label>advanceDividendPerShare</rdfs:label>
    <rdfs:comment>The advance dividend amount per share.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SustainableFinanceMarket">
    <rdfs:label>SustainableFinanceMarket</rdfs:label>
    <rdfs:comment>Market for sustainable finance that the framework aims to develop, especially for SMEs.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentInFundsOfFunds">
    <rdfs:label>InvestmentInFundsOfFunds</rdfs:label>
    <rdfs:comment>Indirect equity investment via funds of funds referenced in the text.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityInvestmentActivity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOffBalanceSheetCommitmentGiven">
    <rdfs:label>hasOffBalanceSheetCommitmentGiven</rdfs:label>
    <rdfs:comment>Indicates the institution has commitments given (e.g., financing, guarantee, and securities commitments given).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitmentsGiven"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BondProgramme">
    <rdfs:label>BondProgramme</rdfs:label>
    <rdfs:comment>Programme under which bonds are issued (e.g., EMTN programmes, NEU MTN/CP programmes).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DebtSecurity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#KeyBiodiversityArea">
    <rdfs:label>KeyBiodiversityArea</rdfs:label>
    <rdfs:comment>A biodiversity mapping concept used to identify sites and activities linked to biodiversity importance.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#parentEntityFinancialYearEndDate">
    <rdfs:label>parentEntityFinancialYearEndDate</rdfs:label>
    <rdfs:comment>Reporting date for the parent entity financial statements (e.g., 31 December 2023).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ParentEntityFinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#usesClimateKit">
    <rdfs:label>usesClimateKit</rdfs:label>
    <rdfs:comment>Indicates that the group uses a Climate Kit to communicate ESG practices and related information to invested funds/companies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ClimateKit"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FrenchOrEuropeanAuthority">
    <rdfs:label>FrenchOrEuropeanAuthority</rdfs:label>
    <rdfs:comment>A generic class for French or European authorities that may receive personal data in proceedings.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#netInterestMargin">
    <rdfs:label>netInterestMargin</rdfs:label>
    <rdfs:comment>Net interest margin (if disclosed in the document).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetInterestMargin"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LongTermInvestmentsInPortfolioSecuritiesNote">
    <rdfs:label>LongTermInvestmentsInPortfolioSecuritiesNote</rdfs:label>
    <rdfs:comment>Note section detailing long-term investments in portfolio securities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TLTROProgramme">
    <rdfs:label>TLTROProgramme</rdfs:label>
    <rdfs:comment>A refinancing framework referenced as medium-term refinancing from the European Central Bank.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentProgramme"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#certificationOfAccountsFees">
    <rdfs:label>certificationOfAccountsFees</rdfs:label>
    <rdfs:comment>Fees for certification of accounts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#includesControlledCompanies">
    <rdfs:label>includesControlledCompanies</rdfs:label>
    <rdfs:comment>Indicates that consolidated financial statements include companies the group controls (subsidiaries).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Subsidiary"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AdministrativeBodyMember">
    <rdfs:label>AdministrativeBodyMember</rdfs:label>
    <rdfs:comment>A member of administrative bodies referenced for compensation disclosures.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PreContractualDocumentation">
    <rdfs:label>PreContractualDocumentation</rdfs:label>
    <rdfs:comment>Pre-contractual legal documentation negotiated and signed in the context of investments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Transaction"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentSubsidiary">
    <rdfs:label>InvestmentSubsidiary</rdfs:label>
    <rdfs:comment>Investment-related subsidiary referenced in the capital structure chart (e.g., investment holding/vehicle).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompanySubsidiary"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EntrepreneurshipAndRegionsBusinessLine">
    <rdfs:label>EntrepreneurshipAndRegionsBusinessLine</rdfs:label>
    <rdfs:comment>A business line supporting entrepreneurship and regional activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InternationalBusiness"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DebtPortfolio">
    <rdfs:label>DebtPortfolio</rdfs:label>
    <rdfs:comment>A portfolio of debt instruments whose value can be reduced by adverse credit-quality impacts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BankFinancing">
    <rdfs:label>BankFinancing</rdfs:label>
    <rdfs:comment>Financing provided by banks that may be supported by guarantees and insurance.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#UniversalRegistrationDocument">
    <rdfs:label>UniversalRegistrationDocument</rdfs:label>
    <rdfs:comment>A universal registration document filed with a financial markets authority and used for offering financial securities to the public or admitting them to trading on a regulated market.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherReceivables">
    <rdfs:label>OtherReceivables</rdfs:label>
    <rdfs:comment>Receivables other than cash and cash equivalents.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CurrentAssets"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BusinessSupportBusinessLine">
    <rdfs:label>BusinessSupportBusinessLine</rdfs:label>
    <rdfs:comment>A business line providing advice, training, networking and support services for business growth.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CashFlowTable">
    <rdfs:label>CashFlowTable</rdfs:label>
    <rdfs:comment>Cash flow table included in the notes/appendix of financial reporting.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeCommission">
    <rdfs:label>GuaranteeCommission</rdfs:label>
    <rdfs:comment>Guarantee commissions, including commissions to be spread and guarantee commissions for issues.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AntiCorruptionCompliance">
    <rdfs:label>AntiCorruptionCompliance</rdfs:label>
    <rdfs:comment>A compliance domain referenced as part of legal texts governing responsible investment policy.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DueDiligence"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ClimateAndEnvironmentalRiskManagementCommittee">
    <rdfs:label>ClimateAndEnvironmentalRiskManagementCommittee</rdfs:label>
    <rdfs:comment>Dedicated committee incorporated to manage climate and environmental risk governance.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentFund">
    <rdfs:label>InvestmentFund</rdfs:label>
    <rdfs:comment>A fund vehicle referenced as being subscribed to and managed within the Bpifrance group (e.g., FNA 3).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFund"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialProgramme"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TaxAndDuties">
    <rdfs:label>TaxAndDuties</rdfs:label>
    <rdfs:comment>Taxes and duties and similar payments included in operating expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingExpense"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalDataProcessing">
    <rdfs:label>PersonalDataProcessing</rdfs:label>
    <rdfs:comment>The processing activities performed on personal data in the context described by the policy.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ROE">
    <rdfs:label>ROE</rdfs:label>
    <rdfs:comment>Return on equity metric evaluated using net income and shareholder’s equity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityInvestment">
    <rdfs:label>EquityInvestment</rdfs:label>
    <rdfs:comment>An investment in equity instruments, including those measured at fair value through equity or through profit or loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentBusinessLine"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Investment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GDPR">
    <rdfs:label>GDPR</rdfs:label>
    <rdfs:comment>The European General Data Protection Regulation governing processing of personal data.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExpenseRatio">
    <rdfs:label>ExpenseRatio</rdfs:label>
    <rdfs:comment>Ratio comparing operating expenditure to assets under management for the investment business.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SeedFund">
    <rdfs:label>SeedFund</rdfs:label>
    <rdfs:comment>A fund category focused on seed-stage investments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidatedGroup">
    <rdfs:label>ConsolidatedGroup</rdfs:label>
    <rdfs:comment>The group whose consolidated financial statements include entities controlled or significantly influenced.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Impairment">
    <rdfs:label>Impairment</rdfs:label>
    <rdfs:comment>An impairment concept applied to assets (including goodwill and equity-accounted investments) when objective evidence exists.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LiquidityPosition">
    <rdfs:label>LiquidityPosition</rdfs:label>
    <rdfs:comment>Liquidity strength assessed against prudential requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DerecognitionOfFinancialLiabilities">
    <rdfs:label>DerecognitionOfFinancialLiabilities</rdfs:label>
    <rdfs:comment>Accounting treatment for removing financial liabilities when obligations are extinguished, cancelled, or expire.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentBusinessLine">
    <rdfs:label>InvestmentBusinessLine</rdfs:label>
    <rdfs:comment>Business line grouping investment activities structured into capital development, fund of funds, and innovation capital.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeScheme">
    <rdfs:label>GuaranteeScheme</rdfs:label>
    <rdfs:comment>Guarantee mechanisms and commitments described as part of EPIC Bpifrance’s missions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeCommissionToBeSpread">
    <rdfs:label>GuaranteeCommissionToBeSpread</rdfs:label>
    <rdfs:comment>Bpifrance guarantee commissions to be spread included in deferred income.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DeferredIncome"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ClimateRisk">
    <rdfs:label>ClimateRisk</rdfs:label>
    <rdfs:comment>Risk arising from climate-related factors and constraints affecting borrowers and credit quality.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EcosystemRelatedRisk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ESGRisk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Tax">
    <rdfs:label>Tax</rdfs:label>
    <rdfs:comment>Current and deferred tax concepts used in income statement and equity recognition.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SecuritiesSummary">
    <rdfs:label>SecuritiesSummary</rdfs:label>
    <rdfs:comment>A summary document that may accompany a securities note and universal registration document.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LoanCommitment">
    <rdfs:label>LoanCommitment</rdfs:label>
    <rdfs:comment>Commitments related to loan financing (including commitments given/received).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskFactors">
    <rdfs:label>RiskFactors</rdfs:label>
    <rdfs:comment>A section describing risk factors relevant to the issuer.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancingMechanism">
    <rdfs:label>FinancingMechanism</rdfs:label>
    <rdfs:comment>A structured program or mechanism through which financing/support is provided and administered.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityConsolidatedCompanyShareOfNetProfit">
    <rdfs:label>EquityConsolidatedCompanyShareOfNetProfit</rdfs:label>
    <rdfs:comment>Share of net profit from equity-consolidated companies presented in the income statement.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Transaction">
    <rdfs:label>Transaction</rdfs:label>
    <rdfs:comment>A general category of investment-related activities such as contractualization, divestment, and due diligence.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperationalAndNonComplianceRisk">
    <rdfs:label>OperationalAndNonComplianceRisk</rdfs:label>
    <rdfs:comment>Risk of loss from inadequate internal processes or external events, including non-compliance and model risk.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Risk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidatedProfitAndLossStatement">
    <rdfs:label>ConsolidatedProfitAndLossStatement</rdfs:label>
    <rdfs:comment>Consolidated profit and loss statement including net banking income and net income.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GrantReceivable">
    <rdfs:label>GrantReceivable</rdfs:label>
    <rdfs:comment>Receivables for grants to be received from the State.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherReceivable"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialLiability">
    <rdfs:label>FinancialLiability</rdfs:label>
    <rdfs:comment>A financial obligation (e.g., debts, trade debts, other financial liabilities) recognized and measured under IFRS rules.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternationalAccountingStandard">
    <rdfs:label>InternationalAccountingStandard</rdfs:label>
    <rdfs:comment>International Accounting Standards (IAS) referenced as part of the IFRS framework.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AccountingStandard"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SolvencyAndLiquidityStatus">
    <rdfs:label>SolvencyAndLiquidityStatus</rdfs:label>
    <rdfs:comment>A status assessment covering solvency and liquidity ratios.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#UnsecuredLoan">
    <rdfs:label>UnsecuredLoan</rdfs:label>
    <rdfs:comment>Loans provided without guarantee or security against the company or its managers.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Loan"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialAssetAtFairValueThroughEquity">
    <rdfs:label>FinancialAssetAtFairValueThroughEquity</rdfs:label>
    <rdfs:comment>A category of financial assets measured at fair value with changes recognized in equity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValueLevel2">
    <rdfs:label>FairValueLevel2</rdfs:label>
    <rdfs:comment>Fair value determined using observable market data and valuation techniques with observable parameters.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchyLevel"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExpectedRisks">
    <rdfs:label>ExpectedRisks</rdfs:label>
    <rdfs:comment>Cost of risk component related to expected cost of risk and provisions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CostOfRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TradeReceivable">
    <rdfs:label>TradeReceivable</rdfs:label>
    <rdfs:comment>Receivables arising from trade and other receivable categories, including grants and guarantee commissions to be received.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CounterTerroristFinancing">
    <rdfs:label>CounterTerroristFinancing</rdfs:label>
    <rdfs:comment>Compliance activities aimed at countering the financing of terrorism.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DueDiligence"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MediumTermPlan">
    <rdfs:label>MediumTermPlan</rdfs:label>
    <rdfs:comment>A medium-term plan referenced as a mechanism to support ecological and energy transition solutions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TradePayablesAndRelatedAccounts">
    <rdfs:label>TradePayablesAndRelatedAccounts</rdfs:label>
    <rdfs:comment>Trade payables and related accounts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingDebts"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DataProcessingActivity">
    <rdfs:label>DataProcessingActivity</rdfs:label>
    <rdfs:comment>An activity involving collection, processing, retention, disclosure, and management of personal data.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BpifranceGroupEntity">
    <rdfs:label>BpifranceGroupEntity</rdfs:label>
    <rdfs:comment>An entity within the Bpifrance group that may receive personal data for commercial prospecting or legal/regulatory obligations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ServiceAgreement">
    <rdfs:label>ServiceAgreement</rdfs:label>
    <rdfs:comment>Service agreements concluded between entities for management or support activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Agreement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialLiabilityAtFairValueThroughProfitOrLoss">
    <rdfs:label>FinancialLiabilityAtFairValueThroughProfitOrLoss</rdfs:label>
    <rdfs:comment>A category of financial liabilities measured at fair value with changes recognized in profit or loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLiability"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AntiCorruptionProcess">
    <rdfs:label>AntiCorruptionProcess</rdfs:label>
    <rdfs:comment>Due diligence and checks to counter corruption.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DueDiligenceProcess"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SecuritiesRemainingToBeReleased">
    <rdfs:label>SecuritiesRemainingToBeReleased</rdfs:label>
    <rdfs:comment>Securities remaining to be released to funds referenced in debts on fixed assets and related accounts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingDebts"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DebtOnFixedAssetsAndRelatedAccounts"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeBusinessLine">
    <rdfs:label>GuaranteeBusinessLine</rdfs:label>
    <rdfs:comment>A business line providing guarantees to encourage lending to SMEs and other supported entities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Equity">
    <rdfs:label>Equity</rdfs:label>
    <rdfs:comment>Shareholders’ equity, including components such as reserves and gains/losses recognized directly in equity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperationalRisk">
    <rdfs:label>OperationalRisk</rdfs:label>
    <rdfs:comment>Risk categories related to operational activities, including cyberattacks, fraud, non-compliance, pandemic impacts, and damage to physical assets or information systems.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RiskFactor"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Risk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ParentEntityFinancialStatementsAuditReport">
    <rdfs:label>ParentEntityFinancialStatementsAuditReport</rdfs:label>
    <rdfs:comment>Statutory auditor report on the parent entity financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditorReport"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeCoverage">
    <rdfs:label>GuaranteeCoverage</rdfs:label>
    <rdfs:comment>Coverage provided to banks and equity funding institutions against default risks of funding recipients.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Guarantee"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExtraordinaryExpenses">
    <rdfs:label>ExtraordinaryExpenses</rdfs:label>
    <rdfs:comment>Expense items classified as extraordinary, such as book values of assets sold.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CashAndCashEquivalent">
    <rdfs:label>CashAndCashEquivalent</rdfs:label>
    <rdfs:comment>Cash and cash equivalents, including bank accounts and current accounts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GainsAndLossesRecognisedDirectlyInEquity">
    <rdfs:label>GainsAndLossesRecognisedDirectlyInEquity</rdfs:label>
    <rdfs:comment>Components of income and losses recognized directly in equity rather than through profit or loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Equity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ContractPerformanceLegalBasis">
    <rdfs:label>ContractPerformanceLegalBasis</rdfs:label>
    <rdfs:comment>A legal basis for processing personal data based on performance of a contract.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MarketPriceRisk">
    <rdfs:label>MarketPriceRisk</rdfs:label>
    <rdfs:comment>Risk of loss due to changes in market prices and rates.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TrainingPlatform">
    <rdfs:label>TrainingPlatform</rdfs:label>
    <rdfs:comment>An online platform providing short targeted courses and training modules for ESG/climate awareness.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AccruedExpense">
    <rdfs:label>AccruedExpense</rdfs:label>
    <rdfs:comment>Accrued expenses included in other debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherDebt"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityMethodAccounting">
    <rdfs:label>EquityMethodAccounting</rdfs:label>
    <rdfs:comment>Accounting approach referenced as equity-accounting method used in consolidated financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompanies"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StateCurrentAccountInnovationCapital">
    <rdfs:label>StateCurrentAccountInnovationCapital</rdfs:label>
    <rdfs:comment>Expendable cash from the Innovation and Industry Fund held in the State current account via Agence France Trésor Innovation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CurrentAccount"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetworkDirectorate">
    <rdfs:label>NetworkDirectorate</rdfs:label>
    <rdfs:comment>A network directorate grouping regional directorates.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChartOfNetwork"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherDebt">
    <rdfs:label>OtherDebt</rdfs:label>
    <rdfs:comment>A residual category of debts other than trade debts and tax/social security debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Debt"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLiability"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationCapital">
    <rdfs:label>InnovationCapital</rdfs:label>
    <rdfs:comment>Innovation Capital current account interest referenced in financial income/tax note.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherReceivables"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FrenchTechSovereigntyActivity">
    <rdfs:label>FrenchTechSovereigntyActivity</rdfs:label>
    <rdfs:comment>French Tech Sovereignty activity representing equity interests in companies developing future technologies on behalf of the French State.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ActivitiesOnBehalfOfThirdParties"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ThirdPartyActivity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PrivacyPolicy">
    <rdfs:label>PrivacyPolicy</rdfs:label>
    <rdfs:comment>A document setting out rules for processing personal data collected as part of a recruitment process.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetBankingIncome">
    <rdfs:label>NetBankingIncome</rdfs:label>
    <rdfs:comment>Aggregate banking income metric used in the income statement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentCommittee">
    <rdfs:label>InvestmentCommittee</rdfs:label>
    <rdfs:comment>A committee bringing together subscribers or stakeholders for governance and related administrative activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CreditRiskIncreaseAssessment">
    <rdfs:label>CreditRiskIncreaseAssessment</rdfs:label>
    <rdfs:comment>Assessment process for determining significant increase in credit risk for ECL staging.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExpectedCreditLossCalculation"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EuropeanCentralBank">
    <rdfs:label>EuropeanCentralBank</rdfs:label>
    <rdfs:comment>European Central Bank referenced as a source of refinancing via monetary policy programmes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CentralBank"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DataController">
    <rdfs:label>DataController</rdfs:label>
    <rdfs:comment>The entity that determines the purposes and means of processing personal data in the recruitment context.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StateShareholdingEntity">
    <rdfs:label>StateShareholdingEntity</rdfs:label>
    <rdfs:comment>An entity representing the French State’s shareholding and governance role in companies (e.g., shareholding agency context).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublishableIncomeStatement">
    <rdfs:label>PublishableIncomeStatement</rdfs:label>
    <rdfs:comment>A publishable income statement (income statement) section of financial reporting.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ParentEntityFinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Platform">
    <rdfs:label>Platform</rdfs:label>
    <rdfs:comment>An online platform used for procurement and/or user account and access management.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SignatureCommitment">
    <rdfs:label>SignatureCommitment</rdfs:label>
    <rdfs:comment>Commitments issued by the group under financed contracts, including sureties and first-demand guarantees.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationAndIndustryFundReceivables">
    <rdfs:label>InnovationAndIndustryFundReceivables</rdfs:label>
    <rdfs:comment>Receivables related to the Innovation and Industry Fund included in other financial assets.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAssets"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestingActivities">
    <rdfs:label>InvestingActivities</rdfs:label>
    <rdfs:comment>Cash flows related to acquisition and disposal of investments and other investment operations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CashFlowStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityInvestmentActivity">
    <rdfs:label>EquityInvestmentActivity</rdfs:label>
    <rdfs:comment>An activity involving equity investments, including direct investments and fund-based investments.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidationPrinciple">
    <rdfs:label>ConsolidationPrinciple</rdfs:label>
    <rdfs:comment>A rule describing how entities are included in consolidation based on control, joint control, or significant influence.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperatingActivities">
    <rdfs:label>OperatingActivities</rdfs:label>
    <rdfs:comment>Cash flows generated by the business’s revenue-generating activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CashFlowStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Subsidiary">
    <rdfs:label>Subsidiary</rdfs:label>
    <rdfs:comment>An entity controlled by the group, consolidated using full consolidation when complete control is exercised.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SegmentReporting">
    <rdfs:label>SegmentReporting</rdfs:label>
    <rdfs:comment>Disclosure of contributions within the group by sector/segment.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatementNote"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StatutoryAuditors">
    <rdfs:label>StatutoryAuditors</rdfs:label>
    <rdfs:comment>Auditors responsible for auditing consolidated and annual financial statements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OrganizationalChart">
    <rdfs:label>OrganizationalChart</rdfs:label>
    <rdfs:comment>An organizational chart describing organizational structure.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MonetaryPolicyProgramme">
    <rdfs:label>MonetaryPolicyProgramme</rdfs:label>
    <rdfs:comment>Monetary policy refinancing programmes (e.g., TLTRO) referenced as funding sources.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#JointControl">
    <rdfs:label>JointControl</rdfs:label>
    <rdfs:comment>Contractual sharing of control over a partnership requiring unanimous consent for relevant activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidationPrinciple"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Dividends">
    <rdfs:label>Dividends</rdfs:label>
    <rdfs:comment>Dividend income or dividend payments disclosed as part of financial results.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialIncome"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NetBankingIncome"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Guarantee">
    <rdfs:label>Guarantee</rdfs:label>
    <rdfs:comment>A contractual mechanism to cover counterparty risk or repayment risk for financing or long-term supplies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitment"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityMethodInvestment">
    <rdfs:label>EquityMethodInvestment</rdfs:label>
    <rdfs:comment>An investment accounted for using the equity method, replacing the investment value with the investor’s share of investee equity and profit/loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityInvestment"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Company"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityInvestments"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SupportDivision">
    <rdfs:label>SupportDivision</rdfs:label>
    <rdfs:comment>Division within the support organization (e.g., development, marketing, accelerators, consultancy, university, steering, expertise).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SupportExecutiveDepartment"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BusinessSupportBusinessLine"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Expenditure">
    <rdfs:label>Expenditure</rdfs:label>
    <rdfs:comment>General concept of spending eligible under the framework.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Provision">
    <rdfs:label>Provision</rdfs:label>
    <rdfs:comment>A liability recognized when an outflow of resources is probable for an obligation arising from a past event and can be reliably estimated.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ChiefExecutiveOfficer">
    <rdfs:label>ChiefExecutiveOfficer</rdfs:label>
    <rdfs:comment>Chief executive officer role within the institution’s management.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GeneralManagement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TradeDebt">
    <rdfs:label>TradeDebt</rdfs:label>
    <rdfs:comment>Trade debts and related accounts with maturity less than one year.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Debt"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BoardOfDirectors">
    <rdfs:label>BoardOfDirectors</rdfs:label>
    <rdfs:comment>The board that determines corporate matters and updates drafts/resolutions for general meetings.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Board"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SteeringCommittee">
    <rdfs:label>SteeringCommittee</rdfs:label>
    <rdfs:comment>Local steering committee responsible for formulating opinions on mission execution and strategic consistency at regional level.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PressRelease">
    <rdfs:label>PressRelease</rdfs:label>
    <rdfs:comment>A document publishing results and activities for a given period, including financial information and notices.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialInstitution">
    <rdfs:label>FinancialInstitution</rdfs:label>
    <rdfs:comment>An entity subject to non-financial transparency and responsible investment disclosure obligations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ESGWorkforce">
    <rdfs:label>ESGWorkforce</rdfs:label>
    <rdfs:comment>The broader workforce involved in ESG activities, including correspondents and coordination teams.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GeneralManagement">
    <rdfs:label>GeneralManagement</rdfs:label>
    <rdfs:comment>Executive management of EPIC Bpifrance, including the CEO and general management functions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialStatementNote">
    <rdfs:label>FinancialStatementNote</rdfs:label>
    <rdfs:comment>A structured section of notes accompanying the financial statements (e.g., significant events, accounting standards, balance sheet items, income statement items).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AnnualReport"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SecuritiesCommitments">
    <rdfs:label>SecuritiesCommitments</rdfs:label>
    <rdfs:comment>Securities-related commitments such as buyback/takeback options.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitments"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CommitmentsGiven"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialDebt">
    <rdfs:label>FinancialDebt</rdfs:label>
    <rdfs:comment>Debts recorded in the balance sheet under categories such as financial debts to credit institutions or other financial debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Debt"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLiability"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Borrowing"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AccelerationFund">
    <rdfs:label>AccelerationFund</rdfs:label>
    <rdfs:comment>A fund category focused on acceleration-stage investments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IdentificationData">
    <rdfs:label>IdentificationData</rdfs:label>
    <rdfs:comment>Category of personal data used to identify individuals (e.g., names, addresses, signatures, birth details).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalDataCategory"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherFinancialAssets">
    <rdfs:label>OtherFinancialAssets</rdfs:label>
    <rdfs:comment>Category of financial assets other than cash and cash equivalents, including loans and reserve funds.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAssets"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestingInTheFutureProgramme">
    <rdfs:label>InvestingInTheFutureProgramme</rdfs:label>
    <rdfs:comment>The Investing in the Future Programme (PIA) referenced as a major source of endowments and initiatives.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialProgramme"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentProgramme"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialProgramme">
    <rdfs:label>FinancialProgramme</rdfs:label>
    <rdfs:comment>A structured public financing programme such as PIA, France 2030, and Investing in the Future.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperatingDebts">
    <rdfs:label>OperatingDebts</rdfs:label>
    <rdfs:comment>Debt obligations arising from operations, including trade, tax/social security, and other debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Liabilities"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicAuthority">
    <rdfs:label>PublicAuthority</rdfs:label>
    <rdfs:comment>A governmental body or public authority that entrusts missions and steers public policies.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalDataDisclosure">
    <rdfs:label>PersonalDataDisclosure</rdfs:label>
    <rdfs:comment>Disclosure/transfer of personal data to internal group entities and, where applicable, outside the European Union.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataProcessingActivity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CreditRiskCommittee">
    <rdfs:label>CreditRiskCommittee</rdfs:label>
    <rdfs:comment>A committee receiving credit-risk files for decision.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RegulatoryAuthority">
    <rdfs:label>RegulatoryAuthority</rdfs:label>
    <rdfs:comment>A general category for authorities such as financial market regulators referenced for complaint management.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicFundingInstrument">
    <rdfs:label>PublicFundingInstrument</rdfs:label>
    <rdfs:comment>An instrument/programme through which public authorities provide funding and support.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentBusiness">
    <rdfs:label>InvestmentBusiness</rdfs:label>
    <rdfs:comment>A business line evaluated using an expense ratio.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialAsset">
    <rdfs:label>FinancialAsset</rdfs:label>
    <rdfs:comment>A financial asset held by the group, measured under various IFRS categories such as fair value through profit or loss or equity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TradePayable">
    <rdfs:label>TradePayable</rdfs:label>
    <rdfs:comment>Payables arising from trade and other liabilities, including deferred income and tax/social security debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLiability"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AccountingEstimate">
    <rdfs:label>AccountingEstimate</rdfs:label>
    <rdfs:comment>An estimate used in preparing financial statements where outcomes involve uncertainty.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskCommittee">
    <rdfs:label>RiskCommittee</rdfs:label>
    <rdfs:comment>Risk committee referenced as part of governance structures for certain entities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialAssetAtFairValueThroughProfitOrLoss">
    <rdfs:label>FinancialAssetAtFairValueThroughProfitOrLoss</rdfs:label>
    <rdfs:comment>A category of financial assets measured at fair value with changes recognized in profit or loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TaxReceivable">
    <rdfs:label>TaxReceivable</rdfs:label>
    <rdfs:comment>Receivables for taxes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherReceivable"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ShareholdersEquity">
    <rdfs:label>ShareholdersEquity</rdfs:label>
    <rdfs:comment>Equity items presented within the liabilities/equity section, including capital, retained earnings, and current-year profit or loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Liabilities"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LongTermInvestmentInPortfolioSecurities">
    <rdfs:label>LongTermInvestmentInPortfolioSecurities</rdfs:label>
    <rdfs:comment>Long-term investments in portfolio securities, described as non-expendable securities endowment paid by the State for the Innovation and Industry Fund.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ReinsuranceAgreementParticipant">
    <rdfs:label>ReinsuranceAgreementParticipant</rdfs:label>
    <rdfs:comment>An entity intervening within reinsurance or joint insurance agreements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProfessionalAdvisor">
    <rdfs:label>ProfessionalAdvisor</rdfs:label>
    <rdfs:comment>An external professional (e.g., advisors, experts, law firms, investment banks) supporting processing activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalData">
    <rdfs:label>PersonalData</rdfs:label>
    <rdfs:comment>Information that allows a person to be directly or indirectly identified, including data contained in application documents.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StatutoryAuditor">
    <rdfs:label>StatutoryAuditor</rdfs:label>
    <rdfs:comment>Statutory auditor responsible for the auditor’s report on the summary consolidated half-year financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ShareholderEquity">
    <rdfs:label>ShareholderEquity</rdfs:label>
    <rdfs:comment>Equity used as the denominator for ROE calculations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExceptionalProfitOrLoss">
    <rdfs:label>ExceptionalProfitOrLoss</rdfs:label>
    <rdfs:comment>Exceptional profit or loss derived from extraordinary income and expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SanctionsAndEmbargoDueDiligenceProcess">
    <rdfs:label>SanctionsAndEmbargoDueDiligenceProcess</rdfs:label>
    <rdfs:comment>Due diligence and checks related to international sanctions and embargoes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DueDiligenceProcess"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CreditRiskDepartment">
    <rdfs:label>CreditRiskDepartment</rdfs:label>
    <rdfs:comment>A department responsible for counter-analysis of credit-risk files and presenting them to committees.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SupervisoryAuthority">
    <rdfs:label>SupervisoryAuthority</rdfs:label>
    <rdfs:comment>A supervisory authority that may receive personal data and/or complaints (e.g., data protection regulators).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityConsolidatedCompany">
    <rdfs:label>EquityConsolidatedCompany</rdfs:label>
    <rdfs:comment>Company whose net profit/loss is included in the group’s income statement via the equity method (equity-consolidated).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Investment"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Company"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CurrentLiquidity">
    <rdfs:label>CurrentLiquidity</rdfs:label>
    <rdfs:comment>Assets that can be mobilised in one day, including cash, money market funds, and sovereign bonds.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#LiquidityReserve"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CET1Ratio">
    <rdfs:label>CET1Ratio</rdfs:label>
    <rdfs:comment>Core Equity Tier 1 ratio comparing core equity capital to risk-weighted assets.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Solvency"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SolvencyAndLiquidityStatus"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValueMeasurement">
    <rdfs:label>FairValueMeasurement</rdfs:label>
    <rdfs:comment>Fair value measurement framework referenced for transfers between fair value levels and sensitivity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeCommitment">
    <rdfs:label>GuaranteeCommitment</rdfs:label>
    <rdfs:comment>Guarantee commitments given or received, including commitments on behalf of credit institutions/customers.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GuaranteeScheme"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitment"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Guarantee"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitments"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValueHierarchyLevel">
    <rdfs:label>FairValueHierarchyLevel</rdfs:label>
    <rdfs:comment>A level in the fair value hierarchy (Level 1, Level 2, Level 3) based on observability of inputs.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FairValue"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetOperatingIncome">
    <rdfs:label>NetOperatingIncome</rdfs:label>
    <rdfs:comment>Net operating income derived from operating earnings and operating expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CashAndCashEquivalents">
    <rdfs:label>CashAndCashEquivalents</rdfs:label>
    <rdfs:comment>Cash in hand, on-demand deposits, and short-term highly liquid investments with insignificant risk of value change.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAssets"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CurrentAssets"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StateLoan">
    <rdfs:label>StateLoan</rdfs:label>
    <rdfs:comment>Loans from the State (excluding associated liabilities).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Loan"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetIncome">
    <rdfs:label>NetIncome</rdfs:label>
    <rdfs:comment>Profit or loss measure used in the statement of net income and related equity movements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RegionalAuthority">
    <rdfs:label>RegionalAuthority</rdfs:label>
    <rdfs:comment>Regional authorities and their public limited companies that may entrust missions and conclude agreements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ClimatePlan">
    <rdfs:label>ClimatePlan</rdfs:label>
    <rdfs:comment>Climate plan described as the organization’s strategy for ecological and energy transition and as aligned with green financing.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalDataProtectionPolicy">
    <rdfs:label>PersonalDataProtectionPolicy</rdfs:label>
    <rdfs:comment>A policy document describing how personal data is processed, for what purposes, and the rights of individuals.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PolicyDocument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CNIL">
    <rdfs:label>CNIL</rdfs:label>
    <rdfs:comment>A French data protection supervisory authority referenced as a place to lodge complaints.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SupervisoryAuthority"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ComplaintBody"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BpifranceAccruedExpense">
    <rdfs:label>BpifranceAccruedExpense</rdfs:label>
    <rdfs:comment>Accrued expenses of Bpifrance included in other debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherDebt"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TechnologyTransferAccelerationCompany">
    <rdfs:label>TechnologyTransferAccelerationCompany</rdfs:label>
    <rdfs:comment>A type of company referenced in the context of SATT activities (equity interests in technology transfer acceleration companies).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Company">
    <rdfs:label>Company</rdfs:label>
    <rdfs:comment>A general business entity that may be invested in, assessed for ESG risks, and engaged with through governance and questionnaires.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataController"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ResponsibleInvestmentPolicy">
    <rdfs:label>ResponsibleInvestmentPolicy</rdfs:label>
    <rdfs:comment>A policy defining responsible investment approach, exclusions, ESG criteria, and compliance/commitment requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DividendsPaid">
    <rdfs:label>DividendsPaid</rdfs:label>
    <rdfs:comment>Disclosures about dividends distributed during the period.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CurrentAccount">
    <rdfs:label>CurrentAccount</rdfs:label>
    <rdfs:comment>A current account included in cash and cash equivalents (e.g., Bpifrance current account, State current accounts).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CashAndCashEquivalent"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityMethodConsolidation">
    <rdfs:label>EquityMethodConsolidation</rdfs:label>
    <rdfs:comment>Consolidation method used for joint ventures and significant influence holdings.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidationMethod"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ParentEntityFinancialStatements">
    <rdfs:label>ParentEntityFinancialStatements</rdfs:label>
    <rdfs:comment>Financial statements prepared for the parent entity only (publishable balance sheet, income statement, and notes).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AntiFraudPreventionPurpose">
    <rdfs:label>AntiFraudPreventionPurpose</rdfs:label>
    <rdfs:comment>A purpose for processing personal data to prevent fraud (overlaps with fraud protection).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FraudProtectionPurpose"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DerivativeHedging">
    <rdfs:label>DerivativeHedging</rdfs:label>
    <rdfs:comment>Hedging activities reflected through derivative revaluation for recyclable items.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#HedgingDerivative"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MiscellaneousDebts">
    <rdfs:label>MiscellaneousDebts</rdfs:label>
    <rdfs:comment>Miscellaneous debts category, including debts on fixed assets and related accounts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingDebts"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Liabilities"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeCommitments">
    <rdfs:label>GuaranteeCommitments</rdfs:label>
    <rdfs:comment>Guarantee commitments given or received.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitments"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CommitmentsGiven"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExternalReviewer">
    <rdfs:label>ExternalReviewer</rdfs:label>
    <rdfs:comment>Third-party reviewer providing independent pre-issuance review and opinions referenced in the framework.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CounterTerroristFinancingPurpose">
    <rdfs:label>CounterTerroristFinancingPurpose</rdfs:label>
    <rdfs:comment>A purpose for processing personal data to fight terrorist financing.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AdministrativeData">
    <rdfs:label>AdministrativeData</rdfs:label>
    <rdfs:comment>Personal data used for administrative verification (e.g., proof of address).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalDataCategory"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ReserveFund">
    <rdfs:label>ReserveFund</rdfs:label>
    <rdfs:comment>Reserve fund referenced as part of accounting for interest capitalised in reserves.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAssets"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GuaranteeFund"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskManagementPolicy">
    <rdfs:label>RiskManagementPolicy</rdfs:label>
    <rdfs:comment>A policy defining how risks such as liquidity risk are managed and monitored at group level.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AntiMoneyLaunderingProcess">
    <rdfs:label>AntiMoneyLaunderingProcess</rdfs:label>
    <rdfs:comment>Due diligence and checks to counter money laundering.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DueDiligenceProcess"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CEO">
    <rdfs:label>CEO</rdfs:label>
    <rdfs:comment>Chief executive officer responsible for certifying information in the amendment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ArticlesOfAssociation">
    <rdfs:label>ArticlesOfAssociation</rdfs:label>
    <rdfs:comment>The company’s governing charter, including the company object and mission provisions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InterestAndSimilarExpense">
    <rdfs:label>InterestAndSimilarExpense</rdfs:label>
    <rdfs:comment>Interest and similar expenses.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProvenRisks">
    <rdfs:label>ProvenRisks</rdfs:label>
    <rdfs:comment>Cost of risk component reflecting normalization after prior low-risk periods.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CostOfRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalDataRetention">
    <rdfs:label>PersonalDataRetention</rdfs:label>
    <rdfs:comment>Concept of storing personal data for defined periods to meet legal and processing purposes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BookValuesOfAssetsSold">
    <rdfs:label>BookValuesOfAssetsSold</rdfs:label>
    <rdfs:comment>Extraordinary expenses representing book values of assets sold.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExtraordinaryExpenses"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExportFinancing">
    <rdfs:label>ExportFinancing</rdfs:label>
    <rdfs:comment>A function providing medium-long-term financing solutions for foreign buyers of exporting companies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BusinessLine"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExportDepartment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LiquidityReserve">
    <rdfs:label>LiquidityReserve</rdfs:label>
    <rdfs:comment>A liquidity reserve composed of current liquidity, current liquidity buffer, and contingency plan reserve.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#LiquidityPosition"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InterimFinancialStatement">
    <rdfs:label>InterimFinancialStatement</rdfs:label>
    <rdfs:comment>A financial statement for an interim period (e.g., condensed half-year consolidated financial statements).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Debt">
    <rdfs:label>Debt</rdfs:label>
    <rdfs:comment>General concept of a debt obligation with a remaining term (e.g., less than 1 year, 1–5 years, more than 5 years).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLiability"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Contract">
    <rdfs:label>Contract</rdfs:label>
    <rdfs:comment>A legal agreement whose lifecycle drives parts of personal data processing (pre-contractual, execution, management, termination).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Fund">
    <rdfs:label>Fund</rdfs:label>
    <rdfs:comment>An investment vehicle subscribed to directly or managed on behalf of third parties, subject to ESG integration and monitoring.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentVehicle"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentBusinessLine"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityInvestments"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StateCurrentAccount">
    <rdfs:label>StateCurrentAccount</rdfs:label>
    <rdfs:comment>State current account balances with Agence France Trésor referenced in receivables and cash notes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherReceivables"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialResult">
    <rdfs:label>FinancialResult</rdfs:label>
    <rdfs:comment>Net financial result after financial income and financial expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ImpairmentOfAssets">
    <rdfs:label>ImpairmentOfAssets</rdfs:label>
    <rdfs:comment>The impairment framework referenced for testing equity investments and goodwill when objective evidence exists.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ImpairmentLoss"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AccountingStandard"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SecuritiesNote">
    <rdfs:label>SecuritiesNote</rdfs:label>
    <rdfs:comment>A document supplementing a universal registration document for the purposes of offering financial securities to the public or admitting them to trading.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ESGQuestionnaire">
    <rdfs:label>ESGQuestionnaire</rdfs:label>
    <rdfs:comment>A questionnaire assessing ESG integration, CSR policies, and measurable practices for companies and fund managers.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Questionnaire"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LegalObligationLegalBasis">
    <rdfs:label>LegalObligationLegalBasis</rdfs:label>
    <rdfs:comment>A legal basis for processing personal data based on compliance with a legal obligation.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AcceleratorProgramme">
    <rdfs:label>AcceleratorProgramme</rdfs:label>
    <rdfs:comment>A programme/initiative that deploys support for specific sectors or regions (e.g., SME accelerators, energy transition accelerators).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialProgramme"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicFundingInstrument"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentProgramme"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FranceGreenNationGrantsReceivables">
    <rdfs:label>FranceGreenNationGrantsReceivables</rdfs:label>
    <rdfs:comment>Receivables related to France Green Nation grants.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAssets"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BusinessCreation">
    <rdfs:label>BusinessCreation</rdfs:label>
    <rdfs:comment>A mission supporting and strengthening national and local action in favour of business creation through entrepreneurship networks.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SecuritiesCommitment">
    <rdfs:label>SecuritiesCommitment</rdfs:label>
    <rdfs:comment>Securities-related commitments given or received, including buyback/takeback options and other commitments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitment"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitments"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialIncome">
    <rdfs:label>FinancialIncome</rdfs:label>
    <rdfs:comment>Income from financial activities such as dividends and interest.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CreditRisk">
    <rdfs:label>CreditRisk</rdfs:label>
    <rdfs:comment>Risk resulting from default of a counterparty or counterparties considered as a single beneficiary group.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Risk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RiskManagement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NonPerformanceRisk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RiskExposure"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AuditedData">
    <rdfs:label>AuditedData</rdfs:label>
    <rdfs:comment>Financial figures derived from internal approved sources and accounts, noted as not audited in the press release.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityMethodInvestee">
    <rdfs:label>EquityMethodInvestee</rdfs:label>
    <rdfs:comment>A company accounted for using the equity method within consolidated financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Entity">
    <rdfs:label>Entity</rdfs:label>
    <rdfs:comment>General concept of an organization or borrower entity referenced by eligibility definitions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NegotiableDebtSecurity">
    <rdfs:label>NegotiableDebtSecurity</rdfs:label>
    <rdfs:comment>Negotiable debt securities used for short-term financing under the framework.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StateEntity">
    <rdfs:label>StateEntity</rdfs:label>
    <rdfs:comment>Entity representing the French State, acting unilaterally or by agreement and holding capital or entrusting missions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AccountingPrinciplesAndMethods">
    <rdfs:label>AccountingPrinciplesAndMethods</rdfs:label>
    <rdfs:comment>Disclosures describing the accounting principles, valuation methods, and regulatory framework used to prepare the statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternationalSanctionsAndEmbargoDueDiligencePurpose">
    <rdfs:label>InternationalSanctionsAndEmbargoDueDiligencePurpose</rdfs:label>
    <rdfs:comment>A purpose for processing personal data to perform due diligence regarding international sanctions and embargoes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ContractLifecycleManagement">
    <rdfs:label>ContractLifecycleManagement</rdfs:label>
    <rdfs:comment>Overall management of the contract lifecycle including execution and follow-up.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Contract"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CurrentTax">
    <rdfs:label>CurrentTax</rdfs:label>
    <rdfs:comment>Tax expense or receivable determined based on current tax rules and rates in force.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Tax"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DecisionSupportTool">
    <rdfs:label>DecisionSupportTool</rdfs:label>
    <rdfs:comment>A tool used to support credit decisions through comprehensive analysis.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValueLevel">
    <rdfs:label>FairValueLevel</rdfs:label>
    <rdfs:comment>A level within the fair value hierarchy (e.g., quoted prices, observable inputs, unobservable inputs).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FairValueMeasurement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchy"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EuropeanGeneralDataProtectionRegulation">
    <rdfs:label>EuropeanGeneralDataProtectionRegulation</rdfs:label>
    <rdfs:comment>The GDPR legal framework governing personal data protection in the European context.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AntiCorruptionPurpose">
    <rdfs:label>AntiCorruptionPurpose</rdfs:label>
    <rdfs:comment>A purpose for processing personal data to fight corruption.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityConsolidatedCompanies">
    <rdfs:label>EquityConsolidatedCompanies</rdfs:label>
    <rdfs:comment>Companies accounted for using the equity method due to joint control or significant influence.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#WarInUkraine">
    <rdfs:label>WarInUkraine</rdfs:label>
    <rdfs:comment>The war in Ukraine described as a significant event affecting markets and the economy.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SignificantEvent"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialStatement">
    <rdfs:label>FinancialStatement</rdfs:label>
    <rdfs:comment>A financial statement document or section presenting financial position, performance, or notes (e.g., consolidated or parent entity statements).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CentralBank">
    <rdfs:label>CentralBank</rdfs:label>
    <rdfs:comment>A monetary authority referenced as supplying additional liquidity to markets and banks.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LegitimateInterestLegalBasis">
    <rdfs:label>LegitimateInterestLegalBasis</rdfs:label>
    <rdfs:comment>A legal basis for processing personal data based on the controller’s legitimate interests.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PolicyDocument">
    <rdfs:label>PolicyDocument</rdfs:label>
    <rdfs:comment>A document setting rules for processing personal data under applicable regulations (e.g., GDPR policy).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EventOrganization">
    <rdfs:label>EventOrganization</rdfs:label>
    <rdfs:comment>Organization and management of events involving individuals.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Solvency">
    <rdfs:label>Solvency</rdfs:label>
    <rdfs:comment>Overall financial strength measured against regulatory solvency requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements">
    <rdfs:label>ConsolidatedFinancialStatements</rdfs:label>
    <rdfs:comment>Financial statements prepared on a consolidated basis for the group, including notes on accounting standards, consolidation, and financial statement items.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AnnualReport"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AMLCFT">
    <rdfs:label>AML_CFT</rdfs:label>
    <rdfs:comment>Anti-money laundering and combating the financing of terrorism training referenced in non-financial reporting.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProfessionalLifeData">
    <rdfs:label>ProfessionalLifeData</rdfs:label>
    <rdfs:comment>Personal data related to professional life (e.g., professional contact details, position, curriculum vitae).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalData"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalDataCategory"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicLimitedCompanySubsidiary">
    <rdfs:label>PublicLimitedCompanySubsidiary</rdfs:label>
    <rdfs:comment>Subsidiaries of the public limited company referenced in the historical development and organisational chart.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompanyGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DerecognitionOfFinancialAssets">
    <rdfs:label>DerecognitionOfFinancialAssets</rdfs:label>
    <rdfs:comment>Accounting treatment for removing financial assets when contractual rights expire or risks/rewards are transferred.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExtraordinaryExpense">
    <rdfs:label>ExtraordinaryExpense</rdfs:label>
    <rdfs:comment>Extraordinary expenses such as book value of financial assets sold and contributions to funds.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperatingRatio">
    <rdfs:label>OperatingRatio</rdfs:label>
    <rdfs:comment>Ratio comparing operating expenditure to net banking income for the banking business line.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IncomeStatement">
    <rdfs:label>IncomeStatement</rdfs:label>
    <rdfs:comment>A publishable income statement showing operating, financial, and extraordinary results.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialStatements">
    <rdfs:label>FinancialStatements</rdfs:label>
    <rdfs:comment>The annual financial statements (balance sheet, income statement, and appendix) approved by shareholders.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValue">
    <rdfs:label>FairValue</rdfs:label>
    <rdfs:comment>The measurement concept of fair value used for financial assets and liabilities, including exit price basis.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternalLiquidityAdequacyAssessmentProcess">
    <rdfs:label>InternalLiquidityAdequacyAssessmentProcess</rdfs:label>
    <rdfs:comment>A process (ILAAP) used to assess and ensure internal liquidity adequacy for short-term and medium/long-term obligations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValueLevel3">
    <rdfs:label>FairValueLevel3</rdfs:label>
    <rdfs:comment>Fair value determined using unobservable market data and valuation models with unobservable parameters.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchyLevel"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Liabilities">
    <rdfs:label>Liabilities</rdfs:label>
    <rdfs:comment>The liabilities section of financial statements, including total liabilities and their breakdown.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BalanceSheet"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskFactor">
    <rdfs:label>RiskFactor</rdfs:label>
    <rdfs:comment>A category of risks disclosed in the risk factors section of the universal registration document.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Consent">
    <rdfs:label>Consent</rdfs:label>
    <rdfs:comment>A legal basis for processing where the candidate provides permission for certain communications.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Questionnaire">
    <rdfs:label>Questionnaire</rdfs:label>
    <rdfs:comment>A structured set of questions used to collect ESG/CSR information from management companies and portfolio entities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DebtsOnFixedAssetsAndRelatedAccounts">
    <rdfs:label>DebtsOnFixedAssetsAndRelatedAccounts</rdfs:label>
    <rdfs:comment>Debts specifically related to fixed assets and related accounts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#MiscellaneousDebts"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FrenchDataProtectionAct">
    <rdfs:label>FrenchDataProtectionAct</rdfs:label>
    <rdfs:comment>The national French legal framework relating to data protection referenced alongside GDPR.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ServiceProvider">
    <rdfs:label>ServiceProvider</rdfs:label>
    <rdfs:comment>A third party service provider or subcontractor that processes personal data on behalf of the group for recruitment-related services.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataProcessor"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Board">
    <rdfs:label>Board</rdfs:label>
    <rdfs:comment>A governance body where the investment branch may seek seats and provide oversight and engagement.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PhysicalClimateRisk">
    <rdfs:label>PhysicalClimateRisk</rdfs:label>
    <rdfs:comment>Physical risk from financial consequences of extreme and/or chronic climate hazards.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ClimateRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DebtSecurity">
    <rdfs:label>DebtSecurity</rdfs:label>
    <rdfs:comment>A general category of debt instruments/securities issued under financing programmes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalDataMinimizationPrinciple">
    <rdfs:label>PersonalDataMinimizationPrinciple</rdfs:label>
    <rdfs:comment>The principle that only necessary personal data is collected for the stated purposes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TaxUncertainty">
    <rdfs:label>TaxUncertainty</rdfs:label>
    <rdfs:comment>Uncertainty about whether a tax position will be accepted by tax authorities and its reflection in financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DeferredTax"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SMESupport">
    <rdfs:label>SMESupport</rdfs:label>
    <rdfs:comment>Support and financing for small and medium-sized enterprises referenced as a core mission.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EnergyAndEcologicalTransitionSupport">
    <rdfs:label>EnergyAndEcologicalTransitionSupport</rdfs:label>
    <rdfs:comment>Support measures for energy and ecological transition and related reindustrialisation initiatives.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityInvestments">
    <rdfs:label>EquityInvestments</rdfs:label>
    <rdfs:comment>Equity investments held as long-term ownership useful for the company’s business.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAssets"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RetentionPeriod">
    <rdfs:label>RetentionPeriod</rdfs:label>
    <rdfs:comment>The time period during which personal data is retained to implement the stated purposes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StructuredEntity">
    <rdfs:label>StructuredEntity</rdfs:label>
    <rdfs:comment>An entity structured such that voting or similar rights are not the dominant factor in deciding control; referenced as not held by the group.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AdviceServices">
    <rdfs:label>AdviceServices</rdfs:label>
    <rdfs:comment>Support services providing advice to entrepreneurs.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RegionalOffice">
    <rdfs:label>RegionalOffice</rdfs:label>
    <rdfs:comment>A regional office within the organizational network.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChartOfNetwork"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalDataRights">
    <rdfs:label>PersonalDataRights</rdfs:label>
    <rdfs:comment>Rights available to data subjects regarding access, rectification, deletion, portability, limitation, objection, and instructions after death.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument">
    <rdfs:label>AmendmentToUniversalRegistrationDocument</rdfs:label>
    <rdfs:comment>An amendment document updating a universal registration document and filed with the competent authority.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#UniversalRegistrationDocument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IFRSStandard">
    <rdfs:label>IFRSStandard</rdfs:label>
    <rdfs:comment>International Financial Reporting Standards referenced as applied in the preparation of statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AccountingStandard"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicLimitedCompany">
    <rdfs:label>PublicLimitedCompany</rdfs:label>
    <rdfs:comment>A company organized as a public limited company (e.g., with registered capital and corporate registration).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CurrentNonCurrentClassification">
    <rdfs:label>CurrentNonCurrentClassification</rdfs:label>
    <rdfs:comment>The classification of assets and liabilities as current or non-current based on expected settlement or sale within twelve months.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DataProtectionOfficer">
    <rdfs:label>DataProtectionOfficer</rdfs:label>
    <rdfs:comment>An officer responsible for data protection within the organization/group and contact point for exercising rights.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MarketRisk">
    <rdfs:label>MarketRisk</rdfs:label>
    <rdfs:comment>Risk of losses due to changing prices for market products, volatility, and correlations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RiskExposure"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RiskManagement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityMethodInvestments">
    <rdfs:label>EquityMethodInvestments</rdfs:label>
    <rdfs:comment>Investments accounted for using the equity method within consolidation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OffBalanceSheetCommitmentsGiven">
    <rdfs:label>OffBalanceSheetCommitmentsGiven</rdfs:label>
    <rdfs:comment>A grouping of commitments given (financing, guarantee, and securities commitments).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherDebts">
    <rdfs:label>OtherDebts</rdfs:label>
    <rdfs:comment>Other operational debt obligations not classified as trade payables or tax/social security debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingDebts"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AmendmentToAgreement">
    <rdfs:label>AmendmentToAgreement</rdfs:label>
    <rdfs:comment>Amendments to existing agreements referenced throughout governance decisions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Agreement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Partnership">
    <rdfs:label>Partnership</rdfs:label>
    <rdfs:comment>A contractual arrangement subject to joint control, accounted for using the equity method under IFRS 11.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SME">
    <rdfs:label>SME</rdfs:label>
    <rdfs:comment>Small and medium-sized enterprises supported through financing, guarantees, and innovation activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IndustrialEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExportFinancingBusinessLine">
    <rdfs:label>ExportFinancingBusinessLine</rdfs:label>
    <rdfs:comment>A business line offering medium- and long-term export financing solutions to exporting companies for foreign buyers.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InternationalBusinessLine"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperatingIncome">
    <rdfs:label>OperatingIncome</rdfs:label>
    <rdfs:comment>Operating income used in the breakdown of results for tax purposes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BusinessCreationBusinessLine">
    <rdfs:label>BusinessCreationBusinessLine</rdfs:label>
    <rdfs:comment>Mission and business line supporting business creation through entrepreneurship support networks.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Borrowing">
    <rdfs:label>Borrowing</rdfs:label>
    <rdfs:comment>A debt obligation arising from loans and borrowings issued by the group.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLiability"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CinemaAndCulturalIndustriesInstitute">
    <rdfs:label>CinemaAndCulturalIndustriesInstitute</rdfs:label>
    <rdfs:comment>An institute referenced as a partner in deploying cinema/audio-visual and video games accelerators.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ECLSensitivityAnalysis">
    <rdfs:label>ECLSensitivityAnalysis</rdfs:label>
    <rdfs:comment>Sensitivity analysis of ECL amounts to macroeconomic scenarios.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExpectedCreditLossCalculation"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ShareholderDialogue">
    <rdfs:label>ShareholderDialogue</rdfs:label>
    <rdfs:comment>Ongoing engagement with invested companies and governance bodies to encourage ESG progress.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EcosystemRelatedRisk">
    <rdfs:label>EcosystemRelatedRisk</rdfs:label>
    <rdfs:comment>Risk arising from the broader ecosystem, including regulatory, political and climate-related risks.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Risk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SupportExecutiveDepartment">
    <rdfs:label>SupportExecutiveDepartment</rdfs:label>
    <rdfs:comment>An executive department managing the support business line and providing services such as advice, training and networking.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BusinessSupportBusinessLine"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SATTActivity">
    <rdfs:label>SATTActivity</rdfs:label>
    <rdfs:comment>SATT activity representing equity interests in Technology Transfer Accelerator Companies on behalf of the French State.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ActivitiesOnBehalfOfThirdParties"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ThirdPartyActivity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternationalBusiness">
    <rdfs:label>InternationalBusiness</rdfs:label>
    <rdfs:comment>Business activity related to international operations and export guarantees.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProfitOrLossForFinancialYear">
    <rdfs:label>ProfitOrLossForFinancialYear</rdfs:label>
    <rdfs:comment>Result for the financial year included in shareholders’ equity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ShareholdersEquity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BondIssueProgramme">
    <rdfs:label>BondIssueProgramme</rdfs:label>
    <rdfs:comment>A programme framework for issuing debt securities (e.g., EMTN/NEU MTN/CP programmes).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Supplier">
    <rdfs:label>Supplier</rdfs:label>
    <rdfs:comment>An entity providing goods or services to Bpifrance and whose representatives or agents may have their data processed.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Risk">
    <rdfs:label>Risk</rdfs:label>
    <rdfs:comment>A general concept for financial, operational, compliance, liquidity, market and other risks managed by the group.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationBusinessLine">
    <rdfs:label>InnovationBusinessLine</rdfs:label>
    <rdfs:comment>A business line providing financing and support for innovative projects and companies from idea to market.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LeverageRatio">
    <rdfs:label>LeverageRatio</rdfs:label>
    <rdfs:comment>A leverage ratio referenced in solvency and liquidity status.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SolvencyAndLiquidityStatus"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ContingencyPlanReserve">
    <rdfs:label>ContingencyPlanReserve</rdfs:label>
    <rdfs:comment>A reserve of financial assets mobilisable under proven stress situations for liquidity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GuaranteeFund"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicEntity">
    <rdfs:label>PublicEntity</rdfs:label>
    <rdfs:comment>A public institution referenced as the state and public resources involved in funding and commitments.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Fintech">
    <rdfs:label>Fintech</rdfs:label>
    <rdfs:comment>A company meeting conditions of being a start-up/fast-growing SME with innovative technology/business model and offering financial products/services.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Company"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExportDepartment">
    <rdfs:label>ExportDepartment</rdfs:label>
    <rdfs:comment>A department structured around export insurance, export financing and international development.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InternationalBusinessLine"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DebtOnFixedAssetsAndRelatedAccounts">
    <rdfs:label>DebtOnFixedAssetsAndRelatedAccounts</rdfs:label>
    <rdfs:comment>Debts on fixed assets and related accounts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RegulatoryDatabase">
    <rdfs:label>RegulatoryDatabase</rdfs:label>
    <rdfs:comment>A database managed by authorities or supervisory bodies used for indirect collection.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DatabaseProvider"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TradeDebts">
    <rdfs:label>TradeDebts</rdfs:label>
    <rdfs:comment>Trade debts referenced in trade debts and related accounts note.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#TradePayables"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GreenBond">
    <rdfs:label>GreenBond</rdfs:label>
    <rdfs:comment>Green bond issued under the framework, subject to EU green bond eligibility and reporting requirements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GreenFinancingInstrument"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MissionOfGeneralInterest">
    <rdfs:label>MissionOfGeneralInterest</rdfs:label>
    <rdfs:comment>General interest mission carried out by EPIC Bpifrance in support of public policies.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StatementOfCashFlows">
    <rdfs:label>StatementOfCashFlows</rdfs:label>
    <rdfs:comment>Statement of cash flows describing flows related to transactions and taxes paid.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CurrentLiquidityBuffer">
    <rdfs:label>CurrentLiquidityBuffer</rdfs:label>
    <rdfs:comment>Highly liquid assets mobilisable in less than a week.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#LiquidityReserve"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FrameworkAgreement">
    <rdfs:label>FrameworkAgreement</rdfs:label>
    <rdfs:comment>Framework agreements referenced for long-term management of major projects.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Agreement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProfilingForCommercialProspecting">
    <rdfs:label>ProfilingForCommercialProspecting</rdfs:label>
    <rdfs:comment>Profiling related to commercial prospecting referenced in the context of objections.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CommercialProspectingPurpose"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicLimitedCompanyGroup">
    <rdfs:label>PublicLimitedCompanyGroup</rdfs:label>
    <rdfs:comment>Group structure composed of public limited companies and related entities within the Bpifrance group.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DividendDistribution">
    <rdfs:label>DividendDistribution</rdfs:label>
    <rdfs:comment>Distribution of dividends referenced in equity changes and dividend paid.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExportGuarantee">
    <rdfs:label>ExportGuarantee</rdfs:label>
    <rdfs:comment>A public export guarantee granted to support and secure exports and investments abroad.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Guarantee"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExportInsurance"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NotesToFinancialStatements">
    <rdfs:label>NotesToFinancialStatements</rdfs:label>
    <rdfs:comment>Supplementary disclosures accompanying financial statements, including accounting principles, events, and fair value information.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OffBalanceSheetCommitment">
    <rdfs:label>OffBalanceSheetCommitment</rdfs:label>
    <rdfs:comment>Commitments disclosed outside the balance sheet, including guarantees, loan financing, and securities commitments.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExtraordinaryIncome">
    <rdfs:label>ExtraordinaryIncome</rdfs:label>
    <rdfs:comment>Income items classified as extraordinary, such as gains from disposal of assets.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicGroup">
    <rdfs:label>PublicGroup</rdfs:label>
    <rdfs:comment>Public group promoting business financing and development in support of public policies led by the State and regions (Bpifrance group).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ImpairmentLoss">
    <rdfs:label>ImpairmentLoss</rdfs:label>
    <rdfs:comment>Loss recognized when recoverable amount is less than book value, including impairment of goodwill and equity-method investments.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExchangeRisk">
    <rdfs:label>ExchangeRisk</rdfs:label>
    <rdfs:comment>Risk that changes in foreign exchange rates negatively impact the value of instruments and generate losses on non-euro borrowings or loans.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetCashFlowFromOperatingActivities">
    <rdfs:label>NetCashFlowFromOperatingActivities</rdfs:label>
    <rdfs:comment>Net cash flow from operating activities computed using the indirect method.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingActivities"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProfitOrLoss">
    <rdfs:label>ProfitOrLoss</rdfs:label>
    <rdfs:comment>The result of the financial year included in shareholders’ equity and income statement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ShareholdersEquity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SharePriceRisk">
    <rdfs:label>SharePriceRisk</rdfs:label>
    <rdfs:comment>Risk arising from equity investments and sensitivity of net asset value to benchmark index changes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#MarketPriceRisk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#MarketRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityInterest">
    <rdfs:label>EquityInterest</rdfs:label>
    <rdfs:comment>An ownership interest in another entity, with holdings described between 10% and 50% of capital held.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetCash">
    <rdfs:label>NetCash</rdfs:label>
    <rdfs:comment>The net cash concept corresponding to cash and cash equivalents.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CashFlowStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AdministrativeAuthority">
    <rdfs:label>AdministrativeAuthority</rdfs:label>
    <rdfs:comment>A public administrative authority that may receive data in the context of procedures requiring communication.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SupervisoryAuthority"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RelatedReceivable">
    <rdfs:label>RelatedReceivable</rdfs:label>
    <rdfs:comment>Receivables related to loans.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ESGCriteria">
    <rdfs:label>ESGCriteria</rdfs:label>
    <rdfs:comment>Environmental, social, and governance criteria used for analysis, exclusion, integration, and monitoring.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityMethod">
    <rdfs:label>EquityMethod</rdfs:label>
    <rdfs:comment>A method that replaces the investment’s carrying amount with the investor’s share of investee equity and recognizes the investor’s share of profit or loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidationMethod"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Network">
    <rdfs:label>Network</rdfs:label>
    <rdfs:comment>Network of entities/partners referenced in the organisational chart of the Bpifrance network.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FibenRatings">
    <rdfs:label>FibenRatings</rdfs:label>
    <rdfs:comment>Credit ratings provided by the Bank of France used in credit decision processes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Person">
    <rdfs:label>Person</rdfs:label>
    <rdfs:comment>An individual whose personal data may be processed, including representatives, beneficial owners, subscribers, and other stakeholders.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DebtInstrument">
    <rdfs:label>DebtInstrument</rdfs:label>
    <rdfs:comment>A debt instrument measured at amortised cost or fair value depending on business model and contractual cash flows.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperatingExpensesNote">
    <rdfs:label>OperatingExpensesNote</rdfs:label>
    <rdfs:comment>Note section dealing with operating expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IndirectCollection">
    <rdfs:label>IndirectCollection</rdfs:label>
    <rdfs:comment>Collection of personal data indirectly via third-party sources such as publications, databases, directories, or press/social media.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalDataCollection"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FraudProtectionPurpose">
    <rdfs:label>FraudProtectionPurpose</rdfs:label>
    <rdfs:comment>A purpose for processing personal data to protect against fraud and provide evidence in litigation.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DatabaseProvider">
    <rdfs:label>DatabaseProvider</rdfs:label>
    <rdfs:comment>An authority or official third party that makes databases available for indirect data collection.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#JudicialAuthority">
    <rdfs:label>JudicialAuthority</rdfs:label>
    <rdfs:comment>A public judicial authority that may receive data in the context of procedures requiring communication.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SupervisoryAuthority"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Organization">
    <rdfs:label>Organization</rdfs:label>
    <rdfs:comment>A general organizational entity referenced in the document (e.g., entities included in consolidation or network units).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Securities">
    <rdfs:label>Securities</rdfs:label>
    <rdfs:comment>Debt or equity securities referenced in fair value and amortised cost measurement categories.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidationScope">
    <rdfs:label>ConsolidationScope</rdfs:label>
    <rdfs:comment>Disclosures describing which entities are included in the consolidated financial statements and the consolidation methods used.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GeneralMeeting">
    <rdfs:label>GeneralMeeting</rdfs:label>
    <rdfs:comment>A shareholder meeting (ordinary or extraordinary) that approves reports, financial statements, and resolutions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskManagementSystem">
    <rdfs:label>RiskManagementSystem</rdfs:label>
    <rdfs:comment>A system for integrating climate and ESG risks into risk management and reporting.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AccountingStandard">
    <rdfs:label>AccountingStandard</rdfs:label>
    <rdfs:comment>A set of rules governing accounting and financial reporting (e.g., IFRS, IAS, IFRS 9, IFRS 11, IFRS 13, IAS 1, IAS 36).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialLoanAndFinancialDebt">
    <rdfs:label>FinancialLoanAndFinancialDebt</rdfs:label>
    <rdfs:comment>A combined classification covering financial loans and financial debts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DataProcessor">
    <rdfs:label>DataProcessor</rdfs:label>
    <rdfs:comment>An entity that processes personal data on behalf of a data controller (implied by outsourcing/service providers).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PPMTRAllowance">
    <rdfs:label>PPMTRAllowance</rdfs:label>
    <rdfs:comment>An allowance item (PPMTR allowance) included in other financial assets.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAssets"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ImpairmentTest">
    <rdfs:label>ImpairmentTest</rdfs:label>
    <rdfs:comment>A process for testing investments (including goodwill) for impairment when objective evidence exists.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ElectronicSignature">
    <rdfs:label>ElectronicSignature</rdfs:label>
    <rdfs:comment>A signature mechanism referenced for managing electronic signature processes and evidence reliability.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalDataCollection">
    <rdfs:label>PersonalDataCollection</rdfs:label>
    <rdfs:comment>Collection of personal data directly from the data subject or indirectly from third parties/sources.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataProcessingActivity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialResults">
    <rdfs:label>FinancialResults</rdfs:label>
    <rdfs:comment>A set of reported financial performance metrics for a specific financial year.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternalControlCharter">
    <rdfs:label>InternalControlCharter</rdfs:label>
    <rdfs:comment>A reference framework defining internal control within the group.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TechnologyTransferProgramme">
    <rdfs:label>TechnologyTransferProgramme</rdfs:label>
    <rdfs:comment>A programme area supporting technology transfer and related initiatives (e.g., technology transfer and transfer of businesses).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TradePayables">
    <rdfs:label>TradePayables</rdfs:label>
    <rdfs:comment>Payables to suppliers and related accounts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingDebts"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FutureTechnologyCompany">
    <rdfs:label>FutureTechnologyCompany</rdfs:label>
    <rdfs:comment>A type of company referenced as developing future technologies (equity interests).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskManagement">
    <rdfs:label>RiskManagement</rdfs:label>
    <rdfs:comment>The organization and measurement of risk management processes and indicators.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TaxAndSocialSecurityDebts">
    <rdfs:label>TaxAndSocialSecurityDebts</rdfs:label>
    <rdfs:comment>Debts related to taxes and social security contributions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingDebts"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeCommissionReceivable">
    <rdfs:label>GuaranteeCommissionReceivable</rdfs:label>
    <rdfs:comment>Commissions for guarantees to be received.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherReceivable"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancingActivity">
    <rdfs:label>FinancingActivity</rdfs:label>
    <rdfs:comment>A category of financing operations in which personal data is processed (e.g., innovation funding, treasury financing, asset/intangible financing, energy/environment projects).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LiquidityCoverageRatio">
    <rdfs:label>LiquidityCoverageRatio</rdfs:label>
    <rdfs:comment>Liquidity Coverage Ratio comparing high-quality liquid assets to net total cash outflow.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#LiquidityPosition"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ElectronicSignatureProcess">
    <rdfs:label>ElectronicSignatureProcess</rdfs:label>
    <rdfs:comment>The advanced electronic signature process and related management of electronic signature evidence.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PrudentialSupervisoryAndResolutionAuthority">
    <rdfs:label>PrudentialSupervisoryAndResolutionAuthority</rdfs:label>
    <rdfs:comment>A supervisory authority overseeing banking institutions and prudential requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TransactionDerivative">
    <rdfs:label>TransactionDerivative</rdfs:label>
    <rdfs:comment>A derivative arising from transactions, referenced under fair value through profit or loss.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#HedgingDerivative"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialYearEarnings">
    <rdfs:label>FinancialYearEarnings</rdfs:label>
    <rdfs:comment>Earnings for the financial year after tax.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Leasing">
    <rdfs:label>Leasing</rdfs:label>
    <rdfs:comment>Leasing operations used for tangible and intangible investment financing.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CommercialProspectingPurpose">
    <rdfs:label>CommercialProspectingPurpose</rdfs:label>
    <rdfs:comment>A purpose for processing personal data for commercial prospecting and newsletters.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CurrentIncomeBeforeTaxes">
    <rdfs:label>CurrentIncomeBeforeTaxes</rdfs:label>
    <rdfs:comment>Income before taxes line item.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeFund">
    <rdfs:label>GuaranteeFund</rdfs:label>
    <rdfs:comment>A fund related to guarantee activities referenced in the context of guarantee funds and ECL adjustments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherFinancialAssets"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentFund"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ReserveFund"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicFundingInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GovernanceBody">
    <rdfs:label>GovernanceBody</rdfs:label>
    <rdfs:comment>A governance entity (e.g., general meeting, board, supervisory board, or committee) where mandates may be exercised.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialDebts">
    <rdfs:label>FinancialDebts</rdfs:label>
    <rdfs:comment>Debts issued by the group, including financial debts to credit institutions and miscellaneous financial debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLiability"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Liabilities"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StructuralInterestRateRisk">
    <rdfs:label>StructuralInterestRateRisk</rdfs:label>
    <rdfs:comment>Interest rate risk related to structural balance sheet exposures and monitoring indicators such as net interest margin and economic value of equity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#MarketPriceRisk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#MarketRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NonGovernmentalOrganization">
    <rdfs:label>NonGovernmentalOrganization</rdfs:label>
    <rdfs:comment>An NGO referenced as a source of pressure affecting borrowers and credit conditions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BusinessLine">
    <rdfs:label>BusinessLine</rdfs:label>
    <rdfs:comment>A segment of activities within the group, such as financing, investment, or other lines.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChartOfBusinessLines"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ALMCommittee">
    <rdfs:label>ALMCommittee</rdfs:label>
    <rdfs:comment>An asset-liability management committee receiving interest rate and currency risk measurements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EligibleGreenLoan">
    <rdfs:label>EligibleGreenLoan</rdfs:label>
    <rdfs:comment>Loan aligned with EU environmental objectives and eligibility criteria under the green financing framework.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Loan"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NonPerformanceRisk">
    <rdfs:label>NonPerformanceRisk</rdfs:label>
    <rdfs:comment>Risk associated with non-performance of assets, including credit risk, concentration risk, systemic risk, and counterparty risk on financial assets.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RiskFactor"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentVehicle">
    <rdfs:label>InvestmentVehicle</rdfs:label>
    <rdfs:comment>A general concept for investment structures such as funds and direct investment portfolios subject to ESG processes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#HedgingDerivative">
    <rdfs:label>HedgingDerivative</rdfs:label>
    <rdfs:comment>A derivative instrument used for hedging and referenced in fair value and revaluation differences on rate-hedged portfolios.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLiability"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TaxAndSocialSecurityDebt">
    <rdfs:label>TaxAndSocialSecurityDebt</rdfs:label>
    <rdfs:comment>A specific category of liabilities for taxes and social security obligations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Debt"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#TradePayable"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialYear">
    <rdfs:label>FinancialYear</rdfs:label>
    <rdfs:comment>A defined accounting period used for reporting profits, dividends, and governance updates.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialMarketAuthority">
    <rdfs:label>FinancialMarketAuthority</rdfs:label>
    <rdfs:comment>A financial markets authority referenced as having a board where a representative of the State is delegated.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DeputyCEO">
    <rdfs:label>DeputyCEO</rdfs:label>
    <rdfs:comment>Deputy chief executive officer responsible for certifying information in the amendment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialExpenses">
    <rdfs:label>FinancialExpenses</rdfs:label>
    <rdfs:comment>Expenses from financial activities such as interest and similar charges.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TrustedServiceProviderYousign">
    <rdfs:label>TrustedServiceProviderYousign</rdfs:label>
    <rdfs:comment>A trusted service provider used for implementing the advanced electronic signature process (named in text).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#TrustedServiceProvider"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TrustedServiceProvider">
    <rdfs:label>TrustedServiceProvider</rdfs:label>
    <rdfs:comment>A provider trusted to implement electronic signature services used in the advanced electronic signature process.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GreenFinancingInstrument">
    <rdfs:label>GreenFinancingInstrument</rdfs:label>
    <rdfs:comment>Green financing instruments issued under the framework, whose proceeds are managed and allocated to eligible green loans.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BoardOfGovernance">
    <rdfs:label>BoardOfGovernance</rdfs:label>
    <rdfs:comment>A governance concept referenced as those charged with governance.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ShortTermNegotiableDebtSecurity">
    <rdfs:label>ShortTermNegotiableDebtSecurity</rdfs:label>
    <rdfs:comment>Short-term negotiable debt securities (e.g., NEUCP) used to finance or refinance eligible green loans and expenditures.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NegotiableDebtSecurity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialInstrument">
    <rdfs:label>FinancialInstrument</rdfs:label>
    <rdfs:comment>A contract-based asset or liability whose fair value and accounting treatment are discussed (including financial assets and liabilities).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CurrentAssets">
    <rdfs:label>CurrentAssets</rdfs:label>
    <rdfs:comment>Assets expected to be realized within the operating cycle (current assets).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BalanceSheet"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LegalBasisForProcessing">
    <rdfs:label>LegalBasisForProcessing</rdfs:label>
    <rdfs:comment>The legal grounds under which personal data processing is performed (e.g., legal obligation or legitimate interest).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AffiliateCompany">
    <rdfs:label>AffiliateCompany</rdfs:label>
    <rdfs:comment>An investee over which the group has significant influence, typically accounted for using the equity method.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherFinancialAsset">
    <rdfs:label>OtherFinancialAsset</rdfs:label>
    <rdfs:comment>A category of financial assets including loans, grants receivables, and reserve fund-related receivables.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SignificantEvent">
    <rdfs:label>SignificantEvent</rdfs:label>
    <rdfs:comment>An event during the period considered significant for the financial statements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RegionalDirectorate">
    <rdfs:label>RegionalDirectorate</rdfs:label>
    <rdfs:comment>A regional directorate within a network directorate.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChartOfNetwork"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DataSubjectRights">
    <rdfs:label>DataSubjectRights</rdfs:label>
    <rdfs:comment>Rights available to data subjects under applicable regulations, including access, rectification, deletion, portability, limitation, objection, and post-mortem instructions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LocalAuthority">
    <rdfs:label>LocalAuthority</rdfs:label>
    <rdfs:comment>A sub-national public authority, including regions, involved in financing allocations and guarantee funds.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicAuthority"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalDataRequest">
    <rdfs:label>PersonalDataRequest</rdfs:label>
    <rdfs:comment>A request to exercise rights from data subjects, including management of access/right-of-exercise handling.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataProcessingActivity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#HalfYearConsolidatedFinancialStatements">
    <rdfs:label>HalfYearConsolidatedFinancialStatements</rdfs:label>
    <rdfs:comment>Condensed half-year consolidated financial statements prepared for the group.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CostOfRisk">
    <rdfs:label>CostOfRisk</rdfs:label>
    <rdfs:comment>Provision-related cost of risk reflecting proven and expected risks.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CreditCommittee">
    <rdfs:label>CreditCommittee</rdfs:label>
    <rdfs:comment>A committee of the group receiving credit-risk files for decision.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExportInsurance">
    <rdfs:label>ExportInsurance</rdfs:label>
    <rdfs:comment>A function providing and managing public export guarantees for exporters.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BusinessLine"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExportDepartment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DueDiligence">
    <rdfs:label>DueDiligence</rdfs:label>
    <rdfs:comment>A compliance process including checks related to international sanctions, embargoes, and other regulatory requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#UnrealisedForeignExchangeGain">
    <rdfs:label>UnrealisedForeignExchangeGain</rdfs:label>
    <rdfs:comment>Unrealised foreign exchange gains reported for the period.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OrganizationalChartOfNetwork">
    <rdfs:label>OrganizationalChartOfNetwork</rdfs:label>
    <rdfs:comment>Organizational chart describing the network structure (regional offices and delegations).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChart"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicSectorInvestmentBank">
    <rdfs:label>PublicSectorInvestmentBank</rdfs:label>
    <rdfs:comment>A company object describing a public sector investment bank facilitating access to financing and guarantees.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancingCommitments">
    <rdfs:label>FinancingCommitments</rdfs:label>
    <rdfs:comment>Financing commitments given or received.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitments"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CommitmentsGiven"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DueDiligenceProcess">
    <rdfs:label>DueDiligenceProcess</rdfs:label>
    <rdfs:comment>A compliance and assessment process performed for transactions and funds (e.g., legal, financial, tax, strategic, ESG, KYC).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CrossReferenceTable">
    <rdfs:label>CrossReferenceTable</rdfs:label>
    <rdfs:comment>A table mapping headings between the universal registration document and its amendment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EuropeanCommissionDelegatedRegulation">
    <rdfs:label>EuropeanCommissionDelegatedRegulation</rdfs:label>
    <rdfs:comment>A delegated regulation of the European Commission referenced for required cross-reference table headings.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancingAgreement">
    <rdfs:label>FinancingAgreement</rdfs:label>
    <rdfs:comment>An agreement framework concluded with the State and other public actors for implementing programmes and financing mechanisms.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EccContributionToNetIncome">
    <rdfs:label>EccContributionToNetIncome</rdfs:label>
    <rdfs:comment>Contribution from equity-consolidated companies to net income.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SeedLoan">
    <rdfs:label>SeedLoan</rdfs:label>
    <rdfs:comment>Seed-stage unsecured loan product referenced in innovation financing.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#UnsecuredLoan"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SpaceAgency">
    <rdfs:label>SpaceAgency</rdfs:label>
    <rdfs:comment>A space-related agency referenced as a partner in France 2030 space initiatives.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EUTaxonomyActivity">
    <rdfs:label>EU_TaxonomyActivity</rdfs:label>
    <rdfs:comment>EU taxonomy activities referenced as eligible categories for alignment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperatingEarnings">
    <rdfs:label>OperatingEarnings</rdfs:label>
    <rdfs:comment>Operating earnings line item in the income statement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IndividualRights">
    <rdfs:label>IndividualRights</rdfs:label>
    <rdfs:comment>The set of rights granted to individuals regarding their personal data (access, rectification, deletion, portability, etc.).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AllocationPayable">
    <rdfs:label>AllocationPayable</rdfs:label>
    <rdfs:comment>An allocation payable to funds or entities (e.g., Innovation and Industry Fund, Bpifrance Participations, Bpifrance).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherDebt"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PersonalDataCategory">
    <rdfs:label>PersonalDataCategory</rdfs:label>
    <rdfs:comment>A category of personal data collected and processed (e.g., identification, administrative, professional, business login, economic and financial).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ArbitralAuthority">
    <rdfs:label>ArbitralAuthority</rdfs:label>
    <rdfs:comment>An arbitral authority that may receive personal data under legal procedures.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SMESupportEntity">
    <rdfs:label>SMESupportEntity</rdfs:label>
    <rdfs:comment>An organization missioned to promote, support, and finance small and medium-sized enterprises.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Guarantees">
    <rdfs:label>Guarantees</rdfs:label>
    <rdfs:comment>A risk-mitigation product category used to support businesses.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Bpifrance">
    <rdfs:label>Bpifrance</rdfs:label>
    <rdfs:comment>The main public entity acting as a credit institution and holding company for the group’s missions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Investment">
    <rdfs:label>Investment</rdfs:label>
    <rdfs:comment>An allocation of capital into equity or other instruments, including equity investments accounted for using the equity method or fair value.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationAndIndustryFund">
    <rdfs:label>InnovationAndIndustryFund</rdfs:label>
    <rdfs:comment>Innovation and Industry Fund (FII) whose assets are carried on EPIC Bpifrance’s balance sheet and whose programmes are managed.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialProgramme"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicFundingInstrument"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherReceivables"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidatedIncomeStatement">
    <rdfs:label>ConsolidatedIncomeStatement</rdfs:label>
    <rdfs:comment>Income statement presented within consolidated financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialLoansAndFinancialDebts">
    <rdfs:label>FinancialLoansAndFinancialDebts</rdfs:label>
    <rdfs:comment>Subcategory covering financial loans and related financial debts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialDebts"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DividendDistributionPolicy">
    <rdfs:label>DividendDistributionPolicy</rdfs:label>
    <rdfs:comment>The policy and decisions regarding distribution of dividends and advance payments.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperatingExpenses">
    <rdfs:label>OperatingExpenses</rdfs:label>
    <rdfs:comment>Operating expenses line item in the income statement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublishableIncomeStatement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution">
    <rdfs:label>PublicIndustrialAndCommercialInstitution</rdfs:label>
    <rdfs:comment>A public industrial and commercial institution (EPIC) as a legal form referenced for the reporting entity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InterestReceivable">
    <rdfs:label>InterestReceivable</rdfs:label>
    <rdfs:comment>Receivables for interests to be received.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OtherReceivable"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CashFlowStatement">
    <rdfs:label>CashFlowStatement</rdfs:label>
    <rdfs:comment>A financial statement detailing cash flows and their components such as operating, investing, financing, and exchange-rate impacts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherExpense">
    <rdfs:label>OtherExpense</rdfs:label>
    <rdfs:comment>Other expenses included in operating expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingExpense"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskExposure">
    <rdfs:label>RiskExposure</rdfs:label>
    <rdfs:comment>A concept describing exposure to risks inherent in business activities and financial positions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#KYC">
    <rdfs:label>KYC</rdfs:label>
    <rdfs:comment>Know Your Customer processing used for identity verification and compliance.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ComplaintAuthority">
    <rdfs:label>ComplaintAuthority</rdfs:label>
    <rdfs:comment>A regulatory body where data subjects may lodge complaints regarding data protection matters.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InterestExpense">
    <rdfs:label>InterestExpense</rdfs:label>
    <rdfs:comment>Interest and similar expenses, including state loan interest, EIB loan interest, and other financial charges.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IndustrialEntity">
    <rdfs:label>IndustrialEntity</rdfs:label>
    <rdfs:comment>Industrial borrower entity targeted by eligible green industry loans.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BorrowerEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentProgramme">
    <rdfs:label>InvestmentProgramme</rdfs:label>
    <rdfs:comment>A structured public investment programme (e.g., Investing in the Future, France 2030) with commitments and implementation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicFundingInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MediumTermNegotiableDebtSecurity">
    <rdfs:label>MediumTermNegotiableDebtSecurity</rdfs:label>
    <rdfs:comment>Medium-term negotiable debt securities (e.g., NEU MTN) used for green financing.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NegotiableDebtSecurity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExportInsuranceBusinessLine">
    <rdfs:label>ExportInsuranceBusinessLine</rdfs:label>
    <rdfs:comment>A business line managing public export guarantees on behalf of the state and providing export insurance solutions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InternationalBusinessLine"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ECLModel">
    <rdfs:label>ECLModel</rdfs:label>
    <rdfs:comment>A model used to calculate expected credit losses, including calibration and methodological adjustments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RiskManagementSystem"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExpectedCreditLossCalculation"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AntiMoneyLaundering">
    <rdfs:label>AntiMoneyLaundering</rdfs:label>
    <rdfs:comment>Compliance activities aimed at preventing money laundering.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DueDiligence"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IncomeFromDisposalOfAssets">
    <rdfs:label>IncomeFromDisposalOfAssets</rdfs:label>
    <rdfs:comment>Extraordinary income arising from disposal of assets.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ExtraordinaryIncome"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherPurchasesAndExternalExpenses">
    <rdfs:label>OtherPurchasesAndExternalExpenses</rdfs:label>
    <rdfs:comment>Subcategory of operating expenses covering other purchases and external expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OperatingExpenses"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetCashFlow">
    <rdfs:label>NetCashFlow</rdfs:label>
    <rdfs:comment>A cash flow concept corresponding to cash and cash equivalents and used to present cash flow after certain costs.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GuaranteeProvider">
    <rdfs:label>GuaranteeProvider</rdfs:label>
    <rdfs:comment>An organization that provides guarantees for bond issues and other financing instruments on behalf of public authorities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ApplicableRegulation">
    <rdfs:label>ApplicableRegulation</rdfs:label>
    <rdfs:comment>The set of applicable regulations referenced for processing personal data, including GDPR and national provisions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OffBalanceSheetCommitmentsReceived">
    <rdfs:label>OffBalanceSheetCommitmentsReceived</rdfs:label>
    <rdfs:comment>A grouping of commitments received (financing, guarantee, and securities commitments).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskManagementOrganization">
    <rdfs:label>RiskManagementOrganization</rdfs:label>
    <rdfs:comment>The organizational setup for managing risks, including the scope of risks to which the group is exposed.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TerritorialDelegation">
    <rdfs:label>TerritorialDelegation</rdfs:label>
    <rdfs:comment>A territorial delegation within the network structure.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChartOfNetwork"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperationalRiskManagementPolicy">
    <rdfs:label>OperationalRiskManagementPolicy</rdfs:label>
    <rdfs:comment>A policy applied to ensure governance and management of operational and non-compliance risks.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValueLevel1">
    <rdfs:label>FairValueLevel1</rdfs:label>
    <rdfs:comment>Fair value determined using quoted prices in liquid active markets.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchyLevel"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MacroeconomicScenario">
    <rdfs:label>MacroeconomicScenario</rdfs:label>
    <rdfs:comment>A scenario set used to model macroeconomic conditions for ECL calculations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ComplianceAndPermanentControlDepartment">
    <rdfs:label>ComplianceAndPermanentControlDepartment</rdfs:label>
    <rdfs:comment>A department responsible for steering procedures and controls for non-compliance risk management.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ShareholdersEquityStatement">
    <rdfs:label>ShareholdersEquityStatement</rdfs:label>
    <rdfs:comment>A statement/table describing changes in shareholders’ equity over a period.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InterestIncome">
    <rdfs:label>InterestIncome</rdfs:label>
    <rdfs:comment>Interest and similar income, including loan interest and guarantee commissions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BankAccount">
    <rdfs:label>BankAccount</rdfs:label>
    <rdfs:comment>A bank account included in cash and cash equivalents.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CashAndCashEquivalent"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AccountingStandardsFramework">
    <rdfs:label>AccountingStandardsFramework</rdfs:label>
    <rdfs:comment>Framework of applicable accounting standards (IFRS as adopted by the EU) used for consolidated financial statements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BorrowerEntity">
    <rdfs:label>BorrowerEntity</rdfs:label>
    <rdfs:comment>Entity that receives financing under the framework.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InterestRateRisk">
    <rdfs:label>InterestRateRisk</rdfs:label>
    <rdfs:comment>Risk of losses from unfavorable changes in interest rates, including mismatches between asset and liability rates.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Risk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#MarketRisk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CorporateIncomeTax">
    <rdfs:label>CorporateIncomeTax</rdfs:label>
    <rdfs:comment>Corporate income tax accounting and related taxable profit classification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CurrentTax"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#IncomeStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CollectionActions">
    <rdfs:label>CollectionActions</rdfs:label>
    <rdfs:comment>A group of processing purposes related to collecting personal data for compliance and due diligence.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GovernmentCommissioner">
    <rdfs:label>GovernmentCommissioner</rdfs:label>
    <rdfs:comment>A governance role referenced as part of the management company’s governance structure.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ControlledCompany">
    <rdfs:label>ControlledCompany</rdfs:label>
    <rdfs:comment>A company exclusively controlled and therefore fully consolidated in the group accounts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Company"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Loan">
    <rdfs:label>Loan</rdfs:label>
    <rdfs:comment>A contractual lending arrangement recognized as a financial asset and measured according to applicable IFRS rules.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DebtInstrument"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Debt"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AuditCommittee">
    <rdfs:label>AuditCommittee</rdfs:label>
    <rdfs:comment>Audit committee referenced as part of governance structures for certain entities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialRisk">
    <rdfs:label>FinancialRisk</rdfs:label>
    <rdfs:comment>Risk categories related to financial market and balance-sheet exposures, including interest rate, market, liquidity, exchange, and equity-interest risks.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RiskManagement"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Risk"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#RiskFactor"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OffBalanceSheetCommitments">
    <rdfs:label>OffBalanceSheetCommitments</rdfs:label>
    <rdfs:comment>Commitments given and received disclosed outside the balance sheet.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CounterTerrorismFinancingProcess">
    <rdfs:label>CounterTerrorismFinancingProcess</rdfs:label>
    <rdfs:comment>Due diligence and checks to counter financing of terrorism.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DueDiligenceProcess"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicInvestmentBank">
    <rdfs:label>PublicInvestmentBank</rdfs:label>
    <rdfs:comment>Public investment bank concept referenced as the Banque publique d'investissement (Bpifrance’s role and mission).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DeferredTax">
    <rdfs:label>DeferredTax</rdfs:label>
    <rdfs:comment>Tax effects recognized for temporary differences between book values and tax values of assets and liabilities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Tax"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CurriculumVitae">
    <rdfs:label>CurriculumVitae</rdfs:label>
    <rdfs:comment>A CV document that may contain personal data used in recruitment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperatingExpense">
    <rdfs:label>OperatingExpense</rdfs:label>
    <rdfs:comment>Operating expenses, including external charges, reserve fund reallocations, and taxes and duties.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CreditInstitution">
    <rdfs:label>CreditInstitution</rdfs:label>
    <rdfs:comment>A banking institution providing financing activities and subject to banking regulations and prudential supervision.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ServiceProvider"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Bank"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityMethodCompany">
    <rdfs:label>EquityMethodCompany</rdfs:label>
    <rdfs:comment>A company accounted for using the equity method, referenced for share of gains and losses in equity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternationalBusinessLine">
    <rdfs:label>InternationalBusinessLine</rdfs:label>
    <rdfs:comment>A business line supporting internationalisation and export-related financing and insurance activities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BoardOfDirectorsManagementReport">
    <rdfs:label>BoardOfDirectorsManagementReport</rdfs:label>
    <rdfs:comment>Management report of the board of directors referenced in audit responsibilities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#JointVenture">
    <rdfs:label>JointVenture</rdfs:label>
    <rdfs:comment>A partnership arrangement where control is contractually shared and decisions require unanimous consent.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Organization"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Partnership"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Company"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ActivitiesOnBehalfOfThirdParties">
    <rdfs:label>ActivitiesOnBehalfOfThirdParties</rdfs:label>
    <rdfs:comment>Operations managed on behalf of third parties (e.g., the State) not appearing on the balance sheet of the public company.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BalanceSheet">
    <rdfs:label>BalanceSheet</rdfs:label>
    <rdfs:comment>A consolidated statement presenting assets and liabilities at a reporting date.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityConsolidatedCompanyInterest">
    <rdfs:label>EquityConsolidatedCompanyInterest</rdfs:label>
    <rdfs:comment>An interest in an equity-consolidated company presented after equity method adjustments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StatutoryAuditorsReport">
    <rdfs:label>StatutoryAuditorsReport</rdfs:label>
    <rdfs:comment>A report issued by statutory auditors on the limited review of the interim consolidated financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidatedFinancialStatement">
    <rdfs:label>ConsolidatedFinancialStatement</rdfs:label>
    <rdfs:comment>A financial statement that aggregates the financial position and performance of a group of companies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GrossOperatingIncome">
    <rdfs:label>GrossOperatingIncome</rdfs:label>
    <rdfs:comment>Income before cost of risk and other operating items.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#KYCProcess">
    <rdfs:label>KYCProcess</rdfs:label>
    <rdfs:comment>Know Your Customer due diligence performed as part of regulatory checks.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DueDiligenceProcess"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExternalAuditors">
    <rdfs:label>ExternalAuditors</rdfs:label>
    <rdfs:comment>Independent auditors certifying financial accounts.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AdvisoryCommittee">
    <rdfs:label>AdvisoryCommittee</rdfs:label>
    <rdfs:comment>Advisory governance committee set up for specific themes such as financing/guarantees, innovation, and climate.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Bank">
    <rdfs:label>Bank</rdfs:label>
    <rdfs:comment>A credit institution referenced as providing personal data and as a potential support customer for solutions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CreditInstitution"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentUnit">
    <rdfs:label>InvestmentUnit</rdfs:label>
    <rdfs:comment>A structured unit distinguished by sector or stage of intervention within investment activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentBusinessLine"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RiskManagementTool">
    <rdfs:label>RiskManagementTool</rdfs:label>
    <rdfs:comment>A tool used to map and summarise risks by potential impact and probability, incorporating control measures.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicInstitution">
    <rdfs:label>PublicInstitution</rdfs:label>
    <rdfs:comment>A public institution whose activities and financial statements are prepared under French accounting rules.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetCashFlowFromFinancingOperations">
    <rdfs:label>NetCashFlowFromFinancingOperations</rdfs:label>
    <rdfs:comment>Net cash flow from financing operations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancingActivities"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidationMethod">
    <rdfs:label>ConsolidationMethod</rdfs:label>
    <rdfs:comment>The accounting approach used to consolidate entities depending on the nature of control (full consolidation vs equity method).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GreenFinancingFramework">
    <rdfs:label>GreenFinancingFramework</rdfs:label>
    <rdfs:comment>Framework document defining eligible green categories, eligibility criteria, evaluation process, and reporting for green financing instruments.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityConsolidationAdjustments">
    <rdfs:label>EquityConsolidationAdjustments</rdfs:label>
    <rdfs:comment>Adjustments made when applying the equity method, including restatements and eliminations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityMethod"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Provisions">
    <rdfs:label>Provisions</rdfs:label>
    <rdfs:comment>Liabilities of uncertain timing or amount recognized when an outflow is probable from a past event.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentProgrammeOperator">
    <rdfs:label>InvestmentProgrammeOperator</rdfs:label>
    <rdfs:comment>An operator implementing public investment programmes such as Investing in the Future and France 2030.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherReceivable">
    <rdfs:label>OtherReceivable</rdfs:label>
    <rdfs:comment>Receivables other than those explicitly classified as loans or cash equivalents.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TransitionRisk">
    <rdfs:label>TransitionRisk</rdfs:label>
    <rdfs:comment>Risks of losses from inadequate adaptation to a low-carbon economy and transition-related constraints.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ClimateRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetInterestMargin">
    <rdfs:label>NetInterestMargin</rdfs:label>
    <rdfs:comment>Component of net banking income representing net interest margin.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NetBankingIncome"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SustainableDevelopmentGoal">
    <rdfs:label>SustainableDevelopmentGoal</rdfs:label>
    <rdfs:comment>UN sustainable development goals referenced as additional alignment targets for evaluation and selection.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancingBusinessLine">
    <rdfs:label>FinancingBusinessLine</rdfs:label>
    <rdfs:comment>A business line providing financing to companies, including loans, leasing, and working capital support.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BpifranceGroup">
    <rdfs:label>BpifranceGroup</rdfs:label>
    <rdfs:comment>The group of entities collectively described as providing financing, guarantees, innovation support, investment, international development, and business support.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidatedFund">
    <rdfs:label>ConsolidatedFund</rdfs:label>
    <rdfs:comment>A fund included in or removed from the consolidation scope based on consolidation rules.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidationScope"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ESGCommittee">
    <rdfs:label>ESGCommittee</rdfs:label>
    <rdfs:comment>A committee referenced as reviewing and improving ESG questionnaires.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FundOfFundsBusiness">
    <rdfs:label>FundOfFundsBusiness</rdfs:label>
    <rdfs:comment>Business line contributing distributions and changes in fund-of-funds value to income.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NetBankingIncome"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EMTNProgramme">
    <rdfs:label>EMTNProgramme</rdfs:label>
    <rdfs:comment>A bond issuance programme (Euro Medium Term Notes) referenced for medium and long-term refinancing.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentProgramme"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OrganizationalChartOfBusinessLines">
    <rdfs:label>OrganizationalChartOfBusinessLines</rdfs:label>
    <rdfs:comment>Organizational chart describing business lines and related directorates.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChart"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CompensationPaidToAdministrativeBodiesMembers">
    <rdfs:label>CompensationPaidToAdministrativeBodiesMembers</rdfs:label>
    <rdfs:comment>Compensation paid to members of administrative bodies.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ClimateKit">
    <rdfs:label>ClimateKit</rdfs:label>
    <rdfs:comment>A communication and guidance kit on climate and ESG good practices distributed to invested funds and management companies.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DefinedBenefitPlan">
    <rdfs:label>DefinedBenefitPlan</rdfs:label>
    <rdfs:comment>Employee benefit plan generating actuarial gains and losses recognized in equity when applicable.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InvestmentProcess">
    <rdfs:label>InvestmentProcess</rdfs:label>
    <rdfs:comment>The end-to-end workflow for integrating ESG criteria, including due diligence and monitoring phases.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EuropeanRegulation">
    <rdfs:label>EuropeanRegulation</rdfs:label>
    <rdfs:comment>A regulatory instrument referenced for personal data protection (e.g., GDPR).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialAssets">
    <rdfs:label>FinancialAssets</rdfs:label>
    <rdfs:comment>Assets classified as financial assets, including equity investments, portfolio securities, and loans.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BalanceSheet"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NetCashFlowFromInvestingActivities">
    <rdfs:label>NetCashFlowFromInvestingActivities</rdfs:label>
    <rdfs:comment>Net cash flow from investing activities.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestingActivities"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BusinessLoginData">
    <rdfs:label>BusinessLoginData</rdfs:label>
    <rdfs:comment>Personal data used for portal access and authentication (e.g., IP address, tokens, signature certificate).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalDataCategory"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancingCommitment">
    <rdfs:label>FinancingCommitment</rdfs:label>
    <rdfs:comment>Financing commitments given or received (e.g., commitments to credit institutions/customers).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitment"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitments"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DiligencePack">
    <rdfs:label>DiligencePack</rdfs:label>
    <rdfs:comment>A pre-investment documentation package including an ESG questionnaire for fund-of-funds management companies.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ComplaintBody">
    <rdfs:label>ComplaintBody</rdfs:label>
    <rdfs:comment>An authority where individuals can lodge complaints regarding data protection.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CommercialRelationship">
    <rdfs:label>CommercialRelationship</rdfs:label>
    <rdfs:comment>The commercial relationship between the controller and customers/prospects, including management and reporting.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityAccountingMethod">
    <rdfs:label>EquityAccountingMethod</rdfs:label>
    <rdfs:comment>Equity-accounting method referenced as the consolidation approach for certain companies.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DeferredIncome">
    <rdfs:label>DeferredIncome</rdfs:label>
    <rdfs:comment>Income recognized over time (e.g., deferred income such as guarantee commissions to be spread).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialLiability"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Liabilities"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationFinancingAid">
    <rdfs:label>InnovationFinancingAid</rdfs:label>
    <rdfs:comment>Aid provided for innovation financing activities, accounted for as part of financing operations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FullConsolidation">
    <rdfs:label>FullConsolidation</rdfs:label>
    <rdfs:comment>A consolidation method used for entities over which complete control is exercised.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidationMethod"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidatedBalanceSheet">
    <rdfs:label>ConsolidatedBalanceSheet</rdfs:label>
    <rdfs:comment>Balance sheet presented within consolidated financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BalanceSheet"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NewsletterSending">
    <rdfs:label>NewsletterSending</rdfs:label>
    <rdfs:comment>A process of sending newsletters to individuals under the policy.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CommercialProspectingPurpose"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Bond">
    <rdfs:label>Bond</rdfs:label>
    <rdfs:comment>A fixed-income security referenced in fair value and amortised cost disclosures.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Securities"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Director">
    <rdfs:label>Director</rdfs:label>
    <rdfs:comment>Member roles serving on the board of directors, including directors representing the State.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#BoardOfDirectors"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperationalRiskDepartment">
    <rdfs:label>OperationalRiskDepartment</rdfs:label>
    <rdfs:comment>A department within compliance and permanent control responsible for organisation and functioning of operational risk and non-compliance control.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ComplianceAndPermanentControlDepartment"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExecutiveManagement">
    <rdfs:label>ExecutiveManagement</rdfs:label>
    <rdfs:comment>Executive management roles referenced in the organizational charts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OrganizationalChart"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Resolution">
    <rdfs:label>Resolution</rdfs:label>
    <rdfs:comment>A formal decision submitted to and adopted by a general meeting.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FairValueHierarchy">
    <rdfs:label>FairValueHierarchy</rdfs:label>
    <rdfs:comment>The classification of fair value inputs into levels based on quoted prices, observable inputs, or unobservable inputs.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FairValueMeasurement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#GrowthFund">
    <rdfs:label>GrowthFund</rdfs:label>
    <rdfs:comment>A fund category focused on growth-stage investments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#TrustedServiceProviderNetheos">
    <rdfs:label>TrustedServiceProviderNetheos</rdfs:label>
    <rdfs:comment>A trusted service provider used for implementing the advanced electronic signature process (named in text).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#TrustedServiceProvider"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#NonFinancialPerformanceStatement">
    <rdfs:label>NonFinancialPerformanceStatement</rdfs:label>
    <rdfs:comment>A statement reporting non-financial performance metrics such as training figures.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CorporateGovernanceReport">
    <rdfs:label>CorporateGovernanceReport</rdfs:label>
    <rdfs:comment>A report section describing corporate governance information for the issuer.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicResources">
    <rdfs:label>PublicResources</rdfs:label>
    <rdfs:comment>Public resources and intervention resources presented as other financial liabilities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InterestAndSimilarIncome">
    <rdfs:label>InterestAndSimilarIncome</rdfs:label>
    <rdfs:comment>Interest and similar income line item.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialIncome"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#KycCompliancePurpose">
    <rdfs:label>KycCompliancePurpose</rdfs:label>
    <rdfs:comment>A purpose for processing personal data related to Know Your Customer requirements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Agreement">
    <rdfs:label>Agreement</rdfs:label>
    <rdfs:comment>Inter-institutional agreements used to implement missions and programmes (e.g., PIA, aid schemes, deployment agreements).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AdministrativeBodyMemberCompensation">
    <rdfs:label>AdministrativeBodyMemberCompensation</rdfs:label>
    <rdfs:comment>Disclosure category for compensation paid to members of administrative bodies.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CommitmentsGiven">
    <rdfs:label>CommitmentsGiven</rdfs:label>
    <rdfs:comment>Off-balance-sheet commitments given by the entity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitments"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OperatingExpenditure">
    <rdfs:label>OperatingExpenditure</rdfs:label>
    <rdfs:comment>Expenditure figure used to compute operating performance ratios.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternationalDataTransfer">
    <rdfs:label>InternationalDataTransfer</rdfs:label>
    <rdfs:comment>Transfer of personal data outside the European Union under GDPR adequacy decisions or derogations/appropriate safeguards.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalDataDisclosure"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DataSubject">
    <rdfs:label>DataSubject</rdfs:label>
    <rdfs:comment>An individual whose personal data is processed in the recruitment context.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#InternationalFinancialReportingStandard">
    <rdfs:label>InternationalFinancialReportingStandard</rdfs:label>
    <rdfs:comment>International Financial Reporting Standards (IFRS) referenced as the basis for consolidated financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#AccountingStandard"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#LiquidityManagementProcedure">
    <rdfs:label>LiquidityManagementProcedure</rdfs:label>
    <rdfs:comment>Internal procedures for managing liquidity and temporary investments of unallocated proceeds.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EconomicAndFinancialData">
    <rdfs:label>EconomicAndFinancialData</rdfs:label>
    <rdfs:comment>Personal data related to economic and financial status (e.g., bank details, tax situation, identifiers).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#PersonalDataCategory"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AnnualReport">
    <rdfs:label>AnnualReport</rdfs:label>
    <rdfs:comment>A published report covering a specific financial year, including consolidated and separate financial statements and related notes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ESGRisk">
    <rdfs:label>ESGRisk</rdfs:label>
    <rdfs:comment>A risk category arising from ESG issues, including ethical, environmental, and social controversies.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DerecognitionEvent">
    <rdfs:label>DerecognitionEvent</rdfs:label>
    <rdfs:comment>Events leading to derecognition of financial assets or liabilities (expiration of rights or extinguishment of obligations).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EnvironmentalObjective">
    <rdfs:label>EnvironmentalObjective</rdfs:label>
    <rdfs:comment>EU environmental objectives that eligible activities and loans aim to support.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancingActivities">
    <rdfs:label>FinancingActivities</rdfs:label>
    <rdfs:comment>Cash flows resulting from changes in the financial structure, including equity and long-term borrowings.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CashFlowStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#AntiMoneyLaunderingPurpose">
    <rdfs:label>AntiMoneyLaunderingPurpose</rdfs:label>
    <rdfs:comment>A purpose for processing personal data to fight money laundering.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Portfolio">
    <rdfs:label>Portfolio</rdfs:label>
    <rdfs:comment>A collection of investments managed and monitored, including ESG and climate-risk assessment at consolidated level.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ConsolidatedFinancialStatementsAuditReport">
    <rdfs:label>ConsolidatedFinancialStatementsAuditReport</rdfs:label>
    <rdfs:comment>Statutory auditor report on the consolidated financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditorReport"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Loans">
    <rdfs:label>Loans</rdfs:label>
    <rdfs:comment>A financing product category used to finance businesses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAssets"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RelatedParty">
    <rdfs:label>RelatedParty</rdfs:label>
    <rdfs:comment>An entity related to the group for which transactions and balances are disclosed (e.g., entities included in the consolidation scope).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CreditRiskBucket">
    <rdfs:label>CreditRiskBucket</rdfs:label>
    <rdfs:comment>A classification bucket used to allocate exposures based on credit risk increase and expected losses.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ForwardLookingScenarios">
    <rdfs:label>ForwardLookingScenarios</rdfs:label>
    <rdfs:comment>A set of scenarios updated over time and used to compute ECLs.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#MacroeconomicScenario"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#PublicProcurementCode">
    <rdfs:label>PublicProcurementCode</rdfs:label>
    <rdfs:comment>The legal framework referenced for public procurement rules applicable to certain processing purposes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FullConsolidationMethod">
    <rdfs:label>FullConsolidationMethod</rdfs:label>
    <rdfs:comment>A consolidation method used when complete control is exercised over an entity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#ConsolidationMethod"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ThirdPartyActivity">
    <rdfs:label>ThirdPartyActivity</rdfs:label>
    <rdfs:comment>Activities managed on behalf of third parties (e.g., on behalf of the State) that do not appear on the balance sheet of the public company.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExpectedCreditLoss">
    <rdfs:label>ExpectedCreditLoss</rdfs:label>
    <rdfs:comment>Expected credit losses (ECL) calculated using macroeconomic scenarios and model adjustments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#CreditRisk"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RelationshipManagement">
    <rdfs:label>RelationshipManagement</rdfs:label>
    <rdfs:comment>Processing to identify, exchange, and manage the business relationship with a public or media personality.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataProcessingActivity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RelatedPartyTransaction">
    <rdfs:label>RelatedPartyTransaction</rdfs:label>
    <rdfs:comment>Transactions with related parties disclosed in notes to the financial statements.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExpectedCreditLossCalculation">
    <rdfs:label>ExpectedCreditLossCalculation</rdfs:label>
    <rdfs:comment>Method for calculating expected credit losses (ECL) used to assess credit risk.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#StatutoryAuditorReport">
    <rdfs:label>StatutoryAuditorReport</rdfs:label>
    <rdfs:comment>A report issued by statutory auditors on financial statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialStatement"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Goodwill">
    <rdfs:label>Goodwill</rdfs:label>
    <rdfs:comment>Intangible asset arising from acquisition accounting when acquisition cost exceeds the acquired share of net assets revalued.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CompetentAuthority">
    <rdfs:label>CompetentAuthority</rdfs:label>
    <rdfs:comment>A regulatory body competent to approve or receive filings under applicable securities regulations.</rdfs:comment>
  </owl:Class>
</rdf:RDF>
