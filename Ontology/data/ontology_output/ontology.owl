    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IFRSICDecision">
    <rdfs:label>IFRSICDecision</rdfs:label>
