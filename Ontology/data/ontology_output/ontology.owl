    <rdfs:comment>Total amount of other commitments given under an agreement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasDataProtectionOfficer">
    <rdfs:label>hasDataProtectionOfficer</rdfs:label>
    <rdfs:comment>Indicates the data protection officer of the Bpifrance group contacted by individuals to exercise their rights.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroupEntity"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataController"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DataProtectionOfficer"/>
  </owl:ObjectProperty>
