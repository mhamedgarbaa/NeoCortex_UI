  <owl:Class rdf:about="https://talan.com/ontology/bpi#InnovationProjects">
    <rdfs:label>InnovationProjects</rdfs:label>
    <rdfs:comment>Projects supported to foster innovation.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasExtraordinaryExpenses">
    <rdfs:label>hasExtraordinaryExpenses</rdfs:label>
    <rdfs:comment>Relates the financial statement section on extraordinary expenses to extraordinary expense items.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ExtraordinaryExpense"/>
