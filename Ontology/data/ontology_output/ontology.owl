    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BiodiversityConservationPolicy">
    <rdfs:label>BiodiversityConservationPolicy</rdfs:label>
