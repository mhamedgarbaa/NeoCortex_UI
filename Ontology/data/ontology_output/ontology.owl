    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DataController"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasRiskManagementSystem">
    <rdfs:label>hasRiskManagementSystem</rdfs:label>
