    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentBusinessLine"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#otherCommitmentsGivenAmount">
