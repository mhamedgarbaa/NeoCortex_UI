    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Bpifrance"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Loans"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#FinancialLeasing">
    <rdfs:label>FinancialLeasing</rdfs:label>
    <rdfs:comment>Financial leasing arrangements referenced as part of investment financing.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Leasing"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOtherDebtsByRemainingTerm">
    <rdfs:label>hasOtherDebtsByRemainingTerm</rdfs:label>
    <rdfs:comment><![CDATA[Relates other debts to their breakdown by remaining term (e.g., D ≤ 1 year, 1 year < D ≤ 5 years, D > 5 years).]]></rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OtherDebt"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#solvencyCET1RatioValue">
