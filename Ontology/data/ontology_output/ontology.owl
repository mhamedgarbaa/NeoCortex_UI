    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitmentsReceived"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProgrammeOperator">
    <rdfs:label>ProgrammeOperator</rdfs:label>
    <rdfs:comment>Operator role for programmes financed under the Investing in the Future Programme (e.g., core operator of financing).</rdfs:comment>
