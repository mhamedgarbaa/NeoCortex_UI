    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#NetCashFlowFromOperatingActivities"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#holdsStakeIn">
