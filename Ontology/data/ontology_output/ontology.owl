    <rdfs:comment>Governance body determined by law for oversight of compensation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GovernanceBody"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#taxReceivablesAmount">
    <rdfs:label>taxReceivablesAmount</rdfs:label>
    <rdfs:comment>Tax receivables amount included in other receivables (in thousands of euros).</rdfs:comment>
