    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholderEquity"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ShareholdersEquity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
