  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#fairValueLevel3Total">
    <rdfs:label>fairValueLevel3Total</rdfs:label>
    <rdfs:comment>Fair value amount at Level 3 (total) for the reporting date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchyLevel"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FairValueLevel3"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CompensationPaidToAdministrativeBodiesNote">
    <rdfs:label>CompensationPaidToAdministrativeBodiesNote</rdfs:label>
