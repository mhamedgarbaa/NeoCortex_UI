    <rdfs:label>netIncomeAmount</rdfs:label>
    <rdfs:comment>Net income amount reported for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#NetIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#adoptsPolicyDocument">
    <rdfs:label>adoptsPolicyDocument</rdfs:label>
