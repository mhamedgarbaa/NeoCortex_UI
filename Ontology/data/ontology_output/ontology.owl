    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#interestAndSimilarExpenseAmount">
    <rdfs:label>interestAndSimilarExpenseAmount</rdfs:label>
    <rdfs:comment>Amount of interest and similar expenses.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InterestExpense"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CapitalDevelopmentBusinessLine">
    <rdfs:label>CapitalDevelopmentBusinessLine</rdfs:label>
