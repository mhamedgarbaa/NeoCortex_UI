    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#StructuredEntity"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EventInvitation">
    <rdfs:label>EventInvitation</rdfs:label>
    <rdfs:comment>Processing undertaken to invite a public or media figure to an event organized by or for the organization.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DataProcessingActivity"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CashFlowHedging">
