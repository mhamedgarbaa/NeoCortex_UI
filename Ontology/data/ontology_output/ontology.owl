<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteesProvidedAmount">
    <rdfs:label>guaranteesProvidedAmount</rdfs:label>
    <rdfs:comment>Guarantees provided amount at the reporting date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#Guarantees"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#RecyclableGainsAndLosses">
    <rdfs:label>RecyclableGainsAndLosses</rdfs:label>
    <rdfs:comment>Equity-recognized gains and losses that can be reclassified (recycled) into net income.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#GainsAndLossesRecognisedDirectlyInEquity"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#loanFinancingCommitmentsReceived">
    <rdfs:label>loanFinancingCommitmentsReceived</rdfs:label>
    <rdfs:comment>Loan financing commitments received from credit institutions for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#BondsAndFixedIncomeSecurities">
    <rdfs:label>BondsAndFixedIncomeSecurities</rdfs:label>
    <rdfs:comment>Bonds and fixed-income securities referenced in fair value measurement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DebtInstrument"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasConsolidatedIncomeStatement">
    <rdfs:label>hasConsolidatedIncomeStatement</rdfs:label>
    <rdfs:comment>Indicates that consolidated financial statements include a consolidated income statement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ConsolidatedIncomeStatement"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#CulturalAndCreativeIndustriesUnit">
    <rdfs:label>CulturalAndCreativeIndustriesUnit</rdfs:label>
    <rdfs:comment>An investment unit investing in cultural and creative industries via dedicated funds.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentUnit"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ProjectEvaluationAndSelectionProcess">
    <rdfs:label>ProjectEvaluationAndSelectionProcess</rdfs:label>
    <rdfs:comment>Process pillar describing how projects/loans are evaluated and selected for eligibility.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasFinancingCommitments">
    <rdfs:label>hasFinancingCommitments</rdfs:label>
    <rdfs:comment>Connects financing commitments to the underlying financing agreement(s).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancingAgreement"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancingCommitments"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#amountOfRisksGuaranteedByRegions">
    <rdfs:label>amountOfRisksGuaranteedByRegions</rdfs:label>
    <rdfs:comment>Amount of risks guaranteed by Bpifrance Régions reported for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#periodEnd">
    <rdfs:label>periodEnd</rdfs:label>
    <rdfs:comment>End date of the financial period covered by the statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialYear"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#climatePlanLaunchYear">
    <rdfs:label>climatePlanLaunchYear</rdfs:label>
    <rdfs:comment>Year the Climate Plan was launched (e.g., 2020).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGuaranteeCommitmentsReceived">
    <rdfs:label>hasGuaranteeCommitmentsReceived</rdfs:label>
    <rdfs:comment>Relates guarantee commitments received to the off-balance sheet commitments section.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GuaranteeCommitments"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#greenhouseGasReductionPolicyShare">
    <rdfs:label>greenhouseGasReductionPolicyShare</rdfs:label>
    <rdfs:comment>Share of respondent businesses with a greenhouse gas reduction policy with engagements and targets (e.g., 45%).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#amendmentCompetentAuthority">
    <rdfs:label>amendmentCompetentAuthority</rdfs:label>
    <rdfs:comment>The competent authority responsible for the amendment (e.g., AMF).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#grantReceivable">
    <rdfs:label>grantReceivable</rdfs:label>
    <rdfs:comment>Grant receivable amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#GrantReceivable"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#auditsConsolidatedFinancialStatements">
    <rdfs:label>auditsConsolidatedFinancialStatements</rdfs:label>
    <rdfs:comment>The statutory auditor audits the consolidated financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#StatutoryAuditor"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#accountingStandardsAsAt">
    <rdfs:label>accountingStandardsAsAt</rdfs:label>
    <rdfs:comment>Accounting standards applicable as of a specific date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#liquidityReservesCurrentLiquidityBuffer">
    <rdfs:label>liquidityReservesCurrentLiquidityBuffer</rdfs:label>
    <rdfs:comment>Amount of current liquidity buffer (highly liquid assets mobilisable in less than a week).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#LiquidityReserve"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#fairValueTotal">
    <rdfs:label>fairValueTotal</rdfs:label>
    <rdfs:comment>Total fair value amount across all fair value hierarchy levels.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FairValue"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FairValueMeasurement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DeferredIncomeNote">
    <rdfs:label>DeferredIncomeNote</rdfs:label>
    <rdfs:comment>Note section dealing with deferred income.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#managesInvestments">
    <rdfs:label>managesInvestments</rdfs:label>
    <rdfs:comment>Indicates that the investment programme operator manages investment business activities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#InvestmentBusiness"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#testsEquityInvestmentForImpairment">
    <rdfs:label>testsEquityInvestmentForImpairment</rdfs:label>
    <rdfs:comment>Indicates that the equity investment (including goodwill) is tested for impairment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestment"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ImpairmentTest"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Accelerators">
    <rdfs:label>Accelerators</rdfs:label>
    <rdfs:comment>A support division responsible for marketing, training influencers and organizing accelerator programmes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SupportDivision"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasUnrealisedForeignExchangeGains">
    <rdfs:label>hasUnrealisedForeignExchangeGains</rdfs:label>
    <rdfs:comment>Indicates the presence of unrealised foreign exchange gains.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#UnrealisedForeignExchangeGain"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#usesFairValueHierarchyLevel">
    <rdfs:label>usesFairValueHierarchyLevel</rdfs:label>
    <rdfs:comment>Indicates that fair value is measured at a specific hierarchy level (e.g., Level 1/2/3).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchy"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FairValueHierarchyLevel"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#includesNetworkDirectorate">
    <rdfs:label>includesNetworkDirectorate</rdfs:label>
    <rdfs:comment>The organizational chart of the network includes network directorates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#OrganizationalChartOfNetwork"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#NetworkDirectorate"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#remainingDividendAmount">
    <rdfs:label>remainingDividendAmount</rdfs:label>
    <rdfs:comment>The amount of the remaining dividend to be distributed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DividendsPaid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DebtsOnFixedAssetsAndRelatedAccountsNote">
    <rdfs:label>DebtsOnFixedAssetsAndRelatedAccountsNote</rdfs:label>
    <rdfs:comment>Note section detailing debts on fixed assets and related accounts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#NotesToFinancialStatements"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EnvironmentalDiagnostic">
    <rdfs:label>EnvironmentalDiagnostic</rdfs:label>
    <rdfs:comment>Environmental diagnostic tools/assessments used to justify eligible green industry loans (e.g., carbon footprint, action plans).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#OtherCommitmentReceived">
    <rdfs:label>OtherCommitmentReceived</rdfs:label>
    <rdfs:comment>Other commitments received.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#OffBalanceSheetCommitment"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#economicAndFinancialDataTaxSituation">
    <rdfs:label>economicAndFinancialDataTaxSituation</rdfs:label>
    <rdfs:comment>Tax situation component of economic and financial data.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#EconomicAndFinancialData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#deferredIncome">
    <rdfs:label>deferredIncome</rdfs:label>
    <rdfs:comment>Deferred income amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#DeferredIncome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#providesExternalAssuranceOn">
    <rdfs:label>providesExternalAssuranceOn</rdfs:label>
    <rdfs:comment>Indicates that the bank provides external third-party assurance regarding allocation and reporting compliance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ExternalAuditors"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#amendmentTitle">
    <rdfs:label>amendmentTitle</rdfs:label>
    <rdfs:comment>Title or label of the amendment to the universal registration document.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DevelopmentCapitalInvestment">
    <rdfs:label>DevelopmentCapitalInvestment</rdfs:label>
    <rdfs:comment>Direct development capital investment referenced as an equity investment activity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityInvestmentActivity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#preparesInAccordanceWith">
    <rdfs:label>preparesInAccordanceWith</rdfs:label>
    <rdfs:comment>Implied by reference to EU adoption of standards; noted as a generic EU framework application.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EuropeanGeneralDataProtectionRegulation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#conductsShareholderDialogue">
    <rdfs:label>conductsShareholderDialogue</rdfs:label>
    <rdfs:comment>Indicates that the group conducts shareholder dialogue/engagement with portfolio companies and fund managers.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ShareholderDialogue"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#guaranteeCommissionsForBpifranceIssuesToBeReceived">
    <rdfs:label>guaranteeCommissionsForBpifranceIssuesToBeReceived</rdfs:label>
    <rdfs:comment>Guarantee commissions for Bpifrance issues to be received.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#TradeReceivable"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#preparesParentEntityFinancialStatements">
    <rdfs:label>preparesParentEntityFinancialStatements</rdfs:label>
    <rdfs:comment>Indicates that the institution prepares parent entity financial statements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ParentEntityFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#FinancialStatements"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Participation">
    <rdfs:label>Participation</rdfs:label>
    <rdfs:comment>An invested interest in a company, including participations in which the organization has invested and monitors.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#calculatesExpectedCreditLossesUsing">
    <rdfs:label>calculatesExpectedCreditLossesUsing</rdfs:label>
    <rdfs:comment>Indicates that expected credit losses are calculated using forward-looking scenarios.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ECLModel"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ForwardLookingScenarios"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasImpairmentOfAssets">
    <rdfs:label>hasImpairmentOfAssets</rdfs:label>
    <rdfs:comment>Indicates that impairment is considered under IAS 36 for equity-method investments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ImpairmentOfAssets"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EcotechnologiesFund2">
    <rdfs:label>EcotechnologiesFund2</rdfs:label>
    <rdfs:comment>Ecotechnologies Fund 2 referenced in equity investments.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Fund"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#participatesIn">
    <rdfs:label>participatesIn</rdfs:label>
    <rdfs:comment>Indicates that the group participates in networks/initiatives (e.g., clubs/initiatives) for responsible investment and biodiversity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Network"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#expectedRisksAmount">
    <rdfs:label>expectedRisksAmount</rdfs:label>
    <rdfs:comment>Amount of expected risks for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ExpectedRisks"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#ppMTRAllowanceAmount">
    <rdfs:label>ppMTRAllowanceAmount</rdfs:label>
    <rdfs:comment>PPMTR allowance amount (in thousands of euros).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PPMTRAllowance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#IndustrialProjectInvestmentsUnit">
    <rdfs:label>IndustrialProjectInvestmentsUnit</rdfs:label>
    <rdfs:comment>An investment unit managing equity investments for deeptech start-ups until industrialisation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#InvestmentUnit"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasDerecognitionOfFinancialAssets">
    <rdfs:label>hasDerecognitionOfFinancialAssets</rdfs:label>
    <rdfs:comment>Indicates that the notes describe derecognition of financial assets.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#DerecognitionOfFinancialAssets"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasGrossOperatingIncome">
    <rdfs:label>hasGrossOperatingIncome</rdfs:label>
    <rdfs:comment>States the gross operating income figure reported in the financial results.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GrossOperatingIncome"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasLoans">
    <rdfs:label>hasLoans</rdfs:label>
    <rdfs:comment>Indicates that the institution holds loans as financial assets.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicInstitution"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicSectorInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Loans"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#consolidatesJointVentureUsingEquityMethod">
    <rdfs:label>consolidatesJointVentureUsingEquityMethod</rdfs:label>
    <rdfs:comment>A joint venture is consolidated using the equity method (IFRS 11).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestee"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethod"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#JointVenture"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityInstrument">
    <rdfs:label>EquityInstrument</rdfs:label>
    <rdfs:comment>A financial instrument representing an equity interest, accounted for at fair value through equity or profit/loss depending on designation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#Securities"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialAsset"/>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#financialExpenses">
    <rdfs:label>financialExpenses</rdfs:label>
    <rdfs:comment>Total financial expenses amount.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialExpenses"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#communicatesPersonalDataTo">
    <rdfs:label>communicatesPersonalDataTo</rdfs:label>
    <rdfs:comment>Indicates that personal data may be communicated to administrative authorities in the context of legal procedures.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PersonalDataProcessing"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#AdministrativeAuthority"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#JudicialAuthority"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ArbitralAuthority"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#SupervisoryAuthority"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#ExternalAudit">
    <rdfs:label>ExternalAudit</rdfs:label>
    <rdfs:comment>External third-party assurance/audit certifying allocation of proceeds and compliance of allocation reporting.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#DueDiligence"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#innovationAssetsUnderManagement">
    <rdfs:label>innovationAssetsUnderManagement</rdfs:label>
    <rdfs:comment>Innovation component (including SPI Fund) of assets under management reported for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FundOfFundsBusiness"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#measuredListedPortfolioShare2020">
    <rdfs:label>measuredListedPortfolioShare2020</rdfs:label>
    <rdfs:comment>Percentage of the listed portfolio measured in 2020.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasOperationalRisk">
    <rdfs:label>hasOperationalRisk</rdfs:label>
    <rdfs:comment>Indicates that risk exposure includes operational risk.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RiskExposure"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#OperationalRisk"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasCurrentTax">
    <rdfs:label>hasCurrentTax</rdfs:label>
    <rdfs:comment>Indicates that the notes describe current tax recognition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ConsolidatedFinancialStatements"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#CurrentTax"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasESGCommittee">
    <rdfs:label>hasESGCommittee</rdfs:label>
    <rdfs:comment>Indicates that the group has an ESG committee involved in ESG questionnaire/workflow and governance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicGroup"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#ESGCommittee"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#mappedSitesToIdentifyKBAShare">
    <rdfs:label>mappedSitesToIdentifyKBAShare</rdfs:label>
    <rdfs:comment>Share of respondents mapping sites/activities to identify Key Biodiversity Areas (e.g., 4%).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#InvestmentProgrammeOperator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EligibleBiodiversityExpenditure">
    <rdfs:label>EligibleBiodiversityExpenditure</rdfs:label>
    <rdfs:comment>Eligible expenditures supporting biodiversity protection and related services/projects.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EligibleGreenLoan"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#Level3FairValueInstrument">
    <rdfs:label>Level3FairValueInstrument</rdfs:label>
    <rdfs:comment>A financial instrument measured using Level 3 fair value inputs requiring significant judgement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#FinancialInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#MidCapCompany">
    <rdfs:label>MidCapCompany</rdfs:label>
    <rdfs:comment>A company category targeted for growth investments within mid-cap divisions.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#shareCapitalAmount">
    <rdfs:label>shareCapitalAmount</rdfs:label>
    <rdfs:comment>Company share capital amount stated in the document (e.g., €5,440,000,000).</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#creditFinancingCommitmentsToClients">
    <rdfs:label>creditFinancingCommitmentsToClients</rdfs:label>
    <rdfs:comment>Credit financing commitments made to clients at the reporting date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancingCommitment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#DevelopmentSupportDivision">
    <rdfs:label>DevelopmentSupportDivision</rdfs:label>
    <rdfs:comment>A support division designing support products and negotiating agreements with partners.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#SupportDivision"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#guaranteesSecuritiesIssuedBy">
    <rdfs:label>guaranteesSecuritiesIssuedBy</rdfs:label>
    <rdfs:comment>Indicates that the institution acts as guarantor for securities issues by another entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GuaranteeProvider"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#receivesDividendsFrom">
    <rdfs:label>receivesDividendsFrom</rdfs:label>
    <rdfs:comment>Indicates that the institution receives dividends from its holdings.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicIndustrialAndCommercialInstitution"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Dividends"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityConsolidatedHolding">
    <rdfs:label>EquityConsolidatedHolding</rdfs:label>
    <rdfs:comment>The holding used to record impairments and allow reversal when conditions improve.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompanies"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#submitsResolutionsToGeneralMeeting">
    <rdfs:label>submitsResolutionsToGeneralMeeting</rdfs:label>
    <rdfs:comment>Indicates resolutions are submitted to the ordinary and extraordinary general meeting of shareholders.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicLimitedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#GeneralMeeting"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#profitOrLossAmount">
    <rdfs:label>profitOrLossAmount</rdfs:label>
    <rdfs:comment>Profit or loss amount for the period.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#ProfitOrLoss"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#hasSolvency">
    <rdfs:label>hasSolvency</rdfs:label>
    <rdfs:comment>States that solvency ratios confirm financial robustness.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#FinancialResults"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#BpifranceGroup"/>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#PublicSectorInvestmentBank"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#Solvency"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://talan.com/ontology/bpi#amendmentEffectiveDate">
    <rdfs:label>amendmentEffectiveDate</rdfs:label>
    <rdfs:comment>The date the amendment is certified/dated in the document.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#AmendmentToUniversalRegistrationDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://talan.com/ontology/bpi#isOriginatorAndManagerOfLoans">
    <rdfs:label>isOriginatorAndManagerOfLoans</rdfs:label>
