    <rdfs:label>retentionPeriodDescription</rdfs:label>
    <rdfs:comment>Description of how long personal data is kept, including that it does not exceed what is necessary for the stated purposes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://talan.com/ontology/bpi#RetentionPeriod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#SoftLoan">
