    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityConsolidatedCompany"/>
    <rdfs:range rdf:resource="https://talan.com/ontology/bpi#EquityMethodInvestee"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://talan.com/ontology/bpi#EquityPortfolio">
    <rdfs:label>EquityPortfolio</rdfs:label>
    <rdfs:comment>The portfolio of equity investments designated for fair value through equity treatment.</rdfs:comment>
  </owl:Class>
