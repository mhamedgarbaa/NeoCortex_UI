    rdfs:range xsd:string .

bpi:identificationDataTitle a owl:DatatypeProperty ;
    rdfs:label "identificationDataTitle" ;
    rdfs:comment "Personal title component of identification data." ;
    rdfs:domain bpi:IdentificationData ;
    rdfs:range xsd:string .

bpi:impactReportUntilMaturity a owl:DatatypeProperty ;
    rdfs:label "impactReportUntilMaturity" ;
