bpi:incorporatesConsolidatedFinancialStatementsOf a owl:ObjectProperty ;
    rdfs:label "incorporatesConsolidatedFinancialStatementsOf" ;
    rdfs:comment "Indicates that EPIC’s consolidated financial statements incorporate the consolidated financial statements of Bpifrance SA." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:ConsolidatedFinancialStatements,
        bpi:EquityConsolidatedCompany .

bpi:incorporatesEquityAccountedInvestments a owl:ObjectProperty ;
    rdfs:label "incorporatesEquityAccountedInvestments" ;
    rdfs:comment "Consolidated accounts include equity-accounted investments using the equity method." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityMethodAccounting .

bpi:incorporatesEquityMethodAccounting a owl:ObjectProperty ;
    rdfs:label "incorporatesEquityMethodAccounting" ;
    rdfs:comment "Indicates that consolidated accounts incorporate equity-accounting method for investments." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:EquityMethodAccounting .

