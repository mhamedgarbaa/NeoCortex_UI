bpi:implementsAgreementWith a owl:ObjectProperty ;
    rdfs:label "implementsAgreementWith" ;
    rdfs:comment "Indicates that EPIC implements agreements concluded with the State and other parties (e.g., in the framework of France 2030/PIA)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:Agreement .

bpi:implementsAgreementsWith a owl:ObjectProperty ;
    rdfs:label "implementsAgreementsWith" ;
    rdfs:comment "Indicates the institution implements agreements concluded with another party (e.g., agreements with the State and others)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:Agreement .

bpi:implementsGDPR a owl:ObjectProperty ;
    rdfs:label "implementsGDPR" ;
    rdfs:comment "Indicates that the personal data protection policy implements or is aligned with the GDPR." ;
    rdfs:domain bpi:PersonalDataProtectionPolicy ;
    rdfs:range bpi:GDPR .

bpi:includes a owl:ObjectProperty ;
    rdfs:label "includes" ;
    rdfs:comment "Indicates that the consolidated financial statements include equity-consolidated companies." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityConsolidatedCompany,
        bpi:EquityMethodInvestee .

bpi:includesActivitiesOnBehalfOfThirdParties a owl:ObjectProperty ;
    rdfs:label "includesActivitiesOnBehalfOfThirdParties" ;
    rdfs:comment "The notes disclose activities on behalf of third parties that are not included in the consolidated balance sheet." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:ThirdPartyActivity .

bpi:includesBusinessLine a owl:ObjectProperty ;
    rdfs:label "includesBusinessLine" ;
    rdfs:comment "The organizational chart of business lines includes business lines." ;
    rdfs:domain bpi:OrganizationalChartOfBusinessLines ;
    rdfs:range bpi:BusinessLine .

bpi:includesCompanies a owl:ObjectProperty ;
    rdfs:label "includesCompanies" ;
    rdfs:comment "Indicates that the consolidated financial statements include companies controlled or over which significant influence is exercised." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityConsolidatedCompany .

bpi:includesCompaniesControlledOrWithSignificantInfluence a owl:ObjectProperty ;
    rdfs:label "includesCompaniesControlledOrWithSignificantInfluence" ;
    rdfs:comment "Consolidated financial statements include companies the group controls or over which it exercises significant influence." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityConsolidatedCompany .

bpi:includesCompaniesInConsolidationScope a owl:ObjectProperty ;
    rdfs:label "includesCompaniesInConsolidationScope" ;
    rdfs:comment "Indicates that the consolidated financial statements include companies within the consolidation scope (exclusively controlled companies, joint ventures, and significant influence investees)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:ControlledCompany .

bpi:includesConsolidatedFinancialStatementsOf a owl:ObjectProperty ;
    rdfs:label "includesConsolidatedFinancialStatementsOf" ;
    rdfs:comment "Indicates that the consolidated financial statements include financial statements of entities accounted for using the equity method." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityMethodAccounting .

bpi:includesConsolidationScope a owl:ObjectProperty ;
    rdfs:label "includesConsolidationScope" ;
    rdfs:comment "Consolidated financial statements include information about the consolidation scope." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:ConsolidationScope .

bpi:includesControlledCompanies a owl:ObjectProperty ;
    rdfs:label "includesControlledCompanies" ;
    rdfs:comment "Indicates that consolidated financial statements include companies the group controls (subsidiaries)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:Subsidiary .

bpi:includesEquityConsolidatedCompanies a owl:ObjectProperty ;
    rdfs:label "includesEquityConsolidatedCompanies" ;
    rdfs:comment "Indicates that the consolidated financial statements include equity-consolidated companies." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityConsolidatedCompanies .

bpi:includesEquityInvestmentInEquityConsolidatedCompanies a owl:ObjectProperty ;
    rdfs:label "includesEquityInvestmentInEquityConsolidatedCompanies" ;
    rdfs:comment "Indicates that the consolidated statements include equity investments in equity-consolidated companies accounted for using the equity method." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityMethodInvestment .

bpi:includesGuaranteeCommitmentsGiven a owl:ObjectProperty ;
    rdfs:label "includesGuaranteeCommitmentsGiven" ;
    rdfs:comment "Notes disclose guarantee commitments given by the group." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:GuaranteeCommitments .

bpi:includesGuaranteeCommitmentsReceived a owl:ObjectProperty ;
    rdfs:label "includesGuaranteeCommitmentsReceived" ;
    rdfs:comment "Notes disclose guarantee commitments received by the group (even if nil)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:GuaranteeCommitments .

bpi:includesInConsolidation a owl:ObjectProperty ;
    rdfs:label "includesInConsolidation" ;
    rdfs:comment "The consolidated group includes legal entities accounted for using the equity method within the consolidation scope." ;
    rdfs:domain bpi:ConsolidatedGroup ;
    rdfs:range bpi:EquityMethodInvestee .

bpi:includesInConsolidationScope a owl:ObjectProperty ;
    rdfs:label "includesInConsolidationScope" ;
    rdfs:comment "Equity method investees are included in the consolidation scope for financial reporting." ;
    rdfs:domain bpi:ConsolidationScope ;
    rdfs:range bpi:EquityMethodInvestee .

bpi:includesNetCashFlowFromFinancingOperations a owl:ObjectProperty ;
    rdfs:label "includesNetCashFlowFromFinancingOperations" ;
    rdfs:comment "The cash flow table includes net cash flow from financing operations." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:NetCashFlowFromFinancingOperations .

bpi:includesNetCashFlowFromInvestingActivities a owl:ObjectProperty ;
    rdfs:label "includesNetCashFlowFromInvestingActivities" ;
    rdfs:comment "The cash flow table includes net cash flow from investing activities." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:NetCashFlowFromInvestingActivities .

bpi:includesNetCashFlowFromOperatingActivities a owl:ObjectProperty ;
    rdfs:label "includesNetCashFlowFromOperatingActivities" ;
    rdfs:comment "The cash flow table includes net cash flow from operating activities." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:NetCashFlowFromOperatingActivities .

bpi:includesNetworkDirectorate a owl:ObjectProperty ;
    rdfs:label "includesNetworkDirectorate" ;
    rdfs:comment "The organizational chart of the network includes network directorates." ;
    rdfs:domain bpi:OrganizationalChartOfNetwork ;
    rdfs:range bpi:NetworkDirectorate .

bpi:includesRegionalDirectorate a owl:ObjectProperty ;
    rdfs:label "includesRegionalDirectorate" ;
    rdfs:comment "The organizational chart of the network includes regional directorates." ;
    rdfs:domain bpi:OrganizationalChartOfNetwork ;
    rdfs:range bpi:RegionalDirectorate .

bpi:includesSignificantlyInfluencedCompanies a owl:ObjectProperty ;
    rdfs:label "includesSignificantlyInfluencedCompanies" ;
    rdfs:comment "Indicates that consolidated financial statements include companies over which the group has significant influence (equity method investees)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityMethodCompany .

bpi:includesTerritorialDelegation a owl:ObjectProperty ;
    rdfs:label "includesTerritorialDelegation" ;
    rdfs:comment "The organizational chart of the network includes territorial delegations." ;
    rdfs:domain bpi:OrganizationalChartOfNetwork ;
    rdfs:range bpi:TerritorialDelegation .

bpi:includingGroupShare a owl:DatatypeProperty ;
    rdfs:label "includingGroupShare" ;
    rdfs:comment "Portion of net income and gains/losses directly recognised in equity attributable to the group." ;
    rdfs:domain bpi:NetIncome ;
    rdfs:range xsd:decimal .

bpi:includingMinorityInterestsShare a owl:DatatypeProperty ;
    rdfs:label "includingMinorityInterestsShare" ;
    rdfs:comment "Portion of net income and gains/losses directly recognised in equity attributable to minority interests." ;
    rdfs:domain bpi:NetIncome ;
    rdfs:range xsd:decimal .

bpi:incomeFromDisposalOfAssetsAmount a owl:DatatypeProperty ;
    rdfs:label "incomeFromDisposalOfAssetsAmount" ;
    rdfs:comment "Income from disposal of assets amount (in thousands of euros)." ;
    rdfs:domain bpi:IncomeFromDisposalOfAssets ;
    rdfs:range xsd:decimal .

bpi:incomeReceivedByCompanyEndorsementAmount a owl:DatatypeProperty ;
    rdfs:label "incomeReceivedByCompanyEndorsementAmount" ;
    rdfs:comment "Income received by the company endorsed (in thousands of euros)." ;
    rdfs:domain bpi:FinancialResults ;
    rdfs:range xsd:decimal .

bpi:incorporatesAccountsOfParentEntity a owl:ObjectProperty ;
    rdfs:label "incorporatesAccountsOfParentEntity" ;
    rdfs:comment "Indicates that consolidated accounts include the accounts of the parent entity." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:ParentEntityFinancialStatements .

bpi:incorporatesByReference a owl:ObjectProperty ;
    rdfs:label "incorporatesByReference" ;
    rdfs:comment "Indicates that the amendment incorporates other universal registration documents by reference as integral parts of the amendment." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range bpi:ConsolidatedFinancialStatements,
