bpi:incorporatesConsolidatedFinancialStatements a owl:ObjectProperty ;
    rdfs:label "incorporatesConsolidatedFinancialStatements" ;
    rdfs:comment "The consolidated accounts incorporate the parent entity accounts (i.e., parent entity financial statements are included in consolidation)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
