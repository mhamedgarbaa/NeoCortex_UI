bpi:professionalLifeDataEmail a owl:DatatypeProperty ;
    rdfs:label "professionalLifeDataEmail" ;
    rdfs:comment "Professional email address component of professional life data." ;
    rdfs:domain bpi:ProfessionalLifeData ;
    rdfs:range xsd:string .

bpi:professionalLifeDataPosition a owl:DatatypeProperty ;
    rdfs:label "professionalLifeDataPosition" ;
    rdfs:comment "Position/role within the company component of professional life data." ;
    rdfs:domain bpi:ProfessionalLifeData ;
    rdfs:range xsd:string .

bpi:professionalLifeDataPostalAddress a owl:DatatypeProperty ;
    rdfs:label "professionalLifeDataPostalAddress" ;
    rdfs:comment "Professional postal address component of professional life data." ;
    rdfs:domain bpi:ProfessionalLifeData ;
    rdfs:range xsd:string .

bpi:professionalLifeDataTelephoneNumber a owl:DatatypeProperty ;
    rdfs:label "professionalLifeDataTelephoneNumber" ;
    rdfs:comment "Professional telephone number component of professional life data." ;
    rdfs:domain bpi:ProfessionalLifeData ;
    rdfs:range xsd:string .

bpi:profitAmount a owl:DatatypeProperty ;
    rdfs:label "profitAmount" ;
    rdfs:comment "The profit amount recorded for the last financial year." ;
    rdfs:domain bpi:NetIncome ;
    rdfs:range xsd:decimal .

bpi:profitOrLossAmount a owl:DatatypeProperty ;
    rdfs:label "profitOrLossAmount" ;
    rdfs:comment "Profit or loss amount for the period." ;
    rdfs:domain bpi:ProfitOrLoss ;
    rdfs:range xsd:decimal .

bpi:profitOrLossForFinancialYear a owl:DatatypeProperty ;
    rdfs:label "profitOrLossForFinancialYear" ;
    rdfs:comment "Profit or loss for the financial year amount." ;
    rdfs:domain bpi:ProfitOrLossForFinancialYear ;
    rdfs:range xsd:decimal .

bpi:profitOrLossForFinancialYearAmount a owl:DatatypeProperty ;
    rdfs:label "profitOrLossForFinancialYearAmount" ;
    rdfs:comment "Profit or loss for the financial year included in shareholders' equity." ;
    rdfs:domain bpi:ProfitOrLossForFinancialYear,
        bpi:ShareholderEquity ;
    rdfs:range xsd:decimal .

bpi:profitOrLossForLastFinancialYearAmount a owl:DatatypeProperty ;
    rdfs:label "profitOrLossForLastFinancialYearAmount" ;
    rdfs:comment "Profit or loss for the last closed financial year (in thousands of euros)." ;
    rdfs:domain bpi:FinancialYearEarnings ;
    rdfs:range xsd:decimal .

bpi:provenRisks a owl:DatatypeProperty ;
    rdfs:label "provenRisks" ;
    rdfs:comment "Proven risks allocation amount (e.g., bucket 3) for the period." ;
    rdfs:domain bpi:ProvenRisks ;
    rdfs:range xsd:decimal .

bpi:provenRisksAmount a owl:DatatypeProperty ;
    rdfs:label "provenRisksAmount" ;
    rdfs:comment "Amount of proven risks for the period." ;
    rdfs:domain bpi:ProvenRisks ;
    rdfs:range xsd:decimal .

bpi:providesConsultingServices a owl:ObjectProperty ;
    rdfs:label "providesConsultingServices" ;
    rdfs:comment "Indicates that the investment programme operator provides consulting/advisory services." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range bpi:AdviceServices .

bpi:providesExportFinancingThrough a owl:ObjectProperty ;
    rdfs:label "providesExportFinancingThrough" ;
    rdfs:comment "Indicates that the group provides export financing through its export financing business line." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:ExportFinancingBusinessLine .

bpi:providesExportInsuranceThrough a owl:ObjectProperty ;
    rdfs:label "providesExportInsuranceThrough" ;
    rdfs:comment "Indicates that the group provides export insurance through its export insurance business line." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:ExportInsuranceBusinessLine .

bpi:providesExternalAssuranceOn a owl:ObjectProperty ;
    rdfs:label "providesExternalAssuranceOn" ;
    rdfs:comment "Indicates that the bank provides external third-party assurance regarding allocation and reporting compliance." ;
    rdfs:domain bpi:PublicInvestmentBank ;
    rdfs:range bpi:ExternalAuditors .

bpi:providesFinancingThrough a owl:ObjectProperty ;
    rdfs:label "providesFinancingThrough" ;
    rdfs:comment "Indicates that the group provides financing through its financing business line." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:FinancingBusinessLine .

bpi:providesGuaranteeFor a owl:ObjectProperty ;
    rdfs:label "providesGuaranteeFor" ;
    rdfs:comment "Indicates the institution provides guarantees (e.g., guaranteeing bond issues by Bpifrance)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:Guarantee .

bpi:providesGuaranteesFor a owl:ObjectProperty ;
    rdfs:label "providesGuaranteesFor" ;
    rdfs:comment "Indicates that EPIC provides guarantees for bond issues of Bpifrance SA." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:Guarantees .

bpi:providesGuaranteesThrough a owl:ObjectProperty ;
    rdfs:label "providesGuaranteesThrough" ;
    rdfs:comment "Indicates that the group provides guarantees through its guarantee business line." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:GuaranteeBusinessLine .

bpi:providesInnovationFinancingThrough a owl:ObjectProperty ;
    rdfs:label "providesInnovationFinancingThrough" ;
    rdfs:comment "Indicates that the group provides innovation financing through its innovation business line." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:InnovationBusinessLine .

bpi:providesSupportThrough a owl:ObjectProperty ;
    rdfs:label "providesSupportThrough" ;
    rdfs:comment "Indicates that the group provides business support through its support business line." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:BusinessSupportBusinessLine .

bpi:providesTraining a owl:ObjectProperty ;
    rdfs:label "providesTraining" ;
    rdfs:comment "Indicates that the group provides training via an online training platform and related learning modules." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:TrainingPlatform .

bpi:provisionsAmount a owl:DatatypeProperty ;
    rdfs:label "provisionsAmount" ;
    rdfs:comment "Provisions amount." ;
    rdfs:domain bpi:Provision ;
    rdfs:range xsd:decimal .

bpi:publicationDate a owl:DatatypeProperty ;
    rdfs:label "publicationDate" ;
    rdfs:comment "Date when the green financing framework is published." ;
    rdfs:domain bpi:GreenFinancingFramework,
        bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range xsd:date .

bpi:publishableBalanceSheetAmount a owl:DatatypeProperty ;
    rdfs:label "publishableBalanceSheetAmount" ;
    rdfs:comment "Numeric amount shown in the publishable balance sheet tables (values in thousands of euros)." ;
    rdfs:domain bpi:BalanceSheet ;
    rdfs:range xsd:decimal .

bpi:publishableBalanceSheetDate a owl:DatatypeProperty ;
    rdfs:label "publishableBalanceSheetDate" ;
    rdfs:comment "Reporting date used for the publishable balance sheet (e.g., 31/12/2023 and 31/12/2022)." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range xsd:date .

bpi:publishableIncomeStatementAmount a owl:DatatypeProperty ;
    rdfs:label "publishableIncomeStatementAmount" ;
    rdfs:comment "Numeric amount shown in the publishable income statement tables (values in thousands of euros)." ;
    rdfs:domain bpi:IncomeStatement ;
    rdfs:range xsd:decimal .

bpi:publishableIncomeStatementDate a owl:DatatypeProperty ;
    rdfs:label "publishableIncomeStatementDate" ;
    rdfs:comment "Reporting date used for the publishable income statement (e.g., 31/12/2023 and 31/12/2022)." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range xsd:date .

bpi:rcsNumber a owl:DatatypeProperty ;
    rdfs:label "rcsNumber" ;
    rdfs:comment "Company registration number (RCS) stated in the document (e.g., 320 252 489 RCS CRETEIL)." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range xsd:string .

bpi:receivablesForInnovationAndIndustryFund a owl:DatatypeProperty ;
    rdfs:label "receivablesForInnovationAndIndustryFund" ;
    rdfs:comment "Receivables for the Innovation and Industry Fund." ;
    rdfs:domain bpi:InnovationAndIndustryFund,
        bpi:OtherFinancialAssets ;
    rdfs:range xsd:decimal .

bpi:receivesDividendsFrom a owl:ObjectProperty ;
    rdfs:label "receivesDividendsFrom" ;
    rdfs:comment "Indicates that the institution receives dividends from its holdings." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:Dividends .

bpi:recognisesDividendsInOtherFinancialIncomeAndExpenses a owl:ObjectProperty ;
    rdfs:label "recognisesDividendsInOtherFinancialIncomeAndExpenses" ;
    rdfs:comment "Dividends are recorded in other financial income and expenses when related to equity instruments accounted for at fair value through profit or loss." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:Dividends .

bpi:recognisesFinancialAssetsAtFairValueThroughProfitOrLoss a owl:ObjectProperty ;
    rdfs:label "recognisesFinancialAssetsAtFairValueThroughProfitOrLoss" ;
    rdfs:comment "Indicates that certain financial assets are measured at fair value through profit or loss." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:FinancialAssetAtFairValueThroughProfitOrLoss .

bpi:recognisesFinancialAssetsAtFairValueThroughShareholdersEquity a owl:ObjectProperty ;
    rdfs:label "recognisesFinancialAssetsAtFairValueThroughShareholdersEquity" ;
    rdfs:comment "Indicates that certain financial assets are measured at fair value through shareholders’ equity." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:FinancialAssetAtFairValueThroughEquity .

bpi:recognisesFinancialLiabilitiesAtFairValueThroughProfitOrLoss a owl:ObjectProperty ;
    rdfs:label "recognisesFinancialLiabilitiesAtFairValueThroughProfitOrLoss" ;
    rdfs:comment "Indicates that certain financial liabilities are measured at fair value through profit or loss." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:FinancialLiabilityAtFairValueThroughProfitOrLoss .

bpi:recognisesImpairmentForEquityMethodInvestments a owl:ObjectProperty ;
    rdfs:label "recognisesImpairmentForEquityMethodInvestments" ;
    rdfs:comment "Equity method investments are tested for impairment and impairment losses are recognized when objective evidence exists." ;
    rdfs:domain bpi:EquityMethodInvestments ;
    rdfs:range bpi:ImpairmentTest .

bpi:recognisesImpairmentLossInIncomeStatement a owl:ObjectProperty ;
    rdfs:label "recognisesImpairmentLossInIncomeStatement" ;
    rdfs:comment "Indicates that impairment losses are recognised when recoverable amount is less than book value." ;
    rdfs:domain bpi:ImpairmentTest ;
    rdfs:range bpi:Impairment .

bpi:recognisesShareOfNetProfitFromEquityConsolidatedCompanies a owl:ObjectProperty ;
    rdfs:label "recognisesShareOfNetProfitFromEquityConsolidatedCompanies" ;
    rdfs:comment "Represents that the consolidated income statement includes the share of net profit from equity-consolidated companies." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityConsolidatedCompany .

bpi:recommendsVotingAgainstOrAbstaining a owl:ObjectProperty ;
    rdfs:label "recommendsVotingAgainstOrAbstaining" ;
    rdfs:comment "Indicates that the group recommends voting against or abstaining on certain resolutions when information is insufficient." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:Resolution .

bpi:referencesEuropeanCommissionDelegatedRegulation a owl:ObjectProperty ;
    rdfs:label "referencesEuropeanCommissionDelegatedRegulation" ;
    rdfs:comment "Indicates the cross-reference table is based on a specific European Commission delegated regulation." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:EuropeanCommissionDelegatedRegulation .

bpi:registeredOfficeAddress a owl:DatatypeProperty ;
    rdfs:label "registeredOfficeAddress" ;
    rdfs:comment "The registered office address of the company." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range xsd:string .

bpi:registeredOfficeCity a owl:DatatypeProperty ;
    rdfs:label "registeredOfficeCity" ;
    rdfs:comment "City of the registered office." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range xsd:string .

bpi:registeredOfficePostalCode a owl:DatatypeProperty ;
    rdfs:label "registeredOfficePostalCode" ;
    rdfs:comment "Postal code of the registered office." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range xsd:string .

bpi:regulationNumber a owl:DatatypeProperty ;
    rdfs:label "regulationNumber" ;
    rdfs:comment "Identifier of the applicable regulation referenced for the filing/approval context." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:string .

bpi:relatedDebtsAmount a owl:DatatypeProperty ;
    rdfs:label "relatedDebtsAmount" ;
    rdfs:comment "Related debts amount reported for the period (in thousands of euros)." ;
    rdfs:domain bpi:FinancialLoansAndFinancialDebts ;
    rdfs:range xsd:decimal .

bpi:relatedPartiesCommittedAmountUnderFrameworkAgreement a owl:DatatypeProperty ;
    rdfs:label "relatedPartiesCommittedAmountUnderFrameworkAgreement" ;
    rdfs:comment "Committed amount under the framework agreement between Bpifrance Participations and EPIC Bpifrance (total and/or annual amounts as disclosed)." ;
    rdfs:domain bpi:RelatedPartyTransaction ;
    rdfs:range xsd:decimal .

bpi:relatedReceivables a owl:DatatypeProperty ;
    rdfs:label "relatedReceivables" ;
    rdfs:comment "Related receivables amount." ;
    rdfs:domain bpi:OtherReceivables ;
    rdfs:range xsd:decimal .

bpi:relatedReceivablesAmount a owl:DatatypeProperty ;
    rdfs:label "relatedReceivablesAmount" ;
    rdfs:comment "Amount of related receivables associated with loans reported for the period (in thousands of euros)." ;
    rdfs:domain bpi:Loans,
        bpi:RelatedReceivable ;
    rdfs:range xsd:decimal .

bpi:remainingDividendAmount a owl:DatatypeProperty ;
    rdfs:label "remainingDividendAmount" ;
    rdfs:comment "The amount of the remaining dividend to be distributed." ;
    rdfs:domain bpi:DividendsPaid ;
    rdfs:range xsd:decimal .

bpi:remainingDividendPerShare a owl:DatatypeProperty ;
    rdfs:label "remainingDividendPerShare" ;
    rdfs:comment "The remaining dividend amount per share." ;
    rdfs:domain bpi:DividendsPaid ;
    rdfs:range xsd:decimal .

bpi:reportDate a owl:DatatypeProperty ;
    rdfs:label "reportDate" ;
    rdfs:comment "The publication or signing date of the report." ;
    rdfs:domain bpi:PressRelease ;
    rdfs:range xsd:date .

bpi:reportIssueDate a owl:DatatypeProperty ;
    rdfs:label "reportIssueDate" ;
    rdfs:comment "Date on which the statutory auditor report was issued (e.g., 25 March 2024)." ;
    rdfs:domain bpi:StatutoryAuditor ;
    rdfs:range xsd:date .

bpi:reportYear a owl:DatatypeProperty ;
    rdfs:label "reportYear" ;
    rdfs:comment "Financial/reporting year covered by the annual report." ;
    rdfs:domain bpi:AnnualReport,
        bpi:PressRelease,
        bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range xsd:integer .

bpi:reportingDate a owl:DatatypeProperty ;
    rdfs:label "reportingDate" ;
    rdfs:comment "Date to which the half-year consolidated financial statements are prepared (e.g., 30 June 2022)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FairValueMeasurement,
        bpi:FinancialYear,
        bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range xsd:date .

bpi:reportingFrequency a owl:DatatypeProperty ;
    rdfs:label "reportingFrequency" ;
    rdfs:comment "Frequency of publication for allocation and impact reports (annual basis)." ;
    rdfs:domain bpi:GreenFinancingFramework ;
    rdfs:range xsd:string .

bpi:reportingYear a owl:DatatypeProperty ;
    rdfs:label "reportingYear" ;
    rdfs:comment "Financial year to which the reported information applies (e.g., 2023)." ;
    rdfs:domain bpi:FinancialYear ;
    rdfs:range xsd:integer .

bpi:requestIdentityVerificationRequired a owl:DatatypeProperty ;
    rdfs:label "requestIdentityVerificationRequired" ;
    rdfs:comment "Indicates whether additional information may be requested to confirm the identity of the requester." ;
    rdfs:domain bpi:GDPR ;
    rdfs:range xsd:boolean .

bpi:reserveFund a owl:DatatypeProperty ;
    rdfs:label "reserveFund" ;
    rdfs:comment "Reserve fund amount." ;
    rdfs:domain bpi:OtherFinancialAssets,
        bpi:ReserveFund ;
    rdfs:range xsd:decimal .

bpi:reserveFundAmount a owl:DatatypeProperty ;
    rdfs:label "reserveFundAmount" ;
    rdfs:comment "Reserve fund amount included in other financial assets (in thousands of euros)." ;
    rdfs:domain bpi:OtherFinancialAssets,
        bpi:ReserveFund ;
    rdfs:range xsd:decimal .

bpi:respondentBusinessesCountBiodiversity a owl:DatatypeProperty ;
    rdfs:label "respondentBusinessesCountBiodiversity" ;
    rdfs:comment "Number of respondents in biodiversity-related survey (e.g., 190)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:integer .

bpi:responseDeadline a owl:DatatypeProperty ;
    rdfs:label "responseDeadline" ;
    rdfs:comment "Maximum time to respond to a data subject request (e.g., within one month, subject to GDPR derogations)." ;
    rdfs:domain bpi:RetentionPeriod ;
    rdfs:range xsd:string .

bpi:responsiblePersonName a owl:DatatypeProperty ;
    rdfs:label "responsiblePersonName" ;
    rdfs:comment "Name of the person responsible for the half-year consolidated financial statements." ;
    rdfs:domain bpi:GeneralManagement ;
    rdfs:range xsd:string .

bpi:responsiblePersonStatementDate a owl:DatatypeProperty ;
    rdfs:label "responsiblePersonStatementDate" ;
    rdfs:comment "Date of the statement by the person responsible." ;
    rdfs:domain bpi:GeneralManagement ;
    rdfs:range xsd:date .

bpi:responsiblePersonTitle a owl:DatatypeProperty ;
    rdfs:label "responsiblePersonTitle" ;
    rdfs:comment "Title/role of the person responsible for the half-year consolidated financial statements." ;
    rdfs:domain bpi:GeneralManagement ;
    rdfs:range xsd:string .

bpi:result a owl:DatatypeProperty ;
    rdfs:label "result" ;
    rdfs:comment "Result amount included in shareholders’ equity." ;
    rdfs:domain bpi:ShareholderEquity ;
    rdfs:range xsd:decimal .

bpi:retainedEarnings a owl:DatatypeProperty ;
    rdfs:label "retainedEarnings" ;
    rdfs:comment "Retained earnings amount reported in shareholders' equity." ;
    rdfs:domain bpi:ShareholdersEquityStatement ;
    rdfs:range xsd:decimal .

bpi:retainedEarningsAmount a owl:DatatypeProperty ;
    rdfs:label "retainedEarningsAmount" ;
    rdfs:comment "Retained earnings included in shareholders' equity." ;
    rdfs:domain bpi:ShareholderEquity,
        bpi:ShareholdersEquity ;
    rdfs:range xsd:decimal .

bpi:retentionPeriod a owl:DatatypeProperty ;
    rdfs:label "retentionPeriod" ;
    rdfs:comment "Retention period for personal data after a specified event (e.g., from response, from last contact, until remedies exhausted)." ;
    rdfs:domain bpi:RetentionPeriod ;
    rdfs:range xsd:string .

bpi:retentionPeriodDescription a owl:DatatypeProperty ;
    rdfs:label "retentionPeriodDescription" ;
    rdfs:comment "Description of how long personal data is kept, including that it does not exceed what is necessary for the stated purposes." ;
    rdfs:domain bpi:RetentionPeriod ;
    rdfs:range xsd:string .

bpi:retentionPeriodEndEvent a owl:DatatypeProperty ;
    rdfs:label "retentionPeriodEndEvent" ;
    rdfs:comment "Event or milestone that determines when the retention period ends (e.g., end of investment, last contact, termination of relationship)." ;
    rdfs:domain bpi:PersonalDataRetention ;
    rdfs:range xsd:string .

bpi:retentionPeriodStartEvent a owl:DatatypeProperty ;
    rdfs:label "retentionPeriodStartEvent" ;
    rdfs:comment "Event or trigger from which the retention period starts (e.g., end of contract, last contact, closure of claim)." ;
    rdfs:domain bpi:RetentionPeriod ;
    rdfs:range xsd:string .

bpi:retentionPeriodUnit a owl:DatatypeProperty ;
    rdfs:label "retentionPeriodUnit" ;
    rdfs:comment "Unit of the retention period (e.g., years, months) when specified." ;
    rdfs:domain bpi:RetentionPeriod ;
    rdfs:range xsd:string .

bpi:retentionPeriodYears a owl:DatatypeProperty ;
    rdfs:label "retentionPeriodYears" ;
    rdfs:comment "Retention period expressed in number of years for personal data." ;
    rdfs:domain bpi:PersonalDataRetention ;
    rdfs:range xsd:integer .

bpi:returnOnEquity a owl:DatatypeProperty ;
    rdfs:label "returnOnEquity" ;
    rdfs:comment "Return on equity (ROE) percentage reported for the period." ;
    rdfs:domain bpi:ROE ;
    rdfs:range xsd:decimal .

bpi:reviewsReportDedicatedTo a owl:ObjectProperty ;
    rdfs:label "reviewsReportDedicatedTo" ;
    rdfs:comment "Indicates that annual review/verification is performed for reports dedicated to EU green bonds (via required external review mechanisms)." ;
    rdfs:domain bpi:PublicInvestmentBank ;
    rdfs:range bpi:ExternalAuditors .

bpi:rightToAccess a owl:DatatypeProperty ;
    rdfs:label "rightToAccess" ;
    rdfs:comment "Whether the policy states the right of access to personal data." ;
    rdfs:domain bpi:DataSubjectRights ;
    rdfs:range xsd:boolean .

bpi:rightToDeletion a owl:DatatypeProperty ;
    rdfs:label "rightToDeletion" ;
    rdfs:comment "Whether the policy states the right to erasure/deletion." ;
    rdfs:domain bpi:DataSubjectRights ;
    rdfs:range xsd:boolean .

bpi:rightToLimitationOfProcessing a owl:DatatypeProperty ;
    rdfs:label "rightToLimitationOfProcessing" ;
    rdfs:comment "Whether the policy states the right to request limitation of processing." ;
    rdfs:domain bpi:DataSubjectRights ;
    rdfs:range xsd:boolean .

bpi:rightToLodgeComplaint a owl:DatatypeProperty ;
    rdfs:label "rightToLodgeComplaint" ;
    rdfs:comment "Whether the policy states the right to lodge a complaint with a supervisory authority." ;
    rdfs:domain bpi:DataSubjectRights ;
    rdfs:range xsd:boolean .

bpi:rightToObjectToProcessing a owl:DatatypeProperty ;
    rdfs:label "rightToObjectToProcessing" ;
    rdfs:comment "Whether the policy states a right to object to processing / commercial prospecting." ;
    rdfs:domain bpi:DataSubjectRights ;
    rdfs:range xsd:boolean .

bpi:rightToPortability a owl:DatatypeProperty ;
    rdfs:label "rightToPortability" ;
    rdfs:comment "Whether the policy states the right to data portability." ;
    rdfs:domain bpi:DataSubjectRights ;
    rdfs:range xsd:boolean .

bpi:rightToProvidePostMortemInstructions a owl:DatatypeProperty ;
    rdfs:label "rightToProvidePostMortemInstructions" ;
    rdfs:comment "Whether the policy states the ability to provide instructions on the fate of personal data after death." ;
    rdfs:domain bpi:DataSubjectRights ;
    rdfs:range xsd:boolean .

bpi:rightToRectification a owl:DatatypeProperty ;
    rdfs:label "rightToRectification" ;
    rdfs:comment "Whether the policy states the right to rectification." ;
    rdfs:domain bpi:DataSubjectRights ;
    rdfs:range xsd:boolean .

bpi:riskCategory a owl:DatatypeProperty ;
    rdfs:label "riskCategory" ;
    rdfs:comment "Category label under which a risk factor is grouped." ;
    rdfs:domain bpi:RiskFactor ;
    rdfs:range xsd:string .

bpi:riskCost a owl:DatatypeProperty ;
    rdfs:label "riskCost" ;
    rdfs:comment "Cost of risk for the period." ;
    rdfs:domain bpi:CostOfRisk ;
    rdfs:range xsd:decimal .

bpi:roe a owl:DatatypeProperty ;
    rdfs:label "roe" ;
    rdfs:comment "Return on equity (ROE) indicator value." ;
    rdfs:domain bpi:ROE ;
    rdfs:range xsd:decimal .

bpi:roeValue a owl:DatatypeProperty ;
    rdfs:label "roeValue" ;
    rdfs:comment "Return on equity (ROE) value for the period." ;
    rdfs:domain bpi:ROE ;
    rdfs:range xsd:decimal .

bpi:sanctionsImplementationMentioned a owl:DatatypeProperty ;
    rdfs:label "sanctionsImplementationMentioned" ;
    rdfs:comment "Indicates whether the text mentions implementation of sanctions following the referenced crisis." ;
    rdfs:domain bpi:WarInUkraine ;
    rdfs:range xsd:boolean .

bpi:secondPartyOpinionDate a owl:DatatypeProperty ;
    rdfs:label "secondPartyOpinionDate" ;
    rdfs:comment "Issue date of the independent second party opinion on the green financing framework." ;
    rdfs:domain bpi:GreenFinancingFramework ;
    rdfs:range xsd:date .

bpi:secondPartyOpinionYear a owl:DatatypeProperty ;
    rdfs:label "secondPartyOpinionYear" ;
    rdfs:comment "Year referenced for the alignment of the Second-Party Opinion with the ICMA Green Bond Principles (2025)." ;
    rdfs:domain bpi:GreenFinancingFramework ;
    rdfs:range xsd:integer .

bpi:securitiesCommitments a owl:DatatypeProperty ;
    rdfs:label "securitiesCommitments" ;
    rdfs:comment "Securities commitments (securities to be delivered/received)." ;
    rdfs:domain bpi:SecuritiesCommitment ;
    rdfs:range xsd:decimal .

bpi:securitiesCommitmentsToBeDeliveredAmount a owl:DatatypeProperty ;
    rdfs:label "securitiesCommitmentsToBeDeliveredAmount" ;
    rdfs:comment "Amount of securities commitments to be delivered." ;
    rdfs:domain bpi:SecuritiesCommitment ;
    rdfs:range xsd:decimal .

bpi:securitiesCommitmentsToBeReceivedAmount a owl:DatatypeProperty ;
    rdfs:label "securitiesCommitmentsToBeReceivedAmount" ;
    rdfs:comment "Amount of securities commitments to be received." ;
    rdfs:domain bpi:SecuritiesCommitment ;
    rdfs:range xsd:decimal .

bpi:securitiesRemainingToBeReleasedAmount a owl:DatatypeProperty ;
    rdfs:label "securitiesRemainingToBeReleasedAmount" ;
    rdfs:comment "Securities remaining to be released amount (in thousands of euros)." ;
