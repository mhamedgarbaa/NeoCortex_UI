    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:IFRSStandard,
        bpi:InternationalAccountingStandard,
        bpi:InternationalFinancialReportingStandard .

bpi:preparedUnderResponsibilityOf a owl:ObjectProperty ;
    rdfs:label "preparedUnderResponsibilityOf" ;
