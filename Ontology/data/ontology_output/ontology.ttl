    rdfs:range xsd:decimal .

bpi:impairmentLoss a owl:DatatypeProperty ;
    rdfs:label "impairmentLoss" ;
    rdfs:comment "Impairment loss amount." ;
    rdfs:domain bpi:Impairment,
        bpi:ImpairmentLoss ;
    rdfs:range xsd:decimal .

bpi:impairmentTestEventDate a owl:DatatypeProperty ;
    rdfs:label "impairmentTestEventDate" ;
