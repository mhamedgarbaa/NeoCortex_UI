    rdfs:range xsd:decimal .

bpi:cashContributionCurrency a owl:DatatypeProperty ;
    rdfs:label "cashContributionCurrency" ;
    rdfs:comment "Currency of the cash contribution amount (e.g., EUR)." ;
    rdfs:domain bpi:PublicResources ;
    rdfs:range xsd:string .

bpi:cashFlowAfterCostOfNetFinancialDebtAndTax a owl:DatatypeProperty ;
    rdfs:label "cashFlowAfterCostOfNetFinancialDebtAndTax" ;
    rdfs:comment "Cash flow after cost of net financial debt and tax." ;
