bpi:consolidationMethodAsOf a owl:DatatypeProperty ;
    rdfs:label "consolidationMethodAsOf" ;
    rdfs:comment "Date for which the consolidation scope and methods are presented (e.g., 31/12/2022)." ;
    rdfs:domain bpi:ConsolidationScope ;
    rdfs:range xsd:date .

bpi:contingencyPlanReserve a owl:DatatypeProperty ;
    rdfs:label "contingencyPlanReserve" ;
    rdfs:comment "Contingency plan reserve amount (assets mobilisable under proven stress) reported for the period end dates." ;
    rdfs:domain bpi:ContingencyPlanReserve ;
    rdfs:range xsd:decimal .

bpi:controls a owl:ObjectProperty ;
    rdfs:label "controls" ;
    rdfs:comment "Relates a group/public institution to a subsidiary it controls." ;
