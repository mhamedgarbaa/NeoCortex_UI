bpi:changeInWorkingCapitalRequirementsRelatedToActivity a owl:DatatypeProperty ;
    rdfs:label "changeInWorkingCapitalRequirementsRelatedToActivity" ;
    rdfs:comment "Change in working capital requirements related to activity." ;
