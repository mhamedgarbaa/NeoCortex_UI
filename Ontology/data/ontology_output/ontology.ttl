    rdfs:range xsd:decimal .

bpi:classifiesAssetsAsCurrentOrNonCurrent a owl:ObjectProperty ;
    rdfs:label "classifiesAssetsAsCurrentOrNonCurrent" ;
    rdfs:comment "Indicates that balance sheet items are classified as current or non-current." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:CurrentNonCurrentClassification .

bpi:classifiesFairValueMeasurementsIntoLevels a owl:ObjectProperty ;
    rdfs:label "classifiesFairValueMeasurementsIntoLevels" ;
