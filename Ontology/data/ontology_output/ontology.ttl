bpi:identificationDataNationality a owl:DatatypeProperty ;
    rdfs:label "identificationDataNationality" ;
    rdfs:comment "Nationality component of identification data." ;
    rdfs:domain bpi:IdentificationData ;
    rdfs:range xsd:string .

bpi:identificationDataPostalAddress a owl:DatatypeProperty ;
