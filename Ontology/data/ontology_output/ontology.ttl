bpi:bookValuesOfAssetsSoldAmount a owl:DatatypeProperty ;
    rdfs:label "bookValuesOfAssetsSoldAmount" ;
    rdfs:comment "Book values of assets sold amount (in thousands of euros)." ;
    rdfs:domain bpi:BookValuesOfAssetsSold ;
    rdfs:range xsd:decimal .

bpi:bpifranceAccruedExpensesAmount a owl:DatatypeProperty ;
    rdfs:label "bpifranceAccruedExpensesAmount" ;
    rdfs:comment "Bpifrance accrued expenses amount (in thousands of euros)." ;
    rdfs:domain bpi:BpifranceAccruedExpense ;
    rdfs:range xsd:decimal .

bpi:bpifranceCurrentAccountAmount a owl:DatatypeProperty ;
    rdfs:label "bpifranceCurrentAccountAmount" ;
    rdfs:comment "Bpifrance current account balance included in cash and cash equivalents (in thousands of euros)." ;
    rdfs:domain bpi:CashAndCashEquivalents ;
    rdfs:range xsd:decimal .

bpi:bpifranceGuaranteeCommissionsToBeSpreadAmount a owl:DatatypeProperty ;
    rdfs:label "bpifranceGuaranteeCommissionsToBeSpreadAmount" ;
    rdfs:comment "Bpifrance guarantee commissions to be spread included in deferred income (in thousands of euros)." ;
    rdfs:domain bpi:DeferredIncome ;
