    rdfs:range xsd:integer .

bpi:cnilComplaintRight a owl:DatatypeProperty ;
    rdfs:label "cnilComplaintRight" ;
    rdfs:comment "Indicates whether the policy states a right to lodge a complaint with CNIL." ;
