bpi:biodiversityConservationPoliciesWithCommitmentsCount a owl:DatatypeProperty ;
    rdfs:label "biodiversityConservationPoliciesWithCommitmentsCount" ;
    rdfs:comment "Number of respondents with formal biodiversity conservation policies with commitments and objectives (e.g., 30)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:integer .

bpi:boardMeetingCount a owl:DatatypeProperty ;
    rdfs:label "boardMeetingCount" ;
    rdfs:comment "Number of board meetings held during the year." ;
    rdfs:domain bpi:BoardOfDirectors ;
    rdfs:range xsd:integer .

bpi:boardMeetingDate a owl:DatatypeProperty ;
    rdfs:label "boardMeetingDate" ;
