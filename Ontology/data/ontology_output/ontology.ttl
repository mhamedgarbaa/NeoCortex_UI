bpi:TradeAndCompaniesRegister a owl:Class ;
    rdfs:label "TradeAndCompaniesRegister" ;
    rdfs:comment "A register referenced as a source of databases for indirect collection." ;
    rdfs:subClassOf bpi:RegulatoryDatabase .

bpi:TradeAndOtherReceivables a owl:Class ;
    rdfs:label "TradeAndOtherReceivables" ;
    rdfs:comment "Receivables arising from trade and other activities, including grants and guarantee-related receivables." ;
    rdfs:subClassOf bpi:FinancialAsset .

bpi:TradeDebtsAndMiscellaneousDebts a owl:Class ;
    rdfs:label "TradeDebtsAndMiscellaneousDebts" ;
    rdfs:comment "Trade payables and other miscellaneous debts, including deferred income." ;
    rdfs:subClassOf bpi:FinancialLiability .

bpi:TradeDebtsAndRelatedAccounts a owl:Class ;
    rdfs:label "TradeDebtsAndRelatedAccounts" ;
    rdfs:comment "Note category for trade debts and related accounts." ;
    rdfs:subClassOf bpi:NotesToFinancialStatements .

bpi:TradeDebtsAndRelatedAccountsNote a owl:Class ;
    rdfs:label "TradeDebtsAndRelatedAccountsNote" ;
    rdfs:comment "Note section detailing trade debts and related accounts." ;
    rdfs:subClassOf bpi:NotesToFinancialStatements .

bpi:TransitionClimateRisk a owl:Class ;
    rdfs:label "TransitionClimateRisk" ;
    rdfs:comment "Transition risk from losses due to inadequate adaptation to a low-carbon economy." ;
    rdfs:subClassOf bpi:ClimateRisk .

bpi:TransitionRiskQuantification a owl:Class ;
    rdfs:label "TransitionRiskQuantification" ;
    rdfs:comment "Annual assessment and monitoring of portfolio exposure and vulnerability to climate transition risk." .

bpi:TreasuryFinancing a owl:Class ;
    rdfs:label "TreasuryFinancing" ;
    rdfs:comment "Financing activity related to treasury financing." ;
    rdfs:subClassOf bpi:FinancingActivity .

bpi:TreasuryShares a owl:Class ;
    rdfs:label "TreasuryShares" ;
    rdfs:comment "Shares held by the company itself, affecting dividend allocation and retained earnings adjustments." ;
    rdfs:subClassOf bpi:Equity .

bpi:TreasuryTeam a owl:Class ;
    rdfs:label "TreasuryTeam" ;
    rdfs:comment "Organizational unit responsible for management of net proceeds and liquidity/earmarking processes." .

bpi:TurnaroundCapital a owl:Class ;
    rdfs:label "TurnaroundCapital" ;
    rdfs:comment "Segment aiming to turn around companies in difficulty, typically via minority shares alongside private investors." ;
    rdfs:subClassOf bpi:Investment .

bpi:TurnaroundCapitalSegment a owl:Class ;
    rdfs:label "TurnaroundCapitalSegment" ;
    rdfs:comment "A segment aiming to turn around companies in difficulty, referenced as exceptional and subject to specific precautions." .

bpi:UCITSUnit a owl:Class ;
    rdfs:label "UCITSUnit" ;
    rdfs:comment "Units of UCITS funds referenced as part of fair value through profit or loss assets." ;
    rdfs:subClassOf bpi:FinancialInstrument,
        bpi:Securities .

bpi:UNSustainableDevelopmentGoals a owl:Class ;
    rdfs:label "UNSustainableDevelopmentGoals" ;
    rdfs:comment "A set of UN sustainable development goals referenced as part of commitments and reporting context." .

bpi:UnallocatedProceeds a owl:Class ;
    rdfs:label "UnallocatedProceeds" ;
    rdfs:comment "Proceeds temporarily not allocated to eligible green loans, managed under liquidity management procedures." .

bpi:UnconventionalResources a owl:Class ;
    rdfs:label "UnconventionalResources" ;
    rdfs:comment "A sector category (e.g., oil and gas from oil sands, shale, Arctic) referenced in exclusion criteria." .

bpi:UnemploymentInsuranceOrganization a owl:Class ;
    rdfs:label "UnemploymentInsuranceOrganization" ;
    rdfs:comment "An organization providing unemployment insurance that may receive information to finalize recruitment." .

bpi:UniversityPrograms a owl:Class ;
    rdfs:label "UniversityPrograms" ;
    rdfs:comment "Educational or training programs offered to entrepreneurs." .

bpi:UseOfProceeds a owl:Class ;
    rdfs:label "UseOfProceeds" ;
    rdfs:comment "Pillar describing how net proceeds of green financing instruments are used for eligible green loans." .

bpi:User a owl:Class ;
    rdfs:label "User" ;
    rdfs:comment "A natural person who accesses a platform and whose identity and access are managed." ;
    rdfs:subClassOf bpi:DataSubject .

bpi:UserAccount a owl:Class ;
    rdfs:label "UserAccount" ;
    rdfs:comment "A user account created and administered for access to a platform." .

bpi:VentureCapitalFund a owl:Class ;
    rdfs:label "VentureCapitalFund" ;
    rdfs:comment "A venture capital fund." ;
    rdfs:subClassOf bpi:Fund .

bpi:VentureCapitalSupportTeam a owl:Class ;
    rdfs:label "VentureCapitalSupportTeam" ;
    rdfs:comment "A team grouping venture capital support activities, working mainly with start-ups in the portfolio." .

bpi:VentureFund a owl:Class ;
    rdfs:label "VentureFund" ;
    rdfs:comment "A venture-oriented fund category referenced in the document." ;
    rdfs:subClassOf bpi:Fund .

bpi:VerySmallEnterprise a owl:Class ;
    rdfs:label "VerySmallEnterprise" ;
    rdfs:comment "Very small enterprises supported through public interest missions and financing/guarantee tools." ;
    rdfs:subClassOf bpi:Company .

bpi:WasteManagementActivity a owl:Class ;
    rdfs:label "WasteManagementActivity" ;
    rdfs:comment "Waste management activities financed under eligible waste management related loans." .

bpi:WasteManagementProject a owl:Class ;
    rdfs:label "WasteManagementProject" ;
    rdfs:comment "Projects for waste collection, sorting, recovery, and related waste management activities." .

bpi:WatchList a owl:Class ;
    rdfs:label "WatchList" ;
    rdfs:comment "A list used to flag counterparties for credit risk assessment criteria." .

bpi:WomenEntrepreneurshipSupport a owl:Class ;
    rdfs:label "WomenEntrepreneurshipSupport" ;
    rdfs:comment "Mission component encouraging and supporting women’s entrepreneurship." .

bpi:WorkingCapital a owl:Class ;
    rdfs:label "WorkingCapital" ;
    rdfs:comment "Working capital requirements whose changes are used in operating cash flow calculations." .

bpi:WorkingCapitalRequirements a owl:Class ;
    rdfs:label "WorkingCapitalRequirements" ;
    rdfs:comment "The net working capital requirement changes used to compute cash flow from operating activities." ;
    rdfs:subClassOf bpi:OperatingActivities .

bpi:WorkingGroup a owl:Class ;
    rdfs:label "WorkingGroup" ;
    rdfs:comment "A group referenced as reviewing and improving questionnaires and methodologies." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:WorldEconomicForum a owl:Class ;
    rdfs:label "WorldEconomicForum" ;
    rdfs:comment "An organization referenced as producing a report estimating dependence of GDP on nature services." .

bpi:WorldTradeOrganisation a owl:Class ;
    rdfs:label "WorldTradeOrganisation" ;
    rdfs:comment "World Trade Organisation referenced for compliance of export guarantees." .

bpi:ZeroInterestInnovationLoan a owl:Class ;
    rdfs:label "ZeroInterestInnovationLoan" ;
    rdfs:comment "Innovation loans with zero interest used when traditional financing fails." ;
    rdfs:subClassOf bpi:Loan .

bpi:accountingProfitAmount a owl:DatatypeProperty ;
    rdfs:label "accountingProfitAmount" ;
    rdfs:comment "Accounting profit amount for the FII-exempt and taxable sectors used in the tax disclosure (e.g., €76.3 million and €312.1 million)." ;
    rdfs:domain bpi:CorporateIncomeTax ;
    rdfs:range xsd:decimal .

bpi:accountingStandardsAsAt a owl:DatatypeProperty ;
    rdfs:label "accountingStandardsAsAt" ;
    rdfs:comment "Accounting standards applicable as of a specific date." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range xsd:date .

bpi:accountingStandardsInForceDate a owl:DatatypeProperty ;
    rdfs:label "accountingStandardsInForceDate" ;
    rdfs:comment "Date as at which the applicable IFRS/IAS standards are stated to be in force for the consolidated financial statements." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range xsd:date .

bpi:accountsForEquityInvestmentsUsingEquityMethod a owl:ObjectProperty ;
    rdfs:label "accountsForEquityInvestmentsUsingEquityMethod" ;
    rdfs:comment "Indicates that equity investments are accounted for using the equity method." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:PublicInstitution ;
    rdfs:range bpi:EquityMethodAccounting,
        bpi:EquityMethodInvestments .

bpi:accountsForFrenchTechSovereigntyActivityAsEquityInterestsInFutureTechnologyCompanies a owl:ObjectProperty ;
    rdfs:label "accountsForFrenchTechSovereigntyActivityAsEquityInterestsInFutureTechnologyCompanies" ;
    rdfs:comment "French Tech Sovereignty activity corresponds to equity interests in companies developing future technologies." ;
    rdfs:domain bpi:ThirdPartyActivity ;
    rdfs:range bpi:FutureTechnologyCompany .

bpi:accountsForInvestmentsUsingEquityMethod a owl:ObjectProperty ;
    rdfs:label "accountsForInvestmentsUsingEquityMethod" ;
    rdfs:comment "Investments in companies accounted for using the equity method are recognized by replacing the share of equity and reflecting the share of net profit or loss." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityMethodInvestments .

bpi:accountsForSATTActivityAsEquityInterestsInTechnologyTransferAccelerationCompanies a owl:ObjectProperty ;
    rdfs:label "accountsForSATTActivityAsEquityInterestsInTechnologyTransferAccelerationCompanies" ;
    rdfs:comment "SATT activity corresponds to equity interests in technology transfer acceleration companies." ;
    rdfs:domain bpi:ThirdPartyActivity ;
    rdfs:range bpi:TechnologyTransferAccelerationCompany .

bpi:accountsForUsingEquityMethod a owl:ObjectProperty ;
    rdfs:label "accountsForUsingEquityMethod" ;
    rdfs:comment "The entity accounts for investments using the equity method for certain investees." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:EquityConsolidatedCompany,
        bpi:EquityMethodAccounting,
        bpi:EquityMethodCompany ;
    rdfs:range bpi:EquityMethodAccounting,
        bpi:EquityMethodInvestee,
        bpi:EquityMethodInvestment .

bpi:acquisitionDate a owl:DatatypeProperty ;
    rdfs:label "acquisitionDate" ;
    rdfs:comment "Date of acquisition used to measure identifiable assets and liabilities at fair values for goodwill recognition." ;
    rdfs:domain bpi:Goodwill ;
    rdfs:range xsd:date .

bpi:actsAsDataControllerFor a owl:ObjectProperty ;
    rdfs:label "actsAsDataControllerFor" ;
    rdfs:comment "Indicates the Bpifrance group entity that is deemed to act as the data controller for personal data processing in the recruitment context." ;
    rdfs:domain bpi:Bpifrance,
        bpi:BpifranceGroupEntity ;
    rdfs:range bpi:PersonalDataProcessing .

bpi:actsThroughSubsidiaries a owl:ObjectProperty ;
    rdfs:label "actsThroughSubsidiaries" ;
    rdfs:comment "Indicates that the group acts through its subsidiaries." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:PublicLimitedCompany .

bpi:addressesClimateRisks a owl:ObjectProperty ;
    rdfs:label "addressesClimateRisks" ;
    rdfs:comment "Indicates that the group addresses climate risks through its climate risk management framework." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:ClimateRisk .

bpi:addressesPhysicalRisks a owl:ObjectProperty ;
    rdfs:label "addressesPhysicalRisks" ;
    rdfs:comment "Indicates that the group addresses physical climate risks as part of climate risk management." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:PhysicalClimateRisk .

bpi:addressesTransitionRisks a owl:ObjectProperty ;
    rdfs:label "addressesTransitionRisks" ;
    rdfs:comment "Indicates that the group addresses transition risks as part of climate risk management." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:TransitionRisk .

bpi:administrativeDataProofOfAddress a owl:DatatypeProperty ;
    rdfs:label "administrativeDataProofOfAddress" ;
    rdfs:comment "Proof of address document/information." ;
    rdfs:domain bpi:AdministrativeData ;
    rdfs:range xsd:string .

bpi:adoptsPolicyDocument a owl:ObjectProperty ;
    rdfs:label "adoptsPolicyDocument" ;
    rdfs:comment "Indicates that the group adopts policy documents such as responsible investment policy and charters." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:PolicyDocument .

bpi:advanceDividendAmount a owl:DatatypeProperty ;
    rdfs:label "advanceDividendAmount" ;
    rdfs:comment "The amount of the advance payment of the dividend." ;
    rdfs:domain bpi:DividendsPaid ;
    rdfs:range xsd:decimal .

bpi:advanceDividendPerShare a owl:DatatypeProperty ;
    rdfs:label "advanceDividendPerShare" ;
    rdfs:comment "The advance dividend amount per share." ;
    rdfs:domain bpi:DividendsPaid ;
    rdfs:range xsd:decimal .

bpi:alignsWithGreenBondPrinciples a owl:ObjectProperty ;
    rdfs:label "alignsWithGreenBondPrinciples" ;
    rdfs:comment "The framework is prepared in accordance with ICMA Green Bond Principles (external standard)." ;
    rdfs:domain bpi:GreenFinancingInstrument ;
    rdfs:range bpi:EuropeanGeneralDataProtectionRegulation .

bpi:allocatesToEligibleGreenLoans a owl:ObjectProperty ;
    rdfs:label "allocatesToEligibleGreenLoans" ;
    rdfs:comment "Indicates that net proceeds are earmarked and allocated to eligible green loans categories." ;
    rdfs:domain bpi:PublicInvestmentBank ;
    rdfs:range bpi:Loans .

bpi:allocationPayableAmount a owl:DatatypeProperty ;
    rdfs:label "allocationPayableAmount" ;
    rdfs:comment "Allocation payable amount (in thousands of euros)." ;
    rdfs:domain bpi:AllocationPayable ;
    rdfs:range xsd:decimal .

bpi:allowsExerciseOfRight a owl:ObjectProperty ;
    rdfs:label "allowsExerciseOfRight" ;
    rdfs:comment "Indicates individuals can exercise rights (access, rectification, deletion, portability, limitation, objection, etc.) via requests." ;
    rdfs:domain bpi:PersonalDataRequest ;
    rdfs:range bpi:DataSubjectRights .

bpi:amendingFinanceActArticle79Date a owl:DatatypeProperty ;
    rdfs:label "amendingFinanceActArticle79Date" ;
    rdfs:comment "Date of the Amending Finance Act referenced for dividend receipt rules." ;
    rdfs:domain bpi:DividendDistributionPolicy ;
    rdfs:range xsd:date .

bpi:amendingFinanceActFor2003Date a owl:DatatypeProperty ;
    rdfs:label "amendingFinanceActFor2003Date" ;
    rdfs:comment "Date of the Amending Finance Act for 2003 referenced as an amendment." ;
    rdfs:domain bpi:DividendDistributionPolicy ;
    rdfs:range xsd:date .

bpi:amendmentApprovalRegulation a owl:DatatypeProperty ;
    rdfs:label "amendmentApprovalRegulation" ;
    rdfs:comment "The regulation under which the amendment is filed/approved (e.g., EU regulation reference)." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:string .

bpi:amendmentCompetentAuthority a owl:DatatypeProperty ;
    rdfs:label "amendmentCompetentAuthority" ;
    rdfs:comment "The competent authority responsible for the amendment (e.g., AMF)." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:string .

bpi:amendmentEffectiveDate a owl:DatatypeProperty ;
    rdfs:label "amendmentEffectiveDate" ;
    rdfs:comment "The date the amendment is certified/dated in the document." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:date .

bpi:amendmentFilingDate a owl:DatatypeProperty ;
    rdfs:label "amendmentFilingDate" ;
    rdfs:comment "The date the amendment was filed with the competent authority (AMF)." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:date .

bpi:amendmentTitle a owl:DatatypeProperty ;
    rdfs:label "amendmentTitle" ;
    rdfs:comment "Title or label of the amendment to the universal registration document." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:string .

bpi:amendmentWrittenDate a owl:DatatypeProperty ;
    rdfs:label "amendmentWrittenDate" ;
    rdfs:comment "Date at which the risk factors matrix/listing was written." ;
    rdfs:domain bpi:RiskFactors ;
    rdfs:range xsd:date .

bpi:amendsUniversalRegistrationDocument a owl:ObjectProperty ;
    rdfs:label "amendsUniversalRegistrationDocument" ;
    rdfs:comment "Indicates that this amendment updates a prior universal registration document." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:UniversalRegistrationDocument .

bpi:amountInThousandsOfEuros a owl:DatatypeProperty ;
    rdfs:label "amountInThousandsOfEuros" ;
    rdfs:comment "Numeric amounts presented in the notes, expressed in thousands of euros." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range xsd:decimal .

bpi:amountOfLoansTakenOut a owl:DatatypeProperty ;
    rdfs:label "amountOfLoansTakenOut" ;
    rdfs:comment "Total amount of loans taken out during the period (in €m)." ;
    rdfs:domain bpi:Loans ;
    rdfs:range xsd:decimal .

bpi:amountOfRisksGuaranteed a owl:DatatypeProperty ;
    rdfs:label "amountOfRisksGuaranteed" ;
    rdfs:comment "Amount of risks guaranteed (excluding internal funds) reported for the period." ;
    rdfs:domain bpi:GuaranteeCommitment ;
    rdfs:range xsd:decimal .

bpi:amountOfRisksGuaranteedByRegions a owl:DatatypeProperty ;
    rdfs:label "amountOfRisksGuaranteedByRegions" ;
    rdfs:comment "Amount of risks guaranteed by Bpifrance Régions reported for the period." ;
    rdfs:domain bpi:GuaranteeCommitment ;
    rdfs:range xsd:decimal .

bpi:annualReportReleaseOccasion a owl:DatatypeProperty ;
    rdfs:label "annualReportReleaseOccasion" ;
    rdfs:comment "Reference to the occasion when the allocation report is published (at the Annual Report release)." ;
    rdfs:domain bpi:GreenFinancingFramework ;
    rdfs:range xsd:string .

bpi:applicableRegulation a owl:DatatypeProperty ;
    rdfs:label "applicableRegulation" ;
    rdfs:comment "Regulation(s) applicable to the processing described in the policy (e.g., GDPR 2016/679, national provisions)." ;
    rdfs:domain bpi:ApplicableRegulation ;
    rdfs:range xsd:string .

bpi:appliesAccountingStandard a owl:ObjectProperty ;
    rdfs:label "appliesAccountingStandard" ;
    rdfs:comment "Indicates that the consolidated financial statements are prepared using IFRS standards." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:IFRSStandard .

bpi:appliesAccountingStandards a owl:ObjectProperty ;
    rdfs:label "appliesAccountingStandards" ;
    rdfs:comment "Indicates that the consolidated financial statements are prepared in accordance with IFRS standards." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:IFRSStandard .

bpi:appliesDataProtectionPolicy a owl:ObjectProperty ;
    rdfs:label "appliesDataProtectionPolicy" ;
    rdfs:comment "Indicates that a policy document applies a personal data protection policy." ;
    rdfs:domain bpi:PolicyDocument ;
    rdfs:range bpi:PersonalDataProtectionPolicy .

bpi:appointmentDecreeDate a owl:DatatypeProperty ;
    rdfs:label "appointmentDecreeDate" ;
    rdfs:comment "Date of the decree appointing a board member." ;
    rdfs:domain bpi:BoardOfDirectors ;
    rdfs:range xsd:date .

bpi:approvedBy a owl:ObjectProperty ;
    rdfs:label "approvedBy" ;
    rdfs:comment "Indicates the competent authority that approves the overall documentation for public offering or admission to trading." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range bpi:CompetentAuthority .

bpi:approvedByCompetentAuthority a owl:ObjectProperty ;
    rdfs:label "approvedByCompetentAuthority" ;
    rdfs:comment "Indicates the universal registration document (as completed/amended) is approved by the competent authority." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:CompetentAuthority .

bpi:approves a owl:ObjectProperty ;
    rdfs:label "approves" ;
    rdfs:comment "The board of directors approves the consolidated financial statements." ;
    rdfs:domain bpi:BoardOfDirectors ;
    rdfs:range bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatements .

bpi:approvesFinancialStatements a owl:ObjectProperty ;
    rdfs:label "approvesFinancialStatements" ;
    rdfs:comment "Indicates that the board scrutinised and approved the financial statements." ;
    rdfs:domain bpi:BoardOfDirectors ;
    rdfs:range bpi:FinancialStatements .

bpi:article8FundsClassification a owl:DatatypeProperty ;
    rdfs:label "article8FundsClassification" ;
    rdfs:comment "SFDR classification referenced for qualifying financial products (Article 8 funds)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:string .

bpi:article8FundsShareOutstanding a owl:DatatypeProperty ;
    rdfs:label "article8FundsShareOutstanding" ;
    rdfs:comment "Whether there were outstanding Article 8 funds at the reporting date (stated as none)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:boolean .

bpi:asAtDate a owl:DatatypeProperty ;
    rdfs:label "asAtDate" ;
    rdfs:comment "Reference date for the consolidated financial statements (e.g., end-of-year date)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatements ;
    rdfs:range xsd:date .

bpi:asOfDate a owl:DatatypeProperty ;
    rdfs:label "asOfDate" ;
    rdfs:comment "Reporting date for the financial statement figures (e.g., 31/12/2021, 31/12/2020)." ;
    rdfs:domain bpi:FinancialStatements,
        bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range xsd:date .

bpi:assessedBiodiversityFootprintShare a owl:DatatypeProperty ;
    rdfs:label "assessedBiodiversityFootprintShare" ;
    rdfs:comment "Share of respondents that assessed their biodiversity footprint (e.g., 2%)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:decimal .

bpi:assessesSustainabilityRisks a owl:ObjectProperty ;
    rdfs:label "assessesSustainabilityRisks" ;
    rdfs:comment "Indicates that the group assesses sustainability/ESG risks as part of its risk analysis." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:FinancialRisk .

bpi:assetsUnderManagement a owl:DatatypeProperty ;
    rdfs:label "assetsUnderManagement" ;
    rdfs:comment "Assets under management reported for the period." ;
    rdfs:domain bpi:FundOfFundsBusiness ;
    rdfs:range xsd:decimal .

bpi:auditPeriodEndDate a owl:DatatypeProperty ;
    rdfs:label "auditPeriodEndDate" ;
    rdfs:comment "End date of the period covered by the statutory auditor’s independence statement (date of report issuance)." ;
    rdfs:domain bpi:StatutoryAuditor ;
    rdfs:range xsd:date .

bpi:auditPeriodStartDate a owl:DatatypeProperty ;
    rdfs:label "auditPeriodStartDate" ;
    rdfs:comment "Start date of the period covered by the statutory auditor’s independence statement (e.g., 1 January 2023)." ;
    rdfs:domain bpi:StatutoryAuditor ;
    rdfs:range xsd:date .

bpi:audits a owl:ObjectProperty ;
    rdfs:label "audits" ;
    rdfs:comment "The statutory auditor audits the consolidated financial statements." ;
    rdfs:domain bpi:StatutoryAuditor ;
    rdfs:range bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatements .

bpi:auditsConsolidatedFinancialStatements a owl:ObjectProperty ;
    rdfs:label "auditsConsolidatedFinancialStatements" ;
    rdfs:comment "The statutory auditor audits the consolidated financial statements." ;
    rdfs:domain bpi:StatutoryAuditor ;
    rdfs:range bpi:ConsolidatedFinancialStatements .

bpi:auditsParentEntityFinancialStatements a owl:ObjectProperty ;
    rdfs:label "auditsParentEntityFinancialStatements" ;
    rdfs:comment "The statutory auditor audits the parent entity financial statements." ;
    rdfs:domain bpi:StatutoryAuditor ;
    rdfs:range bpi:FinancialStatements .

bpi:authorisesSigningOfAmendmentToAgreement a owl:ObjectProperty ;
    rdfs:label "authorisesSigningOfAmendmentToAgreement" ;
    rdfs:comment "Indicates that governance authorises signing of amendments to agreements." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:AmendmentToAgreement .

bpi:authorisesSigningOfFinancingAgreement a owl:ObjectProperty ;
    rdfs:label "authorisesSigningOfFinancingAgreement" ;
    rdfs:comment "Indicates that governance authorises signing of financing agreements." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:FinancingAgreement .

bpi:authorisesSigningOfFrameworkAgreement a owl:ObjectProperty ;
    rdfs:label "authorisesSigningOfFrameworkAgreement" ;
    rdfs:comment "Indicates that governance authorises signing of framework agreements for programme management." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:FrameworkAgreement .

bpi:authorisesSigningOfServiceAgreement a owl:ObjectProperty ;
    rdfs:label "authorisesSigningOfServiceAgreement" ;
    rdfs:comment "Indicates that governance authorises signing of service agreements." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:ServiceAgreement .

bpi:balanceSheetDate a owl:DatatypeProperty ;
    rdfs:label "balanceSheetDate" ;
    rdfs:comment "The balance sheet closing date used for the consolidated financial statements (e.g., 31 December 2023)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatements,
        bpi:FinancialYear ;
    rdfs:range xsd:date .

bpi:balanceSheetDateForParentEntity a owl:DatatypeProperty ;
    rdfs:label "balanceSheetDateForParentEntity" ;
    rdfs:comment "Balance sheet date for the parent entity publishable financial statements." ;
    rdfs:domain bpi:ParentEntityFinancialStatements ;
    rdfs:range xsd:date .

bpi:balanceSheetTotal a owl:DatatypeProperty ;
    rdfs:label "balanceSheetTotal" ;
    rdfs:comment "Total assets/balance sheet amount reported for the period." ;
    rdfs:domain bpi:BalanceSheet,
        bpi:ConsolidatedFinancialStatements,
        bpi:LiquidityPosition ;
    rdfs:range xsd:decimal .

bpi:balanceSheetTotalAmount a owl:DatatypeProperty ;
    rdfs:label "balanceSheetTotalAmount" ;
    rdfs:comment "Total assets (balance sheet total) reported in the balance sheet." ;
    rdfs:domain bpi:BalanceSheet ;
    rdfs:range xsd:decimal .

bpi:balanceSheetTotalAsOfDate a owl:DatatypeProperty ;
    rdfs:label "balanceSheetTotalAsOfDate" ;
    rdfs:comment "Reporting date for the balance sheet total." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range xsd:date .

bpi:bankAccountAmount a owl:DatatypeProperty ;
    rdfs:label "bankAccountAmount" ;
    rdfs:comment "Bank account balance included in cash and cash equivalents (in thousands of euros)." ;
    rdfs:domain bpi:CashAndCashEquivalents ;
    rdfs:range xsd:decimal .

bpi:bankAccountInterestAmount a owl:DatatypeProperty ;
    rdfs:label "bankAccountInterestAmount" ;
    rdfs:comment "Bank account interest amount included in interest and similar expenses (in thousands of euros)." ;
    rdfs:domain bpi:InterestExpense ;
    rdfs:range xsd:decimal .

bpi:benchmarkIndexFallPercentage a owl:DatatypeProperty ;
    rdfs:label "benchmarkIndexFallPercentage" ;
    rdfs:comment "Percentage fall applied to the benchmark index for sensitivity analysis (e.g., 30% fall in CAC40)." ;
    rdfs:domain bpi:SharePriceRisk ;
