bpi:carbonFootprintAssessedShare a owl:DatatypeProperty ;
    rdfs:label "carbonFootprintAssessedShare" ;
    rdfs:comment "Share of respondent businesses that assessed partial or total carbon footprint (e.g., 33%)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:decimal .

bpi:carbonFootprintAttributableToBpifranceTeqCO2PerThousandEurInvested2020 a owl:DatatypeProperty ;
    rdfs:label "carbonFootprintAttributableToBpifranceTeqCO2PerThousandEurInvested2020" ;
    rdfs:comment "Carbon footprint attributable to Bpifrance for total listed portfolio in 2020 (teqCO2 per thousand euros invested)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:decimal .

bpi:carbonFootprintAttributableToBpifranceTeqCO2PerThousandEurInvested2021 a owl:DatatypeProperty ;
    rdfs:label "carbonFootprintAttributableToBpifranceTeqCO2PerThousandEurInvested2021" ;
    rdfs:comment "Carbon footprint attributable to Bpifrance for total listed portfolio in 2021 (teqCO2 per thousand euros invested)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:decimal .

bpi:carbonFootprintAttributableToBpifranceTotalListedPF2020TeqCO2PerThousandEurInvested a owl:DatatypeProperty ;
    rdfs:label "carbonFootprintAttributableToBpifranceTotalListedPF2020TeqCO2PerThousandEurInvested" ;
    rdfs:comment "Carbon footprint attributable to Bpifrance for total listed portfolio in 2020 (teqCO2/thousand euros invested)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:decimal .

bpi:carbonFootprintAttributableToBpifranceTotalListedPF2021TeqCO2PerThousandEurInvested a owl:DatatypeProperty ;
    rdfs:label "carbonFootprintAttributableToBpifranceTotalListedPF2021TeqCO2PerThousandEurInvested" ;
    rdfs:comment "Carbon footprint attributable to Bpifrance for total listed portfolio in 2021 (teqCO2/thousand euros invested)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:decimal .

bpi:carbonFootprintUnlistedCompanyCorrectionTeqCO2 a owl:DatatypeProperty ;
    rdfs:label "carbonFootprintUnlistedCompanyCorrectionTeqCO2" ;
    rdfs:comment "Carbon footprint correction value for an omitted unlisted company (e.g., 0.213 teqCO2)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
