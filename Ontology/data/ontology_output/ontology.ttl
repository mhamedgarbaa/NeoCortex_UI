    rdfs:label "preparesConsolidatedFinancialStatement" ;
    rdfs:comment "Indicates the institution prepares consolidated financial statements (publishable consolidated balance sheet/income statement/cash flow table)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:ConsolidatedFinancialStatement .

bpi:preparesConsolidatedFinancialStatements a owl:ObjectProperty ;
    rdfs:label "preparesConsolidatedFinancialStatements" ;
