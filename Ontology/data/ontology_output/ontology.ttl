bpi:cashAndCashEquivalentsTotalAmount a owl:DatatypeProperty ;
    rdfs:label "cashAndCashEquivalentsTotalAmount" ;
    rdfs:comment "Total cash and cash equivalents reported for the period (in thousands of euros)." ;
    rdfs:domain bpi:CashAndCashEquivalents ;
    rdfs:range xsd:decimal .

bpi:cashContributionAmount a owl:DatatypeProperty ;
    rdfs:label "cashContributionAmount" ;
    rdfs:comment "Amount of cash contribution taken back by the State as part of a fund." ;
