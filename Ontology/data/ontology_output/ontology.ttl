    rdfs:range xsd:boolean .

bpi:collectsPersonalData a owl:ObjectProperty ;
    rdfs:label "collectsPersonalData" ;
    rdfs:comment "Indicates that a personal data collection activity collects personal data." ;
    rdfs:domain bpi:PersonalDataCollection ;
    rdfs:range bpi:PersonalData .

bpi:collectsPersonalDataFrom a owl:ObjectProperty ;
    rdfs:label "collectsPersonalDataFrom" ;
    rdfs:comment "Indicates that personal data is collected directly from data subjects." ;
    rdfs:domain bpi:DataController,
        bpi:PersonalDataProcessing ;
    rdfs:range bpi:DataSubject .

bpi:collectsPersonalDataIndirectlyFrom a owl:ObjectProperty ;
    rdfs:label "collectsPersonalDataIndirectlyFrom" ;
    rdfs:comment "Indicates that personal data may be collected indirectly from third parties that have informed the data subject." ;
    rdfs:domain bpi:DataController,
        bpi:PersonalDataProcessing ;
    rdfs:range bpi:DataSubject,
        bpi:ThirdPartyActivity .

bpi:commissionsExternalReviewFor a owl:ObjectProperty ;
    rdfs:label "commissionsExternalReviewFor" ;
    rdfs:comment "Indicates that the bank commissions external parties to conduct reviews (e.g., second-party opinion and external verification)." ;
    rdfs:domain bpi:PublicInvestmentBank ;
    rdfs:range bpi:ExternalAuditors .

bpi:commitmentsGiven a owl:DatatypeProperty ;
    rdfs:label "commitmentsGiven" ;
    rdfs:comment "Total commitments given (e.g., guarantee commitments given) for the period." ;
    rdfs:domain bpi:FinancingCommitment ;
    rdfs:range xsd:decimal .

bpi:commitmentsGivenAmount a owl:DatatypeProperty ;
    rdfs:label "commitmentsGivenAmount" ;
    rdfs:comment "Total amount of financing commitments given." ;
    rdfs:domain bpi:FinancingCommitment ;
    rdfs:range xsd:decimal .

bpi:commitmentsReceived a owl:DatatypeProperty ;
    rdfs:label "commitmentsReceived" ;
    rdfs:comment "Total commitments received at the reporting date." ;
    rdfs:domain bpi:FinancingCommitment ;
    rdfs:range xsd:decimal .

bpi:commitmentsReceivedAmount a owl:DatatypeProperty ;
    rdfs:label "commitmentsReceivedAmount" ;
    rdfs:comment "Total amount of financing commitments received." ;
    rdfs:domain bpi:FinancingCommitment ;
    rdfs:range xsd:decimal .

bpi:committeeMeetsAtLeastOncePerYear a owl:DatatypeProperty ;
    rdfs:label "committeeMeetsAtLeastOncePerYear" ;
    rdfs:comment "Indicates that the Green Financing Committee meets at least once a year." ;
    rdfs:domain bpi:GreenFinancingFramework ;
    rdfs:range xsd:boolean .

bpi:communicatesPersonalDataTo a owl:ObjectProperty ;
    rdfs:label "communicatesPersonalDataTo" ;
    rdfs:comment "Indicates that personal data may be communicated to administrative authorities in the context of legal procedures." ;
    rdfs:domain bpi:PersonalDataProcessing ;
