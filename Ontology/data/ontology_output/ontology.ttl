        bpi:JudicialAuthority,
        bpi:SupervisoryAuthority .

bpi:compensationPaidToAdministrativeBodiesMembersAmount a owl:DatatypeProperty ;
    rdfs:label "compensationPaidToAdministrativeBodiesMembersAmount" ;
    rdfs:comment "Compensation paid to members of administrative bodies (amount stated as zero)." ;
    rdfs:domain bpi:CompensationPaidToAdministrativeBodiesMembers ;
    rdfs:range xsd:decimal .

bpi:compensationPaidToMembersOfAdministrativeBodiesAmount a owl:DatatypeProperty ;
    rdfs:label "compensationPaidToMembersOfAdministrativeBodiesAmount" ;
    rdfs:comment "Compensation paid to members of the administrative bodies (amount as disclosed)." ;
    rdfs:domain bpi:AdministrativeBodyMemberCompensation ;
    rdfs:range xsd:decimal .

bpi:competentAuthorityName a owl:DatatypeProperty ;
    rdfs:label "competentAuthorityName" ;
    rdfs:comment "Name of the competent authority with which the amendment was filed." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:string .

bpi:complaintAuthorityName a owl:DatatypeProperty ;
    rdfs:label "complaintAuthorityName" ;
    rdfs:comment "Name of the complaint authority mentioned in the policy (e.g., CNIL)." ;
    rdfs:domain bpi:ComplaintAuthority ;
    rdfs:range xsd:string .

bpi:complaintBodyName a owl:DatatypeProperty ;
    rdfs:label "complaintBodyName" ;
    rdfs:comment "Name of the authority where a complaint can be lodged (CNIL)." ;
    rdfs:domain bpi:ComplaintAuthority ;
    rdfs:range xsd:string .

bpi:complaintLodgingAuthorityName a owl:DatatypeProperty ;
    rdfs:label "complaintLodgingAuthorityName" ;
    rdfs:comment "Name of the authority where a complaint can be lodged (e.g., CNIL)." ;
    rdfs:domain bpi:ComplaintAuthority ;
    rdfs:range xsd:string .

bpi:concludesFinancingAgreementWith a owl:ObjectProperty ;
    rdfs:label "concludesFinancingAgreementWith" ;
    rdfs:comment "Indicates the institution concludes financing agreements (e.g., financial agreements regarding support measures and financing plans)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:FinancingAgreement .

bpi:conductsDueDiligenceProcess a owl:ObjectProperty ;
    rdfs:label "conductsDueDiligenceProcess" ;
    rdfs:comment "Indicates that the group conducts due diligence processes for ESG and climate risks prior to investment." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:DueDiligenceProcess .

bpi:conductsShareholderDialogue a owl:ObjectProperty ;
    rdfs:label "conductsShareholderDialogue" ;
    rdfs:comment "Indicates that the group conducts shareholder dialogue/engagement with portfolio companies and fund managers." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:ShareholderDialogue .

bpi:consolidatedNetIncome a owl:DatatypeProperty ;
    rdfs:label "consolidatedNetIncome" ;
    rdfs:comment "Net income amount reported on a consolidated basis for the period." ;
    rdfs:domain bpi:NetIncome ;
    rdfs:range xsd:decimal .

bpi:consolidatedNetIncomeAmount a owl:DatatypeProperty ;
    rdfs:label "consolidatedNetIncomeAmount" ;
    rdfs:comment "Net income amount reported in the consolidated financial statements." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range xsd:decimal .

bpi:consolidatedNetIncomeGroupShare a owl:DatatypeProperty ;
    rdfs:label "consolidatedNetIncomeGroupShare" ;
    rdfs:comment "Consolidated net income attributable to the group share." ;
    rdfs:domain bpi:NetIncome ;
    rdfs:range xsd:decimal .

bpi:consolidatedReserves a owl:DatatypeProperty ;
    rdfs:label "consolidatedReserves" ;
    rdfs:comment "Consolidated reserves amount." ;
    rdfs:domain bpi:ShareholderEquity ;
    rdfs:range xsd:decimal .

bpi:consolidatesEntityUsingEquityMethod a owl:ObjectProperty ;
    rdfs:label "consolidatesEntityUsingEquityMethod" ;
    rdfs:comment "Indicates that the institution consolidates a jointly controlled entity using the equity method." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:EquityMethodCompany .

bpi:consolidatesEntityUsingFullConsolidation a owl:ObjectProperty ;
    rdfs:label "consolidatesEntityUsingFullConsolidation" ;
    rdfs:comment "Indicates that the institution consolidates entities under full consolidation when it has complete control." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:FullConsolidation .

bpi:consolidatesInBalanceSheetUnderAccountingStandards a owl:ObjectProperty ;
    rdfs:label "consolidatesInBalanceSheetUnderAccountingStandards" ;
    rdfs:comment "Indicates that eligible green loans are consolidated in the bank’s balance sheet under IFRS accounting standards." ;
    rdfs:domain bpi:PublicInvestmentBank ;
