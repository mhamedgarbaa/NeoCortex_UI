@prefix bpi: <https://talan.com/ontology/bpi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://talan.com/ontology/bpi> a owl:Ontology .

bpi:ACPR a owl:Class ;
    rdfs:label "ACPR" ;
    rdfs:comment "A regulatory authority referenced for climate stress tests." .

bpi:AMFAuthority a owl:Class ;
    rdfs:label "AMFAuthority" ;
    rdfs:comment "The Autorité des Marchés Financiers (AMF) referenced for complaint management under its regulations." ;
    rdfs:subClassOf bpi:RegulatoryAuthority .

bpi:AcceleratorPrograms a owl:Class ;
    rdfs:label "AcceleratorPrograms" ;
    rdfs:comment "Accelerator program offered to start-ups, SMEs, and mid-caps." .

bpi:Accelerators a owl:Class ;
    rdfs:label "Accelerators" ;
    rdfs:comment "A support division responsible for marketing, training influencers and organizing accelerator programmes." ;
    rdfs:subClassOf bpi:SupportDivision .

bpi:AccountingAmendment a owl:Class ;
    rdfs:label "AccountingAmendment" ;
    rdfs:comment "An amendment to existing accounting standards or interpretations." ;
    rdfs:subClassOf bpi:AccountingStandard .

bpi:AccountingDelegate a owl:Class ;
    rdfs:label "AccountingDelegate" ;
    rdfs:comment "An entity to whom accounting management of funds is delegated." ;
    rdfs:subClassOf bpi:ServiceProvider .

bpi:AccountingInterpretation a owl:Class ;
    rdfs:label "AccountingInterpretation" ;
    rdfs:comment "An interpretation issued as part of the mandatory or optional accounting requirements." ;
    rdfs:subClassOf bpi:AccountingStandard .

bpi:AccountingMethodEquity a owl:Class ;
    rdfs:label "AccountingMethodEquity" ;
    rdfs:comment "Equity-accounting method used to incorporate equity-consolidated companies in consolidated financial statements." ;
    rdfs:subClassOf bpi:ConsolidationScope .

bpi:AccountingStandardsAuthority a owl:Class ;
    rdfs:label "AccountingStandardsAuthority" ;
    rdfs:comment "An authority referenced as having a board where a representative of the State is delegated." .

bpi:ActivitiesOnBehalfOfThirdPartiesNote a owl:Class ;
    rdfs:label "ActivitiesOnBehalfOfThirdPartiesNote" ;
    rdfs:comment "Note section describing activities on behalf of third parties." ;
    rdfs:subClassOf bpi:NotesToFinancialStatements .

bpi:ActuarialGainLoss a owl:Class ;
    rdfs:label "ActuarialGainLoss" ;
    rdfs:comment "Actuarial gains and losses arising from defined benefit plans." ;
    rdfs:subClassOf bpi:DefinedBenefitPlan .

bpi:AdministrativeBodyCompensation a owl:Class ;
    rdfs:label "AdministrativeBodyCompensation" ;
    rdfs:comment "Compensation paid to members of administrative bodies disclosed in the notes." .

bpi:AdministrativeBodyMember a owl:Class ;
    rdfs:label "AdministrativeBodyMember" ;
    rdfs:comment "A member of administrative bodies referenced for compensation disclosures." .

bpi:AdministrativeFile a owl:Class ;
    rdfs:label "AdministrativeFile" ;
    rdfs:comment "The administrative file compiled for selected candidates as part of recruitment." .

bpi:AdministrativeProcedure a owl:Class ;
    rdfs:label "AdministrativeProcedure" ;
    rdfs:comment "An administrative process where personal data may be disclosed to authorities." .

bpi:Affiliate a owl:Class ;
    rdfs:label "Affiliate" ;
    rdfs:comment "An entity over which the group has significant influence, typically accounted for using the equity method." ;
    rdfs:subClassOf bpi:EquityConsolidatedCompany .

bpi:AgencyForEcologicalTransition a owl:Class ;
    rdfs:label "AgencyForEcologicalTransition" ;
    rdfs:comment "The agency responsible for ecological transition implementation referenced in agreements." .

bpi:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "A natural person acting as an agent of a supplier whose personal data is processed." ;
    rdfs:subClassOf bpi:DataSubject .

bpi:AidContract a owl:Class ;
    rdfs:label "AidContract" ;
    rdfs:comment "A contract type under which aid is granted as part of financing/support schemes." ;
    rdfs:subClassOf bpi:FinancingMechanism .

bpi:AidForInnovation a owl:Class ;
    rdfs:label "AidForInnovation" ;
    rdfs:comment "Innovation financing through grants and related instruments." ;
    rdfs:subClassOf bpi:InnovationBusinessLine .

bpi:AllocationAndImpactReport a owl:Class ;
    rdfs:label "AllocationAndImpactReport" ;
    rdfs:comment "Annual reporting package describing allocation of proceeds and environmental impact metrics for eligible green loans categories." .

bpi:AmortisedCostFinancialAsset a owl:Class ;
    rdfs:label "AmortisedCostFinancialAsset" ;
    rdfs:comment "A financial asset carried at amortised cost when contractual cash flows meet criteria such as SPPI." ;
    rdfs:subClassOf bpi:FinancialAsset .

bpi:AngelsSeedAmbitionFund a owl:Class ;
    rdfs:label "AngelsSeedAmbitionFund" ;
    rdfs:comment "Ambition Seed Angels Fund referenced in equity investments." ;
    rdfs:subClassOf bpi:SeedFund .

bpi:Annex a owl:Class ;
    rdfs:label "Annex" ;
    rdfs:comment "An annex section referenced for structured regulatory content (e.g., Annex I and II headings)." .

bpi:AnnualFinancialStatements a owl:Class ;
    rdfs:label "AnnualFinancialStatements" ;
    rdfs:comment "Financial statements prepared for the parent entity on an annual basis." ;
    rdfs:subClassOf bpi:FinancialStatements .

bpi:AntiCorruption a owl:Class ;
    rdfs:label "AntiCorruption" ;
    rdfs:comment "Anti-corruption training referenced in non-financial reporting." .

bpi:AntiMoneyLaunderingCompliance a owl:Class ;
    rdfs:label "AntiMoneyLaunderingCompliance" ;
    rdfs:comment "A compliance domain referenced as part of legal texts governing responsible investment policy." .

bpi:AppointmentAndCompensationCommittee a owl:Class ;
    rdfs:label "AppointmentAndCompensationCommittee" ;
    rdfs:comment "A committee responsible for appointment and compensation matters within governance." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:AppointmentsCommittee a owl:Class ;
    rdfs:label "AppointmentsCommittee" ;
    rdfs:comment "Governance body determined by law for oversight of appointments." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:Article8Fund a owl:Class ;
    rdfs:label "Article8Fund" ;
    rdfs:comment "A classification of financial products/funds under EU sustainable finance disclosure rules." ;
    rdfs:subClassOf bpi:Fund .

bpi:AssetAndIntangiblesFinancing a owl:Class ;
    rdfs:label "AssetAndIntangiblesFinancing" ;
    rdfs:comment "Short-term financing of assets and intangibles." ;
    rdfs:subClassOf bpi:FinancingActivity .

bpi:AssuranceExport a owl:Class ;
    rdfs:label "AssuranceExport" ;
    rdfs:comment "Export insurance subsidiary referenced in the capital structure chart." ;
    rdfs:subClassOf bpi:PublicLimitedCompanySubsidiary .

bpi:AuditEngagement a owl:Class ;
    rdfs:label "AuditEngagement" ;
    rdfs:comment "The engagement entrusted to statutory auditors to audit financial statements." ;
    rdfs:subClassOf bpi:StatutoryAuditorReport,
        bpi:StatutoryAuditors .

bpi:AuditEvidence a owl:Class ;
    rdfs:label "AuditEvidence" ;
    rdfs:comment "Evidence obtained by auditors as a basis for their opinion." ;
    rdfs:subClassOf bpi:StatutoryAuditors .

bpi:AuditOpinion a owl:Class ;
    rdfs:label "AuditOpinion" ;
    rdfs:comment "The audit opinion expressed on the financial statements." ;
    rdfs:subClassOf bpi:StatutoryAuditors .

bpi:Auditor a owl:Class ;
    rdfs:label "Auditor" ;
    rdfs:comment "An independent reviewer (including statutory auditors) certifying accounts or supporting compliance." ;
    rdfs:subClassOf bpi:ProfessionalAdvisor .

bpi:AuthorizedPerson a owl:Class ;
    rdfs:label "AuthorizedPerson" ;
    rdfs:comment "A person authorized to act or provide information in relation to covered transactions." ;
    rdfs:subClassOf bpi:Person .

bpi:AutonomousPatientUnit a owl:Class ;
    rdfs:label "AutonomousPatientUnit" ;
    rdfs:comment "An investment unit operating in digital health through a dedicated fund." ;
    rdfs:subClassOf bpi:InvestmentUnit .

bpi:AutoriteDesMarchesFinanciers a owl:Class ;
    rdfs:label "AutoriteDesMarchesFinanciers" ;
    rdfs:comment "The French financial markets authority referenced in governance delegation." ;
    rdfs:subClassOf bpi:FinancialMarketAuthority .

bpi:BMTNProgramme a owl:Class ;
    rdfs:label "BMTNProgramme" ;
    rdfs:comment "Medium-term refinancing programme referenced alongside EMTN in outstanding amounts." .

bpi:BankAccountInterestExpense a owl:Class ;
    rdfs:label "BankAccountInterestExpense" ;
    rdfs:comment "Interest expense on bank accounts." ;
    rdfs:subClassOf bpi:InterestAndSimilarExpense .

bpi:BankFinancing a owl:Class ;
    rdfs:label "BankFinancing" ;
    rdfs:comment "Financing provided by banks that may be supported by guarantees and insurance." .

bpi:BankingAndFinancialData a owl:Class ;
    rdfs:label "BankingAndFinancialData" ;
    rdfs:comment "Category of personal data related to banking details and financial information." ;
    rdfs:subClassOf bpi:PersonalData .

bpi:BankingInstitution a owl:Class ;
    rdfs:label "BankingInstitution" ;
    rdfs:comment "An institution referenced as part of interdependent links that can fail and create systemic effects." .

bpi:BankingSupervisoryAuthorityDatabase a owl:Class ;
    rdfs:label "BankingSupervisoryAuthorityDatabase" ;
    rdfs:comment "Databases managed by banking supervisory authorities referenced as sources." ;
    rdfs:subClassOf bpi:RegulatoryDatabase .

bpi:BanquePubliqueDInvestissement a owl:Class ;
    rdfs:label "BanquePubliqueDInvestissement" ;
    rdfs:comment "The public investment bank/group that brings together business financing and development activities." ;
    rdfs:subClassOf bpi:PublicGroup .

bpi:BeneficialOwner a owl:Class ;
    rdfs:label "BeneficialOwner" ;
    rdfs:comment "A person who ultimately owns or controls a company seeking or receiving financing/support." ;
    rdfs:subClassOf bpi:Person .

bpi:BilateralLoan a owl:Class ;
    rdfs:label "BilateralLoan" ;
    rdfs:comment "Debt financing provided through bilateral loans referenced in guarantee commitments." ;
    rdfs:subClassOf bpi:DebtSecurity .

bpi:BiodiversityClub a owl:Class ;
    rdfs:label "BiodiversityClub" ;
    rdfs:comment "A business club referenced as supporting positive biodiversity initiatives." .

bpi:BiodiversityConservationGoal a owl:Class ;
    rdfs:label "BiodiversityConservationGoal" ;
    rdfs:comment "International biodiversity conservation objectives used as reference points for alignment and measurement." .

bpi:BiodiversityConservationPolicy a owl:Class ;
    rdfs:label "BiodiversityConservationPolicy" ;
    rdfs:comment "A policy held by companies with commitments and objectives for biodiversity conservation." .

bpi:BiodiversityFootprint a owl:Class ;
    rdfs:label "BiodiversityFootprint" ;
    rdfs:comment "A measurement of biodiversity impact/footprint of portfolio companies or funds." .

bpi:BiodiversityProgram a owl:Class ;
    rdfs:label "BiodiversityProgram" ;
    rdfs:comment "Diag Biodiversité program involving expert visits, biodiversity materiality analysis, and action levers for implementation." .

bpi:BiodiversityProtectionProject a owl:Class ;
    rdfs:label "BiodiversityProtectionProject" ;
    rdfs:comment "Projects and expenditures aimed at protecting and restoring biodiversity." .

bpi:BiodiversityScore a owl:Class ;
    rdfs:label "BiodiversityScore" ;
    rdfs:comment "A scoring methodology (e.g., global biodiversity score) used to measure biodiversity footprint." .

bpi:BoardOfDirectorsReport a owl:Class ;
    rdfs:label "BoardOfDirectorsReport" ;
    rdfs:comment "A management report to the general meeting prepared/updated by the board, including corporate governance information." .

bpi:BondIssue a owl:Class ;
    rdfs:label "BondIssue" ;
    rdfs:comment "A bond issuance referenced in the context of funding sources and liquidity risk." ;
    rdfs:subClassOf bpi:FinancialInstrument .

bpi:BondProgramme a owl:Class ;
    rdfs:label "BondProgramme" ;
    rdfs:comment "Programme under which bonds are issued (e.g., EMTN programmes, NEU MTN/CP programmes)." ;
    rdfs:subClassOf bpi:DebtSecurity .

bpi:BondsAndFixedIncomeSecurities a owl:Class ;
    rdfs:label "BondsAndFixedIncomeSecurities" ;
    rdfs:comment "Bonds and fixed-income securities referenced in fair value measurement." ;
    rdfs:subClassOf bpi:DebtInstrument .

bpi:BookValueOfFinancialAssetsSold a owl:Class ;
    rdfs:label "BookValueOfFinancialAssetsSold" ;
    rdfs:comment "Book value of financial assets sold included in extraordinary expenses." ;
    rdfs:subClassOf bpi:ExtraordinaryExpense .

bpi:BpifranceAccruedExpenses a owl:Class ;
    rdfs:label "BpifranceAccruedExpenses" ;
    rdfs:comment "Bpifrance accrued expenses referenced in other debts." ;
    rdfs:subClassOf bpi:OtherDebts .

bpi:BpifranceAssuranceExport a owl:Class ;
    rdfs:label "BpifranceAssuranceExport" ;
    rdfs:comment "A subsidiary managing public export guarantees on behalf of and under control of the French State." ;
    rdfs:subClassOf bpi:Subsidiary .

bpi:BpifranceCapital2Fund a owl:Class ;
    rdfs:label "BpifranceCapital2Fund" ;
    rdfs:comment "A fund referenced as included in the consolidation scope." ;
    rdfs:subClassOf bpi:InvestmentFund .

bpi:BpifranceFinancement a owl:Class ;
    rdfs:label "BpifranceFinancement" ;
    rdfs:comment "An entity referenced as the subsidiary absorbing the holding company and involved in the group structure." ;
    rdfs:subClassOf bpi:PublicLimitedCompany .

bpi:BpifranceInvestissement a owl:Class ;
    rdfs:label "BpifranceInvestissement" ;
    rdfs:comment "An entity within the group associated with equity activity and investment management." ;
    rdfs:subClassOf bpi:BpifranceGroup,
        bpi:PublicLimitedCompany,
        bpi:Subsidiary .

bpi:BpifranceNetwork a owl:Class ;
    rdfs:label "BpifranceNetwork" ;
    rdfs:comment "Bpifrance network referenced as having an organisational chart in the appendix." .

bpi:BpifranceParticipations a owl:Class ;
    rdfs:label "BpifranceParticipations" ;
    rdfs:comment "An entity within the group referenced as participating in accelerator deployments and support activities." ;
    rdfs:subClassOf bpi:BpifranceGroup,
        bpi:PublicLimitedCompany,
        bpi:Subsidiary .

bpi:BpifranceParticipationsAllocation a owl:Class ;
    rdfs:label "BpifranceParticipationsAllocation" ;
    rdfs:comment "Allocation payable to Bpifrance Participations referenced in other debts." ;
    rdfs:subClassOf bpi:OtherDebts .

bpi:BpifranceRegions a owl:Class ;
    rdfs:label "BpifranceRegions" ;
    rdfs:comment "A subsidiary operating financing activities within the group." ;
    rdfs:subClassOf bpi:Subsidiary .

bpi:Building a owl:Class ;
    rdfs:label "Building" ;
    rdfs:comment "Real-estate asset financed under eligible green building loans, evaluated for environmental norms and renovation programs." .

bpi:BusinessCreationSupportActors a owl:Class ;
    rdfs:label "BusinessCreationSupportActors" ;
    rdfs:comment "Actors involved in supporting business creation, including awareness, preparation, direction, and financing of projects." ;
    rdfs:subClassOf bpi:BusinessCreation .

bpi:BusinessLines a owl:Class ;
    rdfs:label "BusinessLines" ;
    rdfs:comment "Business lines organized within the entity’s organizational chart." ;
    rdfs:subClassOf bpi:OrganizationalChartOfBusinessLines .

bpi:BusinessLoan a owl:Class ;
    rdfs:label "BusinessLoan" ;
    rdfs:comment "Business loans (co-financing) described as financing solutions for investments and operations." ;
    rdfs:subClassOf bpi:Loan .

bpi:BusinessSupportActivity a owl:Class ;
    rdfs:label "BusinessSupportActivity" ;
    rdfs:comment "Operational activities such as accelerated companies and consultancy assignments." ;
    rdfs:subClassOf bpi:BusinessSupportBusinessLine .

bpi:CNES a owl:Class ;
    rdfs:label "CNES" ;
    rdfs:comment "The National Centre for Space Studies referenced as a partner in implementing space initiatives." ;
    rdfs:subClassOf bpi:SpaceAgency .

bpi:CSR a owl:Class ;
    rdfs:label "CSR" ;
    rdfs:comment "Corporate social responsibility approach referenced as part of ESG integration and monitoring." .

bpi:CSRClause a owl:Class ;
    rdfs:label "CSRClause" ;
    rdfs:comment "A contractual clause formalizing ESG progress expectations in shareholder agreements." .

bpi:CaisseDesDepots a owl:Class ;
    rdfs:label "CaisseDesDepots" ;
    rdfs:comment "Public institution referenced as owning/controlling and represented in governance." ;
    rdfs:subClassOf bpi:PublicEntity .

bpi:Capital a owl:Class ;
    rdfs:label "Capital" ;
    rdfs:comment "Subscribed capital component of shareholders’ equity." ;
    rdfs:subClassOf bpi:ShareholdersEquity .

bpi:CapitalDevelopmentBusinessLine a owl:Class ;
    rdfs:label "CapitalDevelopmentBusinessLine" ;
    rdfs:comment "An investment business line investing directly in equity, quasi-equity and debt for SMEs, intermediate-sized enterprises and large companies." ;
    rdfs:subClassOf bpi:InvestmentBusinessLine .

bpi:CarbonFootprint a owl:Class ;
    rdfs:label "CarbonFootprint" ;
    rdfs:comment "A carbon footprint attributed to the investment portfolio and used for trajectory and reporting." .

bpi:CarbonIntensity a owl:Class ;
    rdfs:label "CarbonIntensity" ;
    rdfs:comment "A metric measuring carbon intensity of financing, investment, and insurance activities." .

bpi:CarbonNeutralityObjective a owl:Class ;
    rdfs:label "CarbonNeutralityObjective" ;
    rdfs:comment "An objective of carbon neutrality referenced for alignment with climate goals." .

bpi:CashAndCashEquivalentsNote a owl:Class ;
    rdfs:label "CashAndCashEquivalentsNote" ;
    rdfs:comment "Note section detailing cash and cash equivalents." ;
    rdfs:subClassOf bpi:NotesToFinancialStatements .

bpi:CashFlowHedging a owl:Class ;
    rdfs:label "CashFlowHedging" ;
    rdfs:comment "Hedging strategy where changes in cash flows are recognized according to cash flow hedge accounting." ;
    rdfs:subClassOf bpi:HedgingDerivative .

bpi:CateringTradeModernisationFund a owl:Class ;
    rdfs:label "CateringTradeModernisationFund" ;
    rdfs:comment "Catering-trade Modernisation Fund referenced in other debts and fixed-asset-related debts." ;
    rdfs:subClassOf bpi:Fund,
        bpi:OtherDebt .

bpi:CertificatesOfDeposit a owl:Class ;
    rdfs:label "CertificatesOfDeposit" ;
    rdfs:comment "Certificates of deposit referenced as outstanding short-term refinancing instruments." ;
    rdfs:subClassOf bpi:Securities .

bpi:ChairmanAndChiefExecutiveOfficer a owl:Class ;
    rdfs:label "ChairmanAndChiefExecutiveOfficer" ;
    rdfs:comment "A combined role of chairman and chief executive officer for the entity." .

bpi:ChangesInEquity a owl:Class ;
    rdfs:label "ChangesInEquity" ;
    rdfs:comment "A statement section describing movements in equity over time, including group share and minority interests." ;
    rdfs:subClassOf bpi:Equity .

bpi:ClaimsManagement a owl:Class ;
    rdfs:label "ClaimsManagement" ;
    rdfs:comment "A processing purpose covering management of possible disputes and claims." .

bpi:CleanTransportationProject a owl:Class ;
    rdfs:label "CleanTransportationProject" ;
    rdfs:comment "Projects for clean transportation and acquisition of clean vehicles/equipment." .

bpi:ClearingAgent a owl:Class ;
    rdfs:label "ClearingAgent" ;
    rdfs:comment "A financial intermediary whose interruption or malfunction can create operational risk." .

bpi:Client a owl:Class ;
    rdfs:label "Client" ;
    rdfs:comment "A counterparty receiving financing or subject to credit risk measurement." ;
    rdfs:subClassOf bpi:Organization .

bpi:ClimateAdvisoryCommittee a owl:Class ;
    rdfs:label "ClimateAdvisoryCommittee" ;
    rdfs:comment "Advisory committee for climate matters." ;
    rdfs:subClassOf bpi:AdvisoryCommittee .

bpi:ClimateAndEnvironmentalRiskCommittee a owl:Class ;
    rdfs:label "ClimateAndEnvironmentalRiskCommittee" ;
    rdfs:comment "Dedicated governance and advisory committee overseeing climate and environmental risk." .

bpi:ClimateCommittee a owl:Class ;
    rdfs:label "ClimateCommittee" ;
    rdfs:comment "Committee incorporated to oversee the climate plan within governance bodies." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:ClimateMaturityIndex a owl:Class ;
    rdfs:label "ClimateMaturityIndex" ;
    rdfs:comment "Index used to evaluate exposure and maturity of companies regarding green transition challenges." .

bpi:ClimatePlanCoordinationTeam a owl:Class ;
    rdfs:label "ClimatePlanCoordinationTeam" ;
    rdfs:comment "A team coordinating climate plan activities within the ESG workforce." ;
    rdfs:subClassOf bpi:ESGWorkforce .

bpi:ClimateRelatedRisk a owl:Class ;
    rdfs:label "ClimateRelatedRisk" ;
    rdfs:comment "Risks stemming from climate change, including physical risks and transition risks related to adaptation to a low-carbon economy." ;
    rdfs:subClassOf bpi:Risk .

bpi:ClimateRiskCommittee a owl:Class ;
    rdfs:label "ClimateRiskCommittee" ;
    rdfs:comment "A committee created to monitor the group’s exposure to climate risks and endorse methodological changes." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:ClimateRiskManagement a owl:Class ;
    rdfs:label "ClimateRiskManagement" ;
    rdfs:comment "Internal tool used to assess physical climate risks during credit granting." .

bpi:ClimateRiskManagementTool a owl:Class ;
    rdfs:label "ClimateRiskManagementTool" ;
    rdfs:comment "Internal tool used during credit granting to assess physical climate risks under multiple hazards, scenarios, and time horizons." .

bpi:CoInvestor a owl:Class ;
    rdfs:label "CoInvestor" ;
    rdfs:comment "A stakeholder participating in investment transactions alongside the organization." ;
    rdfs:subClassOf bpi:Person .

bpi:CommercialBank a owl:Class ;
    rdfs:label "CommercialBank" ;
    rdfs:comment "Private commercial banks referenced as partners in financing and as shareholders." ;
    rdfs:subClassOf bpi:FinancialInstitution .

bpi:CommercialProspecting a owl:Class ;
    rdfs:label "CommercialProspecting" ;
    rdfs:comment "Activities related to receiving commercial prospecting communications and related processing." .

bpi:CommercialRelationshipManagement a owl:Class ;
    rdfs:label "CommercialRelationshipManagement" ;
    rdfs:comment "Management of the commercial relationship between the organization and prospects." ;
    rdfs:subClassOf bpi:ContractLifecycleManagement .

bpi:CommissionNationaleDeLInformatiqueEtDesLibertes a owl:Class ;
    rdfs:label "CommissionNationaleDeLInformatiqueEtDesLibertes" ;
    rdfs:comment "A national data protection authority where individuals may lodge a complaint." .

bpi:Commitment a owl:Class ;
    rdfs:label "Commitment" ;
    rdfs:comment "A generic commitment disclosed off-balance sheet." ;
    rdfs:subClassOf bpi:OffBalanceSheetCommitments .

bpi:CommitmentsReceived a owl:Class ;
    rdfs:label "CommitmentsReceived" ;
    rdfs:comment "Off-balance-sheet commitments received by the entity." ;
    rdfs:subClassOf bpi:OffBalanceSheetCommitments .

bpi:CompensationCommittee a owl:Class ;
    rdfs:label "CompensationCommittee" ;
    rdfs:comment "Governance body determined by law for oversight of compensation." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:CompensationPaidToAdministrativeBodiesNote a owl:Class ;
    rdfs:label "CompensationPaidToAdministrativeBodiesNote" ;
    rdfs:comment "Note section detailing compensation paid to members of administrative bodies." ;
    rdfs:subClassOf bpi:NotesToFinancialStatements .

bpi:CompensationPaidToMembersOfAdministrativeBodies a owl:Class ;
    rdfs:label "CompensationPaidToMembersOfAdministrativeBodies" ;
    rdfs:comment "Note category for compensation paid to members of administrative bodies." ;
    rdfs:subClassOf bpi:NotesToFinancialStatements .

bpi:ComplaintManagement a owl:Class ;
    rdfs:label "ComplaintManagement" ;
    rdfs:comment "A process for handling complaints under applicable regulatory frameworks." .

bpi:ComplaintsAndDisputesData a owl:Class ;
    rdfs:label "ComplaintsAndDisputesData" ;
    rdfs:comment "Personal data processed for management of complaints and possible disputes arising from recruitment." ;
    rdfs:subClassOf bpi:PersonalData .

bpi:ComplaintsAndLitigationManagement a owl:Class ;
    rdfs:label "ComplaintsAndLitigationManagement" ;
    rdfs:comment "Processing activities for managing complaints and litigation and defending rights in court." .

bpi:ComplianceDepartment a owl:Class ;
    rdfs:label "ComplianceDepartment" ;
    rdfs:comment "Organizational unit ensuring compliance with applicable rules, eligibility criteria, and governance requirements." .

bpi:ComplianceWithLegalRegulatoryTaxProvision a owl:Class ;
    rdfs:label "ComplianceWithLegalRegulatoryTaxProvision" ;
    rdfs:comment "Processing to comply with other legal, regulatory, or tax provisions applicable to the organization." .

bpi:ConcentrationRisk a owl:Class ;
    rdfs:label "ConcentrationRisk" ;
    rdfs:comment "Risk arising from excessive dependency on certain counterparties, business segments, or geographical regions." ;
    rdfs:subClassOf bpi:NonPerformanceRisk .

bpi:ConnectedSpace a owl:Class ;
    rdfs:label "ConnectedSpace" ;
    rdfs:comment "A user-accessible connected environment for which identification and authentication data are processed." .

bpi:ConnectionData a owl:Class ;
    rdfs:label "ConnectionData" ;
    rdfs:comment "Category of personal data related to identification/authentication and online activity (e.g., IP address, logs)." .

bpi:ConsolidatedStatutoryAuditorReport a owl:Class ;
    rdfs:label "ConsolidatedStatutoryAuditorReport" ;
    rdfs:comment "Statutory auditor report on consolidated financial statements." ;
    rdfs:subClassOf bpi:StatutoryAuditorReport .

bpi:ConsultancyAndOperationalManagement a owl:Class ;
    rdfs:label "ConsultancyAndOperationalManagement" ;
    rdfs:comment "A support division participating in design and implementation of consultancy and operational management projects." ;
    rdfs:subClassOf bpi:SupportDivision .

bpi:ContractExecution a owl:Class ;
    rdfs:label "ContractExecution" ;
    rdfs:comment "The execution and management of the life of a contract, including disbursement and repayment." ;
    rdfs:subClassOf bpi:Contract .

bpi:Control a owl:Class ;
    rdfs:label "Control" ;
    rdfs:comment "The condition under which the group is exposed to variable returns and can direct relevant activities to influence those returns." ;
