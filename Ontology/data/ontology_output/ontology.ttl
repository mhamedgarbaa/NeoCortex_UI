bpi:integratesRiskAssessmentInto a owl:ObjectProperty ;
    rdfs:label "integratesRiskAssessmentInto" ;
    rdfs:comment "Indicates that the bank gradually integrates the assessment of risks into its risk management system." ;
    rdfs:domain bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:RiskManagementSystem .

bpi:interestAndSimilarExpenseAmount a owl:DatatypeProperty ;
    rdfs:label "interestAndSimilarExpenseAmount" ;
    rdfs:comment "Amount of interest and similar expenses." ;
    rdfs:domain bpi:InterestExpense ;
    rdfs:range xsd:decimal .

bpi:interestAndSimilarExpenses a owl:DatatypeProperty ;
    rdfs:label "interestAndSimilarExpenses" ;
    rdfs:comment "Interest and similar expenses amount disclosed in the financial statements." ;
    rdfs:domain bpi:InterestExpense,
        bpi:NetInterestMargin ;
    rdfs:range xsd:decimal .

bpi:interestAndSimilarExpensesAmount a owl:DatatypeProperty ;
    rdfs:label "interestAndSimilarExpensesAmount" ;
    rdfs:comment "Interest and similar expenses amount (in thousands of euros)." ;
    rdfs:domain bpi:InterestExpense ;
    rdfs:range xsd:decimal .

bpi:interestAndSimilarExpensesTotalAmount a owl:DatatypeProperty ;
    rdfs:label "interestAndSimilarExpensesTotalAmount" ;
    rdfs:comment "Total interest and similar expenses reported for the period (in thousands of euros)." ;
    rdfs:domain bpi:InterestExpense ;
    rdfs:range xsd:decimal .

bpi:interestAndSimilarIncome a owl:DatatypeProperty ;
    rdfs:label "interestAndSimilarIncome" ;
    rdfs:comment "Interest and similar income amount disclosed in the financial statements." ;
    rdfs:domain bpi:InterestIncome,
        bpi:NetInterestMargin ;
    rdfs:range xsd:decimal .

bpi:interestAndSimilarIncomeAmount a owl:DatatypeProperty ;
    rdfs:label "interestAndSimilarIncomeAmount" ;
    rdfs:comment "Interest and similar income amount (in thousands of euros)." ;
    rdfs:domain bpi:InterestIncome ;
    rdfs:range xsd:decimal .

bpi:interestAndSimilarIncomeTotalAmount a owl:DatatypeProperty ;
    rdfs:label "interestAndSimilarIncomeTotalAmount" ;
    rdfs:comment "Total interest and similar income reported for the period (in thousands of euros)." ;
    rdfs:domain bpi:InterestIncome ;
    rdfs:range xsd:decimal .

bpi:interestExpense a owl:DatatypeProperty ;
    rdfs:label "interestExpense" ;
    rdfs:comment "Interest expense amount for the period." ;
    rdfs:domain bpi:InterestExpense ;
    rdfs:range xsd:decimal .

bpi:interestIncome a owl:DatatypeProperty ;
    rdfs:label "interestIncome" ;
    rdfs:comment "Interest income amount for the period." ;
    rdfs:domain bpi:InterestIncome ;
    rdfs:range xsd:decimal .

bpi:interestRateScenarioShockBasisPoints a owl:DatatypeProperty ;
    rdfs:label "interestRateScenarioShockBasisPoints" ;
    rdfs:comment "Magnitude of the interest rate shock used to assess sensitivity (e.g., 200 bps rise/fall)." ;
    rdfs:domain bpi:NetInterestMargin ;
    rdfs:range xsd:decimal .

bpi:interestReceivable a owl:DatatypeProperty ;
    rdfs:label "interestReceivable" ;
    rdfs:comment "Interest receivable amount." ;
    rdfs:domain bpi:InterestReceivable ;
    rdfs:range xsd:decimal .

bpi:interestReceivableAmount a owl:DatatypeProperty ;
    rdfs:label "interestReceivableAmount" ;
    rdfs:comment "Interest receivable amount (in thousands of euros)." ;
    rdfs:domain bpi:InterestReceivable ;
    rdfs:range xsd:decimal .

bpi:interestsToBeReceivedStateCurrentAccountAmount a owl:DatatypeProperty ;
    rdfs:label "interestsToBeReceivedStateCurrentAccountAmount" ;
    rdfs:comment "Interests to be received on the State current account (in thousands of euros)." ;
    rdfs:domain bpi:OtherReceivables ;
    rdfs:range xsd:decimal .

bpi:interimDividendAmount a owl:DatatypeProperty ;
    rdfs:label "interimDividendAmount" ;
    rdfs:comment "Total interim dividend amount already paid." ;
    rdfs:domain bpi:Dividends,
        bpi:DividendsPaid ;
    rdfs:range xsd:decimal .

bpi:interimDividendPaymentDate a owl:DatatypeProperty ;
    rdfs:label "interimDividendPaymentDate" ;
    rdfs:comment "Date on which the interim dividend was paid." ;
    rdfs:domain bpi:Dividends,
        bpi:DividendsPaid ;
    rdfs:range xsd:date .

bpi:interimDividendPerShare a owl:DatatypeProperty ;
    rdfs:label "interimDividendPerShare" ;
    rdfs:comment "Interim dividend amount distributed per share (e.g., €0.63 per share)." ;
    rdfs:domain bpi:Dividends,
        bpi:DividendsPaid ;
    rdfs:range xsd:decimal .

bpi:interimDividendTotalAmount a owl:DatatypeProperty ;
    rdfs:label "interimDividendTotalAmount" ;
    rdfs:comment "Total interim dividend amount distributed (e.g., €427.2 million)." ;
    rdfs:domain bpi:DividendsPaid ;
    rdfs:range xsd:decimal .

bpi:internationalTransferSafeguards a owl:DatatypeProperty ;
    rdfs:label "internationalTransferSafeguards" ;
    rdfs:comment "Safeguards or mechanisms used for international transfers (e.g., adequacy decision, GDPR derogations, legal/technical/organizational measures)." ;
    rdfs:domain bpi:InternationalDataTransfer ;
    rdfs:range xsd:string .

bpi:investsThrough a owl:ObjectProperty ;
    rdfs:label "investsThrough" ;
    rdfs:comment "Indicates that the group invests through its investment business lines." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:InvestmentBusinessLine .

bpi:isAboutDataSubject a owl:ObjectProperty ;
    rdfs:label "isAboutDataSubject" ;
    rdfs:comment "Indicates that a personal data request concerns a particular data subject." ;
    rdfs:domain bpi:PersonalDataRequest ;
    rdfs:range bpi:DataSubject .

bpi:isAlignedWithSustainableDevelopmentGoals a owl:ObjectProperty ;
    rdfs:label "isAlignedWithSustainableDevelopmentGoals" ;
    rdfs:comment "Green financing instruments aim to contribute to the Sustainable Development Goals." ;
    rdfs:domain bpi:GreenFinancingInstrument ;
    rdfs:range bpi:SustainableDevelopmentGoal .

bpi:isComplaintTo a owl:ObjectProperty ;
    rdfs:label "isComplaintTo" ;
    rdfs:comment "Indicates that the complaint authority is the CNIL for lodging complaints." ;
    rdfs:domain bpi:ComplaintAuthority ;
    rdfs:range bpi:CNIL .

bpi:isCompliantWith a owl:ObjectProperty ;
    rdfs:label "isCompliantWith" ;
    rdfs:comment "Indicates that the policy is compliant with GDPR requirements." ;
    rdfs:domain bpi:GDPR,
        bpi:PersonalDataProtectionPolicy ;
    rdfs:range bpi:EuropeanGeneralDataProtectionRegulation,
        bpi:GDPR .

bpi:isControlledBy a owl:ObjectProperty ;
    rdfs:label "isControlledBy" ;
    rdfs:comment "Indicates control by a state shareholding entity where the state holds shares (implied by the French State holding a share and control context)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:StateShareholdingEntity .

bpi:isDataControllerFor a owl:ObjectProperty ;
    rdfs:label "isDataControllerFor" ;
    rdfs:comment "Indicates that a data controller is responsible for a specific personal data processing activity." ;
    rdfs:domain bpi:DataController ;
    rdfs:range bpi:PersonalDataProcessing .

bpi:isDataControllerOf a owl:ObjectProperty ;
    rdfs:label "isDataControllerOf" ;
    rdfs:comment "Indicates that a data controller performs personal data processing." ;
    rdfs:domain bpi:DataController ;
    rdfs:range bpi:PersonalDataProcessing .

bpi:isGovernedBy a owl:ObjectProperty ;
    rdfs:label "isGovernedBy" ;
    rdfs:comment "Indicates which applicable regulation governs a personal data processing activity." ;
    rdfs:domain bpi:PersonalDataProcessing ;
    rdfs:range bpi:ApplicableRegulation .

bpi:isGovernedByApplicableRegulation a owl:ObjectProperty ;
    rdfs:label "isGovernedByApplicableRegulation" ;
    rdfs:comment "Indicates that the processing is governed by applicable national provisions and regulations referenced in the policy." ;
    rdfs:domain bpi:PersonalDataProcessing ;
    rdfs:range bpi:ApplicableRegulation .

bpi:isGovernedByGDPR a owl:ObjectProperty ;
    rdfs:label "isGovernedByGDPR" ;
    rdfs:comment "Indicates that the processing is governed by the GDPR." ;
    rdfs:domain bpi:PersonalDataProcessing ;
    rdfs:range bpi:GDPR .

bpi:isGuarantorFor a owl:ObjectProperty ;
    rdfs:label "isGuarantorFor" ;
    rdfs:comment "Indicates that the institution provides guarantees for bond issues under a bond issue programme." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:BondIssueProgramme .

bpi:isImplementedBy a owl:ObjectProperty ;
    rdfs:label "isImplementedBy" ;
    rdfs:comment "Indicates the data controller that implements the processing described by the policy." ;
    rdfs:domain bpi:ElectronicSignatureProcess,
        bpi:PrivacyPolicy ;
    rdfs:range bpi:DataController,
        bpi:TrustedServiceProvider .

bpi:isLimitedReviewedBy a owl:ObjectProperty ;
    rdfs:label "isLimitedReviewedBy" ;
    rdfs:comment "Indicates that the consolidated financial statements are subject to a limited review by statutory auditors." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:StatutoryAuditor .

bpi:isOriginatorAndManagerOfLoans a owl:ObjectProperty ;
    rdfs:label "isOriginatorAndManagerOfLoans" ;
    rdfs:comment "Bpifrance is the originator and manager of the loans financed or refinanced by the green financing instruments." ;
    rdfs:domain bpi:Bpifrance ;
    rdfs:range bpi:Loans .

bpi:isParentOf a owl:ObjectProperty ;
    rdfs:label "isParentOf" ;
    rdfs:comment "Indicates the institution consolidates equity-consolidated companies as part of its group financial statements (equity-consolidated companies included in consolidated accounts)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:EquityConsolidatedCompany .

bpi:isPartnerOf a owl:ObjectProperty ;
    rdfs:label "isPartnerOf" ;
    rdfs:comment "Indicates that the group is a partner of an NGO/initiative for biodiversity and related programmes." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:NonGovernmentalOrganization .

bpi:isPolicyFor a owl:ObjectProperty ;
    rdfs:label "isPolicyFor" ;
    rdfs:comment "Indicates the business context/financing activity for which the privacy policy applies." ;
    rdfs:domain bpi:PrivacyPolicy,
        bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:FinancingBusinessLine,
        bpi:SMESupportEntity .

bpi:isPreparedInAccordanceWith a owl:ObjectProperty ;
    rdfs:label "isPreparedInAccordanceWith" ;
    rdfs:comment "The framework references EU delegated acts for eligibility criteria (e.g., taxonomy delegated acts)." ;
    rdfs:domain bpi:GreenFinancingInstrument ;
    rdfs:range bpi:EuropeanCommissionDelegatedRegulation .

bpi:isPublicIndustrialAndCommercialInstitution a owl:ObjectProperty ;
    rdfs:label "isPublicIndustrialAndCommercialInstitution" ;
    rdfs:comment "Self-classification as a public industrial and commercial institution (redundant but implied)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:PublicIndustrialAndCommercialInstitution .

bpi:isPubliclyServedBy a owl:ObjectProperty ;
    rdfs:label "isPubliclyServedBy" ;
    rdfs:comment "Indicates the public industrial and commercial establishment serves as the Bpifrance group entity described in the document." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:BpifranceGroup .

bpi:isRequestedByDataSubject a owl:ObjectProperty ;
    rdfs:label "isRequestedByDataSubject" ;
    rdfs:comment "Indicates that a personal data request is made by a data subject." ;
    rdfs:domain bpi:PersonalDataRequest ;
    rdfs:range bpi:DataSubject .

bpi:isShareholderOf a owl:ObjectProperty ;
    rdfs:label "isShareholderOf" ;
    rdfs:comment "Indicates the institution is a shareholder of a public limited company (e.g., EPIC Bpifrance as shareholder of Bpifrance)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:PublicLimitedCompany ;
    owl:inverseOf bpi:holdsShareholdingIn .

bpi:isSubjectTo a owl:ObjectProperty ;
    rdfs:label "isSubjectTo" ;
    rdfs:comment "Indicates the processing is subject to applicable regulations referenced in the policy." ;
    rdfs:domain bpi:PersonalDataProcessing ;
    rdfs:range bpi:ApplicableRegulation .

bpi:isSubjectToDirectPrudentialSupervisionBy a owl:ObjectProperty ;
    rdfs:label "isSubjectToDirectPrudentialSupervisionBy" ;
    rdfs:comment "Indicates that the group is subject to direct prudential supervision by the European Central Bank." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:EuropeanCentralBank .

bpi:isSubjectToRegulation a owl:ObjectProperty ;
    rdfs:label "isSubjectToRegulation" ;
    rdfs:comment "Indicates that the policy is governed by GDPR (European Regulation 2016/679)." ;
    rdfs:domain bpi:PrivacyPolicy ;
    rdfs:range bpi:EuropeanGeneralDataProtectionRegulation .

bpi:isSubjectToRegulationFramework a owl:ObjectProperty ;
    rdfs:label "isSubjectToRegulationFramework" ;
    rdfs:comment "Indicates that the policy is also subject to applicable national provisions and other regulatory requirements." ;
    rdfs:domain bpi:PrivacyPolicy ;
    rdfs:range bpi:ApplicableRegulation .

bpi:isSupervisedBy a owl:ObjectProperty ;
    rdfs:label "isSupervisedBy" ;
    rdfs:comment "Indicates that the group is supervised by the prudential supervisory and resolution authority." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:PrudentialSupervisoryAndResolutionAuthority .

bpi:issuedDate a owl:DatatypeProperty ;
    rdfs:label "issuedDate" ;
    rdfs:comment "Issue date of a bond transaction." ;
    rdfs:domain bpi:BondIssueProgramme ;
    rdfs:range xsd:date .

bpi:issuesGreenFinancingInstruments a owl:ObjectProperty ;
    rdfs:label "issuesGreenFinancingInstruments" ;
    rdfs:comment "Indicates that Bpifrance issues green financing instruments under the green financing framework." ;
    rdfs:domain bpi:Bpifrance ;
    rdfs:range bpi:GreenFinancingInstrument .

bpi:largeCorporatesAmount a owl:DatatypeProperty ;
    rdfs:label "largeCorporatesAmount" ;
    rdfs:comment "Amount of managed assets allocated to large corporates (e.g., €10.9 bn)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:decimal .

bpi:lastAppointedDate a owl:DatatypeProperty ;
    rdfs:label "lastAppointedDate" ;
    rdfs:comment "Date when a board member was last appointed (e.g., by decree date)." ;
    rdfs:domain bpi:BoardOfDirectors ;
    rdfs:range xsd:date .

bpi:legalBasis a owl:DatatypeProperty ;
    rdfs:label "legalBasis" ;
    rdfs:comment "Legal basis invoked for processing personal data (e.g., contract performance, legal obligation, legitimate interest)." ;
    rdfs:domain bpi:LegalBasisForProcessing ;
    rdfs:range xsd:string .

bpi:legalBasisDescription a owl:DatatypeProperty ;
    rdfs:label "legalBasisDescription" ;
    rdfs:comment "Narrative description of the legal basis for processing for a specific purpose." ;
    rdfs:domain bpi:LegalBasisForProcessing ;
    rdfs:range xsd:string .

bpi:legalBasisForProcessing a owl:DatatypeProperty ;
    rdfs:label "legalBasisForProcessing" ;
    rdfs:comment "Legal bases invoked for processing personal data (e.g., contract performance, legal obligation, legitimate interests, consent)." ;
    rdfs:domain bpi:LegalBasisForProcessing ;
    rdfs:range xsd:string .

bpi:legalBasisForProcessingConsent a owl:DatatypeProperty ;
    rdfs:label "legalBasisForProcessingConsent" ;
    rdfs:comment "Legal basis indicating processing based on consent (where applicable)." ;
    rdfs:domain bpi:Consent ;
    rdfs:range xsd:string .

bpi:legalBasisForProcessingContractPerformance a owl:DatatypeProperty ;
    rdfs:label "legalBasisForProcessingContractPerformance" ;
    rdfs:comment "Legal basis indicating processing is necessary for performance of the contract." ;
    rdfs:domain bpi:ContractPerformanceLegalBasis ;
    rdfs:range xsd:string .

bpi:legalBasisForProcessingDescription a owl:DatatypeProperty ;
    rdfs:label "legalBasisForProcessingDescription" ;
    rdfs:comment "Description of the legal basis for processing (e.g., pre-contractual measures, legal obligations, legitimate interest)." ;
    rdfs:domain bpi:LegalBasisForProcessing ;
    rdfs:range xsd:string .

bpi:legalBasisForProcessingElectronicSignatureProcess a owl:DatatypeProperty ;
    rdfs:label "legalBasisForProcessingElectronicSignatureProcess" ;
    rdfs:comment "Legal/operational basis for managing electronic signature and establishing evidence for reliability of the process." ;
    rdfs:domain bpi:ElectronicSignatureProcess ;
    rdfs:range xsd:string .

bpi:legalBasisForProcessingLegalObligation a owl:DatatypeProperty ;
    rdfs:label "legalBasisForProcessingLegalObligation" ;
    rdfs:comment "Legal basis indicating processing is necessary to comply with a legal obligation." ;
    rdfs:domain bpi:LegalObligationLegalBasis ;
    rdfs:range xsd:string .

bpi:legalBasisForProcessingLegitimateInterest a owl:DatatypeProperty ;
    rdfs:label "legalBasisForProcessingLegitimateInterest" ;
    rdfs:comment "Legal basis indicating processing is based on legitimate interests." ;
    rdfs:domain bpi:LegitimateInterestLegalBasis ;
    rdfs:range xsd:string .

bpi:lendsTo a owl:ObjectProperty ;
    rdfs:label "lendsTo" ;
    rdfs:comment "Indicates that the public sector investment bank lends money to companies." ;
    rdfs:domain bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:Company .

bpi:leverageRatio a owl:DatatypeProperty ;
    rdfs:label "leverageRatio" ;
    rdfs:comment "Leverage ratio." ;
    rdfs:domain bpi:LeverageRatio,
        bpi:Solvency ;
    rdfs:range xsd:decimal .

bpi:liquidityCoverageRatio a owl:DatatypeProperty ;
    rdfs:label "liquidityCoverageRatio" ;
    rdfs:comment "Liquidity Coverage Ratio (LCR) reported for the period end dates." ;
    rdfs:domain bpi:LiquidityCoverageRatio ;
    rdfs:range xsd:decimal .

bpi:liquidityCoverageRatioValue a owl:DatatypeProperty ;
    rdfs:label "liquidityCoverageRatioValue" ;
    rdfs:comment "Liquidity coverage ratio (LCR) value reported for the period." ;
    rdfs:domain bpi:LiquidityCoverageRatio ;
    rdfs:range xsd:decimal .

bpi:liquidityReserve a owl:DatatypeProperty ;
    rdfs:label "liquidityReserve" ;
    rdfs:comment "Total liquidity reserve amount reported for the period end dates." ;
    rdfs:domain bpi:LiquidityReserve ;
    rdfs:range xsd:decimal .

bpi:liquidityReserveAmount a owl:DatatypeProperty ;
    rdfs:label "liquidityReserveAmount" ;
    rdfs:comment "Liquidity reserve amount reported for the period." ;
    rdfs:domain bpi:LiquidityReserve ;
    rdfs:range xsd:decimal .

bpi:liquidityReservesContingencyPlanReserve a owl:DatatypeProperty ;
    rdfs:label "liquidityReservesContingencyPlanReserve" ;
    rdfs:comment "Amount of contingency plan reserve (assets mobilisable under proven stress)." ;
    rdfs:domain bpi:LiquidityReserve ;
    rdfs:range xsd:decimal .

bpi:liquidityReservesCurrentLiquidity a owl:DatatypeProperty ;
    rdfs:label "liquidityReservesCurrentLiquidity" ;
    rdfs:comment "Amount of current liquidity (assets mobilisable in one day)." ;
    rdfs:domain bpi:LiquidityReserve ;
    rdfs:range xsd:decimal .

bpi:liquidityReservesCurrentLiquidityBuffer a owl:DatatypeProperty ;
    rdfs:label "liquidityReservesCurrentLiquidityBuffer" ;
    rdfs:comment "Amount of current liquidity buffer (highly liquid assets mobilisable in less than a week)." ;
    rdfs:domain bpi:LiquidityReserve ;
    rdfs:range xsd:decimal .

bpi:loanAmount a owl:DatatypeProperty ;
    rdfs:label "loanAmount" ;
    rdfs:comment "Amount of a loan (in €m)." ;
    rdfs:domain bpi:Loan ;
    rdfs:range xsd:decimal .

bpi:loanFinancingCommitments a owl:DatatypeProperty ;
    rdfs:label "loanFinancingCommitments" ;
    rdfs:comment "Loan financing commitments for the period." ;
    rdfs:domain bpi:FinancingCommitment ;
    rdfs:range xsd:decimal .

bpi:loanFinancingCommitmentsReceived a owl:DatatypeProperty ;
    rdfs:label "loanFinancingCommitmentsReceived" ;
    rdfs:comment "Loan financing commitments received from credit institutions for the period." ;
    rdfs:domain bpi:FinancingCommitment ;
    rdfs:range xsd:decimal .

bpi:loanInterest a owl:DatatypeProperty ;
    rdfs:label "loanInterest" ;
    rdfs:comment "Interest amount related to loans." ;
    rdfs:domain bpi:InterestIncome ;
    rdfs:range xsd:decimal .

bpi:loanMaturityDate a owl:DatatypeProperty ;
    rdfs:label "loanMaturityDate" ;
    rdfs:comment "Maturity date of a loan." ;
    rdfs:domain bpi:Loan ;
    rdfs:range xsd:date .

bpi:loanRepaymentDate a owl:DatatypeProperty ;
    rdfs:label "loanRepaymentDate" ;
    rdfs:comment "Repayment date of a loan." ;
    rdfs:domain bpi:Loan ;
    rdfs:range xsd:date .

bpi:loans a owl:DatatypeProperty ;
    rdfs:label "loans" ;
    rdfs:comment "Loans amount." ;
    rdfs:domain bpi:Loans ;
    rdfs:range xsd:decimal .

bpi:loansAmount a owl:DatatypeProperty ;
    rdfs:label "loansAmount" ;
    rdfs:comment "Total loans amount (in thousands of euros)." ;
    rdfs:domain bpi:Loans ;
    rdfs:range xsd:decimal .

bpi:loansFromStateAmount a owl:DatatypeProperty ;
    rdfs:label "loansFromStateAmount" ;
    rdfs:comment "Loans from the State amount reported for the period (in thousands of euros)." ;
    rdfs:domain bpi:FinancialLoansAndFinancialDebts ;
    rdfs:range xsd:decimal .

bpi:loansInEuros a owl:DatatypeProperty ;
    rdfs:label "loansInEuros" ;
    rdfs:comment "Loans in euros." ;
    rdfs:domain bpi:OtherFinancialAssets ;
    rdfs:range xsd:decimal .

bpi:loansInEurosAmount a owl:DatatypeProperty ;
    rdfs:label "loansInEurosAmount" ;
    rdfs:comment "Amount of loans in euros reported for the period (in thousands of euros)." ;
    rdfs:domain bpi:Loans ;
    rdfs:range xsd:decimal .

bpi:managedAssetsAmount a owl:DatatypeProperty ;
    rdfs:label "managedAssetsAmount" ;
    rdfs:comment "Total amount of financial assets managed as of the reporting date (e.g., €44.4 bn)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:decimal .

bpi:managedAssetsCurrency a owl:DatatypeProperty ;
    rdfs:label "managedAssetsCurrency" ;
    rdfs:comment "Currency used for managed assets amounts (e.g., EUR)." ;
