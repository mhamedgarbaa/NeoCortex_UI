    rdfs:subClassOf bpi:ExportInsurance,
        bpi:Guarantee .

bpi:ExportInsuranceBusinessLine a owl:Class ;
    rdfs:label "ExportInsuranceBusinessLine" ;
    rdfs:comment "A business line managing public export guarantees on behalf of the state and providing export insurance solutions." ;
    rdfs:subClassOf bpi:InternationalBusinessLine .

bpi:ExternalReviewer a owl:Class ;
    rdfs:label "ExternalReviewer" ;
    rdfs:comment "Third-party reviewer providing independent pre-issuance review and opinions referenced in the framework." .

bpi:ExtraordinaryExpenses a owl:Class ;
    rdfs:label "ExtraordinaryExpenses" ;
