bpi:consolidatesUsingFullConsolidationMethod a owl:ObjectProperty ;
    rdfs:label "consolidatesUsingFullConsolidationMethod" ;
    rdfs:comment "Indicates that entities under complete control are consolidated using the full consolidation method." ;
    rdfs:domain bpi:PublicInstitution ;
    rdfs:range bpi:FullConsolidation .

bpi:consolidationBalanceSheetDate a owl:DatatypeProperty ;
    rdfs:label "consolidationBalanceSheetDate" ;
    rdfs:comment "Balance sheet date used for classification and for the annual closing of companies in the consolidation scope." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range xsd:date .

bpi:consolidationDate a owl:DatatypeProperty ;
    rdfs:label "consolidationDate" ;
    rdfs:comment "Reporting date for the consolidated financial statements (e.g., 31 December 2023)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range xsd:date .

bpi:consolidationMethod a owl:DatatypeProperty ;
    rdfs:label "consolidationMethod" ;
    rdfs:comment "Consolidation method applied to an entity (e.g., full consolidation or equity method)." ;
    rdfs:domain bpi:ConsolidationMethod,
        bpi:EquityConsolidatedCompany ;
