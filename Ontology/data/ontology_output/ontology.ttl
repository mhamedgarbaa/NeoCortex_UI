bpi:preparedUsing a owl:ObjectProperty ;
    rdfs:label "preparedUsing" ;
    rdfs:comment "Indicates that accounting principles and methods are adopted for preparing the consolidated financial statements." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:AccountingStandard .

