bpi:carbonIntensityEvaluationStartYear a owl:DatatypeProperty ;
    rdfs:label "carbonIntensityEvaluationStartYear" ;
    rdfs:comment "Year of the first evaluation of all portfolios (e.g., 31 December 2019 evaluation conducted in summer 2020)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:integer .

bpi:cashAndCashEquivalents a owl:DatatypeProperty ;
    rdfs:label "cashAndCashEquivalents" ;
    rdfs:comment "Cash and cash equivalents balance." ;
    rdfs:domain bpi:CashAndCashEquivalents ;
    rdfs:range xsd:decimal .

bpi:cashAndCashEquivalentsAmount a owl:DatatypeProperty ;
    rdfs:label "cashAndCashEquivalentsAmount" ;
    rdfs:comment "Cash and cash equivalents amount." ;
    rdfs:domain bpi:CashAndCashEquivalent,
        bpi:CashAndCashEquivalents ;
    rdfs:range xsd:decimal .

bpi:cashAndCashEquivalentsClosingBalance a owl:DatatypeProperty ;
    rdfs:label "cashAndCashEquivalentsClosingBalance" ;
    rdfs:comment "Cash and cash equivalents closing balance for the period." ;
    rdfs:domain bpi:LiquidityPosition,
        bpi:NetCashFlow,
        bpi:StatementOfCashFlows ;
    rdfs:range xsd:decimal .

bpi:cashAndCashEquivalentsOpeningBalance a owl:DatatypeProperty ;
