bpi:hasInterestExpense a owl:ObjectProperty ;
    rdfs:label "hasInterestExpense" ;
    rdfs:comment "Indicates the institution has interest expense (e.g., state loan interest, EIB loan interest, bank account interest)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:InterestExpense .

bpi:hasInterestIncome a owl:ObjectProperty ;
    rdfs:label "hasInterestIncome" ;
    rdfs:comment "Indicates the institution has interest income (e.g., loan interest, state current account interest, financial income)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:InterestIncome .

bpi:hasInterimFinancialStatement a owl:ObjectProperty ;
    rdfs:label "hasInterimFinancialStatement" ;
    rdfs:comment "Indicates that interim reports are used in accordance with consolidated financial statement format recommendations." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range bpi:InterimFinancialStatement .

bpi:hasInternalControlCharter a owl:ObjectProperty ;
    rdfs:label "hasInternalControlCharter" ;
    rdfs:comment "Indicates that the group has an internal control charter defining internal control framework." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:InternalControlCharter .

bpi:hasInternalLiquidityAdequacyAssessmentProcess a owl:ObjectProperty ;
    rdfs:label "hasInternalLiquidityAdequacyAssessmentProcess" ;
    rdfs:comment "Indicates that the group operates an internal liquidity adequacy assessment process (ILAAP)." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:InternalLiquidityAdequacyAssessmentProcess .

bpi:hasInvestingActivities a owl:ObjectProperty ;
    rdfs:label "hasInvestingActivities" ;
    rdfs:comment "Indicates that cash flows are broken down by investing activities." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:InvestingActivities .

bpi:hasInvestmentCommittee a owl:ObjectProperty ;
    rdfs:label "hasInvestmentCommittee" ;
    rdfs:comment "Indicates that the group uses investment committees for collegial investment decisions." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:InvestmentCommittee .

bpi:hasInvestmentProgramme a owl:ObjectProperty ;
    rdfs:label "hasInvestmentProgramme" ;
    rdfs:comment "Indicates that the bank operates investment programmes as part of its activities." ;
    rdfs:domain bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:InvestmentProgramme .

bpi:hasJointControlWith a owl:ObjectProperty ;
    rdfs:label "hasJointControlWith" ;
    rdfs:comment "Indicates that the group exercises joint control with another public institution (e.g., for a joint venture)." ;
    rdfs:domain bpi:PublicInstitution ;
    rdfs:range bpi:PublicInstitution .

bpi:hasKYCProcess a owl:ObjectProperty ;
    rdfs:label "hasKYCProcess" ;
    rdfs:comment "Indicates that the group performs KYC as part of AML/CFT processes." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:KYCProcess .

bpi:hasLegalBasis a owl:ObjectProperty ;
    rdfs:label "hasLegalBasis" ;
    rdfs:comment "Specifies the legal basis used for a personal data processing activity." ;
    rdfs:domain bpi:LegalBasisForProcessing,
        bpi:PersonalDataProcessing ;
    rdfs:range bpi:AntiCorruptionPurpose,
        bpi:AntiFraudPreventionPurpose,
        bpi:AntiMoneyLaunderingPurpose,
        bpi:ContractPerformanceLegalBasis,
        bpi:CounterTerroristFinancingPurpose,
        bpi:FrenchDataProtectionAct,
        bpi:GDPR,
        bpi:InternationalSanctionsAndEmbargoDueDiligencePurpose,
        bpi:LegalBasisForProcessing,
        bpi:LegalObligationLegalBasis,
        bpi:LegitimateInterestLegalBasis .

bpi:hasLegalBasisForProcessing a owl:ObjectProperty ;
    rdfs:label "hasLegalBasisForProcessing" ;
    rdfs:comment "Links each processing purpose to its legal basis (e.g., pre-contractual measures, legal obligations, legitimate interest, contract performance)." ;
    rdfs:domain bpi:PersonalDataProcessing ;
    rdfs:range bpi:LegalBasisForProcessing .

bpi:hasLeverageRatio a owl:ObjectProperty ;
    rdfs:label "hasLeverageRatio" ;
    rdfs:comment "Indicates that the group reports its leverage ratio." ;
    rdfs:domain bpi:BpifranceGroup,
        bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:LeverageRatio .

bpi:hasLiquidityCoverageRatio a owl:ObjectProperty ;
    rdfs:label "hasLiquidityCoverageRatio" ;
    rdfs:comment "Indicates the liquidity coverage ratio (LCR) used to assess liquidity." ;
    rdfs:domain bpi:BpifranceGroup,
        bpi:LiquidityPosition,
        bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:LiquidityCoverageRatio .

bpi:hasLiquidityManagementProcedure a owl:ObjectProperty ;
    rdfs:label "hasLiquidityManagementProcedure" ;
    rdfs:comment "Indicates that the group has a liquidity management procedure as part of liquidity risk management." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:LiquidityManagementProcedure .

bpi:hasLiquidityPosition a owl:ObjectProperty ;
    rdfs:label "hasLiquidityPosition" ;
    rdfs:comment "States that liquidity position is assessed via liquidity ratios and reserves." ;
    rdfs:domain bpi:BpifranceGroup,
        bpi:ConsolidatedFinancialStatements,
        bpi:FinancialResults,
        bpi:PublicInstitution,
        bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:LiquidityPosition .

bpi:hasLiquidityReserve a owl:ObjectProperty ;
    rdfs:label "hasLiquidityReserve" ;
    rdfs:comment "Indicates the liquidity reserve used to assess liquidity." ;
    rdfs:domain bpi:BpifranceGroup,
        bpi:LiquidityPosition,
        bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:LiquidityReserve .

bpi:hasLoan a owl:ObjectProperty ;
    rdfs:label "hasLoan" ;
    rdfs:comment "Indicates that financing commitments include loans." ;
    rdfs:domain bpi:FinancingCommitment ;
    rdfs:range bpi:Loan .

bpi:hasLoanCommitment a owl:ObjectProperty ;
    rdfs:label "hasLoanCommitment" ;
    rdfs:comment "Indicates that financing commitments include loan commitments." ;
    rdfs:domain bpi:FinancingCommitment ;
    rdfs:range bpi:LoanCommitment .

bpi:hasLoanFromState a owl:ObjectProperty ;
    rdfs:label "hasLoanFromState" ;
    rdfs:comment "Indicates that the public institution has loans from the State." ;
    rdfs:domain bpi:PublicInstitution ;
    rdfs:range bpi:StateLoan .

bpi:hasLoans a owl:ObjectProperty ;
    rdfs:label "hasLoans" ;
    rdfs:comment "Indicates that the institution holds loans as financial assets." ;
    rdfs:domain bpi:PublicInstitution,
        bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:Loans .

bpi:hasMarketPriceRisk a owl:ObjectProperty ;
    rdfs:label "hasMarketPriceRisk" ;
    rdfs:comment "Indicates that market price risk is one of the financial risks managed." ;
    rdfs:domain bpi:FinancialRisk ;
    rdfs:range bpi:MarketPriceRisk .

bpi:hasMediumTermPlan a owl:ObjectProperty ;
    rdfs:label "hasMediumTermPlan" ;
    rdfs:comment "Indicates that the group has a medium-term plan supporting transition and financing objectives." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:MediumTermPlan .

bpi:hasMethodologicalNotes a owl:ObjectProperty ;
    rdfs:label "hasMethodologicalNotes" ;
    rdfs:comment "Indicates that methodological notes are provided for the reported figures (non-audited context)." ;
    rdfs:domain bpi:PressRelease ;
    rdfs:range bpi:AuditedData .

bpi:hasNetBankingIncome a owl:ObjectProperty ;
    rdfs:label "hasNetBankingIncome" ;
    rdfs:comment "States the net banking income figure reported in the financial results." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FinancialResults,
        bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range bpi:NetBankingIncome .

bpi:hasNetCashFlow a owl:ObjectProperty ;
    rdfs:label "hasNetCashFlow" ;
    rdfs:comment "Indicates that the consolidated cash flow section reports net cash flow measures." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:NetCashFlow .

bpi:hasNetCashFlowFromFinancingOperations a owl:ObjectProperty ;
    rdfs:label "hasNetCashFlowFromFinancingOperations" ;
    rdfs:comment "Indicates that the consolidated cash flow statement reports net cash flow from financing operations." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:NetCashFlowFromFinancingOperations .

bpi:hasNetCashFlowFromInvestingActivities a owl:ObjectProperty ;
    rdfs:label "hasNetCashFlowFromInvestingActivities" ;
    rdfs:comment "Indicates that the consolidated cash flow statement reports net cash flow from investing activities." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:NetCashFlowFromInvestingActivities .

bpi:hasNetCashFlowFromOperatingActivities a owl:ObjectProperty ;
    rdfs:label "hasNetCashFlowFromOperatingActivities" ;
    rdfs:comment "Indicates that the consolidated cash flow statement reports net cash flow from operating activities." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:NetCashFlowFromOperatingActivities .

bpi:hasNetIncome a owl:ObjectProperty ;
    rdfs:label "hasNetIncome" ;
    rdfs:comment "States the net income figure reported in the financial results." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FinancialResults,
        bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range bpi:NetIncome .

bpi:hasNetInterestMargin a owl:ObjectProperty ;
    rdfs:label "hasNetInterestMargin" ;
    rdfs:comment "Indicates that net banking income includes a net interest margin component." ;
    rdfs:domain bpi:HalfYearConsolidatedFinancialStatements,
        bpi:NetBankingIncome ;
    rdfs:range bpi:NetInterestMargin .

bpi:hasNonFinancialPerformanceStatement a owl:ObjectProperty ;
    rdfs:label "hasNonFinancialPerformanceStatement" ;
    rdfs:comment "Indicates the document includes a non-financial performance statement section." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:NonFinancialPerformanceStatement .

bpi:hasNotesToFinancialStatements a owl:ObjectProperty ;
    rdfs:label "hasNotesToFinancialStatements" ;
    rdfs:comment "Links a half-year consolidated financial statements document to its notes." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatements,
        bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range bpi:FinancialStatementNote,
        bpi:NotesToFinancialStatements .

bpi:hasOffBalanceSheetCommitment a owl:ObjectProperty ;
    rdfs:label "hasOffBalanceSheetCommitment" ;
    rdfs:comment "Indicates that the public institution has off-balance sheet commitments." ;
    rdfs:domain bpi:PublicInstitution ;
    rdfs:range bpi:OffBalanceSheetCommitment .

bpi:hasOffBalanceSheetCommitmentGiven a owl:ObjectProperty ;
    rdfs:label "hasOffBalanceSheetCommitmentGiven" ;
    rdfs:comment "Indicates the institution has commitments given (e.g., financing, guarantee, and securities commitments given)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:OffBalanceSheetCommitmentsGiven .

bpi:hasOffBalanceSheetCommitmentReceived a owl:ObjectProperty ;
    rdfs:label "hasOffBalanceSheetCommitmentReceived" ;
    rdfs:comment "Indicates the institution has commitments received (e.g., financing, guarantee, and securities commitments received)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:OffBalanceSheetCommitmentsReceived .

bpi:hasOffBalanceSheetCommitments a owl:ObjectProperty ;
    rdfs:label "hasOffBalanceSheetCommitments" ;
    rdfs:comment "The financial statements disclose off-balance sheet commitments." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatements,
        bpi:OffBalanceSheetCommitments ;
    rdfs:range bpi:GuaranteeCommitments,
        bpi:OffBalanceSheetCommitments .

bpi:hasOffBalanceSheetCommitmentsGiven a owl:ObjectProperty ;
    rdfs:label "hasOffBalanceSheetCommitmentsGiven" ;
    rdfs:comment "Indicates that the institution has off-balance-sheet commitments given (e.g., guarantees/commitments)." ;
    rdfs:domain bpi:FinancialStatements,
        bpi:OffBalanceSheetCommitment,
        bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:OffBalanceSheetCommitmentsGiven .

bpi:hasOffBalanceSheetCommitmentsReceived a owl:ObjectProperty ;
    rdfs:label "hasOffBalanceSheetCommitmentsReceived" ;
    rdfs:comment "Indicates that the institution has off-balance-sheet commitments received (if applicable in the text)." ;
    rdfs:domain bpi:FinancialStatements,
        bpi:OffBalanceSheetCommitment,
        bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:OffBalanceSheetCommitmentsReceived .

bpi:hasOperatingActivities a owl:ObjectProperty ;
    rdfs:label "hasOperatingActivities" ;
    rdfs:comment "Indicates that cash flows are broken down by operating activities." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:OperatingActivities .

bpi:hasOperatingExpenditure a owl:ObjectProperty ;
    rdfs:label "hasOperatingExpenditure" ;
    rdfs:comment "States the operating expenditure figure reported in the financial results." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FinancialResults,
        bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range bpi:OperatingExpenditure .

bpi:hasOperatingExpenses a owl:ObjectProperty ;
    rdfs:label "hasOperatingExpenses" ;
    rdfs:comment "Relates the financial statement section on operating expenses to operating expense items." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range bpi:OperatingExpense .

bpi:hasOperatingIncome a owl:ObjectProperty ;
    rdfs:label "hasOperatingIncome" ;
    rdfs:comment "States the operating income figure reported in the financial results." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FinancialResults ;
    rdfs:range bpi:OperatingIncome .

bpi:hasOperatingRatio a owl:ObjectProperty ;
    rdfs:label "hasOperatingRatio" ;
    rdfs:comment "Indicates the operating ratio used to assess the banking business line." ;
    rdfs:domain bpi:FinancialResults ;
    rdfs:range bpi:OperatingRatio .

bpi:hasOperationalRisk a owl:ObjectProperty ;
    rdfs:label "hasOperationalRisk" ;
    rdfs:comment "Indicates that risk exposure includes operational risk." ;
    rdfs:domain bpi:RiskExposure ;
    rdfs:range bpi:OperationalRisk .

bpi:hasOperationalRiskDepartment a owl:ObjectProperty ;
    rdfs:label "hasOperationalRiskDepartment" ;
    rdfs:comment "Indicates that the group has an operational risk department responsible for operational and non-compliance risk control system." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:OperationalRiskDepartment .

bpi:hasOperationalRiskManagementPolicy a owl:ObjectProperty ;
    rdfs:label "hasOperationalRiskManagementPolicy" ;
    rdfs:comment "Indicates that the group applies an operational risk management policy as part of its risk governance." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:OperationalRiskManagementPolicy,
        bpi:RiskManagementPolicy .

bpi:hasOrganizationalChart a owl:ObjectProperty ;
    rdfs:label "hasOrganizationalChart" ;
    rdfs:comment "Indicates that the annual report includes organizational charts for EPIC/Bpifrance." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:OrganizationalChart .

bpi:hasOrganizationalChartOfBusinessLines a owl:ObjectProperty ;
    rdfs:label "hasOrganizationalChartOfBusinessLines" ;
    rdfs:comment "The organizational chart includes a chart of business lines." ;
    rdfs:domain bpi:OrganizationalChart,
        bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:OrganizationalChartOfBusinessLines .

bpi:hasOrganizationalChartOfNetwork a owl:ObjectProperty ;
    rdfs:label "hasOrganizationalChartOfNetwork" ;
    rdfs:comment "The organizational chart includes a chart of the network." ;
    rdfs:domain bpi:OrganizationalChart,
        bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:OrganizationalChartOfNetwork .

bpi:hasOtherDebts a owl:ObjectProperty ;
    rdfs:label "hasOtherDebts" ;
    rdfs:comment "Indicates the institution has other debts (e.g., other public intervention resources, allocations payable, accrued expenses)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:OtherDebt .

bpi:hasOtherDebtsByRemainingTerm a owl:ObjectProperty ;
    rdfs:label "hasOtherDebtsByRemainingTerm" ;
    rdfs:comment "Relates other debts to their breakdown by remaining term (e.g., D ≤ 1 year, 1 year < D ≤ 5 years, D > 5 years)." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range bpi:OtherDebt .

bpi:hasParentEntityFinancialStatements a owl:ObjectProperty ;
    rdfs:label "hasParentEntityFinancialStatements" ;
    rdfs:comment "Parent entity financial statements are a type of financial statements." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:ParentEntityFinancialStatements,
        bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:FinancialStatements,
        bpi:ParentEntityFinancialStatements .

bpi:hasParentEntityStatutoryAuditorReport a owl:ObjectProperty ;
    rdfs:label "hasParentEntityStatutoryAuditorReport" ;
    rdfs:comment "The parent entity financial statements are accompanied by a parent entity statutory auditor report." ;
    rdfs:domain bpi:ParentEntityFinancialStatements ;
    rdfs:range bpi:ParentEntityFinancialStatementsAuditReport .

bpi:hasPersonResponsibleForFinancialStatements a owl:ObjectProperty ;
    rdfs:label "hasPersonResponsibleForFinancialStatements" ;
    rdfs:comment "Associates the half-year consolidated financial statements with the person responsible for them." ;
    rdfs:domain bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range bpi:GeneralManagement,
        bpi:Person .

bpi:hasPersonalDataProtectionPolicy a owl:ObjectProperty ;
    rdfs:label "hasPersonalDataProtectionPolicy" ;
    rdfs:comment "Indicates that the group has a personal data protection policy (implied by governance of data and security measures)." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:PersonalDataProtectionPolicy .

bpi:hasPolicy a owl:ObjectProperty ;
    rdfs:label "hasPolicy" ;
    rdfs:comment "Indicates that the privacy policy governs/relates to the personal data processing activities described for recruitment." ;
    rdfs:domain bpi:PrivacyPolicy ;
    rdfs:range bpi:PersonalDataProcessing .

bpi:hasProvenRisks a owl:ObjectProperty ;
    rdfs:label "hasProvenRisks" ;
    rdfs:comment "Indicates that cost of risk includes proven risks." ;
    rdfs:domain bpi:CostOfRisk,
        bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range bpi:ProvenRisks .

bpi:hasProvisions a owl:ObjectProperty ;
    rdfs:label "hasProvisions" ;
    rdfs:comment "Indicates that the notes describe provisions recognition." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:Provisions .

bpi:hasPublishableConsolidatedProfitAndLossStatement a owl:ObjectProperty ;
    rdfs:label "hasPublishableConsolidatedProfitAndLossStatement" ;
    rdfs:comment "Indicates that the half-year consolidated financial statements include a publishable consolidated profit and loss statement." ;
    rdfs:domain bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range bpi:ConsolidatedIncomeStatement .

bpi:hasPurpose a owl:ObjectProperty ;
    rdfs:label "hasPurpose" ;
    rdfs:comment "Indicates due diligence and KYC-related processing for suppliers and intermediaries." ;
    rdfs:domain bpi:PersonalDataProcessing ;
    rdfs:range bpi:AntiCorruptionCompliance,
        bpi:AntiCorruptionProcess,
        bpi:AntiCorruptionPurpose,
        bpi:AntiFraudPreventionPurpose,
        bpi:AntiMoneyLaundering,
        bpi:AntiMoneyLaunderingProcess,
        bpi:AntiMoneyLaunderingPurpose,
        bpi:CommercialProspectingPurpose,
        bpi:CommercialRelationship,
        bpi:ComplaintAuthority,
        bpi:CounterTerrorismFinancingProcess,
        bpi:CounterTerroristFinancing,
        bpi:CounterTerroristFinancingPurpose,
        bpi:ElectronicSignatureProcess,
        bpi:FraudProtectionPurpose,
        bpi:InternationalSanctionsAndEmbargoDueDiligencePurpose,
        bpi:KYC,
        bpi:KYCProcess,
        bpi:KycCompliancePurpose,
        bpi:NewsletterSending,
        bpi:ProfilingForCommercialProspecting,
        bpi:RelationshipManagement,
        bpi:SanctionsAndEmbargoDueDiligenceProcess .

bpi:hasPurposeOfProcessing a owl:ObjectProperty ;
    rdfs:label "hasPurposeOfProcessing" ;
    rdfs:comment "Indicates that processing purposes are specified in the policy (e.g., KYC, corruption prevention, sanctions compliance, electronic signature, claims management)." ;
    rdfs:domain bpi:PersonalDataProcessing ;
    rdfs:range bpi:FraudProtectionPurpose .

bpi:hasROE a owl:ObjectProperty ;
    rdfs:label "hasROE" ;
    rdfs:comment "States the return on equity (ROE) reported in the financial results." ;
    rdfs:domain bpi:FinancialResults ;
    rdfs:range bpi:ROE .

bpi:hasRegionalOffice a owl:ObjectProperty ;
    rdfs:label "hasRegionalOffice" ;
    rdfs:comment "The organizational chart of the network includes regional offices." ;
    rdfs:domain bpi:OrganizationalChartOfNetwork ;
    rdfs:range bpi:RegionalOffice .

bpi:hasRelatedParties a owl:ObjectProperty ;
    rdfs:label "hasRelatedParties" ;
    rdfs:comment "Notes disclose related parties and related party transactions." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:RelatedParty .

bpi:hasRelatedParty a owl:ObjectProperty ;
    rdfs:label "hasRelatedParty" ;
    rdfs:comment "Indicates the institution has related parties for which related-party information is disclosed." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:PublicIndustrialAndCommercialInstitution,
        bpi:RelatedParty ;
    rdfs:range bpi:PublicInstitution,
        bpi:RelatedParty .

bpi:hasRelatedPartyTransaction a owl:ObjectProperty ;
    rdfs:label "hasRelatedPartyTransaction" ;
    rdfs:comment "Indicates that related party transactions are disclosed in the consolidated financial statements." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:RelatedPartyTransaction .

bpi:hasRelatedPartyTransactions a owl:ObjectProperty ;
    rdfs:label "hasRelatedPartyTransactions" ;
    rdfs:comment "Indicates that the financial statements include transactions with related parties." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatements ;
    rdfs:range bpi:RelatedPartyTransaction .

bpi:hasRetentionPeriod a owl:ObjectProperty ;
    rdfs:label "hasRetentionPeriod" ;
    rdfs:comment "Links a personal data processing activity to the retention period(s) stated in the policy." ;
    rdfs:domain bpi:PersonalDataProcessing ;
    rdfs:range bpi:RetentionPeriod .

bpi:hasRiskCommittee a owl:ObjectProperty ;
    rdfs:label "hasRiskCommittee" ;
    rdfs:comment "Indicates that the board of directors has a risk committee." ;
    rdfs:domain bpi:BoardOfDirectors,
        bpi:BpifranceGroup,
        bpi:PublicGroup ;
    rdfs:range bpi:RiskCommittee .

bpi:hasRiskExposure a owl:ObjectProperty ;
    rdfs:label "hasRiskExposure" ;
    rdfs:comment "Relates a risk to the exposure it represents." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:PublicSectorInvestmentBank,
        bpi:Risk ;
    rdfs:range bpi:FinancialRisk,
        bpi:RiskExposure .

bpi:hasRiskFactors a owl:ObjectProperty ;
    rdfs:label "hasRiskFactors" ;
    rdfs:comment "Indicates that the amendment contains or updates the issuer's risk factors section." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range bpi:RiskFactors .

bpi:hasRiskManagement a owl:ObjectProperty ;
    rdfs:label "hasRiskManagement" ;
    rdfs:comment "Indicates that the group has a risk management function/system for ESG and climate risks." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:RiskManagement .

bpi:hasRiskManagementOrganization a owl:ObjectProperty ;
    rdfs:label "hasRiskManagementOrganization" ;
    rdfs:comment "Associates risk management with the organization responsible for risk management." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:RiskManagement ;
    rdfs:range bpi:RiskManagementOrganization .

bpi:hasRiskManagementPolicy a owl:ObjectProperty ;
    rdfs:label "hasRiskManagementPolicy" ;
    rdfs:comment "Indicates that the group has a risk management policy governing risk management activities." ;
    rdfs:domain bpi:BpifranceGroup,
        bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:RiskManagementPolicy .

bpi:hasRiskManagementSystem a owl:ObjectProperty ;
    rdfs:label "hasRiskManagementSystem" ;
    rdfs:comment "Indicates that the group has a governance and operational risk management system." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:RiskManagementSystem .

bpi:hasSATTActivity a owl:ObjectProperty ;
    rdfs:label "hasSATTActivity" ;
    rdfs:comment "Indicates that SATT activity is disclosed as a type of technology transfer activity on behalf of the French State." ;
    rdfs:domain bpi:ThirdPartyActivity ;
    rdfs:range bpi:TechnologyTransferProgramme .

bpi:hasSanctionsAndEmbargoDueDiligenceProcess a owl:ObjectProperty ;
    rdfs:label "hasSanctionsAndEmbargoDueDiligenceProcess" ;
    rdfs:comment "Indicates that the group is subject to sanctions and embargo due diligence processes (referenced as part of financial crime controls)." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:SanctionsAndEmbargoDueDiligenceProcess .

bpi:hasSecuritiesCommitment a owl:ObjectProperty ;
    rdfs:label "hasSecuritiesCommitment" ;
    rdfs:comment "Indicates the institution discloses securities commitments (e.g., buyback/takeback options and other securities commitments)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:SecuritiesCommitments .

bpi:hasSecuritiesCommitmentsGiven a owl:ObjectProperty ;
    rdfs:label "hasSecuritiesCommitmentsGiven" ;
    rdfs:comment "Relates securities commitments given to the off-balance sheet commitments section." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range bpi:SecuritiesCommitments .

bpi:hasSecuritiesCommitmentsReceived a owl:ObjectProperty ;
    rdfs:label "hasSecuritiesCommitmentsReceived" ;
    rdfs:comment "Relates securities commitments received to the off-balance sheet commitments section." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range bpi:SecuritiesCommitments .

bpi:hasSecuritiesNote a owl:ObjectProperty ;
    rdfs:label "hasSecuritiesNote" ;
    rdfs:comment "Indicates the universal registration document may be completed with a securities note for a public offer or admission to trading." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:SecuritiesNote .

bpi:hasSecuritiesSummary a owl:ObjectProperty ;
    rdfs:label "hasSecuritiesSummary" ;
    rdfs:comment "Indicates the universal registration document may be completed with a securities summary when applicable." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:SecuritiesSummary .

bpi:hasSegmentReporting a owl:ObjectProperty ;
    rdfs:label "hasSegmentReporting" ;
    rdfs:comment "Indicates that segment reporting is presented as part of the consolidated financial statements." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:SegmentReporting .

bpi:hasSharePriceRisk a owl:ObjectProperty ;
    rdfs:label "hasSharePriceRisk" ;
    rdfs:comment "Indicates that share price risk is a key risk family." ;
    rdfs:domain bpi:FinancialRisk ;
    rdfs:range bpi:SharePriceRisk .

bpi:hasSolvency a owl:ObjectProperty ;
    rdfs:label "hasSolvency" ;
    rdfs:comment "States that solvency ratios confirm financial robustness." ;
    rdfs:domain bpi:BpifranceGroup,
        bpi:FinancialResults,
        bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:Solvency .

bpi:hasStateLoan a owl:ObjectProperty ;
    rdfs:label "hasStateLoan" ;
    rdfs:comment "Indicates that a state loan is a type of loan." ;
    rdfs:domain bpi:StateLoan ;
    rdfs:range bpi:Loan .

bpi:hasStatementOfCashFlows a owl:ObjectProperty ;
    rdfs:label "hasStatementOfCashFlows" ;
    rdfs:comment "Indicates that the half-year consolidated financial statements include a statement of cash flows." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range bpi:CashFlowStatement,
        bpi:StatementOfCashFlows .

bpi:hasStatutoryAuditor a owl:ObjectProperty ;
    rdfs:label "hasStatutoryAuditor" ;
    rdfs:comment "Links the institution to its statutory auditors (reappointment by the Board of Directors)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution,
        bpi:PublicLimitedCompany ;
    rdfs:range bpi:StatutoryAuditor .

bpi:hasStatutoryAuditorReport a owl:ObjectProperty ;
    rdfs:label "hasStatutoryAuditorReport" ;
    rdfs:comment "Indicates that the half-year consolidated financial statements include a statutory auditor’s report on the summary consolidated half-year financial statements." ;
    rdfs:domain bpi:HalfYearConsolidatedFinancialStatements ;
    rdfs:range bpi:ConsolidatedFinancialStatementsAuditReport,
        bpi:StatutoryAuditorReport .

bpi:hasStatutoryAuditorsReport a owl:ObjectProperty ;
    rdfs:label "hasStatutoryAuditorsReport" ;
    rdfs:comment "The financial statements are accompanied by a statutory auditors report." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatements,
        bpi:HalfYearConsolidatedFinancialStatements,
        bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:StatutoryAuditorReport,
        bpi:StatutoryAuditorsReport .

bpi:hasSteeringCommittee a owl:ObjectProperty ;
    rdfs:label "hasSteeringCommittee" ;
    rdfs:comment "Indicates that the group has steering committees for decision-making and oversight." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:SteeringCommittee .

bpi:hasStrategicObjective a owl:ObjectProperty ;
    rdfs:label "hasStrategicObjective" ;
    rdfs:comment "Links the bank to its strategic objective expressed through a climate plan context." ;
    rdfs:domain bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:ClimatePlan .

bpi:hasStructuralInterestRateRisk a owl:ObjectProperty ;
    rdfs:label "hasStructuralInterestRateRisk" ;
    rdfs:comment "Indicates that structural interest rate risk is a key risk family." ;
    rdfs:domain bpi:FinancialRisk ;
    rdfs:range bpi:StructuralInterestRateRisk .

bpi:hasStructuredEntityInterests a owl:ObjectProperty ;
    rdfs:label "hasStructuredEntityInterests" ;
    rdfs:comment "Represents interests in structured entities (not held in this case, but the disclosure topic is present)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:StructuredEntity .

bpi:hasTaxAndSocialSecurityDebts a owl:ObjectProperty ;
    rdfs:label "hasTaxAndSocialSecurityDebts" ;
    rdfs:comment "Indicates the institution has tax and social security debts." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:TaxAndSocialSecurityDebt .

bpi:hasTaxAndSocialSecurityDebtsMaturityLessThanOneYear a owl:ObjectProperty ;
    rdfs:label "hasTaxAndSocialSecurityDebtsMaturityLessThanOneYear" ;
    rdfs:comment "Indicates that tax and social security debts have a remaining maturity of less than one year." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range bpi:TaxAndSocialSecurityDebt .

bpi:hasTaxReceivable a owl:ObjectProperty ;
    rdfs:label "hasTaxReceivable" ;
    rdfs:comment "Indicates the institution has tax receivables as part of other receivables." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:Tax .

bpi:hasTaxUncertainty a owl:ObjectProperty ;
    rdfs:label "hasTaxUncertainty" ;
    rdfs:comment "Indicates that the notes address tax uncertainty in tax positions." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:TaxUncertainty .

bpi:hasTradeDebts a owl:ObjectProperty ;
    rdfs:label "hasTradeDebts" ;
    rdfs:comment "Indicates the institution has trade debts and related accounts." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:TradeDebt .

bpi:hasTradeDebtsMaturityLessThanOneYear a owl:ObjectProperty ;
    rdfs:label "hasTradeDebtsMaturityLessThanOneYear" ;
    rdfs:comment "Indicates that trade debts have a remaining maturity of less than one year." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range bpi:TradeDebt .

bpi:hasTransactionDerivative a owl:ObjectProperty ;
    rdfs:label "hasTransactionDerivative" ;
    rdfs:comment "Indicates that the bank has transaction derivatives (including currency exchange derivatives)." ;
    rdfs:domain bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:TransactionDerivative .

bpi:hasUnrealisedForeignExchangeGains a owl:ObjectProperty ;
    rdfs:label "hasUnrealisedForeignExchangeGains" ;
    rdfs:comment "Indicates the presence of unrealised foreign exchange gains." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range bpi:UnrealisedForeignExchangeGain .

bpi:holdsEquityInterestIn a owl:ObjectProperty ;
    rdfs:label "holdsEquityInterestIn" ;
    rdfs:comment "Indicates the institution holds equity interests in subsidiaries/holdings (including equity interests accounted for via equity method)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
