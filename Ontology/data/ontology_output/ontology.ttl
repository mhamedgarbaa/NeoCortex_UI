bpi:universalRegistrationDocumentReferenceNumber a owl:DatatypeProperty ;
    rdfs:label "universalRegistrationDocumentReferenceNumber" ;
    rdfs:comment "The reference number of the referenced Universal Registration Document." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:string .

bpi:unrealisedForeignExchangeGainsAmount a owl:DatatypeProperty ;
    rdfs:label "unrealisedForeignExchangeGainsAmount" ;
    rdfs:comment "Amount of unrealised foreign exchange gains reported." ;
    rdfs:domain bpi:UnrealisedForeignExchangeGain ;
    rdfs:range xsd:decimal .

bpi:unrealisedForeignExchangeGainsAsAtDate a owl:DatatypeProperty ;
    rdfs:label "unrealisedForeignExchangeGainsAsAtDate" ;
    rdfs:comment "Date as at which unrealised foreign exchange gains are reported." ;
    rdfs:domain bpi:UnrealisedForeignExchangeGain ;
    rdfs:range xsd:date .

bpi:unrealisedForeignExchangeLossesAmount a owl:DatatypeProperty ;
    rdfs:label "unrealisedForeignExchangeLossesAmount" ;
    rdfs:comment "Amount of unrealised foreign exchange losses reported." ;
    rdfs:domain bpi:UnrealisedForeignExchangeGain ;
    rdfs:range xsd:decimal .

bpi:unrealisedForeignExchangeLossesAsAtDate a owl:DatatypeProperty ;
    rdfs:label "unrealisedForeignExchangeLossesAsAtDate" ;
    rdfs:comment "Date as at which unrealised foreign exchange losses are reported." ;
    rdfs:domain bpi:UnrealisedForeignExchangeGain ;
    rdfs:range xsd:date .

bpi:updates a owl:ObjectProperty ;
    rdfs:label "updates" ;
    rdfs:comment "Indicates that the expected credit loss model uses updated forward-looking scenarios." ;
    rdfs:domain bpi:ECLModel ;
    rdfs:range bpi:ForwardLookingScenarios .

bpi:updatesArticlesOfAssociation a owl:ObjectProperty ;
    rdfs:label "updatesArticlesOfAssociation" ;
    rdfs:comment "Indicates the amendment updates the company’s articles of association (e.g., company object/preamble)." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:ArticlesOfAssociation .

bpi:uses a owl:ObjectProperty ;
    rdfs:label "uses" ;
    rdfs:comment "Indicates that the consolidated financial statements are prepared in accordance with IFRS standards." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:InternationalFinancialReportingStandard .

bpi:usesAccountingStandardFramework a owl:ObjectProperty ;
    rdfs:label "usesAccountingStandardFramework" ;
    rdfs:comment "States that the consolidated financial statements are prepared in accordance with an accounting standards framework (IFRS as adopted by the EU)." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:AccountingStandardsFramework .

bpi:usesClimateKit a owl:ObjectProperty ;
    rdfs:label "usesClimateKit" ;
    rdfs:comment "Indicates that the group uses a Climate Kit to communicate ESG practices and related information to invested funds/companies." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:ClimateKit .

bpi:usesEUTaxonomyAlignedActivities a owl:ObjectProperty ;
    rdfs:label "usesEU_TaxonomyAlignedActivities" ;
    rdfs:comment "Some eligible green loan categories may be fully aligned with EU taxonomy activities and technical screening criteria." ;
    rdfs:domain bpi:Loans ;
    rdfs:range bpi:EUTaxonomyActivity .

bpi:usesEquityMethodAccounting a owl:ObjectProperty ;
    rdfs:label "usesEquityMethodAccounting" ;
    rdfs:comment "Indicates that equity method accounting is used within consolidated financial statements." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityMethodAccounting .

bpi:usesEquityMethodFor a owl:ObjectProperty ;
    rdfs:label "usesEquityMethodFor" ;
    rdfs:comment "Indicates that jointly controlled investments and significant influence investments are accounted for using the equity method." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:EquityMethodAccounting .

bpi:usesEquityMethodForJointControl a owl:ObjectProperty ;
    rdfs:label "usesEquityMethodForJointControl" ;
    rdfs:comment "Joint control over a partnership/joint venture leads to equity method consolidation." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements ;
    rdfs:range bpi:JointControl .

bpi:usesFairValueHierarchyLevel a owl:ObjectProperty ;
    rdfs:label "usesFairValueHierarchyLevel" ;
    rdfs:comment "Indicates that fair value is measured at a specific hierarchy level (e.g., Level 1/2/3)." ;
    rdfs:domain bpi:FairValueHierarchy ;
    rdfs:range bpi:FairValueHierarchyLevel .

bpi:usesFibenRatings a owl:ObjectProperty ;
    rdfs:label "usesFibenRatings" ;
    rdfs:comment "Indicates that the group uses Fiben ratings provided by the Bank of France." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:FibenRatings .

bpi:usesInternalTool a owl:ObjectProperty ;
    rdfs:label "usesInternalTool" ;
    rdfs:comment "Indicates that the group uses internal tools (e.g., ESG analysis tool, monitoring IT tool) for risk/ESG assessment." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:RiskManagementTool .

bpi:usesLiquidityCoverageRatio a owl:ObjectProperty ;
    rdfs:label "usesLiquidityCoverageRatio" ;
    rdfs:comment "Indicates that liquidity coverage ratio is used/considered in liquidity monitoring." ;
    rdfs:domain bpi:LiquidityPosition ;
    rdfs:range bpi:LiquidityCoverageRatio .

bpi:usesNetInterestMargin a owl:ObjectProperty ;
    rdfs:label "usesNetInterestMargin" ;
    rdfs:comment "Indicates that net interest margin is used as an indicator to monitor structural interest rate risk." ;
    rdfs:domain bpi:RiskManagementTool ;
    rdfs:range bpi:NetInterestMargin .

bpi:usesPlatformFor a owl:ObjectProperty ;
    rdfs:label "usesPlatformFor" ;
    rdfs:comment "Indicates connected spaces/platforms are used for user account management, security, hosting, technical support, and maintenance." ;
    rdfs:domain bpi:PersonalDataProcessing ;
    rdfs:range bpi:Platform .

bpi:usesRiskManagementPolicy a owl:ObjectProperty ;
    rdfs:label "usesRiskManagementPolicy" ;
    rdfs:comment "Indicates that the group uses a risk management policy to integrate ESG/climate risks." ;
    rdfs:domain bpi:PublicGroup ;
    rdfs:range bpi:RiskManagementPolicy .

bpi:usesTrustedServiceProvider a owl:ObjectProperty ;
    rdfs:label "usesTrustedServiceProvider" ;
    rdfs:comment "Indicates that the data controller uses a trusted service provider to implement electronic signature processes." ;
    rdfs:domain bpi:DataController ;
    rdfs:range bpi:TrustedServiceProvider .

bpi:valuationGoodwillDifference a owl:DatatypeProperty ;
    rdfs:label "valuationGoodwillDifference" ;
    rdfs:comment "Difference between valuation and goodwill in the reconciliation of equity investment book value." ;
    rdfs:domain bpi:EquityMethodAccounting,
        bpi:EquityMethodInvestment ;
    rdfs:range xsd:decimal .

bpi:votingRightsPercentage a owl:DatatypeProperty ;
    rdfs:label "votingRightsPercentage" ;
    rdfs:comment "Percentage of voting rights held in an equity-consolidated company." ;
    rdfs:domain bpi:EquityConsolidatedCompany ;
    rdfs:range xsd:decimal .

bpi:warInUkraineInvasionDate a owl:DatatypeProperty ;
    rdfs:label "warInUkraineInvasionDate" ;
    rdfs:comment "Date of the invasion of Ukraine referenced as a post balance sheet event." ;
    rdfs:domain bpi:WarInUkraine ;
    rdfs:range xsd:date .

bpi:websiteUrl a owl:DatatypeProperty ;
    rdfs:label "websiteUrl" ;
    rdfs:comment "Company website URL." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range xsd:string .

bpi:ALMCommittee a owl:Class ;
    rdfs:label "ALMCommittee" ;
    rdfs:comment "An asset-liability management committee receiving interest rate and currency risk measurements." .

bpi:AMLCFT a owl:Class ;
    rdfs:label "AML_CFT" ;
    rdfs:comment "Anti-money laundering and combating the financing of terrorism training referenced in non-financial reporting." .

bpi:AccelerationFund a owl:Class ;
    rdfs:label "AccelerationFund" ;
    rdfs:comment "A fund category focused on acceleration-stage investments." ;
    rdfs:subClassOf bpi:Fund .

bpi:AccountingEstimate a owl:Class ;
    rdfs:label "AccountingEstimate" ;
    rdfs:comment "An estimate used in preparing financial statements where outcomes involve uncertainty." .

bpi:AccountingStandardsFramework a owl:Class ;
    rdfs:label "AccountingStandardsFramework" ;
    rdfs:comment "Framework of applicable accounting standards (IFRS as adopted by the EU) used for consolidated financial statements." .

bpi:AccruedExpense a owl:Class ;
    rdfs:label "AccruedExpense" ;
    rdfs:comment "Accrued expenses included in other debts." ;
    rdfs:subClassOf bpi:OtherDebt .

bpi:AdministrativeBodyMemberCompensation a owl:Class ;
    rdfs:label "AdministrativeBodyMemberCompensation" ;
    rdfs:comment "Disclosure category for compensation paid to members of administrative bodies." .

bpi:AdministrativeData a owl:Class ;
    rdfs:label "AdministrativeData" ;
    rdfs:comment "Personal data used for administrative verification (e.g., proof of address)." ;
    rdfs:subClassOf bpi:PersonalDataCategory .

bpi:AdviceServices a owl:Class ;
    rdfs:label "AdviceServices" ;
    rdfs:comment "Support services providing advice to entrepreneurs." .

bpi:AffiliateCompany a owl:Class ;
    rdfs:label "AffiliateCompany" ;
    rdfs:comment "An investee over which the group has significant influence, typically accounted for using the equity method." .

bpi:AllocationPayable a owl:Class ;
    rdfs:label "AllocationPayable" ;
    rdfs:comment "An allocation payable to funds or entities (e.g., Innovation and Industry Fund, Bpifrance Participations, Bpifrance)." ;
    rdfs:subClassOf bpi:OtherDebt .

bpi:AmendmentToAgreement a owl:Class ;
    rdfs:label "AmendmentToAgreement" ;
    rdfs:comment "Amendments to existing agreements referenced throughout governance decisions." ;
    rdfs:subClassOf bpi:Agreement .

bpi:AntiCorruptionCompliance a owl:Class ;
    rdfs:label "AntiCorruptionCompliance" ;
    rdfs:comment "A compliance domain referenced as part of legal texts governing responsible investment policy." ;
    rdfs:subClassOf bpi:DueDiligence .

bpi:AntiMoneyLaundering a owl:Class ;
    rdfs:label "AntiMoneyLaundering" ;
    rdfs:comment "Compliance activities aimed at preventing money laundering." ;
    rdfs:subClassOf bpi:DueDiligence .

bpi:ArbitralAuthority a owl:Class ;
    rdfs:label "ArbitralAuthority" ;
    rdfs:comment "An arbitral authority that may receive personal data under legal procedures." .

bpi:ArticlesOfAssociation a owl:Class ;
    rdfs:label "ArticlesOfAssociation" ;
    rdfs:comment "The company’s governing charter, including the company object and mission provisions." .

bpi:AuditCommittee a owl:Class ;
    rdfs:label "AuditCommittee" ;
    rdfs:comment "Audit committee referenced as part of governance structures for certain entities." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:Bank a owl:Class ;
    rdfs:label "Bank" ;
    rdfs:comment "A credit institution referenced as providing personal data and as a potential support customer for solutions." ;
    rdfs:subClassOf bpi:CreditInstitution .

bpi:BankAccount a owl:Class ;
    rdfs:label "BankAccount" ;
    rdfs:comment "A bank account included in cash and cash equivalents." ;
    rdfs:subClassOf bpi:CashAndCashEquivalent .

bpi:Board a owl:Class ;
    rdfs:label "Board" ;
    rdfs:comment "A governance body where the investment branch may seek seats and provide oversight and engagement." .

bpi:BoardOfDirectorsManagementReport a owl:Class ;
    rdfs:label "BoardOfDirectorsManagementReport" ;
    rdfs:comment "Management report of the board of directors referenced in audit responsibilities." .

bpi:BoardOfGovernance a owl:Class ;
    rdfs:label "BoardOfGovernance" ;
    rdfs:comment "A governance concept referenced as those charged with governance." ;
    rdfs:subClassOf bpi:Organization .

bpi:BookValuesOfAssetsSold a owl:Class ;
    rdfs:label "BookValuesOfAssetsSold" ;
    rdfs:comment "Extraordinary expenses representing book values of assets sold." ;
    rdfs:subClassOf bpi:ExtraordinaryExpenses .

bpi:BorrowerEntity a owl:Class ;
    rdfs:label "BorrowerEntity" ;
    rdfs:comment "Entity that receives financing under the framework." ;
    rdfs:subClassOf bpi:Entity .

bpi:Borrowing a owl:Class ;
    rdfs:label "Borrowing" ;
    rdfs:comment "A debt obligation arising from loans and borrowings issued by the group." ;
    rdfs:subClassOf bpi:FinancialLiability .

bpi:BpifranceAccruedExpense a owl:Class ;
    rdfs:label "BpifranceAccruedExpense" ;
    rdfs:comment "Accrued expenses of Bpifrance included in other debts." ;
    rdfs:subClassOf bpi:OtherDebt .

bpi:BusinessCreationBusinessLine a owl:Class ;
    rdfs:label "BusinessCreationBusinessLine" ;
    rdfs:comment "Mission and business line supporting business creation through entrepreneurship support networks." .

bpi:CEO a owl:Class ;
    rdfs:label "CEO" ;
    rdfs:comment "Chief executive officer responsible for certifying information in the amendment." .

bpi:CashFlowTable a owl:Class ;
    rdfs:label "CashFlowTable" ;
    rdfs:comment "Cash flow table included in the notes/appendix of financial reporting." ;
    rdfs:subClassOf bpi:FinancialStatements .

bpi:CentralBank a owl:Class ;
    rdfs:label "CentralBank" ;
    rdfs:comment "A monetary authority referenced as supplying additional liquidity to markets and banks." .

bpi:CinemaAndCulturalIndustriesInstitute a owl:Class ;
    rdfs:label "CinemaAndCulturalIndustriesInstitute" ;
    rdfs:comment "An institute referenced as a partner in deploying cinema/audio-visual and video games accelerators." .

bpi:ClimateAndEnvironmentalRiskManagementCommittee a owl:Class ;
    rdfs:label "ClimateAndEnvironmentalRiskManagementCommittee" ;
    rdfs:comment "Dedicated committee incorporated to manage climate and environmental risk governance." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:ClimateKit a owl:Class ;
    rdfs:label "ClimateKit" ;
    rdfs:comment "A communication and guidance kit on climate and ESG good practices distributed to invested funds and management companies." .

bpi:CompensationPaidToAdministrativeBodiesMembers a owl:Class ;
    rdfs:label "CompensationPaidToAdministrativeBodiesMembers" ;
    rdfs:comment "Compensation paid to members of administrative bodies." .

bpi:ComplaintBody a owl:Class ;
    rdfs:label "ComplaintBody" ;
    rdfs:comment "An authority where individuals can lodge complaints regarding data protection." .

bpi:Consent a owl:Class ;
    rdfs:label "Consent" ;
    rdfs:comment "A legal basis for processing where the candidate provides permission for certain communications." .

bpi:ConsolidatedBalanceSheet a owl:Class ;
    rdfs:label "ConsolidatedBalanceSheet" ;
    rdfs:comment "Balance sheet presented within consolidated financial statements." ;
    rdfs:subClassOf bpi:BalanceSheet,
        bpi:ConsolidatedFinancialStatements .

bpi:ConsolidatedFund a owl:Class ;
    rdfs:label "ConsolidatedFund" ;
    rdfs:comment "A fund included in or removed from the consolidation scope based on consolidation rules." ;
    rdfs:subClassOf bpi:ConsolidationScope .

bpi:ConsolidatedProfitAndLossStatement a owl:Class ;
    rdfs:label "ConsolidatedProfitAndLossStatement" ;
    rdfs:comment "Consolidated profit and loss statement including net banking income and net income." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements .

bpi:ContractLifecycleManagement a owl:Class ;
    rdfs:label "ContractLifecycleManagement" ;
    rdfs:comment "Overall management of the contract lifecycle including execution and follow-up." ;
    rdfs:subClassOf bpi:Contract .

bpi:CounterTerroristFinancing a owl:Class ;
    rdfs:label "CounterTerroristFinancing" ;
    rdfs:comment "Compliance activities aimed at countering the financing of terrorism." ;
    rdfs:subClassOf bpi:DueDiligence .

bpi:CreditCommittee a owl:Class ;
    rdfs:label "CreditCommittee" ;
    rdfs:comment "A committee of the group receiving credit-risk files for decision." .

bpi:CreditRiskCommittee a owl:Class ;
    rdfs:label "CreditRiskCommittee" ;
    rdfs:comment "A committee receiving credit-risk files for decision." .

bpi:CreditRiskDepartment a owl:Class ;
    rdfs:label "CreditRiskDepartment" ;
    rdfs:comment "A department responsible for counter-analysis of credit-risk files and presenting them to committees." .

bpi:CreditRiskIncreaseAssessment a owl:Class ;
    rdfs:label "CreditRiskIncreaseAssessment" ;
    rdfs:comment "Assessment process for determining significant increase in credit risk for ECL staging." ;
    rdfs:subClassOf bpi:ExpectedCreditLossCalculation .

bpi:CrossReferenceTable a owl:Class ;
    rdfs:label "CrossReferenceTable" ;
    rdfs:comment "A table mapping headings between the universal registration document and its amendment." .

bpi:CurrentAccount a owl:Class ;
    rdfs:label "CurrentAccount" ;
    rdfs:comment "A current account included in cash and cash equivalents (e.g., Bpifrance current account, State current accounts)." ;
    rdfs:subClassOf bpi:CashAndCashEquivalent .

bpi:CurrentNonCurrentClassification a owl:Class ;
    rdfs:label "CurrentNonCurrentClassification" ;
    rdfs:comment "The classification of assets and liabilities as current or non-current based on expected settlement or sale within twelve months." .

bpi:CurriculumVitae a owl:Class ;
    rdfs:label "CurriculumVitae" ;
    rdfs:comment "A CV document that may contain personal data used in recruitment." .

bpi:DatabaseProvider a owl:Class ;
    rdfs:label "DatabaseProvider" ;
    rdfs:comment "An authority or official third party that makes databases available for indirect data collection." ;
    rdfs:subClassOf bpi:Organization .

bpi:DebtOnFixedAssetsAndRelatedAccounts a owl:Class ;
    rdfs:label "DebtOnFixedAssetsAndRelatedAccounts" ;
    rdfs:comment "Debts on fixed assets and related accounts." .

bpi:DebtsOnFixedAssetsAndRelatedAccounts a owl:Class ;
    rdfs:label "DebtsOnFixedAssetsAndRelatedAccounts" ;
    rdfs:comment "Debts specifically related to fixed assets and related accounts." ;
    rdfs:subClassOf bpi:MiscellaneousDebts .

bpi:DecisionSupportTool a owl:Class ;
    rdfs:label "DecisionSupportTool" ;
    rdfs:comment "A tool used to support credit decisions through comprehensive analysis." .

bpi:DefinedBenefitPlan a owl:Class ;
    rdfs:label "DefinedBenefitPlan" ;
    rdfs:comment "Employee benefit plan generating actuarial gains and losses recognized in equity when applicable." .

bpi:DerecognitionOfFinancialAssets a owl:Class ;
    rdfs:label "DerecognitionOfFinancialAssets" ;
    rdfs:comment "Accounting treatment for removing financial assets when contractual rights expire or risks/rewards are transferred." .

bpi:DerecognitionOfFinancialLiabilities a owl:Class ;
    rdfs:label "DerecognitionOfFinancialLiabilities" ;
    rdfs:comment "Accounting treatment for removing financial liabilities when obligations are extinguished, cancelled, or expire." .

bpi:DerivativeHedging a owl:Class ;
    rdfs:label "DerivativeHedging" ;
    rdfs:comment "Hedging activities reflected through derivative revaluation for recyclable items." ;
    rdfs:subClassOf bpi:HedgingDerivative .

bpi:ECLSensitivityAnalysis a owl:Class ;
    rdfs:label "ECLSensitivityAnalysis" ;
    rdfs:comment "Sensitivity analysis of ECL amounts to macroeconomic scenarios." ;
    rdfs:subClassOf bpi:ExpectedCreditLossCalculation .

bpi:ESGCommittee a owl:Class ;
    rdfs:label "ESGCommittee" ;
    rdfs:comment "A committee referenced as reviewing and improving ESG questionnaires." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:ESGQuestionnaire a owl:Class ;
    rdfs:label "ESGQuestionnaire" ;
    rdfs:comment "A questionnaire assessing ESG integration, CSR policies, and measurable practices for companies and fund managers." ;
    rdfs:subClassOf bpi:Questionnaire .

bpi:EcosystemRelatedRisk a owl:Class ;
    rdfs:label "EcosystemRelatedRisk" ;
    rdfs:comment "Risk arising from the broader ecosystem, including regulatory, political and climate-related risks." ;
    rdfs:subClassOf bpi:Risk .

bpi:ElectronicSignature a owl:Class ;
    rdfs:label "ElectronicSignature" ;
    rdfs:comment "A signature mechanism referenced for managing electronic signature processes and evidence reliability." .

bpi:EnergyAndEcologicalTransitionSupport a owl:Class ;
    rdfs:label "EnergyAndEcologicalTransitionSupport" ;
    rdfs:comment "Support measures for energy and ecological transition and related reindustrialisation initiatives." .

bpi:EnvironmentalObjective a owl:Class ;
    rdfs:label "EnvironmentalObjective" ;
    rdfs:comment "EU environmental objectives that eligible activities and loans aim to support." .

bpi:EquityAccountingMethod a owl:Class ;
    rdfs:label "EquityAccountingMethod" ;
    rdfs:comment "Equity-accounting method referenced as the consolidation approach for certain companies." .

bpi:EquityConsolidatedCompanyInterest a owl:Class ;
    rdfs:label "EquityConsolidatedCompanyInterest" ;
    rdfs:comment "An interest in an equity-consolidated company presented after equity method adjustments." ;
    rdfs:subClassOf bpi:EquityMethodInvestment .

bpi:EquityConsolidationAdjustments a owl:Class ;
    rdfs:label "EquityConsolidationAdjustments" ;
    rdfs:comment "Adjustments made when applying the equity method, including restatements and eliminations." ;
    rdfs:subClassOf bpi:EquityMethod .

bpi:EquityMethodConsolidation a owl:Class ;
    rdfs:label "EquityMethodConsolidation" ;
    rdfs:comment "Consolidation method used for joint ventures and significant influence holdings." ;
    rdfs:subClassOf bpi:ConsolidationMethod .

bpi:EuropeanCentralBank a owl:Class ;
    rdfs:label "EuropeanCentralBank" ;
    rdfs:comment "European Central Bank referenced as a source of refinancing via monetary policy programmes." ;
    rdfs:subClassOf bpi:CentralBank .

bpi:EuropeanRegulation a owl:Class ;
    rdfs:label "EuropeanRegulation" ;
    rdfs:comment "A regulatory instrument referenced for personal data protection (e.g., GDPR)." .

bpi:EventOrganization a owl:Class ;
    rdfs:label "EventOrganization" ;
    rdfs:comment "Organization and management of events involving individuals." .

bpi:ExecutiveManagement a owl:Class ;
    rdfs:label "ExecutiveManagement" ;
    rdfs:comment "Executive management roles referenced in the organizational charts." ;
    rdfs:subClassOf bpi:OrganizationalChart .

bpi:ExpectedCreditLoss a owl:Class ;
    rdfs:label "ExpectedCreditLoss" ;
    rdfs:comment "Expected credit losses (ECL) calculated using macroeconomic scenarios and model adjustments." ;
    rdfs:subClassOf bpi:CreditRisk .

bpi:Expenditure a owl:Class ;
    rdfs:label "Expenditure" ;
    rdfs:comment "General concept of spending eligible under the framework." .

bpi:ExportFinancing a owl:Class ;
    rdfs:label "ExportFinancing" ;
    rdfs:comment "A function providing medium-long-term financing solutions for foreign buyers of exporting companies." ;
    rdfs:subClassOf bpi:BusinessLine,
        bpi:ExportDepartment .

bpi:ExportFinancingBusinessLine a owl:Class ;
    rdfs:label "ExportFinancingBusinessLine" ;
    rdfs:comment "A business line offering medium- and long-term export financing solutions to exporting companies for foreign buyers." ;
    rdfs:subClassOf bpi:InternationalBusinessLine .

bpi:ExportGuarantee a owl:Class ;
    rdfs:label "ExportGuarantee" ;
