    rdfs:subClassOf bpi:IncomeStatement,
        bpi:PublishableIncomeStatement .

bpi:FibenRatings a owl:Class ;
    rdfs:label "FibenRatings" ;
    rdfs:comment "Credit ratings provided by the Bank of France used in credit decision processes." .

bpi:FinancialAssetAtFairValueThroughEquity a owl:Class ;
    rdfs:label "FinancialAssetAtFairValueThroughEquity" ;
    rdfs:comment "A category of financial assets measured at fair value with changes recognized in equity." ;
    rdfs:subClassOf bpi:FinancialAsset .

bpi:FinancialAssetAtFairValueThroughProfitOrLoss a owl:Class ;
    rdfs:label "FinancialAssetAtFairValueThroughProfitOrLoss" ;
    rdfs:comment "A category of financial assets measured at fair value with changes recognized in profit or loss." ;
    rdfs:subClassOf bpi:FinancialAsset .

bpi:FinancialDebt a owl:Class ;
    rdfs:label "FinancialDebt" ;
    rdfs:comment "Debts recorded in the balance sheet under categories such as financial debts to credit institutions or other financial debts." ;
    rdfs:subClassOf bpi:Borrowing,
        bpi:Debt,
        bpi:FinancialLiability .

bpi:FinancialInstitution a owl:Class ;
    rdfs:label "FinancialInstitution" ;
    rdfs:comment "An entity subject to non-financial transparency and responsible investment disclosure obligations." .

bpi:FinancialLiabilityAtFairValueThroughProfitOrLoss a owl:Class ;
    rdfs:label "FinancialLiabilityAtFairValueThroughProfitOrLoss" ;
    rdfs:comment "A category of financial liabilities measured at fair value with changes recognized in profit or loss." ;
    rdfs:subClassOf bpi:FinancialLiability .

bpi:FinancialMarketAuthority a owl:Class ;
    rdfs:label "FinancialMarketAuthority" ;
    rdfs:comment "A financial markets authority referenced as having a board where a representative of the State is delegated." .

bpi:Fintech a owl:Class ;
    rdfs:label "Fintech" ;
    rdfs:comment "A company meeting conditions of being a start-up/fast-growing SME with innovative technology/business model and offering financial products/services." ;
    rdfs:subClassOf bpi:Company .

bpi:FrameworkAgreement a owl:Class ;
    rdfs:label "FrameworkAgreement" ;
    rdfs:comment "Framework agreements referenced for long-term management of major projects." ;
    rdfs:subClassOf bpi:Agreement .

bpi:FranceGreenNationGrantsReceivables a owl:Class ;
    rdfs:label "FranceGreenNationGrantsReceivables" ;
    rdfs:comment "Receivables related to France Green Nation grants." ;
    rdfs:subClassOf bpi:OtherFinancialAssets .

bpi:FrenchDataProtectionAct a owl:Class ;
    rdfs:label "FrenchDataProtectionAct" ;
    rdfs:comment "The national French legal framework relating to data protection referenced alongside GDPR." .

bpi:FullConsolidationMethod a owl:Class ;
    rdfs:label "FullConsolidationMethod" ;
    rdfs:comment "A consolidation method used when complete control is exercised over an entity." ;
    rdfs:subClassOf bpi:ConsolidationMethod .

bpi:FutureTechnologyCompany a owl:Class ;
    rdfs:label "FutureTechnologyCompany" ;
    rdfs:comment "A type of company referenced as developing future technologies (equity interests)." .

bpi:GovernmentCommissioner a owl:Class ;
    rdfs:label "GovernmentCommissioner" ;
    rdfs:comment "A governance role referenced as part of the management company’s governance structure." .

bpi:GreenBond a owl:Class ;
    rdfs:label "GreenBond" ;
    rdfs:comment "Green bond issued under the framework, subject to EU green bond eligibility and reporting requirements." ;
    rdfs:subClassOf bpi:FinancialAsset,
        bpi:GreenFinancingInstrument .

bpi:GuaranteeCommissionToBeSpread a owl:Class ;
    rdfs:label "GuaranteeCommissionToBeSpread" ;
    rdfs:comment "Bpifrance guarantee commissions to be spread included in deferred income." ;
    rdfs:subClassOf bpi:DeferredIncome .

bpi:GuaranteeCoverage a owl:Class ;
    rdfs:label "GuaranteeCoverage" ;
    rdfs:comment "Coverage provided to banks and equity funding institutions against default risks of funding recipients." ;
    rdfs:subClassOf bpi:Guarantee .

bpi:GuaranteeProvider a owl:Class ;
    rdfs:label "GuaranteeProvider" ;
    rdfs:comment "An organization that provides guarantees for bond issues and other financing instruments on behalf of public authorities." ;
    rdfs:subClassOf bpi:PublicIndustrialAndCommercialInstitution .

bpi:GuaranteeScheme a owl:Class ;
    rdfs:label "GuaranteeScheme" ;
    rdfs:comment "Guarantee mechanisms and commitments described as part of EPIC Bpifrance’s missions." .

bpi:IncomeFromDisposalOfAssets a owl:Class ;
    rdfs:label "IncomeFromDisposalOfAssets" ;
    rdfs:comment "Extraordinary income arising from disposal of assets." ;
    rdfs:subClassOf bpi:ExtraordinaryIncome .

bpi:IndirectCollection a owl:Class ;
    rdfs:label "IndirectCollection" ;
    rdfs:comment "Collection of personal data indirectly via third-party sources such as publications, databases, directories, or press/social media." ;
    rdfs:subClassOf bpi:PersonalDataCollection .

bpi:InnovationAndIndustryFundReceivables a owl:Class ;
    rdfs:label "InnovationAndIndustryFundReceivables" ;
    rdfs:comment "Receivables related to the Innovation and Industry Fund included in other financial assets." ;
    rdfs:subClassOf bpi:OtherFinancialAsset,
        bpi:OtherFinancialAssets .

bpi:InnovationCapital a owl:Class ;
    rdfs:label "InnovationCapital" ;
    rdfs:comment "Innovation Capital current account interest referenced in financial income/tax note." ;
    rdfs:subClassOf bpi:Fund,
        bpi:OtherReceivables .

bpi:InterestRateRisk a owl:Class ;
    rdfs:label "InterestRateRisk" ;
    rdfs:comment "Risk of losses from unfavorable changes in interest rates, including mismatches between asset and liability rates." ;
    rdfs:subClassOf bpi:FinancialRisk,
        bpi:MarketRisk,
        bpi:Risk .

bpi:InternalControlCharter a owl:Class ;
    rdfs:label "InternalControlCharter" ;
    rdfs:comment "A reference framework defining internal control within the group." .

bpi:InternalLiquidityAdequacyAssessmentProcess a owl:Class ;
    rdfs:label "InternalLiquidityAdequacyAssessmentProcess" ;
    rdfs:comment "A process (ILAAP) used to assess and ensure internal liquidity adequacy for short-term and medium/long-term obligations." .

bpi:InternationalAccountingStandard a owl:Class ;
    rdfs:label "InternationalAccountingStandard" ;
    rdfs:comment "International Accounting Standards (IAS) referenced as part of the IFRS framework." ;
    rdfs:subClassOf bpi:AccountingStandard .

bpi:InvestmentBusiness a owl:Class ;
    rdfs:label "InvestmentBusiness" ;
    rdfs:comment "A business line evaluated using an expense ratio." .

bpi:InvestmentCommittee a owl:Class ;
    rdfs:label "InvestmentCommittee" ;
    rdfs:comment "A committee bringing together subscribers or stakeholders for governance and related administrative activities." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:InvestmentVehicle a owl:Class ;
    rdfs:label "InvestmentVehicle" ;
    rdfs:comment "A general concept for investment structures such as funds and direct investment portfolios subject to ESG processes." ;
    rdfs:subClassOf bpi:Fund .

bpi:JointControl a owl:Class ;
    rdfs:label "JointControl" ;
    rdfs:comment "Contractual sharing of control over a partnership requiring unanimous consent for relevant activities." ;
    rdfs:subClassOf bpi:ConsolidationPrinciple .

bpi:JudicialAuthority a owl:Class ;
    rdfs:label "JudicialAuthority" ;
    rdfs:comment "A public judicial authority that may receive data in the context of procedures requiring communication." ;
    rdfs:subClassOf bpi:SupervisoryAuthority .

bpi:KYC a owl:Class ;
    rdfs:label "KYC" ;
    rdfs:comment "Know Your Customer processing used for identity verification and compliance." .

bpi:KycCompliancePurpose a owl:Class ;
    rdfs:label "KycCompliancePurpose" ;
    rdfs:comment "A purpose for processing personal data related to Know Your Customer requirements." .

bpi:Leasing a owl:Class ;
    rdfs:label "Leasing" ;
    rdfs:comment "Leasing operations used for tangible and intangible investment financing." .

bpi:LiquidityManagementProcedure a owl:Class ;
    rdfs:label "LiquidityManagementProcedure" ;
    rdfs:comment "Internal procedures for managing liquidity and temporary investments of unallocated proceeds." .

bpi:LoanCommitment a owl:Class ;
    rdfs:label "LoanCommitment" ;
    rdfs:comment "Commitments related to loan financing (including commitments given/received)." .

bpi:LocalAuthority a owl:Class ;
    rdfs:label "LocalAuthority" ;
    rdfs:comment "A sub-national public authority, including regions, involved in financing allocations and guarantee funds." ;
    rdfs:subClassOf bpi:PublicAuthority .

bpi:MacroeconomicScenario a owl:Class ;
    rdfs:label "MacroeconomicScenario" ;
    rdfs:comment "A scenario set used to model macroeconomic conditions for ECL calculations." .

bpi:MediumTermNegotiableDebtSecurity a owl:Class ;
    rdfs:label "MediumTermNegotiableDebtSecurity" ;
    rdfs:comment "Medium-term negotiable debt securities (e.g., NEU MTN) used for green financing." ;
    rdfs:subClassOf bpi:NegotiableDebtSecurity .

bpi:MediumTermPlan a owl:Class ;
    rdfs:label "MediumTermPlan" ;
    rdfs:comment "A medium-term plan referenced as a mechanism to support ecological and energy transition solutions." .

bpi:MissionOfGeneralInterest a owl:Class ;
    rdfs:label "MissionOfGeneralInterest" ;
    rdfs:comment "General interest mission carried out by EPIC Bpifrance in support of public policies." .

bpi:MonetaryPolicyProgramme a owl:Class ;
    rdfs:label "MonetaryPolicyProgramme" ;
    rdfs:comment "Monetary policy refinancing programmes (e.g., TLTRO) referenced as funding sources." .

bpi:NetCash a owl:Class ;
    rdfs:label "NetCash" ;
    rdfs:comment "The net cash concept corresponding to cash and cash equivalents." ;
    rdfs:subClassOf bpi:CashFlowStatement .

bpi:Network a owl:Class ;
    rdfs:label "Network" ;
    rdfs:comment "Network of entities/partners referenced in the organisational chart of the Bpifrance network." .

bpi:NetworkDirectorate a owl:Class ;
    rdfs:label "NetworkDirectorate" ;
    rdfs:comment "A network directorate grouping regional directorates." ;
    rdfs:subClassOf bpi:OrganizationalChartOfNetwork .

bpi:NewsletterSending a owl:Class ;
    rdfs:label "NewsletterSending" ;
    rdfs:comment "A process of sending newsletters to individuals under the policy." ;
    rdfs:subClassOf bpi:CommercialProspectingPurpose .

bpi:NonFinancialPerformanceStatement a owl:Class ;
    rdfs:label "NonFinancialPerformanceStatement" ;
    rdfs:comment "A statement reporting non-financial performance metrics such as training figures." .

bpi:NonGovernmentalOrganization a owl:Class ;
    rdfs:label "NonGovernmentalOrganization" ;
    rdfs:comment "An NGO referenced as a source of pressure affecting borrowers and credit conditions." ;
    rdfs:subClassOf bpi:Organization .

bpi:OperatingEarnings a owl:Class ;
    rdfs:label "OperatingEarnings" ;
    rdfs:comment "Operating earnings line item in the income statement." ;
    rdfs:subClassOf bpi:PublishableIncomeStatement .

bpi:OperatingExpensesNote a owl:Class ;
    rdfs:label "OperatingExpensesNote" ;
    rdfs:comment "Note section dealing with operating expenses." ;
    rdfs:subClassOf bpi:NotesToFinancialStatements .

bpi:OperationalRiskDepartment a owl:Class ;
    rdfs:label "OperationalRiskDepartment" ;
    rdfs:comment "A department within compliance and permanent control responsible for organisation and functioning of operational risk and non-compliance control." ;
    rdfs:subClassOf bpi:ComplianceAndPermanentControlDepartment .

bpi:OperationalRiskManagementPolicy a owl:Class ;
    rdfs:label "OperationalRiskManagementPolicy" ;
    rdfs:comment "A policy applied to ensure governance and management of operational and non-compliance risks." .

bpi:OtherExpense a owl:Class ;
    rdfs:label "OtherExpense" ;
    rdfs:comment "Other expenses included in operating expenses." ;
    rdfs:subClassOf bpi:OperatingExpense .

bpi:OtherPurchasesAndExternalExpenses a owl:Class ;
    rdfs:label "OtherPurchasesAndExternalExpenses" ;
    rdfs:comment "Subcategory of operating expenses covering other purchases and external expenses." ;
    rdfs:subClassOf bpi:OperatingExpenses .

bpi:PPMTRAllowance a owl:Class ;
    rdfs:label "PPMTRAllowance" ;
    rdfs:comment "An allowance item (PPMTR allowance) included in other financial assets." ;
    rdfs:subClassOf bpi:OtherFinancialAsset,
        bpi:OtherFinancialAssets .

bpi:ParentEntityFinancialStatementsAuditReport a owl:Class ;
    rdfs:label "ParentEntityFinancialStatementsAuditReport" ;
    rdfs:comment "Statutory auditor report on the parent entity financial statements." ;
    rdfs:subClassOf bpi:StatutoryAuditorReport .

bpi:Partnership a owl:Class ;
    rdfs:label "Partnership" ;
    rdfs:comment "A contractual arrangement subject to joint control, accounted for using the equity method under IFRS 11." ;
    rdfs:subClassOf bpi:EquityConsolidatedCompany .

bpi:PersonalDataMinimizationPrinciple a owl:Class ;
    rdfs:label "PersonalDataMinimizationPrinciple" ;
    rdfs:comment "The principle that only necessary personal data is collected for the stated purposes." .

bpi:PersonalDataRights a owl:Class ;
    rdfs:label "PersonalDataRights" ;
    rdfs:comment "Rights available to data subjects regarding access, rectification, deletion, portability, limitation, objection, and instructions after death." .

bpi:PhysicalClimateRisk a owl:Class ;
    rdfs:label "PhysicalClimateRisk" ;
    rdfs:comment "Physical risk from financial consequences of extreme and/or chronic climate hazards." ;
    rdfs:subClassOf bpi:ClimateRisk .

bpi:Portfolio a owl:Class ;
    rdfs:label "Portfolio" ;
    rdfs:comment "A collection of investments managed and monitored, including ESG and climate-risk assessment at consolidated level." .

bpi:ProfilingForCommercialProspecting a owl:Class ;
    rdfs:label "ProfilingForCommercialProspecting" ;
    rdfs:comment "Profiling related to commercial prospecting referenced in the context of objections." ;
    rdfs:subClassOf bpi:CommercialProspectingPurpose .

bpi:ProfitOrLoss a owl:Class ;
    rdfs:label "ProfitOrLoss" ;
    rdfs:comment "The result of the financial year included in shareholders’ equity and income statement." ;
    rdfs:subClassOf bpi:ShareholdersEquity .

bpi:Provision a owl:Class ;
    rdfs:label "Provision" ;
    rdfs:comment "A liability recognized when an outflow of resources is probable for an obligation arising from a past event and can be reliably estimated." .

bpi:Provisions a owl:Class ;
    rdfs:label "Provisions" ;
    rdfs:comment "Liabilities of uncertain timing or amount recognized when an outflow is probable from a past event." .

bpi:PrudentialSupervisoryAndResolutionAuthority a owl:Class ;
    rdfs:label "PrudentialSupervisoryAndResolutionAuthority" ;
    rdfs:comment "A supervisory authority overseeing banking institutions and prudential requirements." .

bpi:PublicProcurementCode a owl:Class ;
    rdfs:label "PublicProcurementCode" ;
    rdfs:comment "The legal framework referenced for public procurement rules applicable to certain processing purposes." .

bpi:Questionnaire a owl:Class ;
    rdfs:label "Questionnaire" ;
    rdfs:comment "A structured set of questions used to collect ESG/CSR information from management companies and portfolio entities." .

bpi:RegionalAuthority a owl:Class ;
    rdfs:label "RegionalAuthority" ;
    rdfs:comment "Regional authorities and their public limited companies that may entrust missions and conclude agreements." .

bpi:RegionalDirectorate a owl:Class ;
    rdfs:label "RegionalDirectorate" ;
    rdfs:comment "A regional directorate within a network directorate." ;
    rdfs:subClassOf bpi:OrganizationalChartOfNetwork .

bpi:RegionalOffice a owl:Class ;
    rdfs:label "RegionalOffice" ;
    rdfs:comment "A regional office within the organizational network." ;
    rdfs:subClassOf bpi:OrganizationalChartOfNetwork .

bpi:RegulatoryAuthority a owl:Class ;
    rdfs:label "RegulatoryAuthority" ;
    rdfs:comment "A general category for authorities such as financial market regulators referenced for complaint management." .

bpi:ReinsuranceAgreementParticipant a owl:Class ;
    rdfs:label "ReinsuranceAgreementParticipant" ;
    rdfs:comment "An entity intervening within reinsurance or joint insurance agreements." .

bpi:RelatedReceivable a owl:Class ;
    rdfs:label "RelatedReceivable" ;
    rdfs:comment "Receivables related to loans." .

bpi:RelationshipManagement a owl:Class ;
    rdfs:label "RelationshipManagement" ;
    rdfs:comment "Processing to identify, exchange, and manage the business relationship with a public or media personality." ;
    rdfs:subClassOf bpi:DataProcessingActivity .

bpi:RiskCommittee a owl:Class ;
    rdfs:label "RiskCommittee" ;
    rdfs:comment "Risk committee referenced as part of governance structures for certain entities." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:SATTActivity a owl:Class ;
    rdfs:label "SATTActivity" ;
    rdfs:comment "SATT activity representing equity interests in Technology Transfer Accelerator Companies on behalf of the French State." ;
    rdfs:subClassOf bpi:ActivitiesOnBehalfOfThirdParties,
        bpi:ThirdPartyActivity .

bpi:SME a owl:Class ;
    rdfs:label "SME" ;
    rdfs:comment "Small and medium-sized enterprises supported through financing, guarantees, and innovation activities." ;
    rdfs:subClassOf bpi:IndustrialEntity .

bpi:SMESupport a owl:Class ;
    rdfs:label "SMESupport" ;
    rdfs:comment "Support and financing for small and medium-sized enterprises referenced as a core mission." .

bpi:SMESupportEntity a owl:Class ;
    rdfs:label "SMESupportEntity" ;
    rdfs:comment "An organization missioned to promote, support, and finance small and medium-sized enterprises." .

bpi:SecuritiesRemainingToBeReleased a owl:Class ;
    rdfs:label "SecuritiesRemainingToBeReleased" ;
    rdfs:comment "Securities remaining to be released to funds referenced in debts on fixed assets and related accounts." ;
    rdfs:subClassOf bpi:DebtOnFixedAssetsAndRelatedAccounts,
        bpi:OperatingDebts .

bpi:SeedLoan a owl:Class ;
    rdfs:label "SeedLoan" ;
    rdfs:comment "Seed-stage unsecured loan product referenced in innovation financing." ;
    rdfs:subClassOf bpi:UnsecuredLoan .

bpi:SegmentReporting a owl:Class ;
    rdfs:label "SegmentReporting" ;
    rdfs:comment "Disclosure of contributions within the group by sector/segment." ;
    rdfs:subClassOf bpi:FinancialStatementNote .

bpi:ServiceAgreement a owl:Class ;
    rdfs:label "ServiceAgreement" ;
    rdfs:comment "Service agreements concluded between entities for management or support activities." ;
    rdfs:subClassOf bpi:Agreement .

bpi:ShareholderDialogue a owl:Class ;
    rdfs:label "ShareholderDialogue" ;
    rdfs:comment "Ongoing engagement with invested companies and governance bodies to encourage ESG progress." .

bpi:ShortTermNegotiableDebtSecurity a owl:Class ;
    rdfs:label "ShortTermNegotiableDebtSecurity" ;
    rdfs:comment "Short-term negotiable debt securities (e.g., NEUCP) used to finance or refinance eligible green loans and expenditures." ;
    rdfs:subClassOf bpi:NegotiableDebtSecurity .

bpi:SpaceAgency a owl:Class ;
    rdfs:label "SpaceAgency" ;
    rdfs:comment "A space-related agency referenced as a partner in France 2030 space initiatives." .

bpi:StateCurrentAccountInnovationCapital a owl:Class ;
    rdfs:label "StateCurrentAccountInnovationCapital" ;
    rdfs:comment "Expendable cash from the Innovation and Industry Fund held in the State current account via Agence France Trésor Innovation." ;
    rdfs:subClassOf bpi:CurrentAccount .

bpi:StateEntity a owl:Class ;
    rdfs:label "StateEntity" ;
    rdfs:comment "Entity representing the French State, acting unilaterally or by agreement and holding capital or entrusting missions." .

bpi:SteeringCommittee a owl:Class ;
    rdfs:label "SteeringCommittee" ;
    rdfs:comment "Local steering committee responsible for formulating opinions on mission execution and strategic consistency at regional level." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:StructuralInterestRateRisk a owl:Class ;
    rdfs:label "StructuralInterestRateRisk" ;
    rdfs:comment "Interest rate risk related to structural balance sheet exposures and monitoring indicators such as net interest margin and economic value of equity." ;
    rdfs:subClassOf bpi:MarketPriceRisk,
        bpi:MarketRisk .

bpi:StructuredEntity a owl:Class ;
    rdfs:label "StructuredEntity" ;
    rdfs:comment "An entity structured such that voting or similar rights are not the dominant factor in deciding control; referenced as not held by the group." .

bpi:Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    rdfs:comment "An entity providing goods or services to Bpifrance and whose representatives or agents may have their data processed." .

bpi:SupportExecutiveDepartment a owl:Class ;
    rdfs:label "SupportExecutiveDepartment" ;
    rdfs:comment "An executive department managing the support business line and providing services such as advice, training and networking." ;
    rdfs:subClassOf bpi:BusinessSupportBusinessLine .

bpi:SustainableDevelopmentGoal a owl:Class ;
    rdfs:label "SustainableDevelopmentGoal" ;
    rdfs:comment "UN sustainable development goals referenced as additional alignment targets for evaluation and selection." .

bpi:TaxAndDuties a owl:Class ;
    rdfs:label "TaxAndDuties" ;
    rdfs:comment "Taxes and duties and similar payments included in operating expenses." ;
    rdfs:subClassOf bpi:OperatingExpense .

bpi:TechnologyTransferAccelerationCompany a owl:Class ;
    rdfs:label "TechnologyTransferAccelerationCompany" ;
    rdfs:comment "A type of company referenced in the context of SATT activities (equity interests in technology transfer acceleration companies)." .

bpi:TerritorialDelegation a owl:Class ;
    rdfs:label "TerritorialDelegation" ;
    rdfs:comment "A territorial delegation within the network structure." ;
    rdfs:subClassOf bpi:OrganizationalChartOfNetwork .

bpi:TradeDebts a owl:Class ;
    rdfs:label "TradeDebts" ;
    rdfs:comment "Trade debts referenced in trade debts and related accounts note." ;
    rdfs:subClassOf bpi:TradePayables .

bpi:TradePayables a owl:Class ;
    rdfs:label "TradePayables" ;
    rdfs:comment "Payables to suppliers and related accounts." ;
    rdfs:subClassOf bpi:OperatingDebts .

bpi:TrainingPlatform a owl:Class ;
    rdfs:label "TrainingPlatform" ;
    rdfs:comment "An online platform providing short targeted courses and training modules for ESG/climate awareness." .

bpi:Transaction a owl:Class ;
    rdfs:label "Transaction" ;
    rdfs:comment "A general category of investment-related activities such as contractualization, divestment, and due diligence." .

bpi:TransitionRisk a owl:Class ;
    rdfs:label "TransitionRisk" ;
    rdfs:comment "Risks of losses from inadequate adaptation to a low-carbon economy and transition-related constraints." ;
    rdfs:subClassOf bpi:ClimateRisk .

bpi:TrustedServiceProviderNetheos a owl:Class ;
    rdfs:label "TrustedServiceProviderNetheos" ;
    rdfs:comment "A trusted service provider used for implementing the advanced electronic signature process (named in text)." ;
    rdfs:subClassOf bpi:TrustedServiceProvider .

bpi:TrustedServiceProviderYousign a owl:Class ;
    rdfs:label "TrustedServiceProviderYousign" ;
    rdfs:comment "A trusted service provider used for implementing the advanced electronic signature process (named in text)." ;
    rdfs:subClassOf bpi:TrustedServiceProvider .

bpi:holdsShareholdingIn a owl:ObjectProperty ;
    rdfs:label "holdsShareholdingIn" ;
    rdfs:comment "Indicates that the institution holds a shareholding in a public limited company (e.g., share capital of the group)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:PublicLimitedCompany .

bpi:prepares a owl:ObjectProperty ;
    rdfs:label "prepares" ;
    rdfs:comment "Indicates that the company prepares the consolidated financial statements." ;
    rdfs:domain bpi:ConsolidatedFinancialStatements,
        bpi:PublicIndustrialAndCommercialInstitution,
        bpi:PublicLimitedCompany ;
    rdfs:range bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatements,
        bpi:InterimFinancialStatement .

bpi:preparesFinancialStatements a owl:ObjectProperty ;
    rdfs:label "preparesFinancialStatements" ;
    rdfs:comment "Indicates that the board is responsible for preparing the consolidated financial statements." ;
    rdfs:domain bpi:BoardOfDirectors ;
    rdfs:range bpi:ConsolidatedFinancialStatements .

bpi:AcceleratorProgramme a owl:Class ;
    rdfs:label "AcceleratorProgramme" ;
    rdfs:comment "A programme/initiative that deploys support for specific sectors or regions (e.g., SME accelerators, energy transition accelerators)." ;
    rdfs:subClassOf bpi:FinancialProgramme,
        bpi:InvestmentProgramme,
        bpi:PublicFundingInstrument .

bpi:AdministrativeAuthority a owl:Class ;
    rdfs:label "AdministrativeAuthority" ;
    rdfs:comment "A public administrative authority that may receive data in the context of procedures requiring communication." ;
    rdfs:subClassOf bpi:SupervisoryAuthority .

bpi:AntiCorruptionProcess a owl:Class ;
    rdfs:label "AntiCorruptionProcess" ;
    rdfs:comment "Due diligence and checks to counter corruption." ;
    rdfs:subClassOf bpi:DueDiligenceProcess .

bpi:AntiCorruptionPurpose a owl:Class ;
    rdfs:label "AntiCorruptionPurpose" ;
    rdfs:comment "A purpose for processing personal data to fight corruption." .

bpi:AntiFraudPreventionPurpose a owl:Class ;
    rdfs:label "AntiFraudPreventionPurpose" ;
    rdfs:comment "A purpose for processing personal data to prevent fraud (overlaps with fraud protection)." ;
    rdfs:subClassOf bpi:FraudProtectionPurpose .

bpi:AntiMoneyLaunderingProcess a owl:Class ;
    rdfs:label "AntiMoneyLaunderingProcess" ;
    rdfs:comment "Due diligence and checks to counter money laundering." ;
    rdfs:subClassOf bpi:DueDiligenceProcess .

bpi:AntiMoneyLaunderingPurpose a owl:Class ;
    rdfs:label "AntiMoneyLaunderingPurpose" ;
    rdfs:comment "A purpose for processing personal data to fight money laundering." .

bpi:AuditedData a owl:Class ;
    rdfs:label "AuditedData" ;
    rdfs:comment "Financial figures derived from internal approved sources and accounts, noted as not audited in the press release." .

bpi:Bond a owl:Class ;
    rdfs:label "Bond" ;
    rdfs:comment "A fixed-income security referenced in fair value and amortised cost disclosures." ;
    rdfs:subClassOf bpi:Securities .

bpi:BusinessCreation a owl:Class ;
    rdfs:label "BusinessCreation" ;
    rdfs:comment "A mission supporting and strengthening national and local action in favour of business creation through entrepreneurship networks." ;
    rdfs:subClassOf bpi:BpifranceGroup .

bpi:CNIL a owl:Class ;
    rdfs:label "CNIL" ;
    rdfs:comment "A French data protection supervisory authority referenced as a place to lodge complaints." ;
    rdfs:subClassOf bpi:ComplaintBody,
        bpi:SupervisoryAuthority .

bpi:ChiefExecutiveOfficer a owl:Class ;
    rdfs:label "ChiefExecutiveOfficer" ;
    rdfs:comment "Chief executive officer role within the institution’s management." ;
    rdfs:subClassOf bpi:GeneralManagement .

bpi:ClimatePlan a owl:Class ;
    rdfs:label "ClimatePlan" ;
    rdfs:comment "Climate plan described as the organization’s strategy for ecological and energy transition and as aligned with green financing." .

bpi:CommercialRelationship a owl:Class ;
    rdfs:label "CommercialRelationship" ;
    rdfs:comment "The commercial relationship between the controller and customers/prospects, including management and reporting." .

bpi:ComplianceAndPermanentControlDepartment a owl:Class ;
    rdfs:label "ComplianceAndPermanentControlDepartment" ;
    rdfs:comment "A department responsible for steering procedures and controls for non-compliance risk management." .

bpi:ConsolidatedFinancialStatementsAuditReport a owl:Class ;
    rdfs:label "ConsolidatedFinancialStatementsAuditReport" ;
    rdfs:comment "Statutory auditor report on the consolidated financial statements." ;
    rdfs:subClassOf bpi:StatutoryAuditorReport .

bpi:ConsolidatedGroup a owl:Class ;
    rdfs:label "ConsolidatedGroup" ;
    rdfs:comment "The group whose consolidated financial statements include entities controlled or significantly influenced." .

bpi:ConsolidatedIncomeStatement a owl:Class ;
    rdfs:label "ConsolidatedIncomeStatement" ;
    rdfs:comment "Income statement presented within consolidated financial statements." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements,
        bpi:IncomeStatement .

bpi:ContingencyPlanReserve a owl:Class ;
    rdfs:label "ContingencyPlanReserve" ;
    rdfs:comment "A reserve of financial assets mobilisable under proven stress situations for liquidity." ;
    rdfs:subClassOf bpi:GuaranteeFund .

bpi:ContractPerformanceLegalBasis a owl:Class ;
    rdfs:label "ContractPerformanceLegalBasis" ;
    rdfs:comment "A legal basis for processing personal data based on performance of a contract." .

bpi:ControlledCompany a owl:Class ;
    rdfs:label "ControlledCompany" ;
    rdfs:comment "A company exclusively controlled and therefore fully consolidated in the group accounts." ;
    rdfs:subClassOf bpi:Company,
        bpi:Organization .

bpi:CorporateGovernanceReport a owl:Class ;
    rdfs:label "CorporateGovernanceReport" ;
    rdfs:comment "A report section describing corporate governance information for the issuer." .

bpi:CounterTerrorismFinancingProcess a owl:Class ;
    rdfs:label "CounterTerrorismFinancingProcess" ;
    rdfs:comment "Due diligence and checks to counter financing of terrorism." ;
    rdfs:subClassOf bpi:DueDiligenceProcess .

bpi:CounterTerroristFinancingPurpose a owl:Class ;
    rdfs:label "CounterTerroristFinancingPurpose" ;
    rdfs:comment "A purpose for processing personal data to fight terrorist financing." .

bpi:CreditInstitution a owl:Class ;
    rdfs:label "CreditInstitution" ;
    rdfs:comment "A banking institution providing financing activities and subject to banking regulations and prudential supervision." ;
    rdfs:subClassOf bpi:Bank,
        bpi:Organization,
        bpi:PublicGroup,
        bpi:ServiceProvider .

bpi:CreditRiskBucket a owl:Class ;
    rdfs:label "CreditRiskBucket" ;
    rdfs:comment "A classification bucket used to allocate exposures based on credit risk increase and expected losses." .

bpi:CurrentAssets a owl:Class ;
    rdfs:label "CurrentAssets" ;
    rdfs:comment "Assets expected to be realized within the operating cycle (current assets)." ;
    rdfs:subClassOf bpi:BalanceSheet .

bpi:CurrentIncomeBeforeTaxes a owl:Class ;
    rdfs:label "CurrentIncomeBeforeTaxes" ;
    rdfs:comment "Income before taxes line item." ;
    rdfs:subClassOf bpi:PublishableIncomeStatement .

bpi:CurrentLiquidity a owl:Class ;
    rdfs:label "CurrentLiquidity" ;
    rdfs:comment "Assets that can be mobilised in one day, including cash, money market funds, and sovereign bonds." ;
    rdfs:subClassOf bpi:LiquidityReserve .

bpi:CurrentLiquidityBuffer a owl:Class ;
    rdfs:label "CurrentLiquidityBuffer" ;
    rdfs:comment "Highly liquid assets mobilisable in less than a week." ;
    rdfs:subClassOf bpi:LiquidityReserve .

bpi:DataProcessor a owl:Class ;
    rdfs:label "DataProcessor" ;
    rdfs:comment "An entity that processes personal data on behalf of a data controller (implied by outsourcing/service providers)." .

bpi:DebtInstrument a owl:Class ;
    rdfs:label "DebtInstrument" ;
    rdfs:comment "A debt instrument measured at amortised cost or fair value depending on business model and contractual cash flows." ;
    rdfs:subClassOf bpi:FinancialAsset,
        bpi:FinancialInstrument .

bpi:DeputyCEO a owl:Class ;
    rdfs:label "DeputyCEO" ;
    rdfs:comment "Deputy chief executive officer responsible for certifying information in the amendment." .

bpi:DerecognitionEvent a owl:Class ;
    rdfs:label "DerecognitionEvent" ;
    rdfs:comment "Events leading to derecognition of financial assets or liabilities (expiration of rights or extinguishment of obligations)." .

bpi:DiligencePack a owl:Class ;
    rdfs:label "DiligencePack" ;
    rdfs:comment "A pre-investment documentation package including an ESG questionnaire for fund-of-funds management companies." .

bpi:ECLModel a owl:Class ;
    rdfs:label "ECLModel" ;
    rdfs:comment "A model used to calculate expected credit losses, including calibration and methodological adjustments." ;
    rdfs:subClassOf bpi:ExpectedCreditLossCalculation,
        bpi:RiskManagementSystem .

bpi:EMTNProgramme a owl:Class ;
    rdfs:label "EMTNProgramme" ;
    rdfs:comment "A bond issuance programme (Euro Medium Term Notes) referenced for medium and long-term refinancing." ;
    rdfs:subClassOf bpi:InvestmentProgramme .

bpi:ESGRisk a owl:Class ;
    rdfs:label "ESGRisk" ;
    rdfs:comment "A risk category arising from ESG issues, including ethical, environmental, and social controversies." .

bpi:EUTaxonomyActivity a owl:Class ;
    rdfs:label "EU_TaxonomyActivity" ;
    rdfs:comment "EU taxonomy activities referenced as eligible categories for alignment." .

bpi:EquityConsolidatedCompanyShareOfNetProfit a owl:Class ;
    rdfs:label "EquityConsolidatedCompanyShareOfNetProfit" ;
    rdfs:comment "Share of net profit from equity-consolidated companies presented in the income statement." .

bpi:EquityInterest a owl:Class ;
    rdfs:label "EquityInterest" ;
    rdfs:comment "An ownership interest in another entity, with holdings described between 10% and 50% of capital held." .

bpi:EuropeanCommissionDelegatedRegulation a owl:Class ;
    rdfs:label "EuropeanCommissionDelegatedRegulation" ;
    rdfs:comment "A delegated regulation of the European Commission referenced for required cross-reference table headings." .

bpi:ExceptionalProfitOrLoss a owl:Class ;
    rdfs:label "ExceptionalProfitOrLoss" ;
    rdfs:comment "Exceptional profit or loss derived from extraordinary income and expenses." ;
    rdfs:subClassOf bpi:PublishableIncomeStatement .

bpi:ExchangeRisk a owl:Class ;
    rdfs:label "ExchangeRisk" ;
    rdfs:comment "Risk that changes in foreign exchange rates negatively impact the value of instruments and generate losses on non-euro borrowings or loans." ;
    rdfs:subClassOf bpi:FinancialRisk .

bpi:FairValueLevel a owl:Class ;
    rdfs:label "FairValueLevel" ;
    rdfs:comment "A level within the fair value hierarchy (e.g., quoted prices, observable inputs, unobservable inputs)." ;
    rdfs:subClassOf bpi:FairValueHierarchy,
        bpi:FairValueMeasurement .

bpi:FairValueLevel1 a owl:Class ;
    rdfs:label "FairValueLevel1" ;
    rdfs:comment "Fair value determined using quoted prices in liquid active markets." ;
    rdfs:subClassOf bpi:FairValueHierarchyLevel .

bpi:FairValueLevel2 a owl:Class ;
    rdfs:label "FairValueLevel2" ;
    rdfs:comment "Fair value determined using observable market data and valuation techniques with observable parameters." ;
    rdfs:subClassOf bpi:FairValueHierarchyLevel .

bpi:FinancialLoanAndFinancialDebt a owl:Class ;
    rdfs:label "FinancialLoanAndFinancialDebt" ;
    rdfs:comment "A combined classification covering financial loans and financial debts." .

bpi:FinancialYearEarnings a owl:Class ;
    rdfs:label "FinancialYearEarnings" ;
    rdfs:comment "Earnings for the financial year after tax." ;
    rdfs:subClassOf bpi:IncomeStatement,
        bpi:PublishableIncomeStatement .

bpi:FinancingActivities a owl:Class ;
    rdfs:label "FinancingActivities" ;
    rdfs:comment "Cash flows resulting from changes in the financial structure, including equity and long-term borrowings." ;
    rdfs:subClassOf bpi:CashFlowStatement .

bpi:ForwardLookingScenarios a owl:Class ;
    rdfs:label "ForwardLookingScenarios" ;
    rdfs:comment "A set of scenarios updated over time and used to compute ECLs." ;
    rdfs:subClassOf bpi:MacroeconomicScenario .

bpi:FrenchTechSovereigntyActivity a owl:Class ;
    rdfs:label "FrenchTechSovereigntyActivity" ;
    rdfs:comment "French Tech Sovereignty activity representing equity interests in companies developing future technologies on behalf of the French State." ;
    rdfs:subClassOf bpi:ActivitiesOnBehalfOfThirdParties,
        bpi:ThirdPartyActivity .

bpi:FullConsolidation a owl:Class ;
    rdfs:label "FullConsolidation" ;
    rdfs:comment "A consolidation method used for entities over which complete control is exercised." ;
    rdfs:subClassOf bpi:ConsolidationMethod .

bpi:GainsAndLossesRecognisedDirectlyInEquity a owl:Class ;
    rdfs:label "GainsAndLossesRecognisedDirectlyInEquity" ;
    rdfs:comment "Components of income and losses recognized directly in equity rather than through profit or loss." ;
    rdfs:subClassOf bpi:Equity .

bpi:GrantReceivable a owl:Class ;
    rdfs:label "GrantReceivable" ;
    rdfs:comment "Receivables for grants to be received from the State." ;
    rdfs:subClassOf bpi:OtherReceivable .

bpi:GrowthFund a owl:Class ;
    rdfs:label "GrowthFund" ;
    rdfs:comment "A fund category focused on growth-stage investments." ;
    rdfs:subClassOf bpi:Fund .

bpi:GuaranteeBusinessLine a owl:Class ;
    rdfs:label "GuaranteeBusinessLine" ;
    rdfs:comment "A business line providing guarantees to encourage lending to SMEs and other supported entities." ;
    rdfs:subClassOf bpi:BpifranceGroup .

bpi:GuaranteeCommissionReceivable a owl:Class ;
    rdfs:label "GuaranteeCommissionReceivable" ;
    rdfs:comment "Commissions for guarantees to be received." ;
    rdfs:subClassOf bpi:OtherReceivable .

bpi:Impairment a owl:Class ;
    rdfs:label "Impairment" ;
    rdfs:comment "An impairment concept applied to assets (including goodwill and equity-accounted investments) when objective evidence exists." .

bpi:ImpairmentLoss a owl:Class ;
    rdfs:label "ImpairmentLoss" ;
    rdfs:comment "Loss recognized when recoverable amount is less than book value, including impairment of goodwill and equity-method investments." .

bpi:ImpairmentOfAssets a owl:Class ;
    rdfs:label "ImpairmentOfAssets" ;
    rdfs:comment "The impairment framework referenced for testing equity investments and goodwill when objective evidence exists." ;
    rdfs:subClassOf bpi:AccountingStandard,
        bpi:ImpairmentLoss .

bpi:IndustrialEntity a owl:Class ;
    rdfs:label "IndustrialEntity" ;
    rdfs:comment "Industrial borrower entity targeted by eligible green industry loans." ;
    rdfs:subClassOf bpi:BorrowerEntity .

bpi:InnovationBusinessLine a owl:Class ;
    rdfs:label "InnovationBusinessLine" ;
    rdfs:comment "A business line providing financing and support for innovative projects and companies from idea to market." ;
    rdfs:subClassOf bpi:BpifranceGroup .

bpi:InterestReceivable a owl:Class ;
    rdfs:label "InterestReceivable" ;
    rdfs:comment "Receivables for interests to be received." ;
    rdfs:subClassOf bpi:OtherReceivable .

bpi:InternationalFinancialReportingStandard a owl:Class ;
    rdfs:label "InternationalFinancialReportingStandard" ;
    rdfs:comment "International Financial Reporting Standards (IFRS) referenced as the basis for consolidated financial statements." ;
    rdfs:subClassOf bpi:AccountingStandard .

bpi:InternationalSanctionsAndEmbargoDueDiligencePurpose a owl:Class ;
    rdfs:label "InternationalSanctionsAndEmbargoDueDiligencePurpose" ;
    rdfs:comment "A purpose for processing personal data to perform due diligence regarding international sanctions and embargoes." .

bpi:InvestingActivities a owl:Class ;
    rdfs:label "InvestingActivities" ;
    rdfs:comment "Cash flows related to acquisition and disposal of investments and other investment operations." ;
    rdfs:subClassOf bpi:CashFlowStatement .

bpi:InvestmentProcess a owl:Class ;
    rdfs:label "InvestmentProcess" ;
    rdfs:comment "The end-to-end workflow for integrating ESG criteria, including due diligence and monitoring phases." .

bpi:JointVenture a owl:Class ;
    rdfs:label "JointVenture" ;
    rdfs:comment "A partnership arrangement where control is contractually shared and decisions require unanimous consent." ;
    rdfs:subClassOf bpi:Company,
        bpi:Organization,
        bpi:Partnership .

bpi:KYCProcess a owl:Class ;
    rdfs:label "KYCProcess" ;
    rdfs:comment "Know Your Customer due diligence performed as part of regulatory checks." ;
    rdfs:subClassOf bpi:DueDiligenceProcess .

bpi:LegalObligationLegalBasis a owl:Class ;
    rdfs:label "LegalObligationLegalBasis" ;
    rdfs:comment "A legal basis for processing personal data based on compliance with a legal obligation." .

bpi:LegitimateInterestLegalBasis a owl:Class ;
    rdfs:label "LegitimateInterestLegalBasis" ;
    rdfs:comment "A legal basis for processing personal data based on the controller’s legitimate interests." .

bpi:LeverageRatio a owl:Class ;
    rdfs:label "LeverageRatio" ;
    rdfs:comment "A leverage ratio referenced in solvency and liquidity status." ;
    rdfs:subClassOf bpi:SolvencyAndLiquidityStatus .

bpi:LongTermInvestmentInPortfolioSecurities a owl:Class ;
    rdfs:label "LongTermInvestmentInPortfolioSecurities" ;
    rdfs:comment "Long-term investments in portfolio securities, described as non-expendable securities endowment paid by the State for the Innovation and Industry Fund." .

bpi:NegotiableDebtSecurity a owl:Class ;
    rdfs:label "NegotiableDebtSecurity" ;
    rdfs:comment "Negotiable debt securities used for short-term financing under the framework." ;
    rdfs:subClassOf bpi:FinancialInstrument .

bpi:NetCashFlowFromFinancingOperations a owl:Class ;
    rdfs:label "NetCashFlowFromFinancingOperations" ;
    rdfs:comment "Net cash flow from financing operations." ;
    rdfs:subClassOf bpi:FinancingActivities .

bpi:NetCashFlowFromInvestingActivities a owl:Class ;
    rdfs:label "NetCashFlowFromInvestingActivities" ;
    rdfs:comment "Net cash flow from investing activities." ;
    rdfs:subClassOf bpi:InvestingActivities .

bpi:NetCashFlowFromOperatingActivities a owl:Class ;
    rdfs:label "NetCashFlowFromOperatingActivities" ;
    rdfs:comment "Net cash flow from operating activities computed using the indirect method." ;
    rdfs:subClassOf bpi:OperatingActivities .

bpi:NetOperatingIncome a owl:Class ;
    rdfs:label "NetOperatingIncome" ;
    rdfs:comment "Net operating income derived from operating earnings and operating expenses." ;
    rdfs:subClassOf bpi:PublishableIncomeStatement .

bpi:PersonalDataRetention a owl:Class ;
    rdfs:label "PersonalDataRetention" ;
    rdfs:comment "Concept of storing personal data for defined periods to meet legal and processing purposes." .

bpi:Platform a owl:Class ;
    rdfs:label "Platform" ;
    rdfs:comment "An online platform used for procurement and/or user account and access management." .

bpi:ProfessionalAdvisor a owl:Class ;
    rdfs:label "ProfessionalAdvisor" ;
    rdfs:comment "An external professional (e.g., advisors, experts, law firms, investment banks) supporting processing activities." ;
    rdfs:subClassOf bpi:Organization .

bpi:ProfitOrLossForFinancialYear a owl:Class ;
    rdfs:label "ProfitOrLossForFinancialYear" ;
    rdfs:comment "Result for the financial year included in shareholders’ equity." ;
    rdfs:subClassOf bpi:ShareholdersEquity .

bpi:PublicAuthority a owl:Class ;
    rdfs:label "PublicAuthority" ;
    rdfs:comment "A governmental body or public authority that entrusts missions and steers public policies." .

bpi:PublicLimitedCompanyGroup a owl:Class ;
    rdfs:label "PublicLimitedCompanyGroup" ;
    rdfs:comment "Group structure composed of public limited companies and related entities within the Bpifrance group." ;
    rdfs:subClassOf bpi:PublicGroup .

bpi:ResponsibleInvestmentPolicy a owl:Class ;
    rdfs:label "ResponsibleInvestmentPolicy" ;
    rdfs:comment "A policy defining responsible investment approach, exclusions, ESG criteria, and compliance/commitment requirements." .

bpi:RiskFactors a owl:Class ;
    rdfs:label "RiskFactors" ;
    rdfs:comment "A section describing risk factors relevant to the issuer." .

bpi:RiskManagementOrganization a owl:Class ;
    rdfs:label "RiskManagementOrganization" ;
    rdfs:comment "The organizational setup for managing risks, including the scope of risks to which the group is exposed." .

bpi:SanctionsAndEmbargoDueDiligenceProcess a owl:Class ;
    rdfs:label "SanctionsAndEmbargoDueDiligenceProcess" ;
    rdfs:comment "Due diligence and checks related to international sanctions and embargoes." ;
    rdfs:subClassOf bpi:DueDiligenceProcess .

bpi:SecuritiesNote a owl:Class ;
    rdfs:label "SecuritiesNote" ;
    rdfs:comment "A document supplementing a universal registration document for the purposes of offering financial securities to the public or admitting them to trading." .

bpi:SecuritiesSummary a owl:Class ;
    rdfs:label "SecuritiesSummary" ;
    rdfs:comment "A summary document that may accompany a securities note and universal registration document." .

bpi:SignatureCommitment a owl:Class ;
    rdfs:label "SignatureCommitment" ;
    rdfs:comment "Commitments issued by the group under financed contracts, including sureties and first-demand guarantees." .

bpi:StateCurrentAccount a owl:Class ;
    rdfs:label "StateCurrentAccount" ;
    rdfs:comment "State current account balances with Agence France Trésor referenced in receivables and cash notes." ;
    rdfs:subClassOf bpi:OtherReceivables .

bpi:StateLoan a owl:Class ;
    rdfs:label "StateLoan" ;
    rdfs:comment "Loans from the State (excluding associated liabilities)." ;
    rdfs:subClassOf bpi:Loan .

bpi:StateShareholdingEntity a owl:Class ;
    rdfs:label "StateShareholdingEntity" ;
    rdfs:comment "An entity representing the French State’s shareholding and governance role in companies (e.g., shareholding agency context)." .

bpi:StatutoryAuditorsReport a owl:Class ;
    rdfs:label "StatutoryAuditorsReport" ;
    rdfs:comment "A report issued by statutory auditors on the limited review of the interim consolidated financial statements." ;
    rdfs:subClassOf bpi:FinancialStatement .

bpi:TaxReceivable a owl:Class ;
    rdfs:label "TaxReceivable" ;
    rdfs:comment "Receivables for taxes." ;
    rdfs:subClassOf bpi:OtherReceivable .

bpi:TechnologyTransferProgramme a owl:Class ;
    rdfs:label "TechnologyTransferProgramme" ;
    rdfs:comment "A programme area supporting technology transfer and related initiatives (e.g., technology transfer and transfer of businesses)." .

bpi:TradePayablesAndRelatedAccounts a owl:Class ;
    rdfs:label "TradePayablesAndRelatedAccounts" ;
    rdfs:comment "Trade payables and related accounts." ;
    rdfs:subClassOf bpi:OperatingDebts .

bpi:TradeReceivable a owl:Class ;
    rdfs:label "TradeReceivable" ;
    rdfs:comment "Receivables arising from trade and other receivable categories, including grants and guarantee commissions to be received." ;
    rdfs:subClassOf bpi:FinancialAsset .

bpi:Bpifrance a owl:Class ;
    rdfs:label "Bpifrance" ;
    rdfs:comment "The main public entity acting as a credit institution and holding company for the group’s missions." ;
    rdfs:subClassOf bpi:BpifranceGroup,
        bpi:PublicLimitedCompany .

bpi:BusinessLoginData a owl:Class ;
    rdfs:label "BusinessLoginData" ;
    rdfs:comment "Personal data used for portal access and authentication (e.g., IP address, tokens, signature certificate)." ;
    rdfs:subClassOf bpi:PersonalDataCategory .

bpi:CET1Ratio a owl:Class ;
    rdfs:label "CET1Ratio" ;
    rdfs:comment "Core Equity Tier 1 ratio comparing core equity capital to risk-weighted assets." ;
    rdfs:subClassOf bpi:Solvency,
        bpi:SolvencyAndLiquidityStatus .

bpi:CashAndCashEquivalent a owl:Class ;
    rdfs:label "CashAndCashEquivalent" ;
    rdfs:comment "Cash and cash equivalents, including bank accounts and current accounts." .

bpi:CollectionActions a owl:Class ;
    rdfs:label "CollectionActions" ;
    rdfs:comment "A group of processing purposes related to collecting personal data for compliance and due diligence." .

bpi:CommercialProspectingPurpose a owl:Class ;
    rdfs:label "CommercialProspectingPurpose" ;
    rdfs:comment "A purpose for processing personal data for commercial prospecting and newsletters." .

bpi:CommitmentsGiven a owl:Class ;
    rdfs:label "CommitmentsGiven" ;
    rdfs:comment "Off-balance-sheet commitments given by the entity." ;
    rdfs:subClassOf bpi:OffBalanceSheetCommitments .

bpi:ConsolidationPrinciple a owl:Class ;
    rdfs:label "ConsolidationPrinciple" ;
    rdfs:comment "A rule describing how entities are included in consolidation based on control, joint control, or significant influence." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements .

bpi:Contract a owl:Class ;
    rdfs:label "Contract" ;
    rdfs:comment "A legal agreement whose lifecycle drives parts of personal data processing (pre-contractual, execution, management, termination)." .

bpi:DebtSecurity a owl:Class ;
    rdfs:label "DebtSecurity" ;
    rdfs:comment "A general category of debt instruments/securities issued under financing programmes." ;
    rdfs:subClassOf bpi:FinancialInstrument .

bpi:ESGCriteria a owl:Class ;
    rdfs:label "ESGCriteria" ;
    rdfs:comment "Environmental, social, and governance criteria used for analysis, exclusion, integration, and monitoring." .

bpi:ESGWorkforce a owl:Class ;
    rdfs:label "ESGWorkforce" ;
    rdfs:comment "The broader workforce involved in ESG activities, including correspondents and coordination teams." .

bpi:EconomicAndFinancialData a owl:Class ;
    rdfs:label "EconomicAndFinancialData" ;
    rdfs:comment "Personal data related to economic and financial status (e.g., bank details, tax situation, identifiers)." ;
    rdfs:subClassOf bpi:PersonalDataCategory .

bpi:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "General concept of an organization or borrower entity referenced by eligibility definitions." .

bpi:EquityInvestment a owl:Class ;
    rdfs:label "EquityInvestment" ;
    rdfs:comment "An investment in equity instruments, including those measured at fair value through equity or through profit or loss." ;
    rdfs:subClassOf bpi:FinancialAsset,
        bpi:Investment,
        bpi:InvestmentBusinessLine .

bpi:ExpectedCreditLossCalculation a owl:Class ;
    rdfs:label "ExpectedCreditLossCalculation" ;
    rdfs:comment "Method for calculating expected credit losses (ECL) used to assess credit risk." .

bpi:ExpectedRisks a owl:Class ;
    rdfs:label "ExpectedRisks" ;
    rdfs:comment "Cost of risk component related to expected cost of risk and provisions." ;
    rdfs:subClassOf bpi:CostOfRisk .

bpi:ExpenseRatio a owl:Class ;
    rdfs:label "ExpenseRatio" ;
    rdfs:comment "Ratio comparing operating expenditure to assets under management for the investment business." .

bpi:ExportInsurance a owl:Class ;
    rdfs:label "ExportInsurance" ;
    rdfs:comment "A function providing and managing public export guarantees for exporters." ;
    rdfs:subClassOf bpi:BusinessLine,
        bpi:ExportDepartment .

bpi:FairValue a owl:Class ;
    rdfs:label "FairValue" ;
    rdfs:comment "The measurement concept of fair value used for financial assets and liabilities, including exit price basis." .

bpi:FairValueLevel3 a owl:Class ;
    rdfs:label "FairValueLevel3" ;
    rdfs:comment "Fair value determined using unobservable market data and valuation models with unobservable parameters." ;
    rdfs:subClassOf bpi:FairValueHierarchyLevel .

bpi:FinancialExpenses a owl:Class ;
    rdfs:label "FinancialExpenses" ;
    rdfs:comment "Expenses from financial activities such as interest and similar charges." ;
    rdfs:subClassOf bpi:IncomeStatement,
        bpi:PublishableIncomeStatement .

bpi:FinancialResult a owl:Class ;
    rdfs:label "FinancialResult" ;
    rdfs:comment "Net financial result after financial income and financial expenses." ;
    rdfs:subClassOf bpi:PublishableIncomeStatement .

bpi:FinancialStatementNote a owl:Class ;
    rdfs:label "FinancialStatementNote" ;
    rdfs:comment "A structured section of notes accompanying the financial statements (e.g., significant events, accounting standards, balance sheet items, income statement items)." ;
    rdfs:subClassOf bpi:AnnualReport .

bpi:FinancingCommitments a owl:Class ;
    rdfs:label "FinancingCommitments" ;
    rdfs:comment "Financing commitments given or received." ;
    rdfs:subClassOf bpi:CommitmentsGiven,
        bpi:OffBalanceSheetCommitments .

bpi:FinancingMechanism a owl:Class ;
    rdfs:label "FinancingMechanism" ;
    rdfs:comment "A structured program or mechanism through which financing/support is provided and administered." .

bpi:Goodwill a owl:Class ;
    rdfs:label "Goodwill" ;
    rdfs:comment "Intangible asset arising from acquisition accounting when acquisition cost exceeds the acquired share of net assets revalued." .

bpi:GuaranteeFund a owl:Class ;
    rdfs:label "GuaranteeFund" ;
    rdfs:comment "A fund related to guarantee activities referenced in the context of guarantee funds and ECL adjustments." ;
    rdfs:subClassOf bpi:InvestmentFund,
        bpi:OtherFinancialAssets,
        bpi:PublicFundingInstrument,
        bpi:ReserveFund .

bpi:InterimFinancialStatement a owl:Class ;
    rdfs:label "InterimFinancialStatement" ;
    rdfs:comment "A financial statement for an interim period (e.g., condensed half-year consolidated financial statements)." ;
    rdfs:subClassOf bpi:FinancialStatement .

bpi:InternationalBusiness a owl:Class ;
    rdfs:label "InternationalBusiness" ;
    rdfs:comment "Business activity related to international operations and export guarantees." .

bpi:InvestingInTheFutureProgramme a owl:Class ;
    rdfs:label "InvestingInTheFutureProgramme" ;
    rdfs:comment "The Investing in the Future Programme (PIA) referenced as a major source of endowments and initiatives." ;
    rdfs:subClassOf bpi:FinancialProgramme,
        bpi:InvestmentProgramme .

bpi:InvestmentFund a owl:Class ;
    rdfs:label "InvestmentFund" ;
    rdfs:comment "A fund vehicle referenced as being subscribed to and managed within the Bpifrance group (e.g., FNA 3)." ;
    rdfs:subClassOf bpi:ConsolidatedFund,
        bpi:FinancialProgramme,
        bpi:Organization .

bpi:MarketPriceRisk a owl:Class ;
    rdfs:label "MarketPriceRisk" ;
    rdfs:comment "Risk of loss due to changes in market prices and rates." ;
    rdfs:subClassOf bpi:FinancialRisk .

bpi:MarketRisk a owl:Class ;
    rdfs:label "MarketRisk" ;
    rdfs:comment "Risk of losses due to changing prices for market products, volatility, and correlations." ;
    rdfs:subClassOf bpi:FinancialRisk,
        bpi:RiskExposure,
        bpi:RiskManagement .

bpi:MiscellaneousDebts a owl:Class ;
    rdfs:label "MiscellaneousDebts" ;
    rdfs:comment "Miscellaneous debts category, including debts on fixed assets and related accounts." ;
    rdfs:subClassOf bpi:Liabilities,
        bpi:OperatingDebts .

bpi:OperatingActivities a owl:Class ;
    rdfs:label "OperatingActivities" ;
    rdfs:comment "Cash flows generated by the business’s revenue-generating activities." ;
    rdfs:subClassOf bpi:CashFlowStatement .

bpi:OperatingRatio a owl:Class ;
    rdfs:label "OperatingRatio" ;
    rdfs:comment "Ratio comparing operating expenditure to net banking income for the banking business line." .

bpi:OperationalAndNonComplianceRisk a owl:Class ;
    rdfs:label "OperationalAndNonComplianceRisk" ;
    rdfs:comment "Risk of loss from inadequate internal processes or external events, including non-compliance and model risk." ;
    rdfs:subClassOf bpi:Risk .

bpi:PersonalDataCollection a owl:Class ;
    rdfs:label "PersonalDataCollection" ;
    rdfs:comment "Collection of personal data directly from the data subject or indirectly from third parties/sources." ;
    rdfs:subClassOf bpi:DataProcessingActivity .

bpi:PersonalDataRequest a owl:Class ;
    rdfs:label "PersonalDataRequest" ;
    rdfs:comment "A request to exercise rights from data subjects, including management of access/right-of-exercise handling." ;
    rdfs:subClassOf bpi:DataProcessingActivity .

bpi:ProvenRisks a owl:Class ;
    rdfs:label "ProvenRisks" ;
    rdfs:comment "Cost of risk component reflecting normalization after prior low-risk periods." ;
    rdfs:subClassOf bpi:CostOfRisk .

bpi:PublicResources a owl:Class ;
    rdfs:label "PublicResources" ;
    rdfs:comment "Public resources and intervention resources presented as other financial liabilities." .

bpi:RegulatoryDatabase a owl:Class ;
    rdfs:label "RegulatoryDatabase" ;
    rdfs:comment "A database managed by authorities or supervisory bodies used for indirect collection." ;
    rdfs:subClassOf bpi:DatabaseProvider .

bpi:RelatedParty a owl:Class ;
    rdfs:label "RelatedParty" ;
    rdfs:comment "An entity related to the group for which transactions and balances are disclosed (e.g., entities included in the consolidation scope)." .

bpi:ReserveFund a owl:Class ;
    rdfs:label "ReserveFund" ;
    rdfs:comment "Reserve fund referenced as part of accounting for interest capitalised in reserves." ;
    rdfs:subClassOf bpi:GuaranteeFund,
        bpi:OtherFinancialAsset,
        bpi:OtherFinancialAssets .

bpi:RiskManagementPolicy a owl:Class ;
    rdfs:label "RiskManagementPolicy" ;
    rdfs:comment "A policy defining how risks such as liquidity risk are managed and monitored at group level." .

bpi:RiskManagementSystem a owl:Class ;
    rdfs:label "RiskManagementSystem" ;
    rdfs:comment "A system for integrating climate and ESG risks into risk management and reporting." .

bpi:RiskManagementTool a owl:Class ;
    rdfs:label "RiskManagementTool" ;
    rdfs:comment "A tool used to map and summarise risks by potential impact and probability, incorporating control measures." .

bpi:SecuritiesCommitments a owl:Class ;
    rdfs:label "SecuritiesCommitments" ;
    rdfs:comment "Securities-related commitments such as buyback/takeback options." ;
    rdfs:subClassOf bpi:CommitmentsGiven,
        bpi:OffBalanceSheetCommitments .

bpi:SeedFund a owl:Class ;
    rdfs:label "SeedFund" ;
    rdfs:comment "A fund category focused on seed-stage investments." ;
    rdfs:subClassOf bpi:Fund .

bpi:SharePriceRisk a owl:Class ;
    rdfs:label "SharePriceRisk" ;
    rdfs:comment "Risk arising from equity investments and sensitivity of net asset value to benchmark index changes." ;
    rdfs:subClassOf bpi:MarketPriceRisk,
        bpi:MarketRisk .

bpi:ShareholdersEquityStatement a owl:Class ;
    rdfs:label "ShareholdersEquityStatement" ;
    rdfs:comment "A statement/table describing changes in shareholders’ equity over a period." ;
    rdfs:subClassOf bpi:FinancialStatement .

bpi:SolvencyAndLiquidityStatus a owl:Class ;
    rdfs:label "SolvencyAndLiquidityStatus" ;
    rdfs:comment "A status assessment covering solvency and liquidity ratios." .

bpi:TaxAndSocialSecurityDebt a owl:Class ;
    rdfs:label "TaxAndSocialSecurityDebt" ;
    rdfs:comment "A specific category of liabilities for taxes and social security obligations." ;
    rdfs:subClassOf bpi:Debt,
        bpi:TradePayable .

bpi:TaxUncertainty a owl:Class ;
    rdfs:label "TaxUncertainty" ;
    rdfs:comment "Uncertainty about whether a tax position will be accepted by tax authorities and its reflection in financial statements." ;
    rdfs:subClassOf bpi:DeferredTax .

bpi:TradeDebt a owl:Class ;
    rdfs:label "TradeDebt" ;
    rdfs:comment "Trade debts and related accounts with maturity less than one year." ;
    rdfs:subClassOf bpi:Debt .

bpi:TradePayable a owl:Class ;
    rdfs:label "TradePayable" ;
    rdfs:comment "Payables arising from trade and other liabilities, including deferred income and tax/social security debts." ;
    rdfs:subClassOf bpi:FinancialLiability .

bpi:TransactionDerivative a owl:Class ;
    rdfs:label "TransactionDerivative" ;
    rdfs:comment "A derivative arising from transactions, referenced under fair value through profit or loss." ;
    rdfs:subClassOf bpi:FinancialInstrument,
        bpi:HedgingDerivative .

bpi:UnsecuredLoan a owl:Class ;
    rdfs:label "UnsecuredLoan" ;
    rdfs:comment "Loans provided without guarantee or security against the company or its managers." ;
    rdfs:subClassOf bpi:Loan .

bpi:WarInUkraine a owl:Class ;
    rdfs:label "WarInUkraine" ;
    rdfs:comment "The war in Ukraine described as a significant event affecting markets and the economy." ;
    rdfs:subClassOf bpi:SignificantEvent .

bpi:AccountingPrinciplesAndMethods a owl:Class ;
    rdfs:label "AccountingPrinciplesAndMethods" ;
    rdfs:comment "Disclosures describing the accounting principles, valuation methods, and regulatory framework used to prepare the statements." ;
    rdfs:subClassOf bpi:NotesToFinancialStatements .

bpi:AdvisoryCommittee a owl:Class ;
    rdfs:label "AdvisoryCommittee" ;
    rdfs:comment "Advisory governance committee set up for specific themes such as financing/guarantees, innovation, and climate." ;
    rdfs:subClassOf bpi:GovernanceBody .

bpi:AnnualReport a owl:Class ;
    rdfs:label "AnnualReport" ;
    rdfs:comment "A published report covering a specific financial year, including consolidated and separate financial statements and related notes." .

bpi:BpifranceGroupEntity a owl:Class ;
    rdfs:label "BpifranceGroupEntity" ;
    rdfs:comment "An entity within the Bpifrance group that may receive personal data for commercial prospecting or legal/regulatory obligations." .

bpi:BusinessLine a owl:Class ;
    rdfs:label "BusinessLine" ;
    rdfs:comment "A segment of activities within the group, such as financing, investment, or other lines." ;
    rdfs:subClassOf bpi:OrganizationalChartOfBusinessLines .

bpi:ConsolidatedFinancialStatement a owl:Class ;
    rdfs:label "ConsolidatedFinancialStatement" ;
    rdfs:comment "A financial statement that aggregates the financial position and performance of a group of companies." ;
    rdfs:subClassOf bpi:FinancialStatement .

bpi:ElectronicSignatureProcess a owl:Class ;
    rdfs:label "ElectronicSignatureProcess" ;
    rdfs:comment "The advanced electronic signature process and related management of electronic signature evidence." .

bpi:Equity a owl:Class ;
    rdfs:label "Equity" ;
    rdfs:comment "Shareholders’ equity, including components such as reserves and gains/losses recognized directly in equity." ;
    rdfs:subClassOf bpi:FinancialAsset .

bpi:EquityMethod a owl:Class ;
    rdfs:label "EquityMethod" ;
    rdfs:comment "A method that replaces the investment’s carrying amount with the investor’s share of investee equity and recognizes the investor’s share of profit or loss." ;
    rdfs:subClassOf bpi:ConsolidationMethod .

bpi:EuropeanGeneralDataProtectionRegulation a owl:Class ;
    rdfs:label "EuropeanGeneralDataProtectionRegulation" ;
    rdfs:comment "The GDPR legal framework governing personal data protection in the European context." .

bpi:ExternalAuditors a owl:Class ;
    rdfs:label "ExternalAuditors" ;
    rdfs:comment "Independent auditors certifying financial accounts." .

bpi:FairValueMeasurement a owl:Class ;
    rdfs:label "FairValueMeasurement" ;
    rdfs:comment "Fair value measurement framework referenced for transfers between fair value levels and sensitivity." .

bpi:FinancialDebts a owl:Class ;
    rdfs:label "FinancialDebts" ;
    rdfs:comment "Debts issued by the group, including financial debts to credit institutions and miscellaneous financial debts." ;
    rdfs:subClassOf bpi:FinancialLiability,
        bpi:Liabilities .

bpi:FinancialLoansAndFinancialDebts a owl:Class ;
    rdfs:label "FinancialLoansAndFinancialDebts" ;
    rdfs:comment "Subcategory covering financial loans and related financial debts." ;
    rdfs:subClassOf bpi:FinancialDebts .

bpi:FinancingAgreement a owl:Class ;
    rdfs:label "FinancingAgreement" ;
    rdfs:comment "An agreement framework concluded with the State and other public actors for implementing programmes and financing mechanisms." .

bpi:FraudProtectionPurpose a owl:Class ;
    rdfs:label "FraudProtectionPurpose" ;
    rdfs:comment "A purpose for processing personal data to protect against fraud and provide evidence in litigation." .

bpi:GeneralMeeting a owl:Class ;
    rdfs:label "GeneralMeeting" ;
    rdfs:comment "A shareholder meeting (ordinary or extraordinary) that approves reports, financial statements, and resolutions." .

bpi:GrossOperatingIncome a owl:Class ;
    rdfs:label "GrossOperatingIncome" ;
    rdfs:comment "Income before cost of risk and other operating items." ;
    rdfs:subClassOf bpi:FinancialResults .

bpi:GuaranteeCommission a owl:Class ;
    rdfs:label "GuaranteeCommission" ;
    rdfs:comment "Guarantee commissions, including commissions to be spread and guarantee commissions for issues." .

bpi:Guarantees a owl:Class ;
    rdfs:label "Guarantees" ;
    rdfs:comment "A risk-mitigation product category used to support businesses." .

bpi:IFRSStandard a owl:Class ;
    rdfs:label "IFRSStandard" ;
    rdfs:comment "International Financial Reporting Standards referenced as applied in the preparation of statements." ;
    rdfs:subClassOf bpi:AccountingStandard .

bpi:InnovationFinancingAid a owl:Class ;
    rdfs:label "InnovationFinancingAid" ;
    rdfs:comment "Aid provided for innovation financing activities, accounted for as part of financing operations." .

bpi:InterestAndSimilarExpense a owl:Class ;
    rdfs:label "InterestAndSimilarExpense" ;
    rdfs:comment "Interest and similar expenses." .

bpi:InterestAndSimilarIncome a owl:Class ;
    rdfs:label "InterestAndSimilarIncome" ;
    rdfs:comment "Interest and similar income line item." ;
    rdfs:subClassOf bpi:FinancialIncome .

bpi:InternationalBusinessLine a owl:Class ;
    rdfs:label "InternationalBusinessLine" ;
    rdfs:comment "A business line supporting internationalisation and export-related financing and insurance activities." .

bpi:InternationalDataTransfer a owl:Class ;
    rdfs:label "InternationalDataTransfer" ;
    rdfs:comment "Transfer of personal data outside the European Union under GDPR adequacy decisions or derogations/appropriate safeguards." ;
    rdfs:subClassOf bpi:PersonalDataDisclosure .

bpi:LiquidityCoverageRatio a owl:Class ;
    rdfs:label "LiquidityCoverageRatio" ;
    rdfs:comment "Liquidity Coverage Ratio comparing high-quality liquid assets to net total cash outflow." ;
    rdfs:subClassOf bpi:LiquidityPosition .

bpi:NonPerformanceRisk a owl:Class ;
    rdfs:label "NonPerformanceRisk" ;
    rdfs:comment "Risk associated with non-performance of assets, including credit risk, concentration risk, systemic risk, and counterparty risk on financial assets." ;
    rdfs:subClassOf bpi:RiskFactor .

bpi:OperatingExpenses a owl:Class ;
    rdfs:label "OperatingExpenses" ;
    rdfs:comment "Operating expenses line item in the income statement." ;
    rdfs:subClassOf bpi:IncomeStatement,
        bpi:PublishableIncomeStatement .

bpi:OtherFinancialAsset a owl:Class ;
    rdfs:label "OtherFinancialAsset" ;
    rdfs:comment "A category of financial assets including loans, grants receivables, and reserve fund-related receivables." ;
    rdfs:subClassOf bpi:FinancialAsset .

bpi:OtherReceivable a owl:Class ;
    rdfs:label "OtherReceivable" ;
    rdfs:comment "Receivables other than those explicitly classified as loans or cash equivalents." .

bpi:PersonalDataProtectionPolicy a owl:Class ;
    rdfs:label "PersonalDataProtectionPolicy" ;
    rdfs:comment "A policy document describing how personal data is processed, for what purposes, and the rights of individuals." ;
    rdfs:subClassOf bpi:PolicyDocument .

bpi:PolicyDocument a owl:Class ;
    rdfs:label "PolicyDocument" ;
    rdfs:comment "A document setting rules for processing personal data under applicable regulations (e.g., GDPR policy)." .

bpi:ProfessionalLifeData a owl:Class ;
    rdfs:label "ProfessionalLifeData" ;
    rdfs:comment "Personal data related to professional life (e.g., professional contact details, position, curriculum vitae)." ;
    rdfs:subClassOf bpi:PersonalData,
        bpi:PersonalDataCategory .

bpi:RelatedPartyTransaction a owl:Class ;
    rdfs:label "RelatedPartyTransaction" ;
    rdfs:comment "Transactions with related parties disclosed in notes to the financial statements." .

bpi:Resolution a owl:Class ;
    rdfs:label "Resolution" ;
    rdfs:comment "A formal decision submitted to and adopted by a general meeting." .

bpi:Securities a owl:Class ;
    rdfs:label "Securities" ;
    rdfs:comment "Debt or equity securities referenced in fair value and amortised cost measurement categories." ;
    rdfs:subClassOf bpi:FinancialInstrument .

bpi:SignificantEvent a owl:Class ;
    rdfs:label "SignificantEvent" ;
    rdfs:comment "An event during the period considered significant for the financial statements." .

bpi:StatutoryAuditors a owl:Class ;
    rdfs:label "StatutoryAuditors" ;
    rdfs:comment "Auditors responsible for auditing consolidated and annual financial statements." .

bpi:TrustedServiceProvider a owl:Class ;
    rdfs:label "TrustedServiceProvider" ;
    rdfs:comment "A provider trusted to implement electronic signature services used in the advanced electronic signature process." .

bpi:ActivitiesOnBehalfOfThirdParties a owl:Class ;
    rdfs:label "ActivitiesOnBehalfOfThirdParties" ;
    rdfs:comment "Operations managed on behalf of third parties (e.g., the State) not appearing on the balance sheet of the public company." ;
    rdfs:subClassOf bpi:NotesToFinancialStatements .

bpi:Agreement a owl:Class ;
    rdfs:label "Agreement" ;
    rdfs:comment "Inter-institutional agreements used to implement missions and programmes (e.g., PIA, aid schemes, deployment agreements)." .

bpi:CashFlowStatement a owl:Class ;
    rdfs:label "CashFlowStatement" ;
    rdfs:comment "A financial statement detailing cash flows and their components such as operating, investing, financing, and exchange-rate impacts." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatement .

bpi:ClimateRisk a owl:Class ;
    rdfs:label "ClimateRisk" ;
    rdfs:comment "Risk arising from climate-related factors and constraints affecting borrowers and credit quality." ;
    rdfs:subClassOf bpi:ESGRisk,
        bpi:EcosystemRelatedRisk,
        bpi:FinancialRisk .

bpi:Debt a owl:Class ;
    rdfs:label "Debt" ;
    rdfs:comment "General concept of a debt obligation with a remaining term (e.g., less than 1 year, 1–5 years, more than 5 years)." ;
    rdfs:subClassOf bpi:FinancialAsset,
        bpi:FinancialLiability .

bpi:Director a owl:Class ;
    rdfs:label "Director" ;
    rdfs:comment "Member roles serving on the board of directors, including directors representing the State." ;
    rdfs:subClassOf bpi:BoardOfDirectors .

bpi:DividendDistribution a owl:Class ;
    rdfs:label "DividendDistribution" ;
    rdfs:comment "Distribution of dividends referenced in equity changes and dividend paid." .

bpi:EquityConsolidatedCompanies a owl:Class ;
    rdfs:label "EquityConsolidatedCompanies" ;
    rdfs:comment "Companies accounted for using the equity method due to joint control or significant influence." .

bpi:EquityInvestmentActivity a owl:Class ;
    rdfs:label "EquityInvestmentActivity" ;
    rdfs:comment "An activity involving equity investments, including direct investments and fund-based investments." .

bpi:EquityMethodCompany a owl:Class ;
    rdfs:label "EquityMethodCompany" ;
    rdfs:comment "A company accounted for using the equity method, referenced for share of gains and losses in equity." .

bpi:ExportDepartment a owl:Class ;
    rdfs:label "ExportDepartment" ;
    rdfs:comment "A department structured around export insurance, export financing and international development." ;
    rdfs:subClassOf bpi:BpifranceGroup,
        bpi:InternationalBusinessLine .

bpi:FinancialIncome a owl:Class ;
    rdfs:label "FinancialIncome" ;
    rdfs:comment "Income from financial activities such as dividends and interest." ;
    rdfs:subClassOf bpi:IncomeStatement,
        bpi:PublishableIncomeStatement .

bpi:FinancialProgramme a owl:Class ;
    rdfs:label "FinancialProgramme" ;
    rdfs:comment "A structured public financing programme such as PIA, France 2030, and Investing in the Future." .

bpi:FinancingActivity a owl:Class ;
    rdfs:label "FinancingActivity" ;
    rdfs:comment "A category of financing operations in which personal data is processed (e.g., innovation funding, treasury financing, asset/intangible financing, energy/environment projects)." .

bpi:HedgingDerivative a owl:Class ;
    rdfs:label "HedgingDerivative" ;
    rdfs:comment "A derivative instrument used for hedging and referenced in fair value and revaluation differences on rate-hedged portfolios." ;
    rdfs:subClassOf bpi:FinancialInstrument,
        bpi:FinancialLiability .

bpi:PersonalDataDisclosure a owl:Class ;
    rdfs:label "PersonalDataDisclosure" ;
    rdfs:comment "Disclosure/transfer of personal data to internal group entities and, where applicable, outside the European Union." ;
    rdfs:subClassOf bpi:DataProcessingActivity .

bpi:PressRelease a owl:Class ;
    rdfs:label "PressRelease" ;
    rdfs:comment "A document publishing results and activities for a given period, including financial information and notices." .

bpi:PublicFundingInstrument a owl:Class ;
    rdfs:label "PublicFundingInstrument" ;
    rdfs:comment "An instrument/programme through which public authorities provide funding and support." .

bpi:SecuritiesCommitment a owl:Class ;
    rdfs:label "SecuritiesCommitment" ;
    rdfs:comment "Securities-related commitments given or received, including buyback/takeback options and other commitments." ;
    rdfs:subClassOf bpi:FinancialInstrument,
        bpi:OffBalanceSheetCommitment,
        bpi:OffBalanceSheetCommitments .

bpi:SupervisoryAuthority a owl:Class ;
    rdfs:label "SupervisoryAuthority" ;
    rdfs:comment "A supervisory authority that may receive personal data and/or complaints (e.g., data protection regulators)." .

bpi:TaxAndSocialSecurityDebts a owl:Class ;
    rdfs:label "TaxAndSocialSecurityDebts" ;
    rdfs:comment "Debts related to taxes and social security contributions." ;
    rdfs:subClassOf bpi:OperatingDebts .

bpi:UnrealisedForeignExchangeGain a owl:Class ;
    rdfs:label "UnrealisedForeignExchangeGain" ;
    rdfs:comment "Unrealised foreign exchange gains reported for the period." .

bpi:ApplicableRegulation a owl:Class ;
    rdfs:label "ApplicableRegulation" ;
    rdfs:comment "The set of applicable regulations referenced for processing personal data, including GDPR and national provisions." .

bpi:BusinessSupportBusinessLine a owl:Class ;
    rdfs:label "BusinessSupportBusinessLine" ;
    rdfs:comment "A business line providing advice, training, networking and support services for business growth." ;
    rdfs:subClassOf bpi:BpifranceGroup .

bpi:CompetentAuthority a owl:Class ;
    rdfs:label "CompetentAuthority" ;
    rdfs:comment "A regulatory body competent to approve or receive filings under applicable securities regulations." .

bpi:DataProcessingActivity a owl:Class ;
    rdfs:label "DataProcessingActivity" ;
    rdfs:comment "An activity involving collection, processing, retention, disclosure, and management of personal data." .

bpi:DeferredIncome a owl:Class ;
    rdfs:label "DeferredIncome" ;
    rdfs:comment "Income recognized over time (e.g., deferred income such as guarantee commissions to be spread)." ;
    rdfs:subClassOf bpi:FinancialLiability,
        bpi:Liabilities .

bpi:DueDiligenceProcess a owl:Class ;
    rdfs:label "DueDiligenceProcess" ;
    rdfs:comment "A compliance and assessment process performed for transactions and funds (e.g., legal, financial, tax, strategic, ESG, KYC)." .

bpi:EquityMethodInvestments a owl:Class ;
    rdfs:label "EquityMethodInvestments" ;
    rdfs:comment "Investments accounted for using the equity method within consolidation." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements .

bpi:FinancialAssets a owl:Class ;
    rdfs:label "FinancialAssets" ;
    rdfs:comment "Assets classified as financial assets, including equity investments, portfolio securities, and loans." ;
    rdfs:subClassOf bpi:BalanceSheet .

bpi:FinancingBusinessLine a owl:Class ;
    rdfs:label "FinancingBusinessLine" ;
    rdfs:comment "A business line providing financing to companies, including loans, leasing, and working capital support." ;
    rdfs:subClassOf bpi:BpifranceGroup .

bpi:ImpairmentTest a owl:Class ;
    rdfs:label "ImpairmentTest" ;
    rdfs:comment "A process for testing investments (including goodwill) for impairment when objective evidence exists." .

bpi:InnovationAndIndustryFund a owl:Class ;
    rdfs:label "InnovationAndIndustryFund" ;
    rdfs:comment "Innovation and Industry Fund (FII) whose assets are carried on EPIC Bpifrance’s balance sheet and whose programmes are managed." ;
    rdfs:subClassOf bpi:FinancialProgramme,
        bpi:Fund,
        bpi:OtherReceivables,
        bpi:PublicFundingInstrument .

bpi:Liabilities a owl:Class ;
    rdfs:label "Liabilities" ;
    rdfs:comment "The liabilities section of financial statements, including total liabilities and their breakdown." ;
    rdfs:subClassOf bpi:BalanceSheet,
        bpi:FinancialStatements .

bpi:OrganizationalChart a owl:Class ;
    rdfs:label "OrganizationalChart" ;
    rdfs:comment "An organizational chart describing organizational structure." .

bpi:OrganizationalChartOfBusinessLines a owl:Class ;
    rdfs:label "OrganizationalChartOfBusinessLines" ;
    rdfs:comment "Organizational chart describing business lines and related directorates." ;
    rdfs:subClassOf bpi:OrganizationalChart .

bpi:PublicLimitedCompanySubsidiary a owl:Class ;
    rdfs:label "PublicLimitedCompanySubsidiary" ;
    rdfs:comment "Subsidiaries of the public limited company referenced in the historical development and organisational chart." ;
    rdfs:subClassOf bpi:PublicLimitedCompanyGroup .

bpi:ROE a owl:Class ;
    rdfs:label "ROE" ;
    rdfs:comment "Return on equity metric evaluated using net income and shareholder’s equity." .

bpi:RiskFactor a owl:Class ;
    rdfs:label "RiskFactor" ;
    rdfs:comment "A category of risks disclosed in the risk factors section of the universal registration document." .

bpi:RiskManagement a owl:Class ;
    rdfs:label "RiskManagement" ;
    rdfs:comment "The organization and measurement of risk management processes and indicators." .

bpi:BondIssueProgramme a owl:Class ;
    rdfs:label "BondIssueProgramme" ;
    rdfs:comment "A programme framework for issuing debt securities (e.g., EMTN/NEU MTN/CP programmes)." .

bpi:ConsolidationMethod a owl:Class ;
    rdfs:label "ConsolidationMethod" ;
    rdfs:comment "The accounting approach used to consolidate entities depending on the nature of control (full consolidation vs equity method)." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements .

bpi:ConsolidationScope a owl:Class ;
    rdfs:label "ConsolidationScope" ;
    rdfs:comment "Disclosures describing which entities are included in the consolidated financial statements and the consolidation methods used." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements,
        bpi:NotesToFinancialStatements .

bpi:CreditRisk a owl:Class ;
    rdfs:label "CreditRisk" ;
    rdfs:comment "Risk resulting from default of a counterparty or counterparties considered as a single beneficiary group." ;
    rdfs:subClassOf bpi:FinancialRisk,
        bpi:NonPerformanceRisk,
        bpi:Risk,
        bpi:RiskExposure,
        bpi:RiskManagement .

bpi:DividendDistributionPolicy a owl:Class ;
    rdfs:label "DividendDistributionPolicy" ;
    rdfs:comment "The policy and decisions regarding distribution of dividends and advance payments." .

bpi:DueDiligence a owl:Class ;
    rdfs:label "DueDiligence" ;
    rdfs:comment "A compliance process including checks related to international sanctions, embargoes, and other regulatory requirements." .

bpi:FairValueHierarchy a owl:Class ;
    rdfs:label "FairValueHierarchy" ;
    rdfs:comment "The classification of fair value inputs into levels based on quoted prices, observable inputs, or unobservable inputs." ;
    rdfs:subClassOf bpi:FairValueMeasurement .

bpi:GeneralManagement a owl:Class ;
    rdfs:label "GeneralManagement" ;
    rdfs:comment "Executive management of EPIC Bpifrance, including the CEO and general management functions." .

bpi:InterestIncome a owl:Class ;
    rdfs:label "InterestIncome" ;
    rdfs:comment "Interest and similar income, including loan interest and guarantee commissions." .

bpi:NetInterestMargin a owl:Class ;
    rdfs:label "NetInterestMargin" ;
    rdfs:comment "Component of net banking income representing net interest margin." ;
    rdfs:subClassOf bpi:NetBankingIncome .

bpi:OffBalanceSheetCommitmentsGiven a owl:Class ;
    rdfs:label "OffBalanceSheetCommitmentsGiven" ;
    rdfs:comment "A grouping of commitments given (financing, guarantee, and securities commitments)." ;
    rdfs:subClassOf bpi:OffBalanceSheetCommitment .

bpi:OffBalanceSheetCommitmentsReceived a owl:Class ;
    rdfs:label "OffBalanceSheetCommitmentsReceived" ;
    rdfs:comment "A grouping of commitments received (financing, guarantee, and securities commitments)." ;
    rdfs:subClassOf bpi:OffBalanceSheetCommitment .

bpi:OperatingExpenditure a owl:Class ;
    rdfs:label "OperatingExpenditure" ;
    rdfs:comment "Expenditure figure used to compute operating performance ratios." ;
    rdfs:subClassOf bpi:FinancialResults .

bpi:OperationalRisk a owl:Class ;
    rdfs:label "OperationalRisk" ;
    rdfs:comment "Risk categories related to operational activities, including cyberattacks, fraud, non-compliance, pandemic impacts, and damage to physical assets or information systems." ;
    rdfs:subClassOf bpi:FinancialRisk,
        bpi:Risk,
        bpi:RiskFactor .

bpi:PersonalDataCategory a owl:Class ;
    rdfs:label "PersonalDataCategory" ;
    rdfs:comment "A category of personal data collected and processed (e.g., identification, administrative, professional, business login, economic and financial)." .

bpi:PublicInvestmentBank a owl:Class ;
    rdfs:label "PublicInvestmentBank" ;
    rdfs:comment "Public investment bank concept referenced as the Banque publique d'investissement (Bpifrance’s role and mission)." .

bpi:Subsidiary a owl:Class ;
    rdfs:label "Subsidiary" ;
    rdfs:comment "An entity controlled by the group, consolidated using full consolidation when complete control is exercised." ;
    rdfs:subClassOf bpi:EquityConsolidatedCompany .

bpi:SupportDivision a owl:Class ;
    rdfs:label "SupportDivision" ;
    rdfs:comment "Division within the support organization (e.g., development, marketing, accelerators, consultancy, university, steering, expertise)." ;
    rdfs:subClassOf bpi:BusinessSupportBusinessLine,
        bpi:SupportExecutiveDepartment .

bpi:ComplaintAuthority a owl:Class ;
    rdfs:label "ComplaintAuthority" ;
    rdfs:comment "A regulatory body where data subjects may lodge complaints regarding data protection matters." .

bpi:CorporateIncomeTax a owl:Class ;
    rdfs:label "CorporateIncomeTax" ;
    rdfs:comment "Corporate income tax accounting and related taxable profit classification." ;
    rdfs:subClassOf bpi:CurrentTax,
        bpi:IncomeStatement .

bpi:CostOfRisk a owl:Class ;
    rdfs:label "CostOfRisk" ;
    rdfs:comment "Provision-related cost of risk reflecting proven and expected risks." ;
    rdfs:subClassOf bpi:FinancialResults .

bpi:ExtraordinaryIncome a owl:Class ;
    rdfs:label "ExtraordinaryIncome" ;
    rdfs:comment "Income items classified as extraordinary, such as gains from disposal of assets." ;
    rdfs:subClassOf bpi:IncomeStatement,
        bpi:PublishableIncomeStatement .

bpi:FundOfFundsBusiness a owl:Class ;
    rdfs:label "FundOfFundsBusiness" ;
    rdfs:comment "Business line contributing distributions and changes in fund-of-funds value to income." ;
    rdfs:subClassOf bpi:NetBankingIncome .

bpi:Guarantee a owl:Class ;
    rdfs:label "Guarantee" ;
    rdfs:comment "A contractual mechanism to cover counterparty risk or repayment risk for financing or long-term supplies." ;
    rdfs:subClassOf bpi:FinancialInstrument,
        bpi:GuaranteeCommitment .

bpi:IndividualRights a owl:Class ;
    rdfs:label "IndividualRights" ;
    rdfs:comment "The set of rights granted to individuals regarding their personal data (access, rectification, deletion, portability, etc.)." .

bpi:OtherDebts a owl:Class ;
    rdfs:label "OtherDebts" ;
    rdfs:comment "Other operational debt obligations not classified as trade payables or tax/social security debts." ;
    rdfs:subClassOf bpi:OperatingDebts .

bpi:RetentionPeriod a owl:Class ;
    rdfs:label "RetentionPeriod" ;
    rdfs:comment "The time period during which personal data is retained to implement the stated purposes." .

bpi:StatutoryAuditorReport a owl:Class ;
    rdfs:label "StatutoryAuditorReport" ;
    rdfs:comment "A report issued by statutory auditors on financial statements." ;
    rdfs:subClassOf bpi:FinancialStatement .

bpi:AccountingStandard a owl:Class ;
    rdfs:label "AccountingStandard" ;
    rdfs:comment "A set of rules governing accounting and financial reporting (e.g., IFRS, IAS, IFRS 9, IFRS 11, IFRS 13, IAS 1, IAS 36)." .

bpi:CashAndCashEquivalents a owl:Class ;
    rdfs:label "CashAndCashEquivalents" ;
    rdfs:comment "Cash in hand, on-demand deposits, and short-term highly liquid investments with insignificant risk of value change." ;
    rdfs:subClassOf bpi:CurrentAssets,
        bpi:FinancialAsset,
        bpi:FinancialAssets,
        bpi:NotesToFinancialStatements .

bpi:CurrentTax a owl:Class ;
    rdfs:label "CurrentTax" ;
    rdfs:comment "Tax expense or receivable determined based on current tax rules and rates in force." ;
    rdfs:subClassOf bpi:Tax .

bpi:DeferredTax a owl:Class ;
    rdfs:label "DeferredTax" ;
    rdfs:comment "Tax effects recognized for temporary differences between book values and tax values of assets and liabilities." ;
    rdfs:subClassOf bpi:Tax .

bpi:EccContributionToNetIncome a owl:Class ;
    rdfs:label "EccContributionToNetIncome" ;
    rdfs:comment "Contribution from equity-consolidated companies to net income." ;
    rdfs:subClassOf bpi:FinancialResults .

bpi:EquityMethodInvestment a owl:Class ;
    rdfs:label "EquityMethodInvestment" ;
    rdfs:comment "An investment accounted for using the equity method, replacing the investment value with the investor’s share of investee equity and profit/loss." ;
    rdfs:subClassOf bpi:Company,
        bpi:EquityInvestment,
        bpi:EquityInvestments,
        bpi:FinancialAsset .

bpi:ExtraordinaryExpense a owl:Class ;
    rdfs:label "ExtraordinaryExpense" ;
    rdfs:comment "Extraordinary expenses such as book value of financial assets sold and contributions to funds." .

bpi:FairValueHierarchyLevel a owl:Class ;
    rdfs:label "FairValueHierarchyLevel" ;
    rdfs:comment "A level in the fair value hierarchy (Level 1, Level 2, Level 3) based on observability of inputs." ;
    rdfs:subClassOf bpi:FairValue .

bpi:GreenFinancingInstrument a owl:Class ;
    rdfs:label "GreenFinancingInstrument" ;
    rdfs:comment "Green financing instruments issued under the framework, whose proceeds are managed and allocated to eligible green loans." ;
    rdfs:subClassOf bpi:FinancialInstrument .

bpi:GuaranteeCommitments a owl:Class ;
    rdfs:label "GuaranteeCommitments" ;
    rdfs:comment "Guarantee commitments given or received." ;
    rdfs:subClassOf bpi:CommitmentsGiven,
        bpi:OffBalanceSheetCommitments .

bpi:InvestmentUnit a owl:Class ;
    rdfs:label "InvestmentUnit" ;
    rdfs:comment "A structured unit distinguished by sector or stage of intervention within investment activities." ;
    rdfs:subClassOf bpi:InvestmentBusinessLine .

bpi:LegalBasisForProcessing a owl:Class ;
    rdfs:label "LegalBasisForProcessing" ;
    rdfs:comment "The legal grounds under which personal data processing is performed (e.g., legal obligation or legitimate interest)." .

bpi:OperatingDebts a owl:Class ;
    rdfs:label "OperatingDebts" ;
    rdfs:comment "Debt obligations arising from operations, including trade, tax/social security, and other debts." ;
    rdfs:subClassOf bpi:Liabilities .

bpi:OperatingIncome a owl:Class ;
    rdfs:label "OperatingIncome" ;
    rdfs:comment "Operating income used in the breakdown of results for tax purposes." ;
    rdfs:subClassOf bpi:FinancialResults .

bpi:RiskExposure a owl:Class ;
    rdfs:label "RiskExposure" ;
    rdfs:comment "A concept describing exposure to risks inherent in business activities and financial positions." .

bpi:ServiceProvider a owl:Class ;
    rdfs:label "ServiceProvider" ;
    rdfs:comment "A third party service provider or subcontractor that processes personal data on behalf of the group for recruitment-related services." ;
    rdfs:subClassOf bpi:DataProcessor,
        bpi:Organization .

bpi:ThirdPartyActivity a owl:Class ;
    rdfs:label "ThirdPartyActivity" ;
    rdfs:comment "Activities managed on behalf of third parties (e.g., on behalf of the State) that do not appear on the balance sheet of the public company." .

bpi:DataProtectionOfficer a owl:Class ;
    rdfs:label "DataProtectionOfficer" ;
    rdfs:comment "An officer responsible for data protection within the organization/group and contact point for exercising rights." .

bpi:EligibleGreenLoan a owl:Class ;
    rdfs:label "EligibleGreenLoan" ;
    rdfs:comment "Loan aligned with EU environmental objectives and eligibility criteria under the green financing framework." ;
    rdfs:subClassOf bpi:Loan .

bpi:EquityMethodInvestee a owl:Class ;
    rdfs:label "EquityMethodInvestee" ;
    rdfs:comment "A company accounted for using the equity method within consolidated financial statements." ;
    rdfs:subClassOf bpi:EquityConsolidatedCompany .

bpi:FinancialYear a owl:Class ;
    rdfs:label "FinancialYear" ;
    rdfs:comment "A defined accounting period used for reporting profits, dividends, and governance updates." .

bpi:InvestmentProgramme a owl:Class ;
    rdfs:label "InvestmentProgramme" ;
    rdfs:comment "A structured public investment programme (e.g., Investing in the Future, France 2030) with commitments and implementation." ;
    rdfs:subClassOf bpi:PublicFundingInstrument .

bpi:OffBalanceSheetCommitment a owl:Class ;
    rdfs:label "OffBalanceSheetCommitment" ;
    rdfs:comment "Commitments disclosed outside the balance sheet, including guarantees, loan financing, and securities commitments." .

bpi:Solvency a owl:Class ;
    rdfs:label "Solvency" ;
    rdfs:comment "Overall financial strength measured against regulatory solvency requirements." .

bpi:Tax a owl:Class ;
    rdfs:label "Tax" ;
    rdfs:comment "Current and deferred tax concepts used in income statement and equity recognition." .

bpi:EquityInvestments a owl:Class ;
    rdfs:label "EquityInvestments" ;
    rdfs:comment "Equity investments held as long-term ownership useful for the company’s business." ;
    rdfs:subClassOf bpi:FinancialAssets,
        bpi:NotesToFinancialStatements .

bpi:GDPR a owl:Class ;
    rdfs:label "GDPR" ;
    rdfs:comment "The European General Data Protection Regulation governing processing of personal data." .

bpi:IncomeStatement a owl:Class ;
    rdfs:label "IncomeStatement" ;
    rdfs:comment "A publishable income statement showing operating, financial, and extraordinary results." ;
    rdfs:subClassOf bpi:FinancialStatement .

bpi:InterestExpense a owl:Class ;
    rdfs:label "InterestExpense" ;
    rdfs:comment "Interest and similar expenses, including state loan interest, EIB loan interest, and other financial charges." .

bpi:Investment a owl:Class ;
    rdfs:label "Investment" ;
    rdfs:comment "An allocation of capital into equity or other instruments, including equity investments accounted for using the equity method or fair value." .

bpi:LiquidityPosition a owl:Class ;
    rdfs:label "LiquidityPosition" ;
    rdfs:comment "Liquidity strength assessed against prudential requirements." .

bpi:NetBankingIncome a owl:Class ;
    rdfs:label "NetBankingIncome" ;
    rdfs:comment "Aggregate banking income metric used in the income statement." ;
    rdfs:subClassOf bpi:FinancialResults .

bpi:ShareholdersEquity a owl:Class ;
    rdfs:label "ShareholdersEquity" ;
    rdfs:comment "Equity items presented within the liabilities/equity section, including capital, retained earnings, and current-year profit or loss." ;
    rdfs:subClassOf bpi:Liabilities .

bpi:DataSubjectRights a owl:Class ;
    rdfs:label "DataSubjectRights" ;
    rdfs:comment "Rights available to data subjects under applicable regulations, including access, rectification, deletion, portability, limitation, objection, and post-mortem instructions." .

bpi:FinancialLiability a owl:Class ;
    rdfs:label "FinancialLiability" ;
    rdfs:comment "A financial obligation (e.g., debts, trade debts, other financial liabilities) recognized and measured under IFRS rules." ;
    rdfs:subClassOf bpi:FinancialInstrument .

bpi:InvestmentBusinessLine a owl:Class ;
    rdfs:label "InvestmentBusinessLine" ;
    rdfs:comment "Business line grouping investment activities structured into capital development, fund of funds, and innovation capital." ;
    rdfs:subClassOf bpi:BpifranceGroup .

bpi:OtherReceivables a owl:Class ;
    rdfs:label "OtherReceivables" ;
    rdfs:comment "Receivables other than cash and cash equivalents." ;
    rdfs:subClassOf bpi:CurrentAssets,
        bpi:NotesToFinancialStatements .

bpi:PublicEntity a owl:Class ;
    rdfs:label "PublicEntity" ;
    rdfs:comment "A public institution referenced as the state and public resources involved in funding and commitments." .

bpi:PublishableIncomeStatement a owl:Class ;
    rdfs:label "PublishableIncomeStatement" ;
    rdfs:comment "A publishable income statement (income statement) section of financial reporting." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatements,
        bpi:IncomeStatement,
        bpi:ParentEntityFinancialStatements .

bpi:BalanceSheet a owl:Class ;
    rdfs:label "BalanceSheet" ;
    rdfs:comment "A consolidated statement presenting assets and liabilities at a reporting date." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatement .

bpi:BoardOfDirectors a owl:Class ;
    rdfs:label "BoardOfDirectors" ;
    rdfs:comment "The board that determines corporate matters and updates drafts/resolutions for general meetings." ;
    rdfs:subClassOf bpi:Board,
        bpi:GovernanceBody,
        bpi:Organization .

bpi:LiquidityReserve a owl:Class ;
    rdfs:label "LiquidityReserve" ;
    rdfs:comment "A liquidity reserve composed of current liquidity, current liquidity buffer, and contingency plan reserve." ;
    rdfs:subClassOf bpi:LiquidityPosition .

bpi:OtherDebt a owl:Class ;
    rdfs:label "OtherDebt" ;
    rdfs:comment "A residual category of debts other than trade debts and tax/social security debts." ;
    rdfs:subClassOf bpi:Debt,
        bpi:FinancialLiability .

bpi:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "An individual whose personal data may be processed, including representatives, beneficial owners, subscribers, and other stakeholders." .

bpi:PrivacyPolicy a owl:Class ;
    rdfs:label "PrivacyPolicy" ;
    rdfs:comment "A document setting out rules for processing personal data collected as part of a recruitment process." .

bpi:Risk a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:comment "A general concept for financial, operational, compliance, liquidity, market and other risks managed by the group." .

bpi:OperatingExpense a owl:Class ;
    rdfs:label "OperatingExpense" ;
    rdfs:comment "Operating expenses, including external charges, reserve fund reallocations, and taxes and duties." .

bpi:ParentEntityFinancialStatements a owl:Class ;
    rdfs:label "ParentEntityFinancialStatements" ;
    rdfs:comment "Financial statements prepared for the parent entity only (publishable balance sheet, income statement, and notes)." ;
    rdfs:subClassOf bpi:FinancialStatement,
        bpi:FinancialStatements .

bpi:UniversalRegistrationDocument a owl:Class ;
    rdfs:label "UniversalRegistrationDocument" ;
    rdfs:comment "A universal registration document filed with a financial markets authority and used for offering financial securities to the public or admitting them to trading on a regulated market." .

bpi:DataSubject a owl:Class ;
    rdfs:label "DataSubject" ;
    rdfs:comment "An individual whose personal data is processed in the recruitment context." .

bpi:EquityMethodAccounting a owl:Class ;
    rdfs:label "EquityMethodAccounting" ;
    rdfs:comment "Accounting approach referenced as equity-accounting method used in consolidated financial statements." ;
    rdfs:subClassOf bpi:EquityConsolidatedCompanies .

bpi:OffBalanceSheetCommitments a owl:Class ;
    rdfs:label "OffBalanceSheetCommitments" ;
    rdfs:comment "Commitments given and received disclosed outside the balance sheet." ;
    rdfs:subClassOf bpi:FinancialStatement,
        bpi:NotesToFinancialStatements .

bpi:OrganizationalChartOfNetwork a owl:Class ;
    rdfs:label "OrganizationalChartOfNetwork" ;
    rdfs:comment "Organizational chart describing the network structure (regional offices and delegations)." ;
    rdfs:subClassOf bpi:OrganizationalChart .

bpi:StatementOfCashFlows a owl:Class ;
    rdfs:label "StatementOfCashFlows" ;
    rdfs:comment "Statement of cash flows describing flows related to transactions and taxes paid." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements .

bpi:Company a owl:Class ;
    rdfs:label "Company" ;
    rdfs:comment "A general business entity that may be invested in, assessed for ESG risks, and engaged with through governance and questionnaires." ;
    rdfs:subClassOf bpi:DataController,
        bpi:Organization .

bpi:DataController a owl:Class ;
    rdfs:label "DataController" ;
    rdfs:comment "The entity that determines the purposes and means of processing personal data in the recruitment context." .

bpi:FinancialStatement a owl:Class ;
    rdfs:label "FinancialStatement" ;
    rdfs:comment "A financial statement document or section presenting financial position, performance, or notes (e.g., consolidated or parent entity statements)." .

bpi:IdentificationData a owl:Class ;
    rdfs:label "IdentificationData" ;
    rdfs:comment "Category of personal data used to identify individuals (e.g., names, addresses, signatures, birth details)." ;
    rdfs:subClassOf bpi:PersonalData,
        bpi:PersonalDataCategory .

bpi:NetCashFlow a owl:Class ;
    rdfs:label "NetCashFlow" ;
    rdfs:comment "A cash flow concept corresponding to cash and cash equivalents and used to present cash flow after certain costs." .

bpi:OtherFinancialAssets a owl:Class ;
    rdfs:label "OtherFinancialAssets" ;
    rdfs:comment "Category of financial assets other than cash and cash equivalents, including loans and reserve funds." ;
    rdfs:subClassOf bpi:FinancialAsset,
        bpi:FinancialAssets,
        bpi:NotesToFinancialStatements .

bpi:ShareholderEquity a owl:Class ;
    rdfs:label "ShareholderEquity" ;
    rdfs:comment "Equity used as the denominator for ROE calculations." .

bpi:StatutoryAuditor a owl:Class ;
    rdfs:label "StatutoryAuditor" ;
    rdfs:comment "Statutory auditor responsible for the auditor’s report on the summary consolidated half-year financial statements." ;
    rdfs:subClassOf bpi:Organization .

bpi:EquityConsolidatedCompany a owl:Class ;
    rdfs:label "EquityConsolidatedCompany" ;
    rdfs:comment "Company whose net profit/loss is included in the group’s income statement via the equity method (equity-consolidated)." ;
    rdfs:subClassOf bpi:Company,
        bpi:Investment,
        bpi:Organization .

bpi:AmendmentToUniversalRegistrationDocument a owl:Class ;
    rdfs:label "AmendmentToUniversalRegistrationDocument" ;
    rdfs:comment "An amendment document updating a universal registration document and filed with the competent authority." ;
    rdfs:subClassOf bpi:UniversalRegistrationDocument .

bpi:Loan a owl:Class ;
    rdfs:label "Loan" ;
    rdfs:comment "A contractual lending arrangement recognized as a financial asset and measured according to applicable IFRS rules." ;
    rdfs:subClassOf bpi:Debt,
        bpi:DebtInstrument,
        bpi:FinancialAsset,
        bpi:FinancialInstrument .

bpi:Dividends a owl:Class ;
    rdfs:label "Dividends" ;
    rdfs:comment "Dividend income or dividend payments disclosed as part of financial results." ;
    rdfs:subClassOf bpi:FinancialIncome,
        bpi:NetBankingIncome .

bpi:DividendsPaid a owl:Class ;
    rdfs:label "DividendsPaid" ;
    rdfs:comment "Disclosures about dividends distributed during the period." ;
    rdfs:subClassOf bpi:NotesToFinancialStatements .

bpi:FinancialInstrument a owl:Class ;
    rdfs:label "FinancialInstrument" ;
    rdfs:comment "A contract-based asset or liability whose fair value and accounting treatment are discussed (including financial assets and liabilities)." .

bpi:FinancialRisk a owl:Class ;
    rdfs:label "FinancialRisk" ;
    rdfs:comment "Risk categories related to financial market and balance-sheet exposures, including interest rate, market, liquidity, exchange, and equity-interest risks." ;
    rdfs:subClassOf bpi:Risk,
        bpi:RiskFactor,
        bpi:RiskManagement .

bpi:GovernanceBody a owl:Class ;
    rdfs:label "GovernanceBody" ;
    rdfs:comment "A governance entity (e.g., general meeting, board, supervisory board, or committee) where mandates may be exercised." .

bpi:FinancingCommitment a owl:Class ;
    rdfs:label "FinancingCommitment" ;
    rdfs:comment "Financing commitments given or received (e.g., commitments to credit institutions/customers)." ;
    rdfs:subClassOf bpi:OffBalanceSheetCommitment,
        bpi:OffBalanceSheetCommitments .

bpi:Fund a owl:Class ;
    rdfs:label "Fund" ;
    rdfs:comment "An investment vehicle subscribed to directly or managed on behalf of third parties, subject to ESG integration and monitoring." ;
    rdfs:subClassOf bpi:EquityInvestments,
        bpi:InvestmentBusinessLine,
        bpi:InvestmentVehicle .

bpi:Loans a owl:Class ;
    rdfs:label "Loans" ;
    rdfs:comment "A financing product category used to finance businesses." ;
    rdfs:subClassOf bpi:FinancialAssets,
        bpi:NotesToFinancialStatements .

bpi:PublicSectorInvestmentBank a owl:Class ;
    rdfs:label "PublicSectorInvestmentBank" ;
    rdfs:comment "A company object describing a public sector investment bank facilitating access to financing and guarantees." .

bpi:GuaranteeCommitment a owl:Class ;
    rdfs:label "GuaranteeCommitment" ;
    rdfs:comment "Guarantee commitments given or received, including commitments on behalf of credit institutions/customers." ;
    rdfs:subClassOf bpi:Guarantee,
        bpi:GuaranteeScheme,
        bpi:OffBalanceSheetCommitment,
        bpi:OffBalanceSheetCommitments .

bpi:PersonalData a owl:Class ;
    rdfs:label "PersonalData" ;
    rdfs:comment "Information that allows a person to be directly or indirectly identified, including data contained in application documents." .

bpi:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A general organizational entity referenced in the document (e.g., entities included in consolidation or network units)." .

bpi:NetIncome a owl:Class ;
    rdfs:label "NetIncome" ;
    rdfs:comment "Profit or loss measure used in the statement of net income and related equity movements." ;
    rdfs:subClassOf bpi:FinancialResults .

bpi:PublicInstitution a owl:Class ;
    rdfs:label "PublicInstitution" ;
    rdfs:comment "A public institution whose activities and financial statements are prepared under French accounting rules." .

bpi:GreenFinancingFramework a owl:Class ;
    rdfs:label "GreenFinancingFramework" ;
    rdfs:comment "Framework document defining eligible green categories, eligibility criteria, evaluation process, and reporting for green financing instruments." .

bpi:HalfYearConsolidatedFinancialStatements a owl:Class ;
    rdfs:label "HalfYearConsolidatedFinancialStatements" ;
    rdfs:comment "Condensed half-year consolidated financial statements prepared for the group." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements .

bpi:FinancialAsset a owl:Class ;
    rdfs:label "FinancialAsset" ;
    rdfs:comment "A financial asset held by the group, measured under various IFRS categories such as fair value through profit or loss or equity." ;
    rdfs:subClassOf bpi:FinancialInstrument .

bpi:PersonalDataProcessing a owl:Class ;
    rdfs:label "PersonalDataProcessing" ;
    rdfs:comment "The processing activities performed on personal data in the context described by the policy." .

bpi:FinancialResults a owl:Class ;
    rdfs:label "FinancialResults" ;
    rdfs:comment "A set of reported financial performance metrics for a specific financial year." .

bpi:PublicLimitedCompany a owl:Class ;
    rdfs:label "PublicLimitedCompany" ;
    rdfs:comment "A company organized as a public limited company (e.g., with registered capital and corporate registration)." ;
    rdfs:subClassOf bpi:Organization .

bpi:PublicGroup a owl:Class ;
    rdfs:label "PublicGroup" ;
    rdfs:comment "Public group promoting business financing and development in support of public policies led by the State and regions (Bpifrance group)." ;
    rdfs:subClassOf bpi:PublicEntity .

bpi:InvestmentProgrammeOperator a owl:Class ;
    rdfs:label "InvestmentProgrammeOperator" ;
    rdfs:comment "An operator implementing public investment programmes such as Investing in the Future and France 2030." .

bpi:NotesToFinancialStatements a owl:Class ;
    rdfs:label "NotesToFinancialStatements" ;
    rdfs:comment "Supplementary disclosures accompanying financial statements, including accounting principles, events, and fair value information." ;
    rdfs:subClassOf bpi:ConsolidatedFinancialStatements,
        bpi:FinancialStatement,
        bpi:FinancialStatements .

bpi:FinancialStatements a owl:Class ;
    rdfs:label "FinancialStatements" ;
    rdfs:comment "The annual financial statements (balance sheet, income statement, and appendix) approved by shareholders." .

bpi:BpifranceGroup a owl:Class ;
    rdfs:label "BpifranceGroup" ;
    rdfs:comment "The group of entities collectively described as providing financing, guarantees, innovation support, investment, international development, and business support." ;
    rdfs:subClassOf bpi:PublicGroup .

bpi:PublicIndustrialAndCommercialInstitution a owl:Class ;
    rdfs:label "PublicIndustrialAndCommercialInstitution" ;
    rdfs:comment "A public industrial and commercial institution (EPIC) as a legal form referenced for the reporting entity." ;
    rdfs:subClassOf bpi:PublicEntity .

bpi:ConsolidatedFinancialStatements a owl:Class ;
    rdfs:label "ConsolidatedFinancialStatements" ;
    rdfs:comment "Financial statements prepared on a consolidated basis for the group, including notes on accounting standards, consolidation, and financial statement items." ;
    rdfs:subClassOf bpi:AnnualReport,
        bpi:FinancialStatement,
        bpi:FinancialStatements .

