bpi:innovationFinancingAidAmount a owl:DatatypeProperty ;
    rdfs:label "innovationFinancingAidAmount" ;
    rdfs:comment "Innovation financing aid amount at the reporting date." ;
    rdfs:domain bpi:InnovationFinancingAid ;
    rdfs:range xsd:decimal .

bpi:innovationGrants a owl:DatatypeProperty ;
    rdfs:label "innovationGrants" ;
    rdfs:comment "Innovation grants amount reported for the period." ;
    rdfs:domain bpi:InnovationFinancingAid ;
