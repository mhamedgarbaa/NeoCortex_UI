    rdfs:range xsd:string .

bpi:businessLoginDataElectronicSignatureCertificate a owl:DatatypeProperty ;
    rdfs:label "businessLoginDataElectronicSignatureCertificate" ;
    rdfs:comment "Electronic signature certificate used for authentication/signing." ;
    rdfs:domain bpi:BusinessLoginData ;
    rdfs:range xsd:string .

bpi:businessLoginDataIpAddress a owl:DatatypeProperty ;
    rdfs:label "businessLoginDataIpAddress" ;
    rdfs:comment "IP address used for portal access." ;
    rdfs:domain bpi:BusinessLoginData ;
    rdfs:range xsd:string .

bpi:cET1Ratio a owl:DatatypeProperty ;
    rdfs:label "cET1Ratio" ;
    rdfs:comment "Common Equity Tier 1 (CET1) ratio." ;
    rdfs:domain bpi:CET1Ratio ;
    rdfs:range xsd:decimal .

bpi:calculatesExpectedCreditLossesUsing a owl:ObjectProperty ;
    rdfs:label "calculatesExpectedCreditLossesUsing" ;
    rdfs:comment "Indicates that expected credit losses are calculated using forward-looking scenarios." ;
    rdfs:domain bpi:ECLModel ;
    rdfs:range bpi:ForwardLookingScenarios .

bpi:capital a owl:DatatypeProperty ;
    rdfs:label "capital" ;
    rdfs:comment "Subscribed capital amount reported in shareholders' equity." ;
    rdfs:domain bpi:ShareholdersEquityStatement ;
    rdfs:range xsd:decimal .

bpi:capitalAmount a owl:DatatypeProperty ;
    rdfs:label "capitalAmount" ;
    rdfs:comment "The company’s share capital amount." ;
    rdfs:domain bpi:PublicLimitedCompany,
        bpi:ShareholderEquity,
        bpi:ShareholdersEquity ;
    rdfs:range xsd:decimal .

bpi:capitalAndRelatedReserves a owl:DatatypeProperty ;
    rdfs:label "capitalAndRelatedReserves" ;
    rdfs:comment "Capital and related reserves amount." ;
    rdfs:domain bpi:ShareholderEquity ;
    rdfs:range xsd:decimal .

bpi:capitalHeldPercentage a owl:DatatypeProperty ;
    rdfs:label "capitalHeldPercentage" ;
    rdfs:comment "Percentage of capital held in an equity-consolidated company." ;
    rdfs:domain bpi:EquityConsolidatedCompany ;
    rdfs:range xsd:decimal .

bpi:carbonFootprintAssessedAllScopesShare a owl:DatatypeProperty ;
    rdfs:label "carbonFootprintAssessedAllScopesShare" ;
    rdfs:comment "Share of carbon-footprint-assessing respondents that assessed scopes 1, 2 and 3 (e.g., 37%)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range xsd:decimal .

bpi:carbonFootprintAssessedPartiallyShare a owl:DatatypeProperty ;
    rdfs:label "carbonFootprintAssessedPartiallyShare" ;
    rdfs:comment "Share of carbon-footprint-assessing respondents that assessed partially for one or two scopes combined (e.g., 63%)." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
