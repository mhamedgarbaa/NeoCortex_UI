    rdfs:range xsd:string .

bpi:managesActivitiesOnBehalfOf a owl:ObjectProperty ;
    rdfs:label "managesActivitiesOnBehalfOf" ;
    rdfs:comment "Indicates that the group manages operations on behalf of the State/public sector." ;
    rdfs:domain bpi:PublicInstitution ;
    rdfs:range bpi:PublicSectorInvestmentBank .

bpi:managesActivitiesOnBehalfOfThirdParties a owl:ObjectProperty ;
    rdfs:label "managesActivitiesOnBehalfOfThirdParties" ;
    rdfs:comment "Indicates that the group manages operations on behalf of the State/third parties." ;
    rdfs:domain bpi:PublicInstitution ;
    rdfs:range bpi:ActivitiesOnBehalfOfThirdParties .

bpi:managesBondIssueProgramme a owl:ObjectProperty ;
    rdfs:label "managesBondIssueProgramme" ;
    rdfs:comment "Indicates involvement in bond issue programmes through guarantee commitments and financing activities." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:BondIssueProgramme .

bpi:managesFinancingCommitments a owl:ObjectProperty ;
    rdfs:label "managesFinancingCommitments" ;
    rdfs:comment "Indicates that the bank manages financing commitments." ;
    rdfs:domain bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:FinancingCommitment .

bpi:managesGuaranteeCommitments a owl:ObjectProperty ;
    rdfs:label "managesGuaranteeCommitments" ;
    rdfs:comment "Indicates that the bank manages guarantee commitments." ;
    rdfs:domain bpi:PublicSectorInvestmentBank ;
    rdfs:range bpi:GuaranteeCommitment .

bpi:managesInnovationAndIndustryFund a owl:ObjectProperty ;
    rdfs:label "managesInnovationAndIndustryFund" ;
    rdfs:comment "Indicates that the institution manages the Innovation and Industry Fund." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:InnovationAndIndustryFund .

bpi:managesInnovationCapitalBusinessLine a owl:ObjectProperty ;
    rdfs:label "managesInnovationCapitalBusinessLine" ;
    rdfs:comment "Indicates that the group runs the innovation capital business line." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:InnovationCapital .

bpi:managesInvestmentFundsOfFunds a owl:ObjectProperty ;
    rdfs:label "managesInvestmentFundsOfFunds" ;
    rdfs:comment "Indicates that the group manages funds-of-funds activity." ;
    rdfs:domain bpi:BpifranceGroup ;
    rdfs:range bpi:FundOfFundsBusiness .

bpi:managesInvestmentProgramme a owl:ObjectProperty ;
    rdfs:label "managesInvestmentProgramme" ;
    rdfs:comment "Indicates that the institution manages investment programmes (e.g., PIA/France 2030 initiatives)." ;
    rdfs:domain bpi:PublicIndustrialAndCommercialInstitution ;
    rdfs:range bpi:InvestmentProgramme .

bpi:managesInvestments a owl:ObjectProperty ;
    rdfs:label "managesInvestments" ;
    rdfs:comment "Indicates that the investment programme operator manages investment business activities." ;
    rdfs:domain bpi:InvestmentProgrammeOperator ;
    rdfs:range bpi:InvestmentBusiness .

bpi:managesNetProceedsOf a owl:ObjectProperty ;
    rdfs:label "managesNetProceedsOf" ;
    rdfs:comment "Indicates that the bank’s treasury manages net proceeds for financing and/or refinancing eligible loans." ;
    rdfs:domain bpi:PublicInvestmentBank ;
