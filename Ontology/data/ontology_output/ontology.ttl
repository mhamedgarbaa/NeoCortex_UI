@prefix bpi: <https://talan.com/ontology/bpi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://talan.com/ontology/bpi> a owl:Ontology .

bpi:CorporateCustomer a owl:Class ;
    rdfs:label "CorporateCustomer" ;
    rdfs:comment "A business client referenced as benefiting from counterparty risk guarantees for long-term electricity supplies." .

bpi:Guarantee a owl:Class ;
    rdfs:label "Guarantee" ;
    rdfs:comment "A financial guarantee activity referenced as part of the company object, including guarantees for repayment and counterparty risk." .

bpi:PublicEndowment a owl:Class ;
    rdfs:label "PublicEndowment" ;
    rdfs:comment "Public endowments referenced as providing guarantee funds or reserves with exclusive counterparties." .

bpi:Regulation a owl:Class ;
    rdfs:label "Regulation" ;
    rdfs:comment "A legal instrument governing filings and approvals under EU securities regulation referenced in the text." .

bpi:Subsidiary a owl:Class ;
    rdfs:label "Subsidiary" ;
    rdfs:comment "An entity considered as part of the group, referenced as important subsidiaries in the organisational structure." .

bpi:advancePaymentDate a owl:DatatypeProperty ;
    rdfs:label "advancePaymentDate" ;
    rdfs:comment "The date on which the board decided the advance payment of the dividend." ;
    rdfs:domain bpi:DividendDistribution ;
    rdfs:range xsd:date .

bpi:advancePaymentPaidDate a owl:DatatypeProperty ;
    rdfs:label "advancePaymentPaidDate" ;
    rdfs:comment "The date(s) on which the advance dividend was paid to shareholders." ;
    rdfs:domain bpi:DividendDistribution ;
    rdfs:range xsd:date .

bpi:approvalDate a owl:DatatypeProperty ;
    rdfs:label "approvalDate" ;
    rdfs:comment "The date the amendment was approved/handled by the competent authority under the applicable regulation." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:date .

bpi:approvesAmendmentToUniversalRegistrationDocument a owl:ObjectProperty ;
    rdfs:label "approvesAmendmentToUniversalRegistrationDocument" ;
    rdfs:comment "Indicates the competent authority approves the amendment to the universal registration document." ;
    rdfs:domain bpi:CompetentAuthority ;
    rdfs:range bpi:AmendmentToUniversalRegistrationDocument .

bpi:approvesUniversalRegistrationDocument a owl:ObjectProperty ;
    rdfs:label "approvesUniversalRegistrationDocument" ;
    rdfs:comment "Indicates the competent authority approves the universal registration document (and related amendments) under applicable regulation." ;
    rdfs:domain bpi:CompetentAuthority ;
    rdfs:range bpi:UniversalRegistrationDocument ;
    owl:inverseOf bpi:isApprovedByCompetentAuthority .

bpi:articlesOfAssociationAmendmentAuthorizedDate a owl:DatatypeProperty ;
    rdfs:label "articlesOfAssociationAmendmentAuthorizedDate" ;
    rdfs:comment "The date when the board authorized the preliminary modification to the articles of association." ;
    rdfs:domain bpi:BoardOfDirectors ;
    rdfs:range xsd:date .

bpi:availableOnInvestorRelationsWebsite a owl:ObjectProperty ;
    rdfs:label "availableOnInvestorRelationsWebsite" ;
    rdfs:comment "Indicates the document is available on the company’s investor relations website." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:InvestorRelationsWebsite .

bpi:businessAddress a owl:DatatypeProperty ;
    rdfs:label "businessAddress" ;
    rdfs:comment "The business address of the director." ;
    rdfs:domain bpi:Director ;
    rdfs:range xsd:string .

bpi:capitalAmount a owl:DatatypeProperty ;
    rdfs:label "capitalAmount" ;
    rdfs:comment "The company’s issued capital amount." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range xsd:decimal .

bpi:cooptationDate a owl:DatatypeProperty ;
    rdfs:label "cooptationDate" ;
    rdfs:comment "The date from which the director was coopted." ;
    rdfs:domain bpi:Director ;
    rdfs:range xsd:date .

bpi:counterpartyRiskLongTermElectricitySupplyRenewableEnergies a owl:DatatypeProperty ;
    rdfs:label "counterpartyRiskLongTermElectricitySupplyRenewableEnergies" ;
    rdfs:comment "Indicates that the company’s object includes guaranteeing counterparty risk for long-term electricity supplies using renewable energies." ;
    rdfs:domain bpi:LongTermElectricitySupply ;
    rdfs:range xsd:boolean .

bpi:dateOfBirth a owl:DatatypeProperty ;
    rdfs:label "dateOfBirth" ;
    rdfs:comment "The director’s date of birth." ;
    rdfs:domain bpi:Director ;
    rdfs:range xsd:date .

bpi:dividendAdvancePaymentAmount a owl:DatatypeProperty ;
    rdfs:label "dividendAdvancePaymentAmount" ;
    rdfs:comment "The amount of the advance payment of the dividend." ;
    rdfs:domain bpi:DividendDistribution ;
    rdfs:range xsd:decimal .

bpi:dividendAdvancePaymentPerShare a owl:DatatypeProperty ;
    rdfs:label "dividendAdvancePaymentPerShare" ;
    rdfs:comment "The advance dividend unit amount per share." ;
    rdfs:domain bpi:DividendDistribution ;
    rdfs:range xsd:decimal .

bpi:dividendPerAction a owl:DatatypeProperty ;
    rdfs:label "dividendPerAction" ;
    rdfs:comment "Dividend unit amount per action (when stated)." ;
    rdfs:domain bpi:DividendDistribution ;
    rdfs:range xsd:decimal .

bpi:dividendPerShare a owl:DatatypeProperty ;
    rdfs:label "dividendPerShare" ;
    rdfs:comment "Dividend unit amount per share (when stated for a distribution period)." ;
    rdfs:domain bpi:DividendDistribution ;
    rdfs:range xsd:decimal .

bpi:dividendRemainingDeterminedDate a owl:DatatypeProperty ;
    rdfs:label "dividendRemainingDeterminedDate" ;
    rdfs:comment "The date when the board determined the dividend remaining to be distributed." ;
    rdfs:domain bpi:BoardOfDirectors ;
    rdfs:range xsd:date .

bpi:extraordinaryGeneralMeetingDate a owl:DatatypeProperty ;
    rdfs:label "extraordinaryGeneralMeetingDate" ;
    rdfs:comment "The date of the extraordinary general meeting." ;
    rdfs:domain bpi:ExtraordinaryGeneralMeeting ;
    rdfs:range xsd:date .

bpi:filedWithCompetentAuthority a owl:ObjectProperty ;
    rdfs:label "filedWithCompetentAuthority" ;
    rdfs:comment "Indicates the amendment was filed with the competent authority (e.g., AMF)." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range bpi:CompetentAuthority .

bpi:filingDate a owl:DatatypeProperty ;
    rdfs:label "filingDate" ;
    rdfs:comment "The date the amendment was filed with the competent authority (AMF)." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:date .

bpi:financialYearEndDate a owl:DatatypeProperty ;
    rdfs:label "financialYearEndDate" ;
    rdfs:comment "The end date of the financial year referenced in the document." ;
    rdfs:domain bpi:FinancialYear ;
    rdfs:range xsd:date .

bpi:firstAppointmentDate a owl:DatatypeProperty ;
    rdfs:label "firstAppointmentDate" ;
    rdfs:comment "The date of the director’s first appointment." ;
    rdfs:domain bpi:Director ;
    rdfs:range xsd:date .

bpi:generalMeetingDate a owl:DatatypeProperty ;
    rdfs:label "generalMeetingDate" ;
    rdfs:comment "The date of the general meeting." ;
    rdfs:domain bpi:GeneralMeeting ;
    rdfs:range xsd:date .

bpi:guaranteeFundImplementationAnnouncementDate a owl:DatatypeProperty ;
    rdfs:label "guaranteeFundImplementationAnnouncementDate" ;
    rdfs:comment "The date of the government announcement entrusting implementation of the guarantee fund." ;
    rdfs:domain bpi:GuaranteeFundImplementation ;
    rdfs:range xsd:date .

bpi:guaranteeFundImplementationAnnouncementReference a owl:DatatypeProperty ;
    rdfs:label "guaranteeFundImplementationAnnouncementReference" ;
    rdfs:comment "Reference or description of the announcement related to guarantee fund implementation." ;
    rdfs:domain bpi:GuaranteeFundImplementation ;
    rdfs:range xsd:string .

bpi:guaranteesCounterpartyRisk a owl:ObjectProperty ;
    rdfs:label "guaranteesCounterpartyRisk" ;
    rdfs:comment "Indicates the corporate object includes guaranteeing counterparty risk." ;
    rdfs:domain bpi:CorporateObject ;
    rdfs:range bpi:CounterpartyRisk .

bpi:guaranteesCounterpartyRiskForLongTermElectricitySupply a owl:ObjectProperty ;
    rdfs:label "guaranteesCounterpartyRiskForLongTermElectricitySupply" ;
    rdfs:comment "Indicates the corporate object includes guaranteeing counterparty risk for long-term electricity supplies using renewable energies." ;
    rdfs:domain bpi:CorporateObject ;
    rdfs:range bpi:LongTermElectricitySupply .

bpi:hasAmendment a owl:ObjectProperty ;
    rdfs:label "hasAmendment" ;
    rdfs:comment "Indicates that the universal registration document can have associated amendments." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:AmendmentToUniversalRegistrationDocument ;
    owl:inverseOf bpi:amendsUniversalRegistrationDocument .

bpi:hasArticlesOfAssociation a owl:ObjectProperty ;
    rdfs:label "hasArticlesOfAssociation" ;
    rdfs:comment "Indicates the company has articles of association that can be proposed to be amended." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:ArticlesOfAssociation .

bpi:hasAuditCommittee a owl:ObjectProperty ;
    rdfs:label "hasAuditCommittee" ;
    rdfs:comment "Indicates the corporate governance report includes an audit committee." ;
    rdfs:domain bpi:CorporateGovernanceReport ;
    rdfs:range bpi:AuditCommittee .

bpi:hasBoardOfDirectors a owl:ObjectProperty ;
    rdfs:label "hasBoardOfDirectors" ;
    rdfs:comment "Indicates the company has a board of directors that determines proposals and updates." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:BoardOfDirectors .

bpi:hasCEO a owl:ObjectProperty ;
    rdfs:label "hasCEO" ;
    rdfs:comment "Indicates the company has a CEO responsible for certification in the amendment." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:CEO .

bpi:hasConsolidatedFinancialStatements a owl:ObjectProperty ;
    rdfs:label "hasConsolidatedFinancialStatements" ;
    rdfs:comment "Indicates the universal registration document includes consolidated financial statements." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:ConsolidatedFinancialStatements .

bpi:hasCorporateGovernanceReport a owl:ObjectProperty ;
    rdfs:label "hasCorporateGovernanceReport" ;
    rdfs:comment "Indicates the universal registration document includes a corporate governance report section." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:CorporateGovernanceReport .

bpi:hasCorporateObject a owl:ObjectProperty ;
    rdfs:label "hasCorporateObject" ;
    rdfs:comment "Indicates the company’s corporate object is defined in the articles of association and may be amended." ;
    rdfs:domain bpi:ArticlesOfAssociation ;
    rdfs:range bpi:CorporateObject .

bpi:hasDeputyCEO a owl:ObjectProperty ;
    rdfs:label "hasDeputyCEO" ;
    rdfs:comment "Indicates the company has a deputy CEO responsible for certification in the amendment." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:DeputyCEO .

bpi:hasDirector a owl:ObjectProperty ;
    rdfs:label "hasDirector" ;
    rdfs:comment "Indicates the board of directors includes directors whose terms may end or be renewed." ;
    rdfs:domain bpi:BoardOfDirectors ;
    rdfs:range bpi:Director .

bpi:hasEmployeesTrainingStatement a owl:ObjectProperty ;
    rdfs:label "hasEmployeesTrainingStatement" ;
    rdfs:comment "Indicates the non-financial performance statement includes employees training information." ;
    rdfs:domain bpi:NonFinancialPerformanceStatement ;
    rdfs:range bpi:EmployeesTrainingStatement .

bpi:hasExtraordinaryGeneralMeeting a owl:ObjectProperty ;
    rdfs:label "hasExtraordinaryGeneralMeeting" ;
    rdfs:comment "Indicates the company holds an extraordinary general meeting where extraordinary resolutions are considered." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:ExtraordinaryGeneralMeeting .

bpi:hasFinancialStatements a owl:ObjectProperty ;
    rdfs:label "hasFinancialStatements" ;
    rdfs:comment "Indicates the universal registration document includes financial statements." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:FinancialStatements .

bpi:hasFinancialYear a owl:ObjectProperty ;
    rdfs:label "hasFinancialYear" ;
    rdfs:comment "Indicates financial statements relate to a financial year." ;
    rdfs:domain bpi:FinancialStatements ;
    rdfs:range bpi:FinancialYear .

bpi:hasGeneralManagement a owl:ObjectProperty ;
    rdfs:label "hasGeneralManagement" ;
    rdfs:comment "Indicates the company has general management responsible for statements certified in the amendment." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:GeneralManagement .

bpi:hasGeneralReserve a owl:ObjectProperty ;
    rdfs:label "hasGeneralReserve" ;
    rdfs:comment "Indicates the corporate object relies on general reserves constituted by shareholders." ;
    rdfs:domain bpi:CorporateObject ;
    rdfs:range bpi:GeneralReserve .

bpi:hasGuaranteeFund a owl:ObjectProperty ;
    rdfs:label "hasGuaranteeFund" ;
    rdfs:comment "Indicates the corporate object involves guarantee funds." ;
    rdfs:domain bpi:CorporateObject ;
    rdfs:range bpi:GuaranteeFund .

bpi:hasLegalAndArbitrationProceedings a owl:ObjectProperty ;
    rdfs:label "hasLegalAndArbitrationProceedings" ;
    rdfs:comment "Indicates the universal registration document includes information about legal and arbitration proceedings." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:LegalAndArbitrationProceedings .

bpi:hasMajorContract a owl:ObjectProperty ;
    rdfs:label "hasMajorContract" ;
    rdfs:comment "Indicates the universal registration document includes information about major contracts." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:MajorContract .

bpi:hasNonFinancialPerformanceStatement a owl:ObjectProperty ;
    rdfs:label "hasNonFinancialPerformanceStatement" ;
    rdfs:comment "Indicates the universal registration document includes a non-financial performance statement section." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:NonFinancialPerformanceStatement .

bpi:hasOrdinaryGeneralMeeting a owl:ObjectProperty ;
    rdfs:label "hasOrdinaryGeneralMeeting" ;
    rdfs:comment "Indicates the company holds an ordinary general meeting where ordinary resolutions are considered." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:OrdinaryGeneralMeeting .

bpi:hasOrganisationalStructure a owl:ObjectProperty ;
    rdfs:label "hasOrganisationalStructure" ;
    rdfs:comment "Indicates the universal registration document includes an organisational structure section." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:OrganisationalStructure .

bpi:hasPrincipalShareholder a owl:ObjectProperty ;
    rdfs:label "hasPrincipalShareholder" ;
    rdfs:comment "Indicates the universal registration document includes information about principal shareholders." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:PrincipalShareholder .

bpi:hasPublicSectorInvestmentBankRole a owl:ObjectProperty ;
    rdfs:label "hasPublicSectorInvestmentBankRole" ;
    rdfs:comment "Indicates the company’s object is that of a public sector investment bank." ;
    rdfs:domain bpi:CorporateObject ;
    rdfs:range bpi:PublicSectorInvestmentBank .

bpi:hasRegulatedMarket a owl:ObjectProperty ;
    rdfs:label "hasRegulatedMarket" ;
    rdfs:comment "Indicates securities admission to trading occurs on a regulated market." ;
    rdfs:domain bpi:SecuritiesAdmissionToTrading ;
    rdfs:range bpi:RegulatedMarket .

bpi:hasRelatedPartyTransaction a owl:ObjectProperty ;
    rdfs:label "hasRelatedPartyTransaction" ;
    rdfs:comment "Indicates the universal registration document includes information about related party transactions." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:RelatedPartyTransaction .

bpi:hasRemuneration a owl:ObjectProperty ;
    rdfs:label "hasRemuneration" ;
    rdfs:comment "Indicates the corporate governance report includes remuneration information." ;
    rdfs:domain bpi:CorporateGovernanceReport ;
    rdfs:range bpi:Remuneration .

bpi:hasRemunerationCommittee a owl:ObjectProperty ;
    rdfs:label "hasRemunerationCommittee" ;
    rdfs:comment "Indicates the corporate governance report includes a remuneration committee." ;
    rdfs:domain bpi:CorporateGovernanceReport ;
    rdfs:range bpi:RemunerationCommittee .

bpi:hasRiskFactorsSection a owl:ObjectProperty ;
    rdfs:label "hasRiskFactorsSection" ;
    rdfs:comment "Indicates the universal registration document includes a risk factors section." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:RiskFactorsSection .

bpi:hasSpecialAuditorsReport a owl:ObjectProperty ;
    rdfs:label "hasSpecialAuditorsReport" ;
    rdfs:comment "Indicates the company has a special statutory auditors report approved by the general meeting." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:SpecialAuditorsReport .

bpi:hasStatutoryAuditor a owl:ObjectProperty ;
    rdfs:label "hasStatutoryAuditor" ;
    rdfs:comment "Indicates the company has statutory auditors whose reports are reviewed/approved by the general meeting." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:StatutoryAuditor .

bpi:implementsGuaranteeFund a owl:ObjectProperty ;
    rdfs:label "implementsGuaranteeFund" ;
    rdfs:comment "Indicates the corporate object relates to implementing a guarantee fund for long-term electricity supply contracts." ;
    rdfs:domain bpi:CorporateObject ;
    rdfs:range bpi:GuaranteeFundImplementation .

bpi:isUsedForSecuritiesAdmissionToTrading a owl:ObjectProperty ;
    rdfs:label "isUsedForSecuritiesAdmissionToTrading" ;
    rdfs:comment "Indicates the universal registration document may be used as part of securities admission to trading on a regulated market." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:SecuritiesAdmissionToTrading .

bpi:isUsedForSecuritiesOffer a owl:ObjectProperty ;
    rdfs:label "isUsedForSecuritiesOffer" ;
    rdfs:comment "Indicates the universal registration document may be used as part of a public securities offer." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:SecuritiesOffer .

bpi:mayIncludeSummaryDocument a owl:ObjectProperty ;
    rdfs:label "mayIncludeSummaryDocument" ;
    rdfs:comment "Indicates that a summary document may be included when completing the universal registration document for an offer/admission." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:SummaryDocument .

bpi:meetingDate a owl:DatatypeProperty ;
    rdfs:label "meetingDate" ;
    rdfs:comment "The date of the board meeting referenced in the document." ;
    rdfs:domain bpi:BoardOfDirectors ;
    rdfs:range xsd:date .

bpi:ordinaryGeneralMeetingDate a owl:DatatypeProperty ;
    rdfs:label "ordinaryGeneralMeetingDate" ;
    rdfs:comment "The date of the ordinary general meeting." ;
    rdfs:domain bpi:OrdinaryGeneralMeeting ;
    rdfs:range xsd:date .

bpi:profitAmount a owl:DatatypeProperty ;
    rdfs:label "profitAmount" ;
    rdfs:comment "The profit amount for the last financial year used for the proposed allocation." ;
    rdfs:domain bpi:DividendDistribution ;
    rdfs:range xsd:decimal .

bpi:registeredOfficeAddress a owl:DatatypeProperty ;
    rdfs:label "registeredOfficeAddress" ;
    rdfs:comment "The registered office address of the company." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range xsd:string .

bpi:remainingDividendAmount a owl:DatatypeProperty ;
    rdfs:label "remainingDividendAmount" ;
    rdfs:comment "The total amount of the remaining dividend to be distributed." ;
    rdfs:domain bpi:DividendDistribution ;
    rdfs:range xsd:decimal .

bpi:remainingDividendPaidDate a owl:DatatypeProperty ;
    rdfs:label "remainingDividendPaidDate" ;
    rdfs:comment "The date when the remaining dividend is expected to be paid (if specified)." ;
    rdfs:domain bpi:DividendDistribution ;
    rdfs:range xsd:date .

bpi:remainingDividendPerShare a owl:DatatypeProperty ;
    rdfs:label "remainingDividendPerShare" ;
    rdfs:comment "The remaining dividend unit amount per share." ;
    rdfs:domain bpi:DividendDistribution ;
    rdfs:range xsd:decimal .

bpi:remunerationFinancialYearEndDate a owl:DatatypeProperty ;
    rdfs:label "remunerationFinancialYearEndDate" ;
    rdfs:comment "The end date of the financial year for which remuneration is reported." ;
    rdfs:domain bpi:Remuneration ;
    rdfs:range xsd:date .

bpi:remunerationFte a owl:DatatypeProperty ;
    rdfs:label "remunerationFte" ;
    rdfs:comment "The number of full-time equivalent (FTE) persons to whom remuneration relates." ;
    rdfs:domain bpi:Remuneration ;
    rdfs:range xsd:decimal .

bpi:remunerationTotalGrossAmount a owl:DatatypeProperty ;
    rdfs:label "remunerationTotalGrossAmount" ;
    rdfs:comment "Total gross remuneration amount approved for the financial year." ;
    rdfs:domain bpi:Remuneration ;
    rdfs:range xsd:decimal .

bpi:requiresSecuritiesNote a owl:ObjectProperty ;
    rdfs:label "requiresSecuritiesNote" ;
    rdfs:comment "Indicates that use of the universal registration document for an offer/admission is completed by a securities note." ;
    rdfs:domain bpi:UniversalRegistrationDocument ;
    rdfs:range bpi:SecuritiesNote .

bpi:statementDate a owl:DatatypeProperty ;
    rdfs:label "statementDate" ;
    rdfs:comment "The date of the certification/statement by the CEO and Deputy CEO." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:date .

bpi:submitsResolutionsToGeneralMeeting a owl:ObjectProperty ;
    rdfs:label "submitsResolutionsToGeneralMeeting" ;
    rdfs:comment "Indicates that resolutions are submitted to the company’s general meeting(s)." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range bpi:GeneralMeeting .

bpi:termEndedDate a owl:DatatypeProperty ;
    rdfs:label "termEndedDate" ;
    rdfs:comment "The date when the director’s term ended." ;
    rdfs:domain bpi:Director ;
    rdfs:range xsd:date .

bpi:termExpiredDate a owl:DatatypeProperty ;
    rdfs:label "termExpiredDate" ;
    rdfs:comment "The date when the director’s term expired." ;
    rdfs:domain bpi:Director ;
    rdfs:range xsd:date .

bpi:termOfCurrentOfficeEndDate a owl:DatatypeProperty ;
    rdfs:label "termOfCurrentOfficeEndDate" ;
    rdfs:comment "The end date of the director’s current term of office." ;
    rdfs:domain bpi:Director ;
    rdfs:range xsd:date .

bpi:termOfCurrentOfficeEndDateText a owl:DatatypeProperty ;
    rdfs:label "termOfCurrentOfficeEndDateText" ;
    rdfs:comment "The textual description of the end of the director’s current term of office when not given as a specific date." ;
    rdfs:domain bpi:Director ;
    rdfs:range xsd:string .

bpi:termOfCurrentOfficeEndYear a owl:DatatypeProperty ;
    rdfs:label "termOfCurrentOfficeEndYear" ;
    rdfs:comment "The year in which the director’s current term of office is expected to end (when expressed as a year)." ;
    rdfs:domain bpi:Director ;
    rdfs:range xsd:integer .

bpi:tradeRegisterNumber a owl:DatatypeProperty ;
    rdfs:label "tradeRegisterNumber" ;
    rdfs:comment "The company’s trade and companies register (RCS) number." ;
    rdfs:domain bpi:PublicLimitedCompany ;
    rdfs:range xsd:string .

bpi:treasurySharesAssumedValue a owl:DatatypeProperty ;
    rdfs:label "treasurySharesAssumedValue" ;
    rdfs:comment "The assumed value of treasury shares used in the dividend allocation." ;
    rdfs:domain bpi:TreasuryShares ;
    rdfs:range xsd:decimal .

bpi:treasurySharesAssumptionDate a owl:DatatypeProperty ;
    rdfs:label "treasurySharesAssumptionDate" ;
    rdfs:comment "The date on which the treasury shares value assumption is made (date remaining dividend is paid)." ;
    rdfs:domain bpi:TreasuryShares ;
    rdfs:range xsd:date .

bpi:treasurySharesCountAssumption a owl:DatatypeProperty ;
    rdfs:label "treasurySharesCountAssumption" ;
    rdfs:comment "The assumed number of shares entitled to dividends on the date of the general meeting." ;
    rdfs:domain bpi:TreasuryShares ;
    rdfs:range xsd:integer .

bpi:universalRegistrationDocumentFilingDate a owl:DatatypeProperty ;
    rdfs:label "universalRegistrationDocumentFilingDate" ;
    rdfs:comment "The filing date of the referenced Universal Registration Document (2022 URD)." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:date .

bpi:universalRegistrationDocumentReferenceNumber a owl:DatatypeProperty ;
    rdfs:label "universalRegistrationDocumentReferenceNumber" ;
    rdfs:comment "The reference number under which the 2022 Universal Registration Document was filed with the AMF." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range xsd:string .

bpi:usesRenewableEnergy a owl:ObjectProperty ;
    rdfs:label "usesRenewableEnergy" ;
    rdfs:comment "Indicates the corporate object relates to long-term electricity supplies using renewable energies." ;
    rdfs:domain bpi:CorporateObject ;
    rdfs:range bpi:RenewableEnergy .

bpi:AuditCommittee a owl:Class ;
    rdfs:label "AuditCommittee" ;
    rdfs:comment "An audit committee referenced in corporate governance annexes." .

bpi:CEO a owl:Class ;
    rdfs:label "CEO" ;
    rdfs:comment "Chief executive officer role responsible for certifying information in the amendment." .

bpi:ConsolidatedFinancialStatements a owl:Class ;
    rdfs:label "ConsolidatedFinancialStatements" ;
    rdfs:comment "Financial statements prepared on a consolidated basis for the group." .

bpi:CounterpartyRisk a owl:Class ;
    rdfs:label "CounterpartyRisk" ;
    rdfs:comment "The risk borne by a business client that is targeted by the company’s counterparty risk guarantees." .

bpi:DeputyCEO a owl:Class ;
    rdfs:label "DeputyCEO" ;
    rdfs:comment "Deputy chief executive officer role responsible for certifying information in the amendment." .

bpi:EmployeesTrainingStatement a owl:Class ;
    rdfs:label "EmployeesTrainingStatement" ;
    rdfs:comment "A non-financial performance subtopic focusing on employee training in AML/CFT and anti-corruption." ;
    rdfs:subClassOf bpi:NonFinancialPerformanceStatement .

bpi:GeneralManagement a owl:Class ;
    rdfs:label "GeneralManagement" ;
    rdfs:comment "General management referenced in the corporate governance annexes and governance structure." .

bpi:GeneralReserve a owl:Class ;
    rdfs:label "GeneralReserve" ;
    rdfs:comment "General reserves constituted by shareholders referenced as a main source relied upon for guarantees." .

bpi:GuaranteeFund a owl:Class ;
    rdfs:label "GuaranteeFund" ;
    rdfs:comment "A fund provided or established to back or finance guarantees, referenced in the company object description." .

bpi:InvestorRelationsWebsite a owl:Class ;
    rdfs:label "InvestorRelationsWebsite" ;
    rdfs:comment "A website section used to make the amendment available to the general public." .

bpi:LegalAndArbitrationProceedings a owl:Class ;
    rdfs:label "LegalAndArbitrationProceedings" ;
    rdfs:comment "Legal and arbitration proceedings referenced as part of additional information." .

bpi:MajorContract a owl:Class ;
    rdfs:label "MajorContract" ;
    rdfs:comment "A significant contract referenced in the list of documents and major contracts." .

bpi:OrganisationalStructure a owl:Class ;
    rdfs:label "OrganisationalStructure" ;
    rdfs:comment "A section describing the group’s organisational structure and important subsidiaries." .

bpi:PrincipalShareholder a owl:Class ;
    rdfs:label "PrincipalShareholder" ;
    rdfs:comment "A person holding significant direct or indirect voting rights in the issuer, referenced in annex headings." .

bpi:PublicSectorInvestmentBank a owl:Class ;
    rdfs:label "PublicSectorInvestmentBank" ;
    rdfs:comment "A type of company object described as a public sector investment bank facilitating access to financing and guarantees." .

bpi:RegulatedMarket a owl:Class ;
    rdfs:label "RegulatedMarket" ;
    rdfs:comment "A market for trading securities referenced as the context for admission to trading." .

bpi:RelatedPartyTransaction a owl:Class ;
    rdfs:label "RelatedPartyTransaction" ;
    rdfs:comment "Transactions between the issuer and related parties, referenced in annex headings." .

bpi:RemunerationCommittee a owl:Class ;
    rdfs:label "RemunerationCommittee" ;
    rdfs:comment "A committee referenced in corporate governance annexes for remuneration matters." .

bpi:RenewableEnergy a owl:Class ;
    rdfs:label "RenewableEnergy" ;
    rdfs:comment "Renewable energies referenced as the basis for long-term electricity supply guarantees." .

bpi:RiskFactorsSection a owl:Class ;
    rdfs:label "RiskFactorsSection" ;
    rdfs:comment "A section of the universal registration document covering risk factors." .

bpi:SecuritiesNote a owl:Class ;
    rdfs:label "SecuritiesNote" ;
    rdfs:comment "A document that, together with the universal registration document, enables an offer to the public or admission to trading." .

bpi:SecuritiesOffer a owl:Class ;
    rdfs:label "SecuritiesOffer" ;
    rdfs:comment "An offer to the public of securities, for which the universal registration document may be used when completed by additional notes." .

bpi:SpecialAuditorsReport a owl:Class ;
    rdfs:label "SpecialAuditorsReport" ;
    rdfs:comment "A special statutory auditors’ report on agreements referred to by the French Commercial Code." ;
    rdfs:subClassOf bpi:StatutoryAuditor .

bpi:SummaryDocument a owl:Class ;
    rdfs:label "SummaryDocument" ;
    rdfs:comment "A summary document that may be required alongside the universal registration document for certain securities transactions." .

bpi:amendsUniversalRegistrationDocument a owl:ObjectProperty ;
    rdfs:label "amendsUniversalRegistrationDocument" ;
    rdfs:comment "Indicates that the amendment updates a specific universal registration document." ;
    rdfs:domain bpi:AmendmentToUniversalRegistrationDocument ;
    rdfs:range bpi:UniversalRegistrationDocument .

bpi:ArticlesOfAssociation a owl:Class ;
    rdfs:label "ArticlesOfAssociation" ;
    rdfs:comment "The company’s constitutional document containing the object and other provisions, amended by shareholder resolutions." .

bpi:ExtraordinaryGeneralMeeting a owl:Class ;
    rdfs:label "ExtraordinaryGeneralMeeting" ;
    rdfs:comment "A type of general meeting with quorum and majority rules for extraordinary matters such as amending the articles of association." ;
    rdfs:subClassOf bpi:GeneralMeeting .

bpi:FinancialStatements a owl:Class ;
    rdfs:label "FinancialStatements" ;
    rdfs:comment "Company financial statements including balance sheet, income statement, and appendix." .

bpi:FinancialYear a owl:Class ;
    rdfs:label "FinancialYear" ;
    rdfs:comment "A defined accounting period referenced for profits, financial statements, and dividend distribution." .

bpi:LongTermElectricitySupply a owl:Class ;
    rdfs:label "LongTermElectricitySupply" ;
    rdfs:comment "Long-term electricity supply arrangements using renewable energies referenced in the updated company object." .

bpi:OrdinaryGeneralMeeting a owl:Class ;
    rdfs:label "OrdinaryGeneralMeeting" ;
    rdfs:comment "A type of general meeting with quorum and majority rules for ordinary business items such as approving financial statements and dividend distribution." ;
    rdfs:subClassOf bpi:GeneralMeeting .

bpi:SecuritiesAdmissionToTrading a owl:Class ;
    rdfs:label "SecuritiesAdmissionToTrading" ;
    rdfs:comment "Admission of securities to trading on a regulated market, supported by the universal registration document and related securities notes." .

bpi:StatutoryAuditor a owl:Class ;
    rdfs:label "StatutoryAuditor" ;
    rdfs:comment "An auditor referenced in relation to reports on company and consolidated accounts and special auditors’ reports on agreements." .

bpi:CompetentAuthority a owl:Class ;
    rdfs:label "CompetentAuthority" ;
    rdfs:comment "A regulatory body competent to approve or receive filings under applicable securities regulations (e.g., AMF)." .

bpi:GuaranteeFundImplementation a owl:Class ;
    rdfs:label "GuaranteeFundImplementation" ;
    rdfs:comment "The implementation of a guarantee fund entrusted by government to encourage long-term renewable electricity contracts." .

bpi:NonFinancialPerformanceStatement a owl:Class ;
    rdfs:label "NonFinancialPerformanceStatement" ;
    rdfs:comment "A statement section covering non-financial performance, including training metrics for AML/CFT and anti-corruption." .

bpi:TreasuryShares a owl:Class ;
    rdfs:label "TreasuryShares" ;
    rdfs:comment "Shares held by the company itself, referenced in assumptions affecting dividend amounts." .

bpi:CorporateGovernanceReport a owl:Class ;
    rdfs:label "CorporateGovernanceReport" ;
    rdfs:comment "A report section within the universal registration document describing corporate governance information." .

bpi:GeneralMeeting a owl:Class ;
    rdfs:label "GeneralMeeting" ;
    rdfs:comment "A shareholders meeting (ordinary or extraordinary) that approves reports, financial statements, and resolutions." .

bpi:Remuneration a owl:Class ;
    rdfs:label "Remuneration" ;
    rdfs:comment "Remuneration paid to people referred to in the French Monetary and Financial Code, approved by shareholders." .

bpi:BoardOfDirectors a owl:Class ;
    rdfs:label "BoardOfDirectors" ;
    rdfs:comment "The board of directors that determines corporate actions (e.g., dividend distribution and proposed amendments) and updates drafts for resolutions." .

bpi:CorporateObject a owl:Class ;
    rdfs:label "CorporateObject" ;
    rdfs:comment "The company’s object/mission as defined in the articles of association, including proposed updates to clarify activities." .

bpi:AmendmentToUniversalRegistrationDocument a owl:Class ;
    rdfs:label "AmendmentToUniversalRegistrationDocument" ;
    rdfs:comment "An amendment to a universal registration document, filed with the competent authority and updating or replacing specific sections." ;
    rdfs:subClassOf bpi:UniversalRegistrationDocument .

bpi:Director a owl:Class ;
    rdfs:label "Director" ;
    rdfs:comment "A member of the board of directors, including directors representing regions or government and those appointed or coopted." .

bpi:DividendDistribution a owl:Class ;
    rdfs:label "DividendDistribution" ;
    rdfs:comment "The policy and process for distributing dividends, including advance payments and remaining dividends." .

bpi:PublicLimitedCompany a owl:Class ;
    rdfs:label "PublicLimitedCompany" ;
    rdfs:comment "A company organized as a public limited company (société anonyme), referenced as having a specified capital amount and registered office." .

bpi:UniversalRegistrationDocument a owl:Class ;
    rdfs:label "UniversalRegistrationDocument" ;
    rdfs:comment "A universal registration document filed with a competent authority (AMF) and used as a base for securities offers or admissions to trading." .

