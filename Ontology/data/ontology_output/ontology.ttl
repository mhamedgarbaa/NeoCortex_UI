    rdfs:range xsd:decimal .

bpi:budgetAmount a owl:DatatypeProperty ;
    rdfs:label "budgetAmount" ;
    rdfs:comment "Budget amount for the year used as a comparison basis for the reported net result (amount not fully specified in the text)." ;
    rdfs:domain bpi:FinancialResults ;
    rdfs:range xsd:decimal .

bpi:budgetYear a owl:DatatypeProperty ;
    rdfs:label "budgetYear" ;
    rdfs:comment "Financial year referenced for budgeting and performance comparison (e.g., 2023)." ;
    rdfs:domain bpi:FinancialYear ;
    rdfs:range xsd:integer .

bpi:businessLoginDataAuthenticationToken a owl:DatatypeProperty ;
    rdfs:label "businessLoginDataAuthenticationToken" ;
    rdfs:comment "Authentication token used for portal access." ;
